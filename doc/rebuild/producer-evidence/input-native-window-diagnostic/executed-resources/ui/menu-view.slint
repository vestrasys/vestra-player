// Experimental shared-menu view for locked Slint 1.16.1; final API may differ.
// Parent supplies a single current layer from the same registry snapshot used by
// other projections. It owns the tree/path stack, current command validation,
// PopupWindow.close(), and restoring the previous focus on dismissal/execution.
// After showing the popup, call view.focus-menu(). No host/business policy lives
// here. External callbacks may synchronously destroy this view: finish local
// focus/state work before invoking them, and do not access the view afterward.
// This source has not been compiled or exercised by its author.
import { Button, ListView } from "std-widgets.slint";

export struct MenuRow {
    token: string,
    title: string,
    enabled: bool,
    checked: bool,
    busy: bool,
    reason: string,
    has-children: bool,
}

export component MenuView inherits Rectangle {
    in property <[MenuRow]> rows;
    in property <bool> can-go-back: false;
    callback activated(string);
    callback back();
    callback dismissed();

    forward-focus: keyboard;
    init => { root.focus-menu(); }
    background: #242832;
    min-width: 280px;
    min-height: 100px;

    private property <int> cursor: 0;
    private property <int> row-count: root.rows.length;
    private property <int> safe-cursor: root.row-count == 0 ? -1 : min(max(0, root.cursor), root.row-count - 1);
    private property <length> row-height: 72px;

    // A replacement layer starts at its first row, even when lengths coincide.
    changed rows => {
        root.cursor = 0;
        list.viewport-y = 0px;
    }
    // In-place model size changes also keep the cursor valid and reachable.
    changed row-count => {
        root.cursor = max(0, min(root.cursor, root.row-count - 1));
        root.reveal-cursor();
    }

    public function focus-menu() {
        root.cursor = 0;
        list.viewport-y = 0px;
        keyboard.focus();
    }

    function reveal-cursor() {
        if root.safe-cursor < 0 { return; }
        let top = list.viewport-y + root.safe-cursor * root.row-height;
        if top < 0px {
            list.viewport-y -= top;
        } else if top + root.row-height > list.visible-height {
            list.viewport-y -= top + root.row-height - list.visible-height;
        }
    }

    function choose(index: int) {
        if index < 0 || index >= root.rows.length { return; }
        root.cursor = index;
        if root.rows[index].enabled && !root.rows[index].busy {
            root.activated(root.rows[index].token);
        }
    }

    keyboard := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            } else if event.text == Key.LeftArrow {
                if root.can-go-back { root.back(); }
                return accept;
            } else if event.text == Key.UpArrow {
                if root.row-count > 0 {
                    root.cursor = max(0, root.safe-cursor - 1);
                    root.reveal-cursor();
                }
                return accept;
            } else if event.text == Key.DownArrow {
                if root.row-count > 0 {
                    root.cursor = min(root.row-count - 1, root.safe-cursor + 1);
                    root.reveal-cursor();
                }
                return accept;
            } else if event.text == Key.Return {
                root.choose(root.safe-cursor);
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 8px;
            spacing: 4px;
            HorizontalLayout {
                if root.can-go-back: Button {
                    text: "‹ Back";
                    clicked => { keyboard.focus(); root.back(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "Close";
                    clicked => { root.dismissed(); }
                }
            }
            list := ListView {
                vertical-stretch: 1;
                for row[index] in root.rows: Rectangle {
                    height: root.row-height;
                    background: index == root.safe-cursor ? #3b5067 : transparent;
                    border-radius: 4px;
                    VerticalLayout {
                        padding: 4px;
                        spacing: 2px;
                        Button {
                            height: 36px;
                            text: (row.checked ? "✓  " : "") + row.title
                                + (row.busy ? "  …" : "")
                                + (row.has-children ? "  ›" : "");
                            enabled: row.enabled && !row.busy;
                            clicked => { keyboard.focus(); root.choose(index); }
                        }
                        Text {
                            text: row.reason;
                            color: #cad1dd;
                            height: 24px;
                            overflow: elide;
                        }
                    }
                }
            }
            if root.rows.length == 0: Text {
                text: "No commands";
                color: #cad1dd;
            }
        }
    }
}

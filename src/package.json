{
  "name": "vestra-runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "start": "cd host && cargo run --",
    "format": "prettier --write \"{runtime,tests,scripts,packaging}/**/*.{ts,mjs}\" package.json tsconfig.json",
    "format:check": "prettier --check \"{runtime,tests,scripts,packaging}/**/*.{ts,mjs}\" package.json tsconfig.json",
    "boundaries": "node scripts/check-boundaries.mjs",
    "licenses": "node packaging/check-licenses.mjs --static",
    "package:macos": "node packaging/bundle-macos.mjs",
    "package:windows": "node packaging/bundle-windows.mjs",
    "sdk:sync-slint": "node scripts/sync-sdk-slint.mjs",
    "plugin": "node scripts/plugin.mjs",
    "plugins:build": "node scripts/plugin.mjs build --all",
    "ui:shots": "node scripts/ui-shots.mjs",
    "test:sdk": "node --test --test-timeout=60000 tests/sdk/",
    "test:packaging": "node --test packaging/tests/",
    "portability": "node scripts/check-portability.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "unsafe-policy": "node scripts/check-unsafe-policy.mjs",
    "ci:local": "node scripts/ci-local.mjs"
  },
  "dependencies": {
    "@vestra-player/sdk": "^1.6.12"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}

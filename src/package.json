{
  "name": "vestra-experimental-runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "start": "cd host && cargo run --",
    "verify": "node scripts/verify.mjs",
    "format": "prettier --write \"{sdk,runtime,examples,tests,scripts}/**/*.{ts,mjs}\" package.json tsconfig.json",
    "format:check": "prettier --check \"{sdk,runtime,examples,tests,scripts}/**/*.{ts,mjs}\" package.json tsconfig.json",
    "boundaries": "node scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}

 // Parse the user-provided filter graph, and populate the unlinked filter pads.
+// hwdevice=: create the filter's own device the first time a graph is
+// made; it is kept across graph rebuilds and freed in lavfi_destroy.
+static bool ensure_hwdevice(struct lavfi *c)
+{
+    if (c->hwdevice_ref)
+        return true;
+    enum AVHWDeviceType type = av_hwdevice_find_type_by_name(c->hwdevice);
+    int err = type == AV_HWDEVICE_TYPE_NONE ? AVERROR(EINVAL) :
+        av_hwdevice_ctx_create(&c->hwdevice_ref, type,
+            c->hwdevice_name && c->hwdevice_name[0] ? c->hwdevice_name : NULL,
+            NULL, 0);
+    if (err < 0) {
+        MP_FATAL(c, "could not create hwdevice=%s (%s): %s\n", c->hwdevice,
+                 c->hwdevice_name ? c->hwdevice_name : "", av_err2str(err));
+        return false;
+    }
+    MP_VERBOSE(c, "Created hwdevice=%s for filter graph: %s\n",
+               c->hwdevice, c->graph_string);
+    return true;
+}
+
+// avfilter_graph_parse2() with the filter's own device set on every filter
+// before it is initialized (hwupload needs it in its init).
+static int parse_with_hwdevice(struct lavfi *c, AVFilterInOut **in,
+                               AVFilterInOut **out)
+{
+    AVFilterGraphSegment *seg = NULL;
+    int ret = avfilter_graph_segment_parse(c->graph, c->graph_string, 0, &seg);
+    if (ret >= 0)
+        ret = avfilter_graph_segment_create_filters(seg, 0);
+    if (ret >= 0) {
+        for (int n = 0; n < c->graph->nb_filters; n++) {
+            AVFilterContext *filter = c->graph->filters[n];
+            if (!filter->hw_device_ctx)
+                filter->hw_device_ctx = av_buffer_ref(c->hwdevice_ref);
+        }
+        ret = avfilter_graph_segment_apply_opts(seg, 0);
+    }
+    if (ret >= 0)
+        ret = avfilter_graph_segment_init(seg, 0);
+    if (ret >= 0)
+        ret = avfilter_graph_segment_link(seg, 0, in, out);
+    avfilter_graph_segment_free(&seg);
+    return ret;
+}

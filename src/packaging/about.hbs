<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Vestra Player: Rust crates</title>
<style>
  body { font: 14px/1.5 -apple-system, "Segoe UI", sans-serif; max-width: 60em; margin: 2em auto; padding: 0 1em; color: #222; background: #fff; }
  @media (prefers-color-scheme: dark) { body { color: #ddd; background: #1b1b1f; } pre { background: #26262b !important; } }
  pre { white-space: pre-wrap; background: #f4f4f6; padding: 1em; font-size: 12px; }
  li { margin: 0.2em 0; }
</style>
</head>
<body>
<h1>Rust crates in Vestra Player</h1>
<p>The player binary links the following crates. Their licenses follow.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>Licenses</h2>
{{#each licenses}}
<section>
  <h3 id="{{id}}">{{name}}</h3>
  <p>Used by:</p>
  <ul>
  {{#each used_by}}
    <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
  {{/each}}
  </ul>
  <pre>{{text}}</pre>
</section>
{{/each}}
</body>
</html>

// A bottom bar of SDK 1.6.7 (menu redesign step 3a): it places no strip,
// reports the least width of its own controls and reads the player's
// strip width (bar_buttons.rs).
import { BarButtonsHost } from "@vestra/bar-buttons.slint";

export global MinBridge {
    in-out property <length> least: 300px;
    // The strip's width as the bar reads it, for the test.
    out property <length> strip: BarButtonsHost.width;
}

export component MinBar inherits Rectangle {
    /* A block comment does not count: property <length> content-min-width */
    out property <length> content-min-width: MinBridge.least;
    min-height: 62px;
    max-height: 62px;
}

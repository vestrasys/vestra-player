// Main window shell (core-ui-design.md §1). composition.rs replaces the
// insertion markers with the mounted panels; without mounts it is the bare shell.
import { MenuView, MenuLevel } from "menu-view.slint";
import { PaletteView, PaletteRow, PaletteLead } from "command-palette.slint";
// The status strip: the palette lead's status while the palette is closed.
import { LeadStripView, LeadStrip } from "lead-strip.slint";
import { Theme } from "@vestra/theme.slint";
import { TitleStrip } from "title-strip.slint";
// The bottom-bar button strip (bar_buttons.rs; composition.rs places it).
import { HostBarStrip } from "bar-strip.slint";
// Exported so the player can set the colours (R-H6).
export { VestraPalette } from "palette.slint";
export { MenuChrome } from "menu-view.slint";
// Bottom-bar command buttons (bar_buttons.rs fills it; HostBarStrip draws it).
export { BarButtonsHost } from "@vestra/bar-buttons.slint";
// `VestraFocus.release` from a panel runs `focus-video` (view::bind_focus).
export { VestraFocus } from "@vestra/focus.slint";
// One action button of the OSD message (`osd.show` actions): its title in
// white on a lighter plate, a gap before it, sized with the OSD font. An
// empty `text` draws nothing and takes no space; the element stays either
// way, so nothing comes or goes while the pointer moves (AccessKit). It
// takes no keyboard focus: keys stay with the video.
component OsdAction {
    in property <string> text;
    in property <length> size;
    // The message is showing (not fading out): presses count.
    in property <bool> live;
    out property <bool> hover: touch.has-hover;
    callback clicked();
    private property <bool> shown: root.text != "";
    private property <length> gap: round(10px * root.size / 18px / 1px) * 1px;
    private property <length> pad: round(8px * root.size / 18px / 1px) * 1px;
    visible: root.shown;
    width: root.shown ? root.gap + label.preferred-width + 2 * root.pad : 0px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.live;
    accessible-action-default => { if root.live { root.clicked(); } }
    Rectangle {
        x: root.gap; y: 0px;
        width: max(0px, root.width - root.gap); height: root.height;
        border-radius: 4px * root.size / 18px;
        background: touch.pressed ? #ffffff1a : touch.has-hover ? #ffffff47 : #ffffff29;
        label := Text {
            width: 100%; height: 100%;
            text: root.text;
            font-size: root.size * 0.85; font-weight: 600;
            color: #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        touch := TouchArea {
            width: 100%; height: 100%;
            enabled: root.live && root.shown;
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
        }
    }
}
export component HostWindow inherits Window {
    in property <string> window-title: "Vestra Player";
    title: root.window-title;
    preferred-width: 780px; preferred-height: 671px;
    min-width: 320px; min-height: 182px;
    background: Theme.bg-video;
    in-out property <image> video-frame;
    in property <[MenuLevel]> menu-levels;
    // Where the menu opens, in window coordinates; the host reads it on menu-reset.
    in-out property <float> menu-origin-x: 8;
    in-out property <float> menu-origin-y: 8;
    callback menu-invoke(string);
    callback menu-hover(int, string, bool);
    callback menu-scroll(int, float);
    callback menu-reset();
    callback menu-back();
    callback menu-dismiss();
    in property <bool> host-fullscreen: false;
    in property <bool> menu-open: false;
    // The command palette (command_palette.rs) on the menu layer: shown
    // instead of the menu while `menu-open`.
    in property <bool> palette-open: false;
    in property <[PaletteRow]> palette-rows;
    in property <int> palette-current: -1;
    in property <int> palette-shown: 0;
    in property <string> palette-count;
    // The first row a built-in plugin holds (`palette.lead`), and the
    // field's placeholder while it does (empty: the palette's own).
    in property <PaletteLead> palette-lead;
    in property <string> palette-placeholder;
    in property <[string]> palette-keys: ["Enter", "Shift+Enter", "Esc"];
    in-out property <string> palette-query;
    callback palette-edited(string);
    callback palette-moved(int);
    callback palette-scrolled(int);
    callback palette-run(int, bool);
    // The status strip (host/lead_strip.rs): what it shows, presses on it
    // (`stop`, `open`, `dismiss`), and whether the pointer is on it
    // (sampled by the host's tick: an end state stays while it is).
    in property <LeadStrip> lead-strip;
    callback lead-strip-action(string);
    out property <bool> lead-strip-hover: lead-strip-view.hover;
    in property <bool> input-blocked: false;
    in property <bool> cursor-hidden: false;
    // No video frame to show (R-U3): the backdrop panel, if any, is drawn instead.
    in property <bool> no-video: true;
    out property <bool> canvas-focused: canvas.has-focus;
    // The user's sidebar width (dragging writes it; the host restores it).
    in-out property <float> sidebar-width: 317;
    // Video at least 318px, splitter 3px, sidebar at least 317px.
    out property <float> sidebar-actual: clamp(root.sidebar-width, 317, max(317, root.width / 1px - 321));
    // The adjust column (menu redesign step 3b, between the video and the
    // sidebar): the user's width, at least 280, at most half the window
    // (window_state::adjust_width); the host docks it only while the video
    // keeps 480px, else it floats over the video.
    in-out property <float> adjust-width: 317;
    out property <float> adjust-actual: clamp(root.adjust-width, 280, max(280, root.width / 1px * 0.5));
    callback adjust-resized(float);
    in-out property <bool> adjust-hover: false;
    out property <float> logical-width: root.width / 1px;
    out property <float> logical-height: root.height / 1px;
    // The video column (without the bottom bar, sidebar and splitter).
    out property <float> video-width: canvas.width / 1px;
    out property <float> video-height: canvas.height / 1px;
    // The picture's shape (width / height) while mpv letterboxes it into its
    // frames (keep aspect, no zoom or pan); 0 otherwise. The host sets it.
    in property <float> video-picture-aspect: 0;
    // While the video area has another shape than the shown frame (a resize,
    // until a frame at the new size comes), only the picture inside the frame
    // is shown, scaled into the area, not mpv's bars for the old shape
    // (the host's reference in render_target.rs computes the same).
    private property <int> frame-w: root.video-frame.width;
    private property <int> frame-h: root.video-frame.height;
    private property <bool> clip-picture: root.video-picture-aspect > 0 && root.frame-w > 0 && root.frame-h > 0
        && canvas.width > 0 && canvas.height > 0
        && abs((root.frame-w / root.frame-h) / (canvas.width / canvas.height) - 1) > 0.01;
    private property <bool> clip-wide: root.video-picture-aspect >= root.frame-w / max(1, root.frame-h);
    private property <int> clip-w: !root.clip-picture ? root.frame-w
        : root.clip-wide ? root.frame-w : max(1, round(root.frame-h * root.video-picture-aspect));
    private property <int> clip-h: !root.clip-picture ? root.frame-h
        : root.clip-wide ? max(1, round(root.frame-w / root.video-picture-aspect)) : root.frame-h;
    out property <int> video-clip-x: round((root.frame-w - root.clip-w) / 2);
    out property <int> video-clip-y: round((root.frame-h - root.clip-h) / 2);
    out property <int> video-clip-width: root.clip-w;
    out property <int> video-clip-height: root.clip-h;
    // Its top-left corner in the window (the PiP source layer sits there).
    out property <float> video-x: canvas.absolute-position.x / 1px;
    out property <float> video-y: canvas.absolute-position.y / 1px;
    // The video plays in the picture-in-picture window (R-H8): the note shows instead.
    in property <bool> picture-in-picture: false;
    // On-screen display (C5) and information blocks (C10).
    in property <string> osd-text;
    in property <bool> osd-visible: false;
    // The message's action buttons ("" for none) and their presses (index
    // 0 or 1); the pointer is on a message (sampled by the host's tick).
    in property <string> osd-action-1;
    in property <string> osd-action-2;
    callback osd-action(int);
    out property <bool> osd-hover: osd-touch.has-hover || osd-first.hover || osd-second.hover;
    in property <[string]> info-panels;
    // G-10: the OSD font follows the video area (3% of its height, 12–48px);
    // the information
    // blocks scale with it (11px at a 16px OSD, 9–28px).
    out property <length> osd-size: clamp(round(canvas.height * 0.03 / 1px) * 1px, 12px, 48px);
    out property <length> info-size: clamp(11px * root.osd-size / 16px, 9px, 28px);
    private property <length> osd-pad-x: round(12px * root.osd-size / 18px / 1px) * 1px;
    private property <length> osd-pad-y: round(5px * root.osd-size / 18px / 1px) * 1px;
    // The OSD message's text width budget: the video width less the plate's
    // 10px margins, its padding and the action buttons (never negative).
    out property <length> osd-text-room: max(0px, min(canvas.width - 20px, root.osd-strip-room) - 2 * root.osd-pad-x - osd-first.width - osd-second.width);
    // While the status strip shows, the message ends 8px left of it (§4.7).
    private property <length> osd-strip-room: root.lead-strip.visible ? lead-strip-view.x - 8px - 10px : 100000px;
    // Where the message's plate ends, and its text's width (tests read them).
    out property <length> osd-right: osd.x + osd.width;
    out property <length> osd-text-width: osd-label.width;
    callback window-input(string);
    // Bindings (C3): true when the input is bound, so Slint stops propagating it.
    callback key-input(string, string, bool, bool, bool, bool, bool) -> bool;
    callback mouse-input(string, bool, bool, bool, bool) -> bool;
    // A left press on the video (x, y, modifiers): the host decides single clicks.
    callback left-press(float, float, bool, bool, bool, bool);
    // Its release (x, y), or `true` when the system cancelled the press.
    callback left-release(float, float, bool);
    // G-05: the pointer dragged the video: the system moves the window.
    callback drag-window();
    // IA-CORE-12: a double click on the video during picture-in-picture.
    callback pip-return();
    out property <float> pointer-x: mouse.mouse-x / 1px;
    out property <float> pointer-y: mouse.mouse-y / 1px;
    callback wheel-input(float, float, bool, bool, bool, bool) -> bool;
    callback sidebar-resized(float);
    // The bottom-bar strip's `»` (bar_buttons.rs): the cell's top-left corner.
    callback bar-more(float, float);
    callback close-menu();
    close-menu => { canvas.focus(); }
    // G-01: the fullscreen sidebar collapsed; keys go back to the video.
    // Also a panel's `VestraFocus.release()` (view::bind_focus).
    callback focus-video();
    focus-video => { canvas.focus(); }
    // G-04 / G-01: where the pointer is, sampled by the host every tick:
    // over the video, over the bottom bar, over the fullscreen sidebar.
    out property <bool> video-hover: mouse.has-hover;
    in-out property <bool> bottom-hover: false;
    in-out property <bool> sidebar-hover: false;
    // The fullscreen sidebar overlay's width: the user's width, leaving at
    // least the minimum video width (318) uncovered.
    out property <float> sidebar-pop-width: max(0, min(root.sidebar-width, root.width / 1px - 318));
    // The fullscreen adjust overlay's width, left of a popped-out sidebar
    // (window_state::adjust_overlay_width), and what the popped-out columns
    // cover at the right edge (the fullscreen bar ends there).
    out property <float> adjust-pop-width: max(0, min(root.adjust-actual, root.width / 1px - 318 - (root.sidebar-popped ? root.sidebar-pop-width : 0)));
    out property <float> columns-popped-width: (root.sidebar-popped ? root.sidebar-pop-width : 0) + (root.adjust-popped ? root.adjust-pop-width : 0);
    // The fullscreen title strip (title-strip.slint): where it applies, whether
    // it is out, the keys in its tooltips (the host sets them); whether the
    // pointer is over it, sampled by the host every tick; its buttons.
    in property <bool> title-strip-enabled: false;
    in property <bool> title-strip-shown: false;
    in property <string> title-strip-exit-key;
    in property <string> title-strip-close-key;
    out property <bool> title-strip-hover: title-strip.strip-hover;
    callback title-strip-action(string);
    // Keys reach the binding table only when something in the window has focus.
    init => { canvas.focus(); }
    // VESTRA-MOUNT-PROPERTIES
    keys := FocusScope {
        // A press that nothing below takes leaves the keys where they
        // were; the video takes them on a press, and a panel's own key
        // scope on a press on an empty part of it (composition.rs
        // `key_forward`), so its `focus: "panel"` bindings apply.
        focus-on-click: false;
        key-pressed(event) => {
            if root.key-input("", event.text, event.modifiers.control, event.modifiers.alt,
                    event.modifiers.shift, event.modifiers.meta, event.repeat) {
                return accept;
            }
            root.window-input("activity");
            reject
        }
        HorizontalLayout {
            spacing: 0px;
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 318px;
                canvas := FocusScope {
                    vertical-stretch: 1;
                    changed has-focus => { if !self.has-focus { root.window-input("canvasFocusLost"); } }
                    Rectangle {
                        background: Theme.bg-video;
                        // Placed (x, y): Slint takes the size constraints of a child without
                        // them into the parent's, so the picture's size fed the window's layout
                        // and every new picture redid the layout and everything that depends
                        // on it.
                        Image { x: 0px; y: 0px; visible: !root.no-video && !root.picture-in-picture; width: parent.width; height: parent.height; source: root.video-frame; image-fit: contain;
                            source-clip-x: root.video-clip-x; source-clip-y: root.video-clip-y;
                            source-clip-width: root.video-clip-width; source-clip-height: root.video-clip-height; }
                        if root.picture-in-picture: Text {
                            width: parent.width;
                            height: parent.height;
                            text: @tr("Playing in picture-in-picture");
                            font-size: 16px;
                            color: #8c8c8c;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        // VESTRA-MOUNT-BACKDROP
                        mouse := TouchArea {
                            private property <KeyboardModifiers> mods;
                            private property <bool> right-armed;
                            // G-05: a left press without modifiers may become a window drag.
                            private property <length> press-x;
                            private property <length> press-y;
                            private property <bool> drag-armed;
                            // After a drag the system may swallow the release, so the
                            // next press can complete a double click: ignore that one.
                            private property <bool> drag-swallow;
                            private property <bool> swallow-press;
                            mouse-cursor: root.cursor-hidden ? MouseCursor.none : MouseCursor.default;
                            changed mouse-x => { root.window-input("activity"); }
                            changed mouse-y => { root.window-input("activity"); }
                            moved => {
                                if self.pressed && self.drag-armed && !root.host-fullscreen && !root.menu-open
                                        && sqrt(pow((self.mouse-x - self.press-x) / 1px, 2) + pow((self.mouse-y - self.press-y) / 1px, 2)) > 4 {
                                    self.drag-armed = false;
                                    self.drag-swallow = true;
                                    self.swallow-press = false;
                                    root.drag-window();
                                }
                            }
                            double-clicked => {
                                if self.swallow-press { return; }
                                // IA-CORE-12: during picture-in-picture a double click
                                // brings the video back instead of toggling fullscreen.
                                if root.picture-in-picture {
                                    root.pip-return();
                                    return;
                                }
                                if !root.menu-open {
                                    root.mouse-input(self.mouse-x < self.width / 2 ? "LeftDoubleClick:LeftHalf" : "LeftDoubleClick:RightHalf",
                                        self.mods.control, self.mods.alt, self.mods.shift, self.mods.meta);
                                }
                            }
                            pointer-event(event) => {
                                self.mods = event.modifiers;
                                if event.kind == PointerEventKind.down {
                                    canvas.focus(); root.window-input("activity");
                                    if event.button == PointerEventButton.left {
                                        self.press-x = self.mouse-x;
                                        self.press-y = self.mouse-y;
                                        self.drag-armed = !event.modifiers.control && !event.modifiers.alt
                                            && !event.modifiers.shift && !event.modifiers.meta;
                                        self.swallow-press = self.drag-swallow;
                                        root.window-input("capture");
                                        // No click during picture-in-picture: the double click
                                        // there brings the video back (IA-CORE-12).
                                        if !root.menu-open && !root.picture-in-picture {
                                            root.left-press(self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.control,
                                                event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                                        }
                                    }
                                    if event.button == PointerEventButton.middle {
                                        root.mouse-input("MiddleClick", event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                                    }
                                    // The side buttons (X1/X2) are window-level: the
                                    // window's winit hook fires them wherever the
                                    // pointer is (host 0.6.0, `observe_side_button`).
                                }
                                // G-15: the menu opens where the right button is
                                // released, if it was also pressed on the video.
                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                    self.right-armed = true;
                                }
                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                    if self.right-armed && self.mouse-x >= 0 && self.mouse-x < self.width
                                            && self.mouse-y >= 0 && self.mouse-y < self.height {
                                        root.menu-origin-x = (self.absolute-position.x + self.mouse-x) / 1px;
                                        root.menu-origin-y = (self.absolute-position.y + self.mouse-y) / 1px;
                                        root.menu-reset();
                                    }
                                    self.right-armed = false;
                                }
                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                                    root.left-release(self.mouse-x / 1px, self.mouse-y / 1px, false);
                                    self.drag-armed = false;
                                    if self.swallow-press {
                                        self.drag-swallow = false;
                                        self.swallow-press = false;
                                    }
                                }
                                if event.kind == PointerEventKind.cancel {
                                    root.left-release(0, 0, true);
                                    self.right-armed = false;
                                    self.drag-armed = false;
                                }
                            }
                            scroll-event(event) => {
                                root.window-input("activity");
                                if root.wheel-input(event.delta-x / 1px, event.delta-y / 1px, event.modifiers.control,
                                        event.modifiers.alt, event.modifiers.shift, event.modifiers.meta) {
                                    return accept;
                                }
                                reject
                            }
                        }
                        // The OSD (ui-spec §6.6): white text on a translucent dark plate
                        // with the accent gradient along its bottom edge. Its padding and
                        // corners scale with the font (12×5px and 8px at 18px). The video
                        // area is dark in every palette, so the colours are fixed.
                        // Up to two action buttons follow the text on the same line
                        // (`osd.show` actions, player 0.7.6).
                        osd := Rectangle {
                            // Below the fullscreen title strip while it is out (it follows the slide).
                            x: 10px; y: 10px + title-strip.covered;
                            width: osd-label.width + osd-first.width + osd-second.width + 2 * root.osd-pad-x;
                            height: osd-label.preferred-height + 2 * root.osd-pad-y;
                            border-radius: Theme.radius-panel * root.osd-size / 18px;
                            background: #0b0a10c4;
                            opacity: 0;
                            // Only a message with actions takes the pointer: a press on
                            // its plate is no click on the video, and the host keeps it
                            // while `osd-hover`. Without actions every press goes through.
                            osd-touch := TouchArea {
                                width: 100%; height: 100%;
                                enabled: root.osd-visible && root.osd-action-1 != "";
                                changed mouse-x => { root.window-input("activity"); }
                                changed mouse-y => { root.window-input("activity"); }
                                // The text takes what the video width leaves beside the
                                // buttons (10px margins on both sides) and ends in "…"
                                // when longer, so the buttons always show whole. Only
                                // widths change: no element comes or goes.
                                osd-label := Text {
                                    x: root.osd-pad-x; y: root.osd-pad-y;
                                    width: min(self.preferred-width, root.osd-text-room);
                                    height: self.preferred-height;
                                    text: root.osd-text;
                                    font-size: root.osd-size; font-weight: 600;
                                    color: #ffffff;
                                    overflow: elide;
                                }
                                osd-first := OsdAction {
                                    x: osd-label.x + osd-label.width; y: root.osd-pad-y;
                                    height: osd-label.height;
                                    text: root.osd-action-1;
                                    size: root.osd-size;
                                    live: root.osd-visible;
                                    clicked => { root.osd-action(0); }
                                }
                                osd-second := OsdAction {
                                    x: osd-first.x + osd-first.width; y: root.osd-pad-y;
                                    height: osd-label.height;
                                    text: root.osd-action-2;
                                    size: root.osd-size;
                                    live: root.osd-visible;
                                    clicked => { root.osd-action(1); }
                                }
                            }
                            Rectangle {
                                x: parent.border-radius; y: parent.height - 2px;
                                width: parent.width - 2 * parent.border-radius; height: 2px;
                                border-radius: 1px;
                                background: Theme.accent-fill;
                            }
                            states [
                                shown when root.osd-visible: {
                                    opacity: 1;
                                    out {
                                        animate opacity { duration: 300ms; }
                                    }
                                }
                            ]
                        }
                        // The information blocks (C10): the same plates without the line,
                        // 4px below the OSD.
                        VerticalLayout {
                            x: 10px; y: osd.y + osd.height + 4px;
                            width: min(self.preferred-width, parent.width - 20px);
                            height: self.preferred-height;
                            spacing: 4px;
                            for text in root.info-panels: Rectangle {
                                background: #0b0a10c4;
                                border-radius: Theme.radius-control * root.osd-size / 16px;
                                HorizontalLayout {
                                    padding: 6px * root.osd-size / 16px;
                                    Text { text: text; font-size: root.info-size; color: #f5f3fa; }
                                }
                            }
                        }
                    }
                }
                // VESTRA-MOUNT-BOTTOM
            }
            // VESTRA-MOUNT-ADJUST
            // VESTRA-MOUNT-SIDEBAR
        }
        // VESTRA-MOUNT-OVERLAY
    }
    // Above the video and the fullscreen sidebar, below the menu layer.
    // G-19: it spans the video only. In fullscreen it ends at the popped-out
    // columns, as the fullscreen bar does, and follows them as they slide
    // (the overlays' own 150 ms x animation, composition.rs); a column
    // popping out or in beside one already out moves the edge at once.
    title-strip := TitleStrip {
        x: 0px; y: 0px; width: root.width;
        states [
            columns when root.host-fullscreen && (root.sidebar-popped || root.adjust-popped): {
                width: root.width - root.columns-popped-width * 1px;
                in { animate width { duration: 150ms; easing: ease-out; } }
                out { animate width { duration: 150ms; easing: ease-in; } }
            }
        ]
        enabled: root.title-strip-enabled;
        shown: root.title-strip-shown;
        title: root.window-title;
        exit-key: root.title-strip-exit-key;
        close-key: root.title-strip-close-key;
        action(name) => { root.title-strip-action(name); }
        activity => { root.window-input("activity"); }
        // As on the video (its double click and wheel above): its halves,
        // not the strip's.
        background-double-clicked(x, mods) => {
            if !root.menu-open {
                root.mouse-input(x < mouse.width / 2 ? "LeftDoubleClick:LeftHalf" : "LeftDoubleClick:RightHalf",
                    mods.control, mods.alt, mods.shift, mods.meta);
            }
        }
        background-scrolled(event) => {
            root.window-input("activity");
            if root.wheel-input(event.delta-x / 1px, event.delta-y / 1px, event.modifiers.control,
                    event.modifiers.alt, event.modifiers.shift, event.modifiers.meta) {
                return accept;
            }
            reject
        }
    }
    // Where the palette was (top centre, y 16), above the video, the OSD and
    // the title strip, below the menu layer (it yields to an open menu:
    // the host hides it). Below the title strip while it is out.
    lead-strip-view := LeadStripView {
        x: (root.width - self.width) / 2;
        y: 16px + title-strip.covered;
        room: root.width - 16px;
        strip: root.lead-strip;
        action(name) => { root.lead-strip-action(name); }
    }
    if root.menu-open: Rectangle {
        width: root.width; height: root.height;
        background: transparent;
        // Any press outside the panels dismisses, like a native context menu.
        TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down { root.menu-dismiss(); }
            }
        }
        if !root.palette-open: MenuView {
            width: root.width; height: root.height;
            levels: root.menu-levels;
            hovered(level, token, now) => { root.menu-hover(level, token, now); }
            scrolled(level, offset) => { root.menu-scroll(level, offset); }
            activated(token) => { root.menu-invoke(token); }
            back => { root.menu-back(); }
            dismissed => { root.menu-dismiss(); }
        }
        if root.palette-open: PaletteView {
            width: root.width; height: root.height;
            rows: root.palette-rows;
            current: root.palette-current;
            shown: root.palette-shown;
            count: root.palette-count;
            lead: root.palette-lead;
            placeholder: root.palette-placeholder;
            run-key: root.palette-keys[0];
            keep-key: root.palette-keys[1];
            close-key: root.palette-keys[2];
            query <=> root.palette-query;
            edited(text) => { root.palette-edited(text); }
            moved(by) => { root.palette-moved(by); }
            scrolled(by) => { root.palette-scrolled(by); }
            run(slot, keep) => { root.palette-run(slot, keep); }
            dismissed => { root.menu-dismiss(); }
        }
    }
}

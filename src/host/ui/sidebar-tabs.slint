// The sidebar's tab strip (panel-slots.md step 1), drawn by the host above
// the current panel while the sidebar holds two or more: the playlist's tab
// strip (ui-spec §5.2) with one tab per panel. The detach/attach button at
// its right end acts on the whole sidebar. There is no close button: next
// to the window's own close button it closed the player when missed (user
// ruling 2026-11-07); the bottom bar's sidebar button, F6 and the menus
// hide the sidebar.
import { Theme } from "@vestra/theme.slint";
import { Icon } from "@vestra/icons.slint";
import { ToolTipArea } from "@vestra/widgets.slint";

// A 25px icon button, as the playlist's (`ui/sidebar.slint`).
component StripButton {
    in property <string> icon;
    in property <string> tip;
    callback clicked();
    width: 25px;
    accessible-role: button;
    accessible-label: root.tip;
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        color: touch.has-hover ? (touch.pressed ? Theme.accent-press : Theme.accent) : Theme.text-dim;
    }
    ToolTipArea {
        width: 100%;
        height: 100%;
        text: root.tip;
        touch := TouchArea {
            clicked => { root.clicked(); }
        }
    }
}

// One tab: the current one has the 28px gradient stroke under its label
// (1px above the bottom edge); the others are dimmed, with the rounded
// hover background on hover.
component Tab {
    in property <string> text;
    in property <bool> current;
    callback clicked();
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.current;
    accessible-action-default => { root.clicked(); }
    // Hover plate and current-tab bar: persistent, hidden by `visible` (no
    // `if` that flips with the pointer; the no-churn rule in menu-view.slint).
    Rectangle {
        visible: !root.current && touch.has-hover;
        x: 2px;
        y: 4px;
        width: parent.width - 4px;
        height: parent.height - 8px;
        border-radius: Theme.radius-control;
        background: Theme.hover-bg;
    }
    Rectangle {
        visible: root.current;
        x: (parent.width - 28px) / 2;
        y: parent.height - 3px;
        width: 28px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent-fill;
    }
    Text {
        x: 4px;
        width: parent.width - 8px;
        height: 100%;
        text: root.text;
        color: root.current ? Theme.text : Theme.text-dim;
        font-size: Theme.font-tab;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// The overflow button (sidebar-tabs.md): `»`, opening the host's menu of
// every tab below itself.
component OverflowButton {
    in property <string> tip;
    callback clicked(length, length);
    width: 25px;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-action-default => { root.clicked(self.absolute-position.x, self.absolute-position.y + self.height); }
    Text {
        text: "»";
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
        color: touch.has-hover ? (touch.pressed ? Theme.accent-press : Theme.accent) : Theme.text-dim;
    }
    ToolTipArea {
        width: 100%;
        height: 100%;
        text: root.tip;
        touch := TouchArea {
            clicked => { root.clicked(root.absolute-position.x, root.absolute-position.y + root.height); }
        }
    }
}

export component SidebarTabs inherits Rectangle {
    in property <[string]> titles;
    in property <int> active;
    in property <bool> detached;
    // A tab was clicked (its index), the overflow button (the menu's
    // origin, window coordinates), the detach/attach button.
    callback tab(int);
    callback overflow(float, float);
    callback detach();
    height: 31px;
    background: Theme.bg-bar;
    accessible-role: tab-list;
    // The room beside the detach button (25px and 3px).
    private property <length> room: max(0px, self.width - 28px);
    // Tabs stay at least 72px wide (sidebar-tabs.md); the ones that do not
    // fit go into the `»` menu, which takes 25px of the room.
    // `overflowing`, `shown` (the places for tabs) and `last` (the tab in the
    // last place) are out properties for the tests.
    // At most 4 places: the host compiles the first three tabs and the
    // current one (`sidebar_tabs::front`), so every tab shown has its panel.
    out property <bool> overflowing: root.titles.length > min(4, max(1, floor(root.room / 72px)));
    out property <int> shown: root.overflowing ? min(4, max(1, floor((root.room - 25px) / 72px))) : root.titles.length;
    // 105px tabs while they fit, narrower down to 72px.
    private property <length> tab-width: min(105px, max(0px, (root.room - (root.overflowing ? 25px : 0px)) / max(1, root.shown)));
    // The last place shows the current tab when it would not fit, so the
    // current tab is always visible; the tabs before it keep their places.
    out property <int> last: root.active >= root.shown - 1 ? root.active : root.shown - 1;
    // Placed by hand, not in a layout: the tab width follows the strip's
    // width, which a layout would make depend on the tabs (a binding loop).
    // Every tab is a persistent element, hidden with `visible` (the
    // no-churn rule of menu-view.slint).
    for title[index] in root.titles: Tab {
        visible: index < root.shown - 1 || index == root.last;
        x: (index < root.shown - 1 ? index : root.shown - 1) * root.tab-width;
        y: 0px;
        width: root.tab-width;
        height: root.height;
        text: title;
        current: index == root.active;
        clicked => { root.tab(index); }
    }
    if root.overflowing: OverflowButton {
        x: root.shown * root.tab-width;
        y: 0px;
        height: root.height;
        tip: @tr("All tabs");
        clicked(x, y) => { root.overflow(x / 1px, y / 1px); }
    }
    StripButton {
        x: root.width - 28px;
        y: 0px;
        height: root.height;
        tip: root.detached ? @tr("Attach to the main window") : @tr("Detach as a floating window");
        // Detached: arrow into the frame; attached: arrow out of it.
        icon: root.detached ? "attach" : "detach";
        clicked => { root.detach(); }
    }
}

// Shared compact context menu (reference player geometry, Vestra colours; ui-alignment.md §6.3).
// The host projects the registry as a chain of open levels (root first) and
// computes each panel's geometry and row tops (menu.rs), so the view never
// guesses layout or policy. Hovering a group opens it beside its row after
// the host's submenu delay (G-15); clicking it or pressing Right opens it at
// once. Left or Escape closes the deepest level; Escape on the top level
// dismisses (IA-CORE-01). A level taller than the window scrolls between two
// arrow bars (G-03): resting on a bar scrolls a row every 50 ms, the wheel
// scrolls, and the keyboard cursor stays in view. The host keeps the offset.
// Rows are plain (non-virtualized) elements so accessibility targets map
// one-to-one to the commands they activate.
// Keep ROW (24px), SEPARATOR (7px), PAD (2px) and ARROW (12px) in sync with menu.rs.
import { Theme } from "@vestra/theme.slint";

export struct MenuRow {
    token: string,
    title: string,
    enabled: bool,
    checked: bool,
    radio: bool,
    busy: bool,
    reason: string,
    has-children: bool,
    open: bool,
    keys: string,
    // A separator line is drawn above this row.
    separator: bool,
    // Row top inside its panel, in logical px.
    y: float,
}

export struct MenuLevel {
    rows: [MenuRow],
    x: float,
    y: float,
    width: float,
    height: float,
    // Index of this level's open group row, or -1.
    open: int,
    // Taller than the window: rows scroll between the arrow bars.
    scroll: bool,
    // Scroll offset of the rows, in logical px.
    viewport-y: float,
}

component MenuItem inherits Rectangle {
    in property <MenuRow> item;
    in property <bool> current;
    callback hovered();
    callback activated();
    private property <bool> active: root.item.enabled && !root.item.busy;
    private property <bool> lit: root.current || root.item.open;
    height: 24px;
    border-radius: Theme.radius-control;
    background: root.lit ? Theme.selected-bg : transparent;
    accessible-role: button;
    accessible-label: root.item.title;
    accessible-description: root.item.reason;
    accessible-enabled: root.active;
    accessible-checkable: root.item.checked;
    accessible-checked: root.item.checked;
    accessible-action-default => { root.activated(); }
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 8px;
        spacing: 4px;
        Rectangle {
            width: 18px;
            if root.item.checked && !root.item.radio: Rectangle {
                width: 14px; height: 14px;
                border-radius: 3px;
                background: Theme.accent;
                Text { text: "✓"; color: #ffffff; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
            }
            if root.item.checked && root.item.radio: Rectangle {
                width: 12px; height: 12px;
                border-radius: 6px;
                background: Theme.button-bg;
                Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Theme.accent; }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.item.title + (root.item.busy ? " …" : "");
            color: !root.active ? Theme.text-dim : root.lit ? Theme.text : Theme.text-list;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.item.keys != "": Text {
            text: root.item.keys;
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        Text {
            width: 10px;
            text: root.item.has-children ? "›" : "";
            color: root.lit ? Theme.text : Theme.text-list;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        changed has-hover => { if self.has-hover { root.hovered(); } }
        clicked => { root.activated(); }
    }
}

export component MenuView inherits Rectangle {
    in property <[MenuLevel]> levels;
    // Hover with level+token: a group token opens that group, a command token
    // closes levels deeper than `level`. The flag is true for a click or a key
    // (at once) and false for the pointer (after the submenu delay).
    callback hovered(int, string, bool);
    // Scroll a level to this offset (the host clamps it).
    callback scrolled(int, float);
    callback activated(string);
    callback back();
    callback dismissed();

    private property <int> cursor-level: 0;
    private property <int> cursor: -1;

    public function focus-menu() {
        root.cursor-level = 0;
        root.cursor = -1;
        keyboard.focus();
    }
    function rows-at(level: int) -> int {
        if level < 0 || level >= root.levels.length { return 0; }
        return root.levels[level].rows.length;
    }
    function open-index(level: int) -> int {
        if level < 0 || level >= root.levels.length { return -1; }
        return root.levels[level].open;
    }
    // Keep the keyboard cursor's row between the arrow bars.
    function reveal(level: int, index: int) {
        if level < 0 || level >= root.levels.length || index < 0 || index >= root.rows-at(level) { return; }
        let panel = root.levels[level];
        if !panel.scroll { return; }
        let top = panel.rows[index].y;
        let visible = panel.height - 24;
        if top - 2 < panel.viewport-y {
            root.scrolled(level, top - 2);
        } else if top + 26 > panel.viewport-y + visible {
            root.scrolled(level, top + 26 - visible);
        }
    }
    function choose(level: int, index: int) {
        if level < 0 || level >= root.levels.length || index < 0 || index >= root.rows-at(level) { return; }
        let row = root.levels[level].rows[index];
        root.cursor-level = level;
        root.cursor = index;
        if row.has-children {
            root.hovered(level, row.token, true);
            root.cursor-level = level + 1;
            root.cursor = 0;
        } else if row.enabled && !row.busy {
            root.activated(row.token);
        }
    }

    init => { root.focus-menu(); }

    keyboard := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                // Close the deepest level first, like Left (IA-CORE-01).
                if root.levels.length > 1 {
                    if root.cursor-level >= root.levels.length - 1 {
                        root.cursor-level = root.levels.length - 2;
                        root.cursor = root.open-index(root.cursor-level);
                    }
                    root.back();
                } else {
                    root.dismissed();
                }
                return accept;
            }
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                let count = root.rows-at(root.cursor-level);
                if count > 0 {
                    if event.text == Key.DownArrow {
                        root.cursor = root.cursor < 0 ? 0 : mod(root.cursor + 1, count);
                    } else {
                        root.cursor = root.cursor <= 0 ? count - 1 : root.cursor - 1;
                    }
                    let row = root.levels[root.cursor-level].rows[root.cursor];
                    // Moving onto a command closes deeper levels at once.
                    if !row.has-children { root.hovered(root.cursor-level, row.token, true); }
                    root.reveal(root.cursor-level, root.cursor);
                }
                return accept;
            }
            if event.text == Key.RightArrow {
                if root.cursor >= 0 && root.levels[root.cursor-level].rows[root.cursor].has-children {
                    root.choose(root.cursor-level, root.cursor);
                }
                return accept;
            }
            if event.text == Key.LeftArrow {
                if root.cursor-level > 0 {
                    root.cursor-level -= 1;
                    root.cursor = root.open-index(root.cursor-level);
                    root.back();
                }
                return accept;
            }
            if event.text == Key.Return || event.text == " " {
                root.choose(root.cursor-level, root.cursor);
                return accept;
            }
            // Every other key stays in the menu: bindings pause while it is open.
            accept
        }
    }

    for level[k] in root.levels: Rectangle {
        x: level.x * 1px;
        y: level.y * 1px;
        width: level.width * 1px;
        height: level.height * 1px;
        background: Theme.bg-panel;
        border-color: Theme.line;
        border-width: 1px;
        border-radius: Theme.radius-panel;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000080;
        // Swallow presses between rows so they do not dismiss the menu; the
        // wheel scrolls a level taller than the window.
        TouchArea {
            scroll-event(event) => {
                if level.scroll {
                    root.scrolled(k, level.viewport-y - event.delta-y / 1px);
                    return accept;
                }
                reject
            }
        }
        // The rows, clipped between the arrow bars while scrolling.
        Rectangle {
            y: level.scroll ? 12px : 0px;
            width: parent.width;
            height: parent.height - (level.scroll ? 24px : 0px);
            clip: level.scroll;
            for row[i] in level.rows: Rectangle {
                x: 2px;
                y: (row.y - level.viewport-y - (level.scroll ? 12 : 0)) * 1px;
                width: parent.width - 4px;
                height: 24px;
                if row.separator: Rectangle {
                    y: -4px;
                    height: 1px;
                    background: Theme.hover-bg;
                }
                MenuItem {
                    width: parent.width;
                    item: row;
                    current: root.cursor-level == k && root.cursor == i;
                    hovered => {
                        root.cursor-level = k;
                        root.cursor = i;
                        root.hovered(k, row.token, false);
                    }
                    activated => {
                        keyboard.focus();
                        root.choose(k, i);
                    }
                }
            }
        }
        if level.scroll: Rectangle {
            y: 0px;
            height: 12px;
            width: parent.width;
            Text {
                text: "▲";
                font-size: 8px;
                color: level.viewport-y > 0 ? Theme.text-list : Theme.text-dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            up := TouchArea { }
            Timer {
                interval: 50ms;
                running: up.has-hover && level.viewport-y > 0;
                triggered => { root.scrolled(k, level.viewport-y - 24); }
            }
        }
        if level.scroll: Rectangle {
            y: parent.height - 12px;
            height: 12px;
            width: parent.width;
            Text {
                text: "▼";
                font-size: 8px;
                color: Theme.text-list;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            down := TouchArea { }
            Timer {
                interval: 50ms;
                running: down.has-hover;
                triggered => { root.scrolled(k, level.viewport-y + 24); }
            }
        }
        if level.rows.length == 0: Text {
            height: 24px;
            text: "（无可用命令）";
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    // Disabled-command explanation for the current row only.
    if root.cursor >= 0 && root.cursor-level < root.levels.length
        && root.cursor < root.rows-at(root.cursor-level)
        && root.levels[root.cursor-level].rows[root.cursor].reason != "": Rectangle {
        private property <MenuLevel> level: root.levels[root.cursor-level];
        // Beside the panel at the row's height, so it never covers other rows.
        x: self.level.x * 1px + self.level.width * 1px + self.width + 4px <= root.width
            ? self.level.x * 1px + self.level.width * 1px + 4px
            : max(0px, self.level.x * 1px - self.width - 4px);
        y: max(0px, min(self.level.y * 1px + (self.level.rows[root.cursor].y - self.level.viewport-y
            + (self.level.scroll ? 12 : 0)) * 1px, root.height - self.height - 4px));
        width: min(tip.preferred-width + 16px, 360px);
        height: tip.preferred-height + 10px;
        background: Theme.bg-panel;
        border-color: Theme.line;
        border-width: 1px;
        tip := Text {
            x: 8px;
            width: parent.width - 16px;
            text: parent.level.rows[root.cursor].reason;
            color: Theme.text;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}

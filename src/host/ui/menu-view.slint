// Shared compact context menu (geometry and colours: ui-spec.md §6.3).
// The host projects the registry as a chain of open levels (root first) and
// computes each panel's geometry and row tops (menu.rs), so the view never
// guesses layout or policy. Hovering a group opens it beside its row at once
// (G-15; the host holds a switch while the pointer heads for the open
// submenu); clicking it or pressing Right opens it too. Left or Escape closes the deepest level; Escape on the top level
// dismisses (IA-CORE-01). A level taller than the window scrolls between two
// arrow bars (G-03): resting on a bar scrolls a row every 50 ms, the wheel
// scrolls, and the keyboard cursor stays in view. The host keeps the offset.
// Rows are plain (non-virtualized) elements so accessibility targets map
// one-to-one to the commands they activate.
// Keep ROW (24px), SEPARATOR (7px), PAD (2px), ARROW (12px) and MenuItem's
// columns (font size, paddings, check, spacing, submenu arrow) in sync with
// menu.rs, which sizes each panel to its widest row.
//
// RULE (no churn, 2026-10-27): nothing under the pointer may toggle an
// `if` as the pointer moves (hover, the lit or current row, a tip that
// follows the cursor). An `if` that flips builds or tears down a sub-tree
// each time: allocations, every binding of it evaluated again, the parent's
// layout redone, the renderer's cached text and textures of it dropped and
// made again (an image is uploaded again), all on the UI thread that also
// presents the video. A persistent element shown with `visible:` or
// `opacity:` costs none of that. Use those; `if` only for state that changes
// by click, key or model. (The rule was found when Slint 1.18's AccessKit
// integration also rebuilt the whole accessibility tree per change,
// 120–160 ms on a 4K render target, video at 10–14 fps during a menu sweep;
// the host is built without Slint's `accessibility` feature since
// 2026-11-07, Cargo.toml.)
// A hover that switches a submenu rewrites the rows and levels in place
// (host 0.5.26), so nothing a row or level shows depends on an `if` either:
// the check, radio, key and arrow columns, the separator, the scroll bars
// and the empty text are persistent and shown by `visible`.
import { Theme } from "@vestra/theme.slint";
import { Icon } from "@vestra/icons.slint";

// Per-palette menu values the player sets (theme.rs, with the colours); the
// defaults are the `vestra` palette's. Host-only, not in the plugin library:
// windows that draw a MenuView export it next to VestraPalette.
export global MenuChrome {
    // Panel drop shadow; only its strength differs between palettes.
    in property <color> shadow: #00000080;
}

export struct MenuRow {
    token: string,
    title: string,
    enabled: bool,
    checked: bool,
    radio: bool,
    busy: bool,
    reason: string,
    has-children: bool,
    open: bool,
    keys: string,
    // An icon of @vestra/icons.slint before the title ("" for none; only
    // the bottom-bar strip's `»` menu has them).
    icon: string,
    // A separator line is drawn above this row.
    separator: bool,
    // Row top inside its panel, in logical px.
    y: float,
}

export struct MenuLevel {
    rows: [MenuRow],
    x: float,
    y: float,
    width: float,
    height: float,
    // Index of this level's open group row, or -1.
    open: int,
    // Taller than the window: rows scroll between the arrow bars.
    scroll: bool,
    // Scroll offset of the rows, in logical px.
    viewport-y: float,
}

component MenuItem inherits Rectangle {
    in property <MenuRow> item;
    in property <bool> current;
    // Its submenu is open and the cursor is in it (or deeper): the parent
    // chain stays lit, as in Windows and macOS menus.
    in property <bool> parent-lit;
    callback hovered();
    callback activated();
    private property <bool> active: root.item.enabled && !root.item.busy;
    // Two styles (0.6.0, user ruling; Windows menus): the cursor's row (the
    // pointer's, set here at once, or the keyboard's) and, on the levels
    // above the cursor, the open rows leading to it are lit in full: one
    // row per level. A row whose submenu is open while the cursor is on
    // another row of its own level shows only the accent bar. The open row
    // follows the host (the held switch of G-15), the lit row never waits.
    private property <bool> lit: root.current || root.parent-lit;
    private property <bool> marked: root.current || root.item.open;
    height: 24px;
    border-radius: Theme.radius-control;
    background: root.lit ? Theme.selected-bg : transparent;
    // The accent bar at the left edge, of the lit and the open row (always
    // present, hidden by `visible`: no element made or dropped per hover,
    // the rule above).
    Rectangle {
        visible: root.marked;
        x: 0;
        y: 5px;
        width: 2px;
        height: 14px;
        border-radius: 1px;
        background: Theme.accent;
    }
    accessible-role: button;
    accessible-label: root.item.title;
    accessible-description: root.item.reason;
    accessible-enabled: root.active;
    accessible-checkable: root.item.checked;
    accessible-checked: root.item.checked;
    accessible-action-default => { root.activated(); }
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 8px;
        spacing: 4px;
        Rectangle {
            width: 18px;
            Rectangle {
                visible: root.item.checked && !root.item.radio;
                width: 14px; height: 14px;
                border-radius: 4px;
                background: Theme.accent;
                Icon { name: "menu-check"; color: #ffffff; }
            }
            Rectangle {
                visible: root.item.checked && root.item.radio;
                width: 12px; height: 12px;
                border-radius: 6px;
                border-width: 1.5px;
                border-color: Theme.accent;
                Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Theme.accent; }
            }
        }
        // The icon (the strip's `»`), 0px wide without one, then the title
        // and keys: without keys the empty key text is 0px wide and the gap
        // before it is 0, as if it were not there.
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 0px;
            Rectangle {
                width: root.item.icon != "" ? 18px : 0px;
                Icon {
                    visible: root.item.icon != "";
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    name: root.item.icon;
                    color: !root.active ? Theme.icon-disabled : Theme.accent;
                }
            }
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: root.item.keys != "" ? 4px : 0px;
                Text {
                    horizontal-stretch: 1;
                    text: root.item.title + (root.item.busy ? " …" : "");
                    color: !root.active ? Theme.text-dim : root.lit ? Theme.text : Theme.text-list;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    visible: root.item.keys != "";
                    text: root.item.keys;
                    color: Theme.text-dim;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
        }
        Rectangle {
            width: 10px;
            Icon {
                visible: root.item.has-children;
                x: 3px;
                name: "submenu";
                color: root.lit ? Theme.text : Theme.text-list;
            }
        }
    }
    touch := TouchArea {
        changed has-hover => { if self.has-hover { root.hovered(); } }
        clicked => { root.activated(); }
    }
}

export component MenuView inherits Rectangle {
    in property <[MenuLevel]> levels;
    // Hover with level+token: a group token opens that group, a command token
    // closes levels deeper than `level`. The flag is true for a click or a key
    // (at once) and false for the pointer (after the submenu delay).
    callback hovered(int, string, bool);
    // Scroll a level to this offset (the host clamps it).
    callback scrolled(int, float);
    callback activated(string);
    callback back();
    callback dismissed();

    private property <int> cursor-level: 0;
    private property <int> cursor: -1;

    public function focus-menu() {
        root.cursor-level = 0;
        root.cursor = -1;
        keyboard.focus();
    }
    function rows-at(level: int) -> int {
        if level < 0 || level >= root.levels.length { return 0; }
        return root.levels[level].rows.length;
    }
    function open-index(level: int) -> int {
        if level < 0 || level >= root.levels.length { return -1; }
        return root.levels[level].open;
    }
    // Keep the keyboard cursor's row between the arrow bars.
    function reveal(level: int, index: int) {
        if level < 0 || level >= root.levels.length || index < 0 || index >= root.rows-at(level) { return; }
        let panel = root.levels[level];
        if !panel.scroll { return; }
        let top = panel.rows[index].y;
        let visible = panel.height - 24;
        if top - 2 < panel.viewport-y {
            root.scrolled(level, top - 2);
        } else if top + 26 > panel.viewport-y + visible {
            root.scrolled(level, top + 26 - visible);
        }
    }
    function choose(level: int, index: int) {
        if level < 0 || level >= root.levels.length || index < 0 || index >= root.rows-at(level) { return; }
        let row = root.levels[level].rows[index];
        root.cursor-level = level;
        root.cursor = index;
        if row.has-children {
            root.hovered(level, row.token, true);
            root.cursor-level = level + 1;
            root.cursor = 0;
        } else if row.enabled && !row.busy {
            root.activated(row.token);
        }
    }

    init => { root.focus-menu(); }

    keyboard := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                // Close the deepest level first, like Left (IA-CORE-01).
                if root.levels.length > 1 {
                    if root.cursor-level >= root.levels.length - 1 {
                        root.cursor-level = root.levels.length - 2;
                        root.cursor = root.open-index(root.cursor-level);
                    }
                    root.back();
                } else {
                    root.dismissed();
                }
                return accept;
            }
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                let count = root.rows-at(root.cursor-level);
                if count > 0 {
                    if event.text == Key.DownArrow {
                        root.cursor = root.cursor < 0 ? 0 : mod(root.cursor + 1, count);
                    } else {
                        root.cursor = root.cursor <= 0 ? count - 1 : root.cursor - 1;
                    }
                    let row = root.levels[root.cursor-level].rows[root.cursor];
                    // Moving onto a command closes deeper levels at once.
                    if !row.has-children { root.hovered(root.cursor-level, row.token, true); }
                    root.reveal(root.cursor-level, root.cursor);
                }
                return accept;
            }
            if event.text == Key.RightArrow {
                if root.cursor >= 0 && root.levels[root.cursor-level].rows[root.cursor].has-children {
                    root.choose(root.cursor-level, root.cursor);
                }
                return accept;
            }
            if event.text == Key.LeftArrow {
                if root.cursor-level > 0 {
                    root.cursor-level -= 1;
                    root.cursor = root.open-index(root.cursor-level);
                    root.back();
                }
                return accept;
            }
            if event.text == Key.Return || event.text == " " {
                root.choose(root.cursor-level, root.cursor);
                return accept;
            }
            // Every other key stays in the menu: bindings pause while it is open.
            accept
        }
    }

    for level[k] in root.levels: Rectangle {
        x: level.x * 1px;
        y: level.y * 1px;
        width: level.width * 1px;
        height: level.height * 1px;
        background: Theme.bg-panel;
        border-color: Theme.line;
        border-width: 1px;
        border-radius: Theme.radius-panel;
        drop-shadow-blur: 8px;
        drop-shadow-color: MenuChrome.shadow;
        // Swallow presses between rows so they do not dismiss the menu; the
        // wheel scrolls a level taller than the window.
        TouchArea {
            scroll-event(event) => {
                if level.scroll {
                    root.scrolled(k, level.viewport-y - event.delta-y / 1px);
                    return accept;
                }
                reject
            }
        }
        // The rows, clipped between the arrow bars while scrolling. Row tops
        // are in content coordinates and the viewport starts below the up
        // bar, as menu.rs places submenus (`row_shift`).
        Rectangle {
            y: level.scroll ? 12px : 0px;
            width: parent.width;
            height: parent.height - (level.scroll ? 24px : 0px);
            clip: level.scroll;
            for row[i] in level.rows: Rectangle {
                x: 2px;
                y: (row.y - level.viewport-y) * 1px;
                width: parent.width - 4px;
                height: 24px;
                Rectangle {
                    visible: row.separator;
                    x: 8px;
                    y: -4px;
                    width: parent.width - 16px;
                    height: 1px;
                    background: Theme.line;
                }
                MenuItem {
                    width: parent.width;
                    item: row;
                    current: root.cursor-level == k && root.cursor == i;
                    parent-lit: level.open == i && root.cursor-level > k;
                    hovered => {
                        root.cursor-level = k;
                        root.cursor = i;
                        root.hovered(k, row.token, false);
                    }
                    activated => {
                        keyboard.focus();
                        root.choose(k, i);
                    }
                }
            }
        }
        Rectangle {
            visible: level.scroll;
            y: 0px;
            height: 12px;
            width: parent.width;
            Icon {
                name: "scroll-up";
                color: level.viewport-y > 0 ? Theme.text-list : Theme.text-dim;
            }
            up := TouchArea { }
            Timer {
                interval: 50ms;
                running: level.scroll && up.has-hover && level.viewport-y > 0;
                triggered => { root.scrolled(k, level.viewport-y - 24); }
            }
        }
        Rectangle {
            visible: level.scroll;
            y: parent.height - 12px;
            height: 12px;
            width: parent.width;
            Icon {
                name: "scroll-down";
                color: Theme.text-list;
            }
            down := TouchArea { }
            Timer {
                interval: 50ms;
                running: level.scroll && down.has-hover;
                triggered => { root.scrolled(k, level.viewport-y + 24); }
            }
        }
        Text {
            visible: level.rows.length == 0;
            height: 24px;
            text: @tr("(No commands available)");
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    // Disabled-command explanation for the current row only. Persistent and
    // shown by `visible` (the rule above: it follows the hovered row). An
    // index out of range reads the default level and row (empty `reason`).
    Rectangle {
        private property <bool> valid: root.cursor >= 0 && root.cursor-level < root.levels.length
            && root.cursor < root.rows-at(root.cursor-level);
        private property <MenuLevel> level: root.levels[root.cursor-level];
        private property <MenuRow> lit-row: self.level.rows[root.cursor];
        visible: self.valid && self.lit-row.reason != "";
        // Beside the panel at the row's height, so it never covers other rows.
        x: self.level.x * 1px + self.level.width * 1px + self.width + 4px <= root.width
            ? self.level.x * 1px + self.level.width * 1px + 4px
            : max(0px, self.level.x * 1px - self.width - 4px);
        y: max(0px, min(self.level.y * 1px + (self.lit-row.y - self.level.viewport-y
            + (self.level.scroll ? 12 : 0)) * 1px, root.height - self.height - 4px));
        width: min(tip.preferred-width + 16px, 360px);
        height: tip.preferred-height + 10px;
        background: Theme.bg-panel;
        border-color: Theme.line;
        border-width: 1px;
        border-radius: Theme.radius-control;
        tip := Text {
            x: 8px;
            width: parent.width - 16px;
            text: parent.lit-row.reason;
            color: Theme.text;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}

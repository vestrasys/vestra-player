// The approval sheet (host/review_sheet.rs; Ask Vestra UX §4.3): before a
// `commands.run` plan with a command that asks first runs, the host asks
// once, where the palette was (top centre), on the palette's plate and at
// its width: the request in the field's box (read-only), the question,
// every step of the plan (number, palette label, plugin, a reason when it
// is a fact), [Run Enter] [Don't Run Esc] at the right of the footer (as
// UrlInputRow: confirm first) and, when the host offers it, "Don't ask
// again for <plugin>" at its left (step 4, H4).
//
// The same sheet asks a plugin's `dialogs.confirm` raised for the main
// window (step 5, H5; §4.4): the request box only when the caller holds the
// palette's first row and its request is live (Ask Vestra's first-use
// consent), then the message, the detail, the caller's checkbox at the
// footer's left and its two buttons with Enter and Esc.
//
// It is modal and takes the keyboard focus: Enter runs, Esc does not,
// Ctrl+Enter (⌘↵ on macOS) runs and remembers when the checkbox is there
// (on a confirmation the host takes it as Enter: the box is the caller's);
// a held-down key's repeats count for nothing (the host also ignores input
// in the first 0.5 s). Space does not toggle the checkbox (it keeps the
// focus off it: a press of Space meant for pause must not check it); a
// click asks the host to (it owns the state, starts it unchecked for each
// sheet and ignores the click within the 0.5 s guard).
// Presses outside it reach the menu layer's dismiss (Don't Run). Rows:
// always SLOTS (8) of them, unused ones hidden by `visible` (the no-churn
// rule in menu-view.slint).
import { Theme } from "@vestra/theme.slint";
import { Icon } from "@vestra/icons.slint";
import { Button, Check } from "@vestra/widgets.slint";
import { MenuChrome } from "menu-view.slint";
import { ScrollView } from "std-widgets.slint";

export struct ReviewStep {
    shown: bool,
    number: string,
    // `Category: Title` as the palette shows it.
    label: string,
    plugin: string,
    // Why it asks, when that is a fact ("Closes the video",
    // "Quits the player"); empty otherwise.
    reason: string,
    // It asks first: drawn in `text`, the others in `text-list`.
    asks: bool,
}

export struct ReviewSheet {
    // The request box is shown (always for a plan; for a confirmation only
    // when its caller holds the lead with a live request).
    request: bool,
    // The request box: the lead's icon (a name of the icon set; "" draws
    // `image`) and title, and the request.
    icon: string,
    image: image,
    title: string,
    query: string,
    question: string,
    // A confirmation (`dialogs.confirm`): its message (non-empty: drawn
    // instead of the question and the steps) and its detail.
    message: string,
    detail: string,
    // Steps shown (the rest of `steps` are hidden).
    count: int,
    steps: [ReviewStep],
    // The footer's checkbox: "Don't ask again for <plugin>" (H4) on a plan,
    // the caller's checkbox on a confirmation; empty: no checkbox.
    remember: string,
    run: string,
    cancel: string,
    run-key: string,
    cancel-key: string,
}

export component ReviewSheetView inherits Rectangle {
    in property <ReviewSheet> sheet;
    // The panel's top edge: 16px, below the fullscreen title strip while
    // it is out.
    in property <length> top: 16px;
    // "Don't ask again" is checked: the host's state (`toggle-remember`
    // asks it to change; it starts unchecked for every sheet).
    in property <bool> remember-checked;
    // `run` (the host remembers when its box is checked), `run-remember`
    // (Ctrl+Enter with the checkbox there), `toggle-remember` (a click on
    // the checkbox) or `decline`.
    callback action(string);
    // Tests read the panel's place and height.
    out property <length> panel-x: panel.x;
    out property <length> panel-y: panel.y;
    out property <length> panel-width: panel.width;
    out property <length> panel-height: panel.height;
    out property <bool> has-keys: keys.has-focus;
    // The body scrolls (it is taller than the room the window leaves): a
    // confirmation's detail (or its message and detail together), a plan's
    // steps.
    out property <bool> detail-scrolls: root.scroll-shown < root.scroll-full;
    // A confirmation's message scrolls with its detail (the window cannot
    // keep it above them).
    out property <bool> message-scrolls: root.confirmation && !root.pinned;
    // The text's right edge and the vertical scroll bar's left edge in the
    // panel (tests check that they do not meet).
    out property <length> text-right: 12px + root.text-width;
    out property <length> bar-left: body.x + body.width - 14px;
    // The buttons' centres in the view (tests press them).
    out property <length> run-x: run.absolute-position.x - root.absolute-position.x + run.width / 2;
    out property <length> cancel-x: cancel.absolute-position.x - root.absolute-position.x + cancel.width / 2;
    out property <length> buttons-y: run.absolute-position.y - root.absolute-position.y + run.height / 2;
    // The checkbox: shown, checked, its box's centre in the view.
    out property <bool> remember-shown: remember.visible;
    out property <length> remember-x: remember.absolute-position.x - root.absolute-position.x + 6px;
    out property <length> remember-y: remember.absolute-position.y - root.absolute-position.y + remember.height / 2;
    out property <length> remember-height: remember.height;

    init => { keys.focus(); }

    // Run: the host remembers when its box is checked (and offered).
    function run() {
        root.action("run");
    }

    // 6px, the 32px request box, 6px (or 6px without the box); the 28px
    // question and the rows, or a confirmation's message (28px,
    // taller when it wraps) and its detail; the footer (separator and
    // buttons) as the palette's: 44px, taller only when the checkbox's text
    // wraps (two long plugin names). The panel ends 16px above the window's
    // bottom at most, so the footer stays in view: a longer body scrolls in
    // one std-widgets ScrollView (`body`). A confirmation keeps its message
    // above and scrolls its detail (a store's list of revoked versions, up to
    // 2000 characters), keeping at least 48px of it; when the window cannot
    // keep the message and 48px of detail (the smallest window, a long
    // message), the message scrolls with the detail. A plan keeps its
    // question above and scrolls its steps. While the body
    // scrolls its text is narrower by the scroll bar's 14px track, which
    // then never covers it (the track widens on hover); the decision is made
    // on the texts at their full width (`*-measure`), so it does not depend
    // on itself.
    private property <length> head: root.sheet.request ? 44px : 6px;
    private property <bool> confirmation: root.sheet.message != "";
    // The texts' full width: the panel's less 12px each side.
    private property <length> full: min(520px, root.width - 16px) - 24px;
    private property <length> text-width: root.detail-scrolls ? root.full - 8px : root.full;
    private property <length> footer-height: root.sheet.remember == "" ? 44px : max(44px, remember.preferred-height + 20px);
    // What the window leaves the body (at least one 28px line).
    private property <length> room: max(28px, root.height - root.top - 16px - root.head - root.footer-height);
    // A confirmation, measured at the full width.
    private property <length> message-height: max(28px, message.preferred-height + 12px);
    private property <length> detail-height: root.sheet.detail == "" ? 0px : detail-measure.preferred-height + 8px;
    private property <bool> pinned: root.message-height + min(root.detail-height, 48px) <= root.room;
    private property <length> detail-shown: max(min(root.detail-height, 48px), min(root.detail-height, root.room - root.message-height));
    // A plan's steps.
    private property <length> steps-height: root.sheet.count * 28px;
    // The scrolled part: its whole height and what is shown of it.
    private property <length> scroll-full: !root.confirmation ? root.steps-height
        : root.pinned ? root.detail-height : root.message-height + root.detail-height;
    private property <length> scroll-shown: !root.confirmation ? min(root.steps-height, max(28px, root.room - 28px))
        : root.pinned ? root.detail-shown : min(root.message-height + root.detail-height, root.room);
    private property <length> body-height: !root.confirmation ? 28px + root.scroll-shown
        : root.pinned ? root.message-height + root.scroll-shown : root.scroll-shown;

    keys := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        key-pressed(event) => {
            // A held-down key (the Enter that sent the request) is no answer.
            if event.repeat { return accept; }
            // Ctrl+Enter (⌘↵): run and remember, where the box is offered
            // (Raycast's Always Allow); Enter alone follows the box.
            if event.text == Key.Return && event.modifiers.control && root.sheet.remember != "" {
                root.action("run-remember");
                return accept;
            }
            if event.text == Key.Return {
                root.run();
                return accept;
            }
            if event.text == Key.Escape {
                root.action("decline");
                return accept;
            }
            reject
        }
    }

    panel := Rectangle {
        x: (root.width - self.width) / 2;
        y: root.top;
        width: min(520px, root.width - 16px);
        height: root.head + root.body-height + root.footer-height;
        background: Theme.bg-panel;
        border-color: Theme.line;
        border-width: 1px;
        border-radius: Theme.radius-panel;
        drop-shadow-blur: 8px;
        drop-shadow-color: MenuChrome.shadow;
        // Presses on the panel do not dismiss it.
        TouchArea { }
        // The request, in the palette field's box: the lead's icon,
        // "Title:" in semibold, the request elided at its end.
        Rectangle {
            visible: root.sheet.request;
            x: 8px;
            y: 6px;
            width: parent.width - 16px;
            height: 32px;
            background: Theme.bg-list;
            border-color: Theme.line;
            border-width: 1px;
            border-radius: Theme.radius-control;
            HorizontalLayout {
                padding-left: 9px;
                padding-right: 9px;
                spacing: 6px;
                Rectangle {
                    width: 14px;
                    Icon {
                        visible: root.sheet.icon != "";
                        name: root.sheet.icon;
                        color: Theme.accent;
                    }
                    Image {
                        visible: root.sheet.icon == "";
                        width: 14px;
                        height: 12px;
                        source: root.sheet.image;
                        image-fit: contain;
                        colorize: Theme.accent;
                    }
                }
                Text {
                    horizontal-stretch: 0;
                    max-width: self.preferred-width;
                    text: root.sheet.title + ":";
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    text: root.sheet.query;
                    font-size: 13px;
                    color: Theme.text-list;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        Text {
            visible: !root.confirmation;
            x: 12px;
            y: root.head;
            width: parent.width - 24px;
            height: 28px;
            text: root.sheet.question;
            font-size: Theme.font-tab;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
        // A confirmation: the message as the question (wrapping), the
        // detail below it in `text-list` (§4.4). Above the
        // scrolled detail while the window keeps it there (`pinned`); also
        // the message's measure at the full width.
        message := Text {
            visible: root.confirmation && root.pinned;
            x: 12px;
            y: root.head;
            width: root.full;
            height: root.message-height;
            text: root.sheet.message;
            font-size: Theme.font-tab;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        // The detail's height at the full width (never drawn): whether
        // the body scrolls is decided on it.
        detail-measure := Text {
            visible: false;
            width: root.full;
            text: root.sheet.detail;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
        // The body's scrolled part, as tall as its content while the window
        // has the room (no scrolling then). Its scroll bar's track (14px,
        // at its right edge) sits in the panel's right margin and beside the
        // text, which is narrower while it scrolls.
        body := ScrollView {
            visible: root.confirmation ? (!root.pinned || root.sheet.detail != "") : root.sheet.count > 0;
            x: 4px;
            y: !root.confirmation ? root.head + 28px : root.pinned ? root.head + root.message-height : root.head;
            width: parent.width - 8px;
            height: max(0px, root.confirmation && root.sheet.detail != "" ? root.scroll-shown - 8px : root.scroll-shown);
            content-width: self.width;
            content-height: !root.confirmation ? root.sheet.count * 28px
                : inner-message.height + (root.sheet.detail == "" ? 0px : detail.height);
            // The message, when the window cannot keep it above the detail.
            inner-message := Text {
                visible: root.confirmation && !root.pinned;
                x: 8px;
                y: 0px;
                width: root.text-width;
                height: self.visible ? max(28px, self.preferred-height + 12px) : 0px;
                text: root.sheet.message;
                font-size: Theme.font-tab;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            detail := Text {
                visible: root.confirmation;
                x: 8px;
                y: inner-message.height;
                width: root.text-width;
                height: self.preferred-height;
                text: root.sheet.detail;
                font-size: Theme.font-body;
                color: Theme.text-list;
                wrap: word-wrap;
            }
            // The steps below the question, as the palette's rows: the
            // number, the label (it keeps up to 60% of the row), the plugin,
            // the reason.
            for step[i] in root.sheet.steps: Rectangle {
                visible: !root.confirmation && step.shown;
                x: 0px;
                y: i * 28px;
                // Clear of the scroll bar's track while the steps scroll.
                width: root.detail-scrolls ? body.width - 16px : body.width;
                height: 28px;
                accessible-role: text;
                accessible-label: step.label;
                accessible-description: step.reason;
                HorizontalLayout {
                    padding-left: 8px;
                    // An empty reason still takes the spacing before it: the
                    // plugin column ends 8px in either way.
                    padding-right: step.reason == "" ? 0px : 8px;
                    spacing: 8px;
                    Text {
                        width: 10px;
                        text: step.number;
                        font-size: Theme.font-body;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-stretch: 1;
                        min-width: min(self.preferred-width, (parent.width - 34px) * 0.6);
                        text: step.label;
                        font-size: Theme.font-tab;
                        color: step.asks ? Theme.text : Theme.text-list;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        horizontal-stretch: 0;
                        min-width: 0px;
                        max-width: 160px;
                        text: step.plugin;
                        font-size: Theme.font-body;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        visible: step.reason != "";
                        horizontal-stretch: 0;
                        width: step.reason == "" ? 0px : min(self.preferred-width, 140px);
                        text: step.reason;
                        font-size: Theme.font-body;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
        // Footer: the palette's separator, the buttons at its right, the
        // checkbox at its left.
        Rectangle {
            x: 8px;
            y: parent.height - root.footer-height + 6px;
            width: parent.width - 16px;
            height: 1px;
            background: Theme.line;
        }
        HorizontalLayout {
            x: 10px;
            y: parent.height - root.footer-height + 12px;
            width: parent.width - 20px;
            height: root.footer-height - 20px;
            spacing: 6px;
            // The checkbox takes the room the buttons leave; its text wraps
            // (two long plugin names) and the footer grows with it.
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                min-width: 0px;
                // The host owns the state: a click asks it to toggle
                // (`toggle-remember`), which it ignores within the 0.5 s
                // guard, as any other input.
                remember := Check {
                    visible: root.sheet.remember != "";
                    text: root.sheet.remember;
                    self-toggle: false;
                    checked: root.remember-checked;
                    toggled(_) => { root.action("toggle-remember"); }
                }
            }
            VerticalLayout {
                alignment: center;
                run := Button {
                    text: root.sheet.run;
                    key: root.sheet.run-key;
                    clicked => { root.run(); }
                }
            }
            VerticalLayout {
                alignment: center;
                cancel := Button {
                    text: root.sheet.cancel;
                    key: root.sheet.cancel-key;
                    clicked => { root.action("decline"); }
                }
            }
        }
    }
}

// The command palette (menu redesign §6; host/palette, Ctrl+Shift+P): a
// field and the matching commands, drawn on the menu layer in the menu's
// style. The host lists, matches and orders the commands and keeps the
// cursor and the rows in view (command_palette.rs); this view only draws
// them and reports keys, edits, clicks and the wheel.
//
// Rows: always SLOTS (12) of them, written in place, unused ones hidden by
// `visible`. Moving through the list or typing never creates or destroys
// an element (the no-churn rule in menu-view.slint). Keep ROW (28px), TOP (16px) and CHROME (92px:
// field, separator, footer and padding) in sync with command_palette.rs.
import { Theme } from "@vestra/theme.slint";
import { Icon } from "@vestra/icons.slint";
import { MenuChrome } from "menu-view.slint";

export struct PaletteRow {
    token: string,
    // The label in runs, alternately plain and matched (plain first).
    segments: [string],
    // The whole label, for accessibility.
    label: string,
    // The plugin's name; for a disabled command, why it is disabled.
    plugin: string,
    // Where the command lives (its window, its menu path, the menu).
    place: string,
    keys: string,
    enabled: bool,
    checked: bool,
    radio: bool,
    checkable: bool,
    busy: bool,
    reason: string,
    shown: bool,
}

// The first row a built-in plugin holds (`palette.lead`, palette.rs): its
// icon, "title: query" (the title alone and `empty` dimmed for an empty
// query), a note on the right; or its status (`status`) while the query is
// empty. Drawn above the commands in view, never scrolled away.
export struct PaletteLead {
    shown: bool,
    // A name of the icon set; "" draws `image`.
    icon: string,
    image: image,
    title: string,
    query: string,
    empty: string,
    note: string,
    status: bool,
}

component KeyCap inherits Rectangle {
    in property <string> text;
    in property <bool> dim;
    visible: root.text != "";
    width: root.text == "" ? 0px : cap.preferred-width + 10px;
    height: 18px;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: Theme.line;
    cap := Text {
        text: root.text;
        font-size: 11px;
        font-family: Theme.font-mono;
        color: root.dim ? Theme.text-dim : Theme.text-list;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component PaletteItem inherits Rectangle {
    in property <PaletteRow> item;
    in property <bool> current;
    callback activated();
    height: 28px;
    border-radius: Theme.radius-control;
    background: root.current ? Theme.selected-bg : touch.has-hover ? Theme.hover-bg : transparent;
    accessible-role: button;
    accessible-label: root.item.label;
    accessible-description: root.item.reason;
    accessible-enabled: root.item.enabled;
    accessible-checkable: root.item.checkable;
    accessible-checked: root.item.checked;
    accessible-action-default => { root.activated(); }
    // The accent bar of the cursor's row, as in menus.
    Rectangle {
        visible: root.current;
        x: 0;
        y: 7px;
        width: 2px;
        height: 14px;
        border-radius: 1px;
        background: Theme.accent;
    }
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 8px;
        spacing: 6px;
        Rectangle {
            width: 18px;
            Rectangle {
                visible: root.item.checked && !root.item.radio;
                width: 14px; height: 14px;
                border-radius: 4px;
                background: Theme.accent;
                Icon { name: "menu-check"; color: #ffffff; }
            }
            Rectangle {
                visible: root.item.checkable && root.item.radio;
                width: 12px; height: 12px;
                border-radius: 6px;
                border-width: 1.5px;
                border-color: root.item.checked ? Theme.accent : Theme.text-dim;
                Rectangle {
                    visible: root.item.checked;
                    width: 6px; height: 6px; border-radius: 3px;
                    background: Theme.accent;
                }
            }
        }
        // The label, clipped: its runs are placed (x, y) so their widths
        // do not size the row. It keeps up to 55% of the row before the
        // plugin's name (or a disabled command's reason) is elided.
        Rectangle {
            horizontal-stretch: 1;
            min-width: min(runs.preferred-width, root.width * 0.55);
            clip: true;
            runs := HorizontalLayout {
                x: 0; y: 0;
                height: parent.height;
                width: self.preferred-width;
                spacing: 0px;
                for run[j] in root.item.segments: Text {
                    text: run;
                    font-size: 12px;
                    font-weight: mod(j, 2) == 1 ? 700 : 400;
                    color: !root.item.enabled ? Theme.text-dim
                        : mod(j, 2) == 1 ? Theme.accent
                        : root.current ? Theme.text : Theme.text-list;
                    vertical-alignment: center;
                }
            }
        }
        // Elided first when the row is short: never under the place.
        Text {
            horizontal-stretch: 0;
            min-width: 0px;
            max-width: 200px;
            text: root.item.plugin;
            font-size: 11px;
            color: Theme.text-dim;
            vertical-alignment: center;
            overflow: elide;
        }
        // Where it lives, as plain secondary text: only keys get a cap.
        Text {
            width: min(self.preferred-width, 140px);
            text: root.item.place;
            font-size: 11px;
            color: Theme.text-dim;
            vertical-alignment: center;
            overflow: elide;
        }
        KeyCap {
            text: root.item.keys;
            dim: !root.item.enabled;
        }
    }
    touch := TouchArea {
        clicked => { root.activated(); }
    }
}

component LeadItem inherits Rectangle {
    in property <PaletteLead> lead;
    in property <bool> current;
    callback activated();
    private property <bool> typed: !root.lead.status && root.lead.query != "";
    height: 28px;
    border-radius: Theme.radius-control;
    background: root.current ? Theme.selected-bg : touch.has-hover ? Theme.hover-bg : transparent;
    accessible-role: button;
    accessible-label: root.typed ? root.lead.title + ": " + root.lead.query : root.lead.title;
    accessible-description: root.lead.note;
    accessible-action-default => { root.activated(); }
    Rectangle {
        visible: root.current;
        x: 0;
        y: 7px;
        width: 2px;
        height: 14px;
        border-radius: 1px;
        background: Theme.accent;
    }
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 8px;
        spacing: 6px;
        // The icon in the commands' check column, in the accent colour.
        Rectangle {
            width: 18px;
            Icon {
                visible: root.lead.icon != "";
                name: root.lead.icon;
                color: Theme.accent;
            }
            Image {
                visible: root.lead.icon == "";
                width: 14px;
                height: 12px;
                source: root.lead.image;
                image-fit: contain;
                colorize: Theme.accent;
            }
        }
        // "Title:" in semibold, then what is typed; the whole row is for
        // the text, elided at its end.
        HorizontalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 4px;
            Text {
                horizontal-stretch: 0;
                max-width: self.preferred-width;
                text: root.typed ? root.lead.title + ":" : root.lead.title;
                font-size: 12px;
                font-weight: root.lead.status ? 400 : 600;
                color: root.current ? Theme.text : Theme.text-list;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: root.typed ? root.lead.query : root.lead.status ? "" : root.lead.empty;
                font-size: 12px;
                color: !root.typed ? Theme.text-dim : root.current ? Theme.text : Theme.text-list;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Text {
            horizontal-stretch: 0;
            min-width: 0px;
            max-width: 200px;
            text: root.lead.note;
            font-size: 11px;
            color: Theme.text-dim;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        clicked => { root.activated(); }
    }
}

export component PaletteView inherits Rectangle {
    in property <[PaletteRow]> rows;
    // The cursor's row among `rows`, -1 for none.
    in property <int> current: -1;
    // Rows shown (the rest of `rows` are hidden).
    in property <int> shown: 0;
    in property <string> count;
    // The lead's row (`palette.lead`): slot 0 of `current` and `run` while
    // shown, the commands after it.
    in property <PaletteLead> lead;
    // The field's placeholder while there is a lead (empty: the palette's own).
    in property <string> placeholder;
    private property <int> leading: root.lead.shown ? 1 : 0;
    // The footer's keys as this system's menus write them (the host's
    // binding labels: `Shift+Enter`, `⇧Enter` on macOS).
    in property <string> run-key: "Enter";
    in property <string> keep-key: "Shift+Enter";
    in property <string> close-key: "Esc";
    in-out property <string> query;
    callback edited(string);
    // Move the cursor by rows (the host clamps; ±1 wraps around).
    callback moved(int);
    // The wheel: move the rows in view.
    callback scrolled(int);
    // Run a row (-1: the cursor's); true keeps the palette open.
    callback run(int, bool);
    callback dismissed();

    public function focus-palette() { field.focus(); }
    init => { field.focus(); }
    // The text cursor in the field's coordinates, as the field last
    // reported it; where it is drawn in the field's window, and that
    // window's width (tests read them: the cursor stays in view).
    private property <length> cursor-at;
    out property <length> cursor-in-field: field.x + root.cursor-at;
    out property <length> field-width: field-clip.width;

    private property <length> panel-width: min(520px, root.width - 16px);

    panel := Rectangle {
        x: (root.width - self.width) / 2;
        y: 16px;
        width: root.panel-width;
        height: 92px + (root.leading + max(1, root.shown)) * 28px;
        background: Theme.bg-panel;
        border-color: Theme.line;
        border-width: 1px;
        border-radius: Theme.radius-panel;
        drop-shadow-blur: 8px;
        drop-shadow-color: MenuChrome.shadow;
        // Presses between rows do not dismiss; the wheel scrolls the rows.
        TouchArea {
            scroll-event(event) => {
                if event.delta-y > 0 { root.scrolled(-3); }
                if event.delta-y < 0 { root.scrolled(3); }
                accept
            }
        }
        // The field, and the count to its right in a column of its own. A
        // plain box with the panel's 1px line (user ruling 2026-11-08: no
        // focus underline and no accent line under it; the field always
        // has the focus while the palette is open). Esc closes the palette,
        // so it has no clear button.
        Rectangle {
            x: 8px;
            y: 6px;
            width: parent.width - 24px - count.width;
            height: 32px;
            background: Theme.bg-list;
            border-color: Theme.line;
            border-width: 1px;
            border-radius: Theme.radius-control;
            // The placeholder while the query is empty; the element stays.
            Text {
                x: 9px;
                width: parent.width - 18px;
                height: parent.height;
                text: root.query != "" ? "" : root.placeholder != "" ? root.placeholder : @tr("Type a command name");
                font-size: 13px;
                color: Theme.text-dim;
                vertical-alignment: center;
                overflow: elide;
            }
            // The text's window: it clips, and the text scrolls so the
            // cursor stays in view, as std-widgets' LineEdit does
            // (lineedit-base.slint): the input is at least as wide as the
            // window and moves left by `scroll`.
            field-clip := Rectangle {
                x: 9px;
                width: parent.width - 18px;
                height: parent.height;
                clip: true;
                field := TextInput {
                    // How far the text is moved left (≥ 0).
                    property <length> scroll;
                    x: -min(self.scroll, max(0px, self.width - parent.width));
                    width: max(parent.width, self.preferred-width + self.text-cursor-width);
                    height: 100%;
                    cursor-position-changed(position) => {
                        root.cursor-at = position.x;
                        if position.x - self.scroll < 0px {
                            self.scroll = position.x;
                        } else if position.x - self.scroll > parent.width - self.text-cursor-width {
                            self.scroll = position.x - parent.width + self.text-cursor-width;
                        }
                    }
                    font-size: 13px;
                    color: Theme.text;
                    selection-background-color: Theme.selected-bg;
                    vertical-alignment: center;
                    single-line: true;
                    accessible-role: text-input;
                    accessible-label: @tr("Type a command name");
                    text <=> root.query;
                    edited => { root.edited(self.text); }
                    key-pressed(event) => {
                        if event.text == Key.Escape {
                            root.dismissed();
                            return accept;
                        }
                        if event.text == Key.UpArrow { root.moved(-1); return accept; }
                        if event.text == Key.DownArrow { root.moved(1); return accept; }
                        if event.text == Key.PageUp { root.moved(-max(1, root.shown - 1)); return accept; }
                        if event.text == Key.PageDown { root.moved(max(1, root.shown - 1)); return accept; }
                        if event.text == Key.Return {
                            root.run(-1, event.modifiers.shift);
                            return accept;
                        }
                        // The focus stays in the palette.
                        if event.text == Key.Tab || event.text == Key.Backtab { return accept; }
                        reject
                    }
                }
            }
        }
        count := Text {
            x: parent.width - self.width - 8px;
            y: 6px;
            width: self.preferred-width;
            height: 32px;
            text: root.count;
            font-size: 11px;
            color: Theme.text-dim;
            vertical-alignment: center;
        }
        // Rows from y 48px: the lead's first, then the commands.
        LeadItem {
            visible: root.lead.shown;
            x: 4px;
            y: 48px;
            width: parent.width - 8px;
            lead: root.lead;
            current: root.lead.shown && root.current == 0;
            activated => {
                field.focus();
                root.run(0, false);
            }
        }
        for row[i] in root.rows: PaletteItem {
            visible: row.shown;
            x: 4px;
            y: 48px + (i + root.leading) * 28px;
            width: parent.width - 8px;
            item: row;
            current: i + root.leading == root.current;
            activated => {
                field.focus();
                if row.enabled { root.run(i + root.leading, false); }
            }
        }
        Text {
            visible: root.shown == 0;
            x: 12px;
            y: 48px + root.leading * 28px;
            height: 28px;
            text: @tr("No matching commands");
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
        // Footer: the keys (38px from the bottom: separator and hints).
        Rectangle {
            x: 8px;
            y: parent.height - 38px;
            width: parent.width - 16px;
            height: 1px;
            background: Theme.line;
        }
        HorizontalLayout {
            x: 10px;
            y: parent.height - 32px;
            height: 24px;
            width: parent.width - 20px;
            spacing: 6px;
            alignment: start;
            KeyCap { text: "↑↓"; }
            Text { text: @tr("choose"); font-size: 11px; color: Theme.text-dim; vertical-alignment: center; }
            KeyCap { text: root.run-key; }
            Text { text: @tr("run"); font-size: 11px; color: Theme.text-dim; vertical-alignment: center; }
            KeyCap { text: root.keep-key; }
            Text { text: @tr("run, keep open"); font-size: 11px; color: Theme.text-dim; vertical-alignment: center; overflow: elide; }
            KeyCap { text: root.close-key; }
            Text { text: @tr("close"); font-size: 11px; color: Theme.text-dim; vertical-alignment: center; }
        }
    }
}

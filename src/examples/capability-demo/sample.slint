import { Button, Slider, VerticalBox } from "std-widgets.slint";
export component CapabilitySample inherits Window {
    title: "API capability sample · not product layout";
    width: 440px;
    height: 180px;
    in property <string> status;
    callback toggle();
    callback adjust(float);
    VerticalBox {
        Text { text: root.status; }
        Button { text: "Toggle pause"; clicked => { root.toggle(); } }
        Slider { minimum: -100; maximum: 100; value: 0; changed(value) => { root.adjust(value); } }
    }
}

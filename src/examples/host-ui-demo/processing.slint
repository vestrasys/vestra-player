import { Slider, VerticalBox } from "std-widgets.slint";
export component ProcessingSpecimen inherits Window {
    title: "Vestra · processing specimen";
    width: 440px; height: 260px;
    callback brightness(float);
    callback audio-gain(float);
    VerticalBox {
        Text { text: "Brightness · paused and playing"; }
        Slider { minimum: -0.5; maximum: 0.5; value: 0; changed(value) => { root.brightness(value); } }
        Text { text: "Audio EQ gain · hold and drag for 5 seconds"; }
        Slider { minimum: -6; maximum: 6; value: 0; changed(value) => { root.audio-gain(value); } }
    }
}

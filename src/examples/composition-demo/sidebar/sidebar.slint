import { Button } from "std-widgets.slint";

export global Bridge {
    in-out property <string> selected: "Nothing selected";
    in-out property <int> count: 0;
    callback select-row(string);
}

export component SourceSidebar inherits Rectangle {
    min-width: 200px;
    background: #283746;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text { text: "Independent sidebar"; color: white; }
        Text { text: Bridge.selected; color: white; }
        Text { text: "Items: " + Bridge.count; color: white; }
        Button { text: "Select example row"; clicked => { Bridge.select-row("example-row"); } }
        Rectangle { vertical-stretch: 1; }
    }
}

import { Button } from "std-widgets.slint";

export global Bridge {
    in-out property <bool> paused: false;
    in-out property <string> status: "";
    callback set-paused(bool);
    callback toggle-sidebar();
}

export component PlaybackBar inherits Rectangle {
    min-height: 56px;
    background: #202b36;
    HorizontalLayout {
        padding: 8px;
        spacing: 10px;
        Button {
            text: Bridge.paused ? "Play" : "Pause";
            clicked => { Bridge.paused = !Bridge.paused; Bridge.set-paused(Bridge.paused); }
        }
        Button { text: "Toggle sidebar"; clicked => { Bridge.toggle-sidebar(); } }
        Text { text: Bridge.status; color: #cad1dd; vertical-alignment: center; horizontal-stretch: 1; }
    }
}

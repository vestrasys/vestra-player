// One service's keys (D16): OpenSubtitles API key + optional account, or the
// assrt token. Saved to the system's secret store on 保存; 测试 shows the remaining downloads.
import { LineEdit } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button } from "@vestra/widgets.slint";

component RowLabel inherits Text {
    width: 70px;
    color: Theme.text;
    font-size: Theme.font-body;
    horizontal-alignment: right;
    vertical-alignment: center;
}

export component ServiceSettings inherits Window {
    title: root.service-name + " 设置";
    width: 360px;
    background: Theme.bg-panel;
    in property <string> service-name: "";
    in property <bool> has-account: true;
    in property <string> key-label: "API 密钥";
    in property <string> help-text: "";
    in-out property <string> key-text: "";
    in-out property <string> user-text: "";
    in-out property <string> password-text: "";
    in property <string> status-text: "";
    in property <bool> busy: false;
    callback save(string, string, string);
    callback test(string, string, string);

    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: 5px;
        HorizontalLayout {
            spacing: 5px;
            RowLabel { text: root.key-label; }
            LineEdit { height: Theme.input-height; font-size: Theme.font-body; input-type: password; text <=> root.key-text; }
        }
        if root.has-account: HorizontalLayout {
            spacing: 5px;
            RowLabel { text: "用户名"; }
            LineEdit { height: Theme.input-height; font-size: Theme.font-body; placeholder-text: "可选"; text <=> root.user-text; }
        }
        if root.has-account: HorizontalLayout {
            spacing: 5px;
            RowLabel { text: "密码"; }
            LineEdit { height: Theme.input-height; font-size: Theme.font-body; input-type: password; placeholder-text: "可选"; text <=> root.password-text; }
        }
        Text {
            text: root.help-text;
            color: Theme.text-dim;
            font-size: Theme.font-body;
            wrap: word-wrap;
            line-height-factor: 1.25;
        }
        HorizontalLayout {
            spacing: 5px;
            Text {
                text: root.status-text;
                color: Theme.text-list;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Button { text: "测试"; enabled: !root.busy; clicked => { root.test(root.key-text, root.user-text, root.password-text); } }
            Button { text: "保存"; enabled: !root.busy; clicked => { root.save(root.key-text, root.user-text, root.password-text); } }
        }
    }
}

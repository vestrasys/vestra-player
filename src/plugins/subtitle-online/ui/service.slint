// One service's keys (D16): OpenSubtitles API key + optional account, or the
// assrt token. Saved to the system's secret store on Save; Test shows the remaining downloads.
import { LineEdit } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button } from "@vestra/widgets.slint";
import { Messages } from "messages.slint";

// The row label; `column` is the window's label column (70px, wider for longer translations).
component RowLabel inherits Text {
    in property <length> column: 70px;
    width: root.column;
    color: Theme.text;
    font-size: Theme.font-body;
    horizontal-alignment: right;
    vertical-alignment: center;
}

export component ServiceSettings inherits Window {
    title: @tr("{} Settings", Messages.service-name(root.service));
    width: 360px;
    background: Theme.bg-panel;
    /** "opensubtitles" (API key and an optional account) or "assrt" (a token). */
    in property <string> service: "opensubtitles";
    /** Where the keys are kept (a text value). */
    in property <string> location;
    property <bool> has-account: root.service == "opensubtitles";
    in-out property <string> key-text: "";
    in-out property <string> user-text: "";
    in-out property <string> password-text: "";
    /** The status line (a text value). */
    in property <string> status;
    in property <bool> busy: false;
    callback save(string, string, string);
    callback test(string, string, string);
    // The label column: 70px, or the widest label.
    private property <length> column: max(70px, label-measure.preferred-width);
    Rectangle {
        visible: false;
        width: 0;
        height: 0;
        label-measure := VerticalLayout {
            for text in [@tr("API key"), @tr("Token"), @tr("User name"), @tr("Password")]: Text { text: text; font-size: Theme.font-body; }
        }
    }

    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: 5px;
        HorizontalLayout {
            spacing: 5px;
            RowLabel { column: root.column; text: root.has-account ? @tr("API key") : @tr("Token"); }
            LineEdit { height: Theme.input-height; font-size: Theme.font-body; input-type: password; text <=> root.key-text; }
        }
        if root.has-account: HorizontalLayout {
            spacing: 5px;
            RowLabel { column: root.column; text: @tr("User name"); }
            LineEdit { height: Theme.input-height; font-size: Theme.font-body; placeholder-text: @tr("Optional"); text <=> root.user-text; }
        }
        if root.has-account: HorizontalLayout {
            spacing: 5px;
            RowLabel { column: root.column; text: @tr("Password"); }
            LineEdit { height: Theme.input-height; font-size: Theme.font-body; input-type: password; placeholder-text: @tr("Optional"); text <=> root.password-text; }
        }
        Text {
            text: root.has-account
                ? @tr("Sign up at opensubtitles.com, then get a free API key on the “API consumers” page. User name and password are optional; logging in gives more downloads per day. Stored in: {}.", root.location)
                : @tr("Sign up at assrt.net, then get the API token in the user center. The service limits how often it can be called. Stored in: {}.", root.location);
            color: Theme.text-dim;
            font-size: Theme.font-body;
            wrap: word-wrap;
            line-height-factor: 1.25;
        }
        HorizontalLayout {
            spacing: 5px;
            Text {
                text: root.status;
                color: Theme.text-list;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Button { text: @tr("Test"); enabled: !root.busy; clicked => { root.test(root.key-text, root.user-text, root.password-text); } }
            Button { text: @tr("Save"); enabled: !root.busy; clicked => { root.save(root.key-text, root.user-text, root.password-text); } }
        }
    }
}

// The status lines of the windows (messages.ts has the same texts, by id, for
// the on-screen messages), and the names the windows show for data: services,
// languages, where secrets are kept.

/** One sentence: an id and up to two arguments (data); "raw" shows `a` as it is, "" nothing. */
export struct Line { id: string, a: string, b: string }
/**
 * Up to five lines joined as sentences ("sentences") or as a list ("list"),
 * or "<service>: <p0>" ("service").
 */
export struct Status { kind: string, service: string, p0: Line, p1: Line, p2: Line, p3: Line, p4: Line }
/** Where secrets are kept (secrets.ts `Location`). */
export struct Location { kind: string, value: string }

export global Messages {
    /** A service's name, by id. */
    pure public function service-name(id: string) -> string {
        if id == "assrt" { return @tr("Assrt"); }
        return "OpenSubtitles";
    }
    /** A language's name by its lower-case code (services.ts has the same codes); else the code as given. */
    pure public function language(code: string, given: string) -> string {
        if code == "zh-cn" { return @tr("Simplified Chinese"); }
        if code == "zh-tw" { return @tr("Traditional Chinese"); }
        if code == "zh" { return @tr("Chinese"); }
        if code == "en" { return @tr("English"); }
        if code == "ja" { return @tr("Japanese"); }
        if code == "ko" { return @tr("Korean"); }
        if code == "fr" { return @tr("French"); }
        if code == "de" { return @tr("German"); }
        if code == "es" { return @tr("Spanish"); }
        if code == "it" { return @tr("Italian"); }
        if code == "ru" { return @tr("Russian"); }
        if code == "pt" { return @tr("Portuguese"); }
        if code == "pt-br" { return @tr("Brazilian Portuguese"); }
        if code == "ar" { return @tr("Arabic"); }
        if code == "th" { return @tr("Thai"); }
        if code == "vi" { return @tr("Vietnamese"); }
        if code == "zh-ca" { return @tr("Cantonese"); }
        return given;
    }
    /** Where secrets are kept: the system's store (`value` is the plugin id), a file (`value` is its path), or memory. */
    pure public function location(kind: string, value: string) -> string {
        if kind == "macos" { return @tr("macOS Keychain ({})", value); }
        if kind == "windows" { return @tr("Windows Credential Manager ({})", value); }
        if kind == "system" { return @tr("System secret store ({})", value); }
        if kind == "file" { return @tr("{} (readable only by you)", value); }
        return @tr("This run only");
    }
    /** The text of one line. */
    pure public function line(m: Line) -> string {
        if m.id == "privacy" { return @tr("Searching sends the file name keywords and the file hash to the chosen service."); }
        if m.id == "noService" { return @tr("First enter an API key for OpenSubtitles under Services (free at opensubtitles.com), or turn on Assrt and enter its token."); }
        if m.id == "noMedia" { return @tr("No media to load subtitles into"); }
        if m.id == "noMediaSearchTitle" { return @tr("No media to load subtitles into; you can search by title."); }
        if m.id == "sourceChanged" { return @tr("The media changed; no subtitle was loaded."); }
        if m.id == "cancelled" { return @tr("Cancelled."); }
        if m.id == "invalid" { return @tr("The player refused the subtitle (file too large or invalid)."); }
        if m.id == "unsupported" { return @tr("Subtitles cannot be loaded into the current media."); }
        if m.id == "failed" { return @tr("Loading the subtitle failed."); }
        if m.id == "enterTitle" { return @tr("Enter a title, then search."); }
        if m.id == "searching" { return @tr("Searching…"); }
        if m.id == "found" { return @tr("Subtitles found: {}", m.a); }
        if m.id == "notFound" { return @tr("No subtitles found; change the title and search again"); }
        if m.id == "downloading" { return @tr("Downloading subtitle…"); }
        if m.id == "downloadingOf" { return @tr("Downloading subtitles ({}/{})…", m.a, m.b); }
        if m.id == "opened" { return @tr("Opened subtitle: {}", m.a); }
        if m.id == "notSavedBeside" { return @tr("Subtitle loaded, but it could not be saved in the video's folder"); }
        if m.id == "savedTo" { return @tr("Saved to {}", m.a); }
        if m.id == "added" { return @tr("Subtitles added: {}", m.a); }
        if m.id == "savedCount" { return @tr("Subtitles saved: {} (in {})", m.a, m.b); }
        if m.id == "nowhereToSave" { return @tr("No place to save to."); }
        if m.id == "notSaved" { return @tr("Not saved."); }
        if m.id == "resetAt" { return @tr("Resets at {}", m.a); }
        if m.id == "autoLoaded" { return @tr("Online subtitle loaded automatically: {}", m.a); }
        if m.id == "archiveUnsupported" { return @tr("This archive format (rar, 7z) is not supported yet; download a zip or a single subtitle file."); }
        if m.id == "archiveEmpty" { return @tr("The archive has no subtitle files."); }
        if m.id == "archiveBroken" { return @tr("The archive is damaged"); }
        if m.id == "languagesHint" { return @tr("Write preferred languages like zh-CN, zh-TW, en (at most 5)"); }
        if m.id == "testing" { return @tr("Testing…"); }
        if m.id == "testing.opensubtitles" { return @tr("Testing OpenSubtitles…"); }
        if m.id == "testing.assrt" { return @tr("Testing Assrt…"); }
        if m.id == "saved" { return @tr("Saved ({})", self.location(m.a, m.b)); }
        if m.id == "saveFailed" { return @tr("Could not save: {}", m.a); }
        if m.id == "keySet" { return @tr("Key entered"); }
        if m.id == "tokenSet" { return @tr("Token entered"); }
        if m.id == "keyMissing" { return @tr("No key"); }
        if m.id == "tokenMissing" { return @tr("No token"); }
        if m.id == "keyFirst" { return @tr("Enter the API key first"); }
        if m.id == "keyAccountValid" { return @tr("Key and account are valid"); }
        if m.id == "keyAccountRemaining" { return @tr("Key and account are valid; downloads left today: {}", m.a); }
        if m.id == "keyValid" { return @tr("Key is valid (not logged in: fewer anonymous downloads)"); }
        if m.id == "tokenFirst" { return @tr("Enter the token first"); }
        if m.id == "tokenValid" { return @tr("Token is valid"); }
        if m.id == "tokenRemaining" { return @tr("Token is valid; calls left: {}", m.a); }
        if m.id == "aborted" { return @tr("Cancelled"); }
        if m.id == "connect.opensubtitles" { return @tr("Cannot connect to OpenSubtitles"); }
        if m.id == "connect.assrt" { return @tr("Cannot connect to Assrt"); }
        if m.id == "unreadable.opensubtitles" { return @tr("OpenSubtitles returned an unreadable response"); }
        if m.id == "unreadable.assrt" { return @tr("Assrt returned an unreadable response"); }
        if m.id == "osBadKey" { return @tr("Invalid API key; check it in Online Subtitle Settings"); }
        if m.id == "osQuota" { return @tr("No downloads left today (OpenSubtitles). Log in for more downloads"); }
        if m.id == "osTooMany" { return @tr("Too many requests to OpenSubtitles; try again later"); }
        if m.id == "osError" { return @tr("OpenSubtitles error ({})", m.a); }
        if m.id == "osBadLogin" { return @tr("Wrong OpenSubtitles user name or password"); }
        if m.id == "osLoginFailed" { return @tr("OpenSubtitles login failed"); }
        if m.id == "osNoLink" { return @tr("OpenSubtitles gave no download link"); }
        if m.id == "downloadFailed" { return @tr("Cannot download the subtitle ({})", m.a); }
        if m.id == "assrtBadToken" { return @tr("Invalid Assrt token; check it in Online Subtitle Settings"); }
        if m.id == "assrtQuota" { return @tr("Assrt call limit reached; try again later"); }
        if m.id == "assrtError" { return @tr("Assrt error ({})", m.a); }
        if m.id == "assrtNoLink" { return @tr("Assrt gave no download link"); }
        if m.id == "readFailed" { return @tr("Cannot read the subtitle file."); }
        if m.id == "notRegular" { return @tr("The subtitle file must be a regular file of 1 byte to 8 MiB."); }
        if m.id == "emptyOrLarge" { return @tr("The subtitle file is empty or larger than 8 MiB."); }
        if m.id == "bitmap" { return @tr("Image subtitle files are not supported yet"); }
        if m.id == "unknownFormat" { return @tr("Unknown subtitle format"); }
        if m.id == "noCues" { return @tr("The subtitle file has no subtitles."); }
        if m.id == "tooLarge" { return @tr("The subtitle file is larger than 2 MiB"); }
        if m.id == "noteEncoding" { return @tr("The subtitle encoding may be wrong; change the default encoding in Subtitle Settings"); }
        if m.id == "noteFonts" { return @tr("Fonts embedded in the subtitle were ignored"); }
        if m.id == "noteFps" { return @tr("Unknown video frame rate; the MicroDVD subtitle was converted at 23.976"); }
        if m.id == "raw" { return m.a; }
        return "";
    }
    pure function join(how: string, first: string, next: string) -> string {
        if next == "" { return first; }
        if first == "" { return next; }
        // TRANSLATORS: two status messages in a list; in Chinese joined with ；
        if how == "list" { return @tr("{0}; {1}", first, next); }
        // TRANSLATORS: a status message, then another sentence about it; in Chinese joined with 。
        return @tr("{0}. {1}", first, next);
    }
    /** The text of a status. */
    pure public function text(s: Status) -> string {
        // TRANSLATORS: {0} is a service name, {1} the result of testing it
        if s.kind == "service" { return @tr("{0}: {1}", self.service-name(s.service), self.line(s.p0)); }
        return self.join(s.kind, self.join(s.kind, self.join(s.kind, self.join(s.kind, self.line(s.p0), self.line(s.p1)), self.line(s.p2)), self.line(s.p3)), self.line(s.p4));
    }
}

/** A window's status line. */
export component StatusText inherits Text {
    in property <Status> status;
    text: Messages.text(root.status);
}

// Online Subtitle Settings (D16): 420 wide. Services (order, on/off,
// keys, test), Search (languages, automatic search, filters), Saving (location).
import { CheckBox, ComboBox, LineEdit } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button } from "@vestra/widgets.slint";
import { Messages } from "messages.slint";

/** A service (by id), whether it is on, and its key state or last test result (a text value). */
export struct ServiceRow {
    service: string,
    enabled: bool,
    state: string,
}

component Heading inherits Text {
    color: Theme.text;
    font-size: Theme.font-tab;
    font-weight: 700;
}

component RowLabel inherits Text {
    width: 90px;
    color: Theme.text;
    font-size: Theme.font-body;
    horizontal-alignment: right;
    vertical-alignment: center;
}

export component OnlineSettings inherits Window {
    title: @tr("Online Subtitle Settings");
    width: 420px;
    background: Theme.bg-panel;
    in property <[ServiceRow]> services: [];
    in-out property <int> selected-service: 0;
    in-out property <string> languages-text: "";
    in property <int> auto-index: 0;
    in property <int> after-index: 0;
    in-out property <bool> exact-only: false;
    in-out property <string> exclude-text: "";
    in property <int> save-index: 0;
    /** Where the keys are kept (a text value). */
    in property <string> location;
    /** The status line (a text value). */
    in property <string> status;
    in property <bool> busy: false;
    changed auto-index => { auto-combo.current-index = root.auto-index; }
    changed after-index => { after-combo.current-index = root.after-index; }
    changed save-index => { save-combo.current-index = root.save-index; }
    callback select-service(int);
    callback toggle-service(int, bool);
    callback move-service(int);
    callback service-settings();
    callback test-service();
    callback change-languages(string);
    callback change-auto(int);
    callback change-after(int);
    callback change-exact(bool);
    callback change-exclude(string);
    callback change-save(int);

    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: 5px;
        Heading { text: @tr("Services"); }
        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                height: 48px;
                background: Theme.bg-list;
                border-width: 1px;
                border-color: Theme.line;
                VerticalLayout {
                    padding: 2px;
                    for service[index] in root.services: Rectangle {
                        height: 22px;
                        background: index == root.selected-service ? Theme.selected-bg : transparent;
                        TouchArea { clicked => { root.selected-service = index; root.select-service(index); } }
                        HorizontalLayout {
                            padding-left: 4px;
                            spacing: 4px;
                            CheckBox {
                                width: 20px;
                                checked: service.enabled;
                                toggled => { root.toggle-service(index, self.checked); }
                            }
                            Text { text: Messages.service-name(service.service); color: Theme.text; font-size: Theme.font-body; vertical-alignment: center; width: 110px; }
                            Text { text: service.state; color: Theme.text-dim; font-size: Theme.font-body; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    spacing: 3px;
                    Button { small: true; text: @tr("Move Up"); enabled: root.selected-service > 0; clicked => { root.move-service(-1); } }
                    Button { small: true; text: @tr("Move Down"); enabled: root.selected-service < root.services.length - 1; clicked => { root.move-service(1); } }
                }
                HorizontalLayout {
                    spacing: 3px;
                    Button { small: true; text: @tr("Settings…"); clicked => { root.service-settings(); } }
                    Button { small: true; text: @tr("Test"); enabled: !root.busy; clicked => { root.test-service(); } }
                }
            }
        }
        Heading { text: @tr("Search"); }
        HorizontalLayout {
            spacing: 5px;
            RowLabel { text: @tr("Languages"); }
            LineEdit {
                height: Theme.input-height;
                font-size: Theme.font-body;
                placeholder-text: "zh-CN, zh-TW, en";
                text <=> root.languages-text;
                accepted => { root.change-languages(self.text); }
                edited => { root.change-languages(self.text); }
            }
        }
        HorizontalLayout {
            spacing: 5px;
            RowLabel { text: @tr("Auto search"); }
            auto-combo := ComboBox {
                height: 22px;
                model: [@tr("Off"), @tr("When opening a video without subtitles")];
                current-index: root.auto-index;
                selected(value) => { root.change-auto(self.current-index); }
            }
        }
        HorizontalLayout {
            spacing: 5px;
            RowLabel { text: @tr("After search"); }
            after-combo := ComboBox {
                height: 22px;
                model: [@tr("Show the download window"), @tr("Load the best result automatically")];
                current-index: root.after-index;
                selected(value) => { root.change-after(self.current-index); }
            }
        }
        HorizontalLayout {
            padding-left: 95px;
            CheckBox {
                height: Theme.checkbox-row-height;
                text: @tr("Only subtitles that exactly match the file (hash)");
                checked <=> root.exact-only;
                toggled => { root.change-exact(self.checked); }
            }
        }
        HorizontalLayout {
            spacing: 5px;
            RowLabel { text: @tr("Exclude"); }
            LineEdit {
                height: Theme.input-height;
                font-size: Theme.font-body;
                placeholder-text: @tr("Separate with commas or spaces");
                text <=> root.exclude-text;
                edited => { root.change-exclude(self.text); }
            }
        }
        Heading { text: @tr("Saving"); }
        HorizontalLayout {
            spacing: 5px;
            RowLabel { text: @tr("Save to"); }
            save-combo := ComboBox {
                height: 22px;
                model: [@tr("Beside the video when possible"), @tr("Plugin data folder")];
                current-index: root.save-index;
                selected(value) => { root.change-save(self.current-index); }
            }
        }
        Text {
            text: @tr("Searching sends the file name keywords and the file hash to the chosen service. Keys and passwords are stored in: {}.", root.location);
            color: Theme.text-dim;
            font-size: Theme.font-body;
            wrap: word-wrap;
            line-height-factor: 1.25;
        }
        Text {
            text: root.status;
            color: Theme.text-list;
            font-size: Theme.font-body;
            overflow: elide;
        }
    }
}

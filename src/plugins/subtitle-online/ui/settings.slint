// Online Subtitle Settings (D16): 420 wide. Services (order, on/off,
// keys, test), Search (languages, automatic search, filters), Saving (location).
import { CheckBox, LineEdit } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button, Choice } from "@vestra/widgets.slint";
import { Messages } from "messages.slint";

/** A service (by id), whether it is on, and its key state or last test result (a text value). */
export struct ServiceRow {
    service: string,
    enabled: bool,
    state: string,
}

component Heading inherits Text {
    color: Theme.text;
    font-size: Theme.font-tab;
    font-weight: 700;
}

// The row label; `column` is the window's label column (90px, wider for longer translations).
component RowLabel inherits Text {
    in property <length> column: 90px;
    width: root.column;
    color: Theme.text;
    font-size: Theme.font-body;
    horizontal-alignment: right;
    vertical-alignment: center;
}

export component OnlineSettings inherits Window {
    title: @tr("Online Subtitle Settings");
    // 420px, wider only when the indented check box needs it in this language.
    width: max(420px, root.column + 5px + exact-check.preferred-width + 2 * Theme.dialog-padding);
    background: Theme.bg-panel;
    in property <[ServiceRow]> services: [];
    in-out property <int> selected-service: 0;
    in-out property <string> languages-text: "";
    in property <int> auto-index: 0;
    in property <int> after-index: 0;
    in-out property <bool> exact-only: false;
    in-out property <string> exclude-text: "";
    in property <int> save-index: 0;
    /** Where the keys are kept (a text value). */
    in property <string> location;
    /** The status line (a text value). */
    in property <string> status;
    in property <bool> busy: false;
    changed auto-index => { auto-combo.current-index = root.auto-index; }
    changed after-index => { after-combo.current-index = root.after-index; }
    changed save-index => { save-combo.current-index = root.save-index; }
    callback select-service(int);
    callback toggle-service(int, bool);
    callback move-service(int);
    callback service-settings();
    callback test-service();
    callback change-languages(string);
    callback change-auto(int);
    callback change-after(int);
    callback change-exact(bool);
    callback change-exclude(string);
    callback change-save(int);
    // The label column: 90px, or the widest label; the service name: 110px, or the longest name.
    private property <length> column: max(90px, label-measure.preferred-width);
    private property <length> name-width: max(110px, name-measure.preferred-width);
    // The drop-downs: one width, their longest entry (and the label and V, 21px).
    private property <length> choice-width: max(120px, choice-measure.preferred-width + 21px);
    private property <[string]> auto-modes: [@tr("Off"), @tr("When opening a video without subtitles")];
    private property <[string]> after-modes: [@tr("Show the download window"), @tr("Load the best result automatically")];
    private property <[string]> save-modes: [@tr("Beside the video when possible"), @tr("Plugin data folder")];
    Rectangle {
        visible: false;
        width: 0;
        height: 0;
        label-measure := VerticalLayout {
            for text in [@tr("Languages"), @tr("Auto search"), @tr("After search"), @tr("Exclude"), @tr("Save to")]: Text { text: text; font-size: Theme.font-body; }
        }
        name-measure := VerticalLayout {
            for id in ["opensubtitles", "assrt"]: Text { text: Messages.service-name(id); font-size: Theme.font-body; }
        }
        choice-measure := VerticalLayout {
            for text in root.auto-modes: Text { text: text; font-size: Theme.font-body; }
            for text in root.after-modes: Text { text: text; font-size: Theme.font-body; }
            for text in root.save-modes: Text { text: text; font-size: Theme.font-body; }
        }
    }

    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: 5px;
        Heading { text: @tr("Services"); }
        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                height: 48px;
                background: Theme.bg-list;
                border-width: 1px;
                border-color: Theme.line;
                VerticalLayout {
                    padding: 2px;
                    for service[index] in root.services: Rectangle {
                        height: 22px;
                        background: index == root.selected-service ? Theme.selected-bg : transparent;
                        TouchArea { clicked => { root.selected-service = index; root.select-service(index); } }
                        HorizontalLayout {
                            padding-left: 4px;
                            spacing: 4px;
                            CheckBox {
                                width: 20px;
                                checked: service.enabled;
                                toggled => { root.toggle-service(index, self.checked); }
                            }
                            Text { text: Messages.service-name(service.service); color: Theme.text; font-size: Theme.font-body; vertical-alignment: center; width: root.name-width; }
                            Text { text: service.state; color: Theme.text-dim; font-size: Theme.font-body; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    spacing: 3px;
                    Button { small: true; text: @tr("Move Up"); enabled: root.selected-service > 0; clicked => { root.move-service(-1); } }
                    Button { small: true; text: @tr("Move Down"); enabled: root.selected-service < root.services.length - 1; clicked => { root.move-service(1); } }
                }
                HorizontalLayout {
                    spacing: 3px;
                    Button { small: true; text: @tr("Settings…"); clicked => { root.service-settings(); } }
                    Button { small: true; text: @tr("Test"); enabled: !root.busy; clicked => { root.test-service(); } }
                }
            }
        }
        Heading { text: @tr("Search"); }
        HorizontalLayout {
            spacing: 5px;
            RowLabel { column: root.column; text: @tr("Languages"); }
            LineEdit {
                height: Theme.input-height;
                font-size: Theme.font-body;
                placeholder-text: "zh-CN, zh-TW, en";
                text <=> root.languages-text;
                accepted => { root.change-languages(self.text); }
                edited => { root.change-languages(self.text); }
            }
        }
        HorizontalLayout {
            spacing: 5px;
            RowLabel { column: root.column; text: @tr("Auto search"); }
            auto-combo := Choice {
                width: root.choice-width;
                model: root.auto-modes;
                current-index: root.auto-index;
                selected(index) => { root.change-auto(index); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 5px;
            RowLabel { column: root.column; text: @tr("After search"); }
            after-combo := Choice {
                width: root.choice-width;
                model: root.after-modes;
                current-index: root.after-index;
                selected(index) => { root.change-after(index); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            padding-left: root.column + 5px;
            exact-check := CheckBox {
                height: Theme.checkbox-row-height;
                text: @tr("Only subtitles that exactly match the file (hash)");
                checked <=> root.exact-only;
                toggled => { root.change-exact(self.checked); }
            }
        }
        HorizontalLayout {
            spacing: 5px;
            RowLabel { column: root.column; text: @tr("Exclude"); }
            LineEdit {
                height: Theme.input-height;
                font-size: Theme.font-body;
                placeholder-text: @tr("Separate with commas or spaces");
                text <=> root.exclude-text;
                edited => { root.change-exclude(self.text); }
            }
        }
        Heading { text: @tr("Saving"); }
        HorizontalLayout {
            spacing: 5px;
            RowLabel { column: root.column; text: @tr("Save to"); }
            save-combo := Choice {
                width: root.choice-width;
                model: root.save-modes;
                current-index: root.save-index;
                selected(index) => { root.change-save(index); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Text {
            text: @tr("Searching sends the file name keywords and the file hash to the chosen service. Keys and passwords are stored in: {}.", root.location);
            color: Theme.text-dim;
            font-size: Theme.font-body;
            wrap: word-wrap;
            line-height-factor: 1.25;
        }
        Text {
            text: root.status;
            color: Theme.text-list;
            font-size: Theme.font-body;
            overflow: elide;
        }
    }
}

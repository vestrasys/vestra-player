// Options ▸ Appearance (H10): palette radio, each with a 120×40 preview, and
// Restore Defaults. The page is 440 wide (the options window's page area).
// Everything themed uses `Theme`; the previews draw colours the plugin passes
// in (`Swatch`), because `Theme` only holds the current palette. Every text is
// @tr (English source; locales/<lang>.po translate it).
import { Theme } from "@vestra/theme.slint";
import { Icon } from "@vestra/icons.slint";
import { Button, RadioMark } from "@vestra/widgets.slint";

struct Rgb { r: int, g: int, b: int }
struct Swatch { video: Rgb, bar: Rgb, track: Rgb, text: Rgb, dim: Rgb, accent: Rgb, f0: Rgb, f1: Rgb, f2: Rgb, f3: Rgb }
struct ThemeRow { id: string, swatch: Swatch }

export global AppearanceBridge {
    in property <[ThemeRow]> themes;
    in property <string> theme;
    in property <bool> can-reset;
    callback pick(string);
    callback reset();
}

// One palette drawn small: video area with a play glyph, then a bottom bar
// with a time, the progress track and fill, and the knob in the accent colour.
component Preview inherits Rectangle {
    in property <Swatch> swatch;
    in property <bool> selected;
    pure function c(v: Rgb) -> color { rgb(v.r, v.g, v.b) }
    width: 120px;
    height: 40px;
    border-width: 1px;
    border-radius: Theme.radius-control;
    border-color: root.selected ? Theme.accent : Theme.line;
    clip: true;
    Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: 24px;
        background: c(root.swatch.video);
        Icon { x: 7px; y: 7px; name: "preview-play"; color: c(root.swatch.text); }
    }
    Rectangle {
        x: 1px; y: 25px; width: parent.width - 2px; height: 14px;
        background: c(root.swatch.bar);
        Text {
            x: 4px; width: 26px; height: parent.height;
            text: "0:42";
            font-size: Theme.font-xs;
            vertical-alignment: center;
            color: c(root.swatch.dim);
        }
        Rectangle {
            x: 32px; y: (parent.height - 2px) / 2; width: parent.width - 38px; height: 2px;
            border-radius: 1px;
            background: c(root.swatch.track);
            Rectangle {
                x: 0; width: parent.width * 0.6; height: parent.height;
                border-radius: 1px;
                background: @linear-gradient(90deg, c(root.swatch.f0) 0%, c(root.swatch.f1) 45%, c(root.swatch.f2) 72%, c(root.swatch.f3) 100%);
            }
            Rectangle {
                x: parent.width * 0.6 - 3px; y: -2px; width: 6px; height: 6px;
                border-radius: 3px;
                background: c(root.swatch.text);
                border-width: 1.5px;
                border-color: c(root.swatch.accent);
            }
        }
    }
}

export component AppearancePage inherits Rectangle {
    // The palettes' names and notes (the plugin passes ids).
    pure function title-of(id: string) -> string {
        id == "vestra-light" ? @tr("Vestra Light") : @tr("Vestra Dark")
    }
    pure function note-of(id: string) -> string {
        id == "vestra-light" ? @tr("For bright rooms; the video area stays dark") : @tr("Default, from the logo's aurora colours")
    }
    background: Theme.bg-panel;
    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: 6px;
        Text {
            height: 24px;
            text: @tr("Appearance");
            font-size: Theme.font-title;
            font-weight: 700;
            vertical-alignment: center;
            color: Theme.text;
        }
        Text {
            height: Theme.label-height;
            text: @tr("Palette");
            font-size: Theme.font-body;
            color: Theme.text-dim;
        }
        for row in AppearanceBridge.themes: Rectangle {
            height: 52px;
            border-radius: Theme.radius-control;
            background: touch.has-hover ? Theme.hover-bg : transparent;
            accessible-role: radio-button;
            accessible-checkable: true;
            accessible-checked: AppearanceBridge.theme == row.id;
            accessible-label: root.title-of(row.id);
            accessible-action-default => { AppearanceBridge.pick(row.id); }
            touch := TouchArea {
                clicked => { AppearanceBridge.pick(row.id); }
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: stretch;
                // The library's radio mark (ctx-radio, 12px).
                RadioMark {
                    y: (parent.height - self.height) / 2;
                    checked: AppearanceBridge.theme == row.id;
                    hover: touch.has-hover;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.title-of(row.id);
                        font-size: Theme.font-tab;
                        color: AppearanceBridge.theme == row.id ? Theme.text : Theme.text-list;
                        overflow: elide;
                    }
                    Text {
                        text: root.note-of(row.id);
                        font-size: Theme.font-body;
                        color: Theme.text-dim;
                        overflow: elide;
                    }
                }
                Preview {
                    y: (parent.height - self.height) / 2;
                    swatch: row.swatch;
                    selected: AppearanceBridge.theme == row.id;
                }
            }
        }
        Text {
            min-height: 32px;
            text: @tr("Changes apply to every window at once. Corner radii, font sizes and control sizes stay the same in every palette.");
            font-size: Theme.font-body;
            color: Theme.text-dim;
            vertical-alignment: center;
            wrap: word-wrap;
            line-height-factor: 1.25;
        }
        HorizontalLayout {
            alignment: end;
            Button {
                text: @tr("Restore Defaults");
                enabled: AppearanceBridge.can-reset;
                clicked => { AppearanceBridge.reset(); }
            }
        }
    }
}

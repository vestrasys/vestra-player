// 选项 ▶ 外观 (H10): palette radio, each with a 120×40 preview, and 恢复默认.
// The page is 440 wide (the options window's page area). Everything themed
// uses `Theme`; the previews draw colours the plugin passes in (`Swatch`),
// because `Theme` only holds the current palette.
import { Theme } from "@vestra/theme.slint";
import { Button } from "@vestra/widgets.slint";

struct Rgb { r: int, g: int, b: int }
struct Swatch { video: Rgb, bar: Rgb, track: Rgb, text: Rgb, dim: Rgb, accent: Rgb, f0: Rgb, f1: Rgb, f2: Rgb, f3: Rgb }
struct ThemeRow { id: string, title: string, note: string, swatch: Swatch }

export global AppearanceBridge {
    in property <[ThemeRow]> themes;
    in property <string> theme;
    in property <bool> can-reset;
    callback pick(string);
    callback reset();
}

// One palette drawn small: video area, then a bottom bar with a time, the
// progress track and fill, and the knob in the accent colour.
component Preview inherits Rectangle {
    in property <Swatch> swatch;
    in property <bool> selected;
    pure function c(v: Rgb) -> color { rgb(v.r, v.g, v.b) }
    width: 120px;
    height: 40px;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.line;
    clip: true;
    Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: 24px;
        background: c(root.swatch.video);
        Text {
            x: 6px; y: 5px;
            text: "▶";
            font-size: Theme.font-body;
            color: c(root.swatch.text);
        }
    }
    Rectangle {
        x: 1px; y: 25px; width: parent.width - 2px; height: 14px;
        background: c(root.swatch.bar);
        Text {
            x: 4px; width: 26px; height: parent.height;
            text: "0:42";
            font-size: Theme.font-xs;
            vertical-alignment: center;
            color: c(root.swatch.dim);
        }
        Rectangle {
            x: 32px; y: (parent.height - 2px) / 2; width: parent.width - 38px; height: 2px;
            background: c(root.swatch.track);
            Rectangle {
                x: 0; width: parent.width * 0.6; height: parent.height;
                background: @linear-gradient(90deg, c(root.swatch.f0) 0%, c(root.swatch.f1) 25%, c(root.swatch.f2) 60%, c(root.swatch.f3) 100%);
            }
            Rectangle {
                x: parent.width * 0.6 - 3px; y: -2px; width: 6px; height: 6px;
                border-radius: 3px;
                background: c(root.swatch.accent);
            }
        }
    }
}

component Radio inherits Rectangle {
    in property <bool> checked;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border-width: 1px;
    border-color: root.checked ? Theme.accent : Theme.text-dim;
    background: Theme.bg-list;
    Rectangle {
        width: 6px; height: 6px; border-radius: 3px;
        visible: root.checked;
        background: Theme.accent;
    }
}

export component AppearancePage inherits Rectangle {
    background: Theme.bg-panel;
    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: 6px;
        Text {
            height: 24px;
            text: "外观";
            font-size: Theme.font-title;
            font-weight: 700;
            vertical-alignment: center;
            color: Theme.text;
        }
        Text {
            height: Theme.label-height;
            text: "配色";
            font-size: Theme.font-body;
            color: Theme.text-dim;
        }
        for row in AppearanceBridge.themes: Rectangle {
            height: 52px;
            border-radius: Theme.radius-control;
            background: touch.has-hover ? Theme.hover-bg : transparent;
            touch := TouchArea {
                clicked => { AppearanceBridge.pick(row.id); }
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: stretch;
                Radio {
                    y: (parent.height - self.height) / 2;
                    checked: AppearanceBridge.theme == row.id;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: row.title;
                        font-size: Theme.font-tab;
                        color: AppearanceBridge.theme == row.id ? Theme.text : Theme.text-list;
                        overflow: elide;
                    }
                    Text {
                        text: row.note;
                        font-size: Theme.font-body;
                        color: Theme.text-dim;
                        overflow: elide;
                    }
                }
                Preview {
                    y: (parent.height - self.height) / 2;
                    swatch: row.swatch;
                    selected: AppearanceBridge.theme == row.id;
                }
            }
        }
        Text {
            height: 32px;
            text: "切换后所有窗口立即生效。圆角、字号与控件尺寸不随配色变化。";
            font-size: Theme.font-body;
            color: Theme.text-dim;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            Button {
                text: "恢复默认";
                enabled: AppearanceBridge.can-reset;
                clicked => { AppearanceBridge.reset(); }
            }
        }
    }
}

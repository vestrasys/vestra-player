msgstr "没能从钥匙串删除：{}"

#: settings.slint:83
msgid "The old provider's key was deleted."
msgstr "旧服务商的 key 已删除。"

#: settings.slint:84
msgid "The key for {} was saved."
msgstr "{} 的 key 已保存。"

#: settings.slint:85
msgid "The key for {} was deleted."
msgstr "{} 的 key 已删除。"

#: settings.slint:86
msgid "Base URL is not a valid address"
msgstr "Base URL 不是有效地址"

#: settings.slint:87
msgid "Base URL must be an http(s) address"
msgstr "Base URL 须为 http(s) 地址"

#: settings.slint:88
msgid "Do not put a user name or password in the Base URL; enter the key under API Key"
msgstr "Base URL 里不要写用户名或密码，key 请填在 API Key 中"

#: settings.slint:89
msgid "Enter the Base URL first."
msgstr "请先填写 Base URL。"

#: settings.slint:90
msgid "This provider does not list its models."
msgstr "这个服务商不提供模型列表。"

#: settings.slint:92
msgid "{0} “{1}” is not in the list; now using “{2}”."
msgstr "{0}「{1}」不在列表中，已改用「{2}」。"

#: settings.slint:93
msgid "Could not get the model list ({}); enter the model ID directly."
msgstr "没能获取模型列表（{}），请直接填写模型 ID。"

#: settings.slint:94
msgid "Could not get the model list ({}); you can choose from pi's own list."
msgstr "没能获取模型列表（{}），可以从 pi 自带的列表中选择。"

#: settings.slint:95
msgid "Could not get the model list (no models listed); enter the model ID directly."
msgstr "没能获取模型列表（没有列出任何模型），请直接填写模型 ID。"

#: settings.slint:96
msgid "Could not get the model list (no models listed); you can choose from pi's own list."
msgstr "没能获取模型列表（没有列出任何模型），可以从 pi 自带的列表中选择。"

#: settings.slint:100
msgid "Found {n} model."
msgid_plural "Found {n} models."
msgstr[0] "获取到 {n} 个模型。"

#: settings.slint:103
msgid "New plugins get the id {}.<name> (the official plugin repository requires the id prefix to be the GitHub user or organization that owns the source repository)."
msgstr "新插件的 id 是 {}.<名字>（官方插件仓库要求 id 前缀就是源码仓库所属的 GitHub 用户或组织）。"

#: settings.slint:104
msgid "Not set: new plugins get the id local.<name>, for this computer only; to publish to the official plugin repository, enter your GitHub name."
msgstr "没有填写：新插件的 id 用 local.<名字>，只适合在本机使用；要发布到官方插件仓库，请填你的 GitHub 用户名。"

#: settings.slint:105
msgid "“vestra” is reserved for official plugins; enter your own GitHub name (new plugins use local.<name> for now)"
msgstr "「vestra」留给官方插件，请填你自己的 GitHub 用户名（新插件暂时用 local.<名字>）"

#: settings.slint:106
msgid "“local” means no name was entered; enter your own GitHub name (new plugins use local.<name> for now)"
msgstr "「local」表示没有填用户名，请填你自己的 GitHub 用户名（新插件暂时用 local.<名字>）"

#: settings.slint:107
msgid "A GitHub name has only letters, digits and “-”, at most 39 characters (new plugins use local.<name> for now)"
msgstr "GitHub 用户名只能有字母、数字和「-」，最多 39 个字符（新插件暂时用 local.<名字>）"


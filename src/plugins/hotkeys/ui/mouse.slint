// Mouse (J02) as a page of the options window (category Keys and Mouse, id
// hotkeys.mouse): modifier radios, then one 26px row per mouse input:
// label (110, right aligned) | command picker (250×21) | Default (41×18).
// The picker opens a filterable command list over the rows (the list has
// over a hundred commands, more than a drop-down fits).
// Width 440: 6 + 110 + 6 + 250 + 6 + 41 + 6 = 425. Height 6 + 21 + 6 + 286
// + 6 + 18 + 6 + 18 + 6 = 373.
import { LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Icon } from "@vestra/icons.slint";
import { Button } from "@vestra/widgets.slint";
import { Cell, Input, Label, Message, Radio, Words } from "parts.slint";

export struct MouseRow {
    // the index in Words.mouse
    input: int,
    // the command path, or "" for none
    command: string,
    bound: bool,
    resettable: bool,
}

export struct PickItem {
    // "" is (None)
    key: string,
    text: string,
    selected: bool,
}

component Picker {
    in property <string> text;
    in property <bool> bound;
    callback clicked();
    height: 21px;
    Rectangle {
        border-radius: Theme.radius-control;
        background: touch.pressed ? Theme.button-press : touch.has-hover ? Theme.button-hover : Theme.button-bg;
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 5px;
        spacing: 2px;
        Cell {
            horizontal-stretch: 1;
            text: root.text;
            color: root.bound ? Theme.text : Theme.text-dim;
        }
        // The drop-down arrow: a small V.
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            Icon { name: "caret-down"; color: Theme.text-dim; }
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component PickLine inherits Rectangle {
    in property <PickItem> item;
    callback picked();
    height: 18px;
    background: touch.has-hover ? Theme.hover-bg : root.item.selected ? Theme.selected-bg : transparent;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Cell {
            text: root.item.key == "" ? @tr("(None)") : root.item.text;
            color: root.item.selected ? Theme.accent : Theme.text-list;
        }
    }
    touch := TouchArea { clicked => { root.picked(); } }
}

export global Mouse {
    // "" is none
    in property <[string]> modifiers;
    in property <int> modifier;
    in property <[MouseRow]> rows;
    in property <bool> picking;
    // The input whose command is being picked.
    in property <Input> pick-input;
    in property <[PickItem]> pick-items;
    in-out property <string> pick-filter;
    in property <Message> message;
    callback set-modifier(int);
    callback pick(int);
    callback filter(string);
    callback choose(string);
    callback cancel-pick();
    callback set-default(int);
}

export component MousePage inherits Rectangle {
    height: 373px;
    private property <bool> picking: Mouse.picking;
    changed picking => {
        if self.picking { filter-input.focus(); }
    }
    // The input column: 110px, or the longest input name; the command picker gives up
    // what the column and the Default button take beyond that (the rows are 428px wide).
    private property <length> input-width: max(110px, input-measure.preferred-width);
    private property <length> default-width: max(Theme.button-small-min-width, default-measure.preferred-width + 2 * Theme.button-padding);
    private property <length> picker-width: min(250px, self.width - 12px - root.input-width - root.default-width - 12px);
    Rectangle {
        visible: false;
        width: 0;
        height: 0;
        input-measure := VerticalLayout {
            for index in 11: Label { text: Words.mouse(index); }
        }
        default-measure := Label { text: @tr("Default"); }
    }

    VerticalLayout {
        padding: 6px;
        spacing: 6px;
        HorizontalLayout {
            height: Theme.button-height;
            spacing: 14px;
            Label { width: max(40px, self.preferred-width); text: @tr("Modifier"); color: Theme.text-list; }
            for name[index] in Mouse.modifiers: Radio {
                horizontal-stretch: 0;
                text: name == "" ? @tr("None") : name;
                checked: index == Mouse.modifier;
                clicked => { Mouse.set-modifier(index); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle {
            height: 11 * 26px;
            VerticalLayout {
                visible: !Mouse.picking;
                for row[index] in Mouse.rows: HorizontalLayout {
                    height: 26px;
                    spacing: 6px;
                    Label {
                        width: root.input-width;
                        text: Words.mouse(row.input);
                        horizontal-alignment: right;
                        color: Theme.text-list;
                    }
                    VerticalLayout {
                        alignment: center;
                        Picker {
                            width: root.picker-width;
                            text: row.bound ? row.command : @tr("(None)");
                            bound: row.bound;
                            clicked => { Mouse.pick(index); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            horizontal-stretch: 0;
                            height: Theme.button-small-height;
                            small: true;
                            text: @tr("Default");
                            enabled: row.resettable;
                            clicked => { Mouse.set-default(index); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            Rectangle {
                visible: Mouse.picking;
                background: Theme.bg-panel;
                VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        height: Theme.input-height;
                        spacing: 6px;
                        Label { text: @tr("Command run by “{}”:", Words.input(Mouse.pick-input)); overflow: elide; horizontal-stretch: 1; }
                        filter-input := LineEdit {
                            width: 160px;
                            height: Theme.input-height;
                            font-size: Theme.font-body;
                            placeholder-text: @tr("Type to filter");
                            text <=> Mouse.pick-filter;
                            edited(text) => { Mouse.filter(text); }
                        }
                        Button { horizontal-stretch: 0; text: @tr("Cancel"); clicked => { Mouse.cancel-pick(); } }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.bg-list;
                        border-width: 1px;
                        border-color: Theme.line;
                        ListView {
                            x: 1px;
                            y: 1px;
                            width: parent.width - 2px;
                            height: parent.height - 2px;
                            for item in Mouse.pick-items: PickLine {
                                item: item;
                                picked => { Mouse.choose(item.key); }
                            }
                        }
                    }
                }
            }
        }
        Text {
            height: 18px;
            text: @tr("A bound left click responds only after the system's double-click interval; the right button always opens the menu.");
            color: Theme.text-dim;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            height: 18px;
            text: Words.message(Mouse.message);
            color: Mouse.message.warn ? Theme.accent : Theme.text-dim;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

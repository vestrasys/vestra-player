// 快捷键 (J01) as a page of the options window (category 快捷键与鼠标, id
// hotkeys.keyboard): filters, the command list (命令 | 快捷键 | 状态), the
// selected command's bindings with capture, and the global buttons.
// Page width 440: 6px padding and the list border leave 426; row padding
// 3 + 6 (clear of the overlay scroll bar) and two 4px gaps leave 409, so
// 快捷键 140 + 状态 60 give 命令 ≈ 209. Top row: 190 + 90 + 128 + 2×6 = 420.
// Edit row: 72 + 150 + 41 + 66 + 66 + 4×6 = 419. Height 436 (fits the
// options window's page area at its default size; it scrolls when smaller).
import { LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button, ToolTipArea } from "@vestra/widgets.slint";
import { Cell, Check, Choice, Label } from "parts.slint";

export struct KeyRow {
    key: string,
    command: string,
    keys: string,
    status: string,
    // 0 default (text-list), 1 changed (text), 2 conflict (accent), 3 ignored / not loaded (dim)
    tone: int,
    selected: bool,
    tip: string,
}

export struct KeyTag {
    input: string,
    label: string,
}

export global Keys {
    in property <[KeyRow]> rows;
    in property <string> empty-text;
    in property <[string]> status-model;
    in-out property <int> status-index;
    in property <[string]> source-model;
    in-out property <int> source-index;
    in-out property <string> search-text;
    in property <string> sort;
    in property <bool> descending;
    in property <bool> has-selection;
    in property <string> edit-title;
    in property <[KeyTag]> tags;
    in property <bool> can-add;
    in property <bool> can-reset;
    in property <bool> can-unbind;
    in property <string> reset-text: "恢复默认";
    in property <bool> capturing;
    in property <bool> pending;
    in property <string> pending-text;
    in property <string> message;
    in property <bool> message-warn;
    in property <bool> ignore;
    callback search(string);
    callback status-filter(int);
    callback source-filter(int);
    callback sort-by(string);
    callback select(string);
    callback remove-tag(string);
    callback add-key();
    callback key(string, bool, bool, bool, bool);
    callback bind-escape();
    callback cancel-capture();
    callback reset-one();
    callback unbind-all();
    callback replace();
    callback cancel-replace();
    callback reset-all();
    callback export();
    callback toggle-ignore();
}

component Row inherits Rectangle {
    in property <KeyRow> item;
    callback select();
    private property <color> ink: root.item.tone == 1 ? Theme.text
        : root.item.tone == 2 ? Theme.accent
        : root.item.tone == 3 ? Theme.text-dim : Theme.text-list;
    height: 18px;
    background: root.item.selected ? Theme.selected-bg : transparent;
    HorizontalLayout {
        padding-left: 3px;
        padding-right: 6px;
        spacing: 4px;
        Cell { horizontal-stretch: 1; text: root.item.command; color: root.ink; }
        Cell { width: 140px; text: root.item.keys; color: root.ink; }
        Cell { width: 60px; text: root.item.status; color: root.ink; }
    }
    // ToolTipArea has no size of its own: without the explicit 100% it was
    // 0×0 and the row could not be clicked.
    ToolTipArea {
        width: 100%;
        height: 100%;
        text: root.item.tip;
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.select(); }
        }
    }
}

// Column title; `sorted` draws the direction arrow, `clicked` sorts by it.
component Head {
    in property <string> text;
    in property <bool> sortable;
    in property <bool> sorted;
    in property <bool> descending;
    callback clicked();
    HorizontalLayout {
        spacing: 2px;
        Cell {
            text: root.text;
            color: touch.has-hover && root.sortable ? Theme.accent : Theme.text-dim;
        }
        if root.sorted: Cell { text: root.descending ? "▼" : "▲"; color: Theme.text-dim; font-size: Theme.font-xs; }
        Rectangle { horizontal-stretch: 1; }
    }
    touch := TouchArea {
        enabled: root.sortable;
        clicked => { root.clicked(); }
    }
}

// One binding of the selected command: label and ×.
component Tag {
    in property <string> text;
    callback remove();
    height: 18px;
    Rectangle {
        border-radius: Theme.radius-control;
        background: Theme.button-bg;
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 3px;
        spacing: 3px;
        Text { text: root.text; color: Theme.text; font-size: Theme.font-body; vertical-alignment: center; }
        Rectangle {
            width: 13px;
            Text {
                text: "×";
                color: x-touch.has-hover ? Theme.accent : Theme.text-dim;
                font-size: Theme.font-body;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            x-touch := TouchArea { clicked => { root.remove(); } }
        }
    }
}

export component KeysPage inherits Rectangle {
    height: 436px;
    private property <bool> capturing: Keys.capturing;
    changed capturing => {
        if self.capturing { capture.focus(); }
    }

    VerticalLayout {
        padding: 6px;
        spacing: 6px;
        HorizontalLayout {
            height: Theme.input-height;
            spacing: 6px;
            LineEdit {
                width: 190px;
                height: Theme.input-height;
                font-size: Theme.font-body;
                placeholder-text: "搜索命令或按键（如 Ctrl+）";
                text <=> Keys.search-text;
                edited(text) => { Keys.search(text); }
            }
            Choice {
                width: 90px;
                model: Keys.status-model;
                current-index <=> Keys.status-index;
                selected(index) => { Keys.status-filter(index); }
            }
            Choice {
                width: 128px;
                popup-height: 240px;
                model: Keys.source-model;
                current-index <=> Keys.source-index;
                selected(index) => { Keys.source-filter(index); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-list;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                padding: 1px;
                HorizontalLayout {
                    height: 18px;
                    padding-left: 3px;
                    padding-right: 6px;
                    spacing: 4px;
                    Head {
                        horizontal-stretch: 1;
                        text: "命令";
                        sortable: true;
                        sorted: Keys.sort == "command";
                        descending: Keys.descending;
                        clicked => { Keys.sort-by("command"); }
                    }
                    Head {
                        width: 140px;
                        text: "快捷键";
                        sortable: true;
                        sorted: Keys.sort == "keys";
                        descending: Keys.descending;
                        clicked => { Keys.sort-by("keys"); }
                    }
                    Head { width: 60px; text: "状态"; }
                }
                Rectangle { height: 1px; background: Theme.line; }
                ListView {
                    vertical-stretch: 1;
                    for row in Keys.rows: Row {
                        item: row;
                        select => { Keys.select(row.key); }
                    }
                }
            }
            if Keys.rows.length == 0: Label {
                y: 19px;
                width: 100%;
                height: parent.height - 19px;
                horizontal-alignment: center;
                color: Theme.text-dim;
                text: Keys.empty-text;
            }
        }
        // Edit area (87px): path · source · scope, bindings, actions, message.
        VerticalLayout {
            spacing: 4px;
            Text {
                height: 18px;
                text: Keys.has-selection ? Keys.edit-title : "选择一条命令以修改它的快捷键";
                color: Keys.has-selection ? Theme.text : Theme.text-dim;
                font-size: Theme.font-body;
                font-weight: Keys.has-selection ? 700 : 400;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                height: 18px;
                clip: true;
                HorizontalLayout {
                    spacing: 4px;
                    for tag in Keys.tags: Tag {
                        text: tag.label;
                        remove => { Keys.remove-tag(tag.input); }
                    }
                    if Keys.has-selection && Keys.tags.length == 0: Label { text: "未绑定"; color: Theme.text-dim; }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            Rectangle {
                height: Theme.button-height;
                HorizontalLayout {
                    visible: !Keys.pending;
                    spacing: 6px;
                    Button {
                        horizontal-stretch: 0;
                        width: 72px;
                        text: "添加按键…";
                        enabled: Keys.can-add;
                        clicked => { Keys.add-key(); }
                    }
                    Rectangle {
                        width: 150px;
                        border-radius: Theme.radius-control;
                        border-width: 1px;
                        border-color: Keys.capturing ? Theme.accent : Theme.line;
                        background: Theme.bg-list;
                        Text {
                            x: 4px;
                            width: parent.width - 8px;
                            text: Keys.capturing ? "请按下快捷键（Esc 取消）" : "";
                            color: Theme.accent;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        TouchArea {
                            enabled: Keys.can-add;
                            clicked => { Keys.add-key(); }
                        }
                        capture := FocusScope {
                            enabled: Keys.capturing;
                            key-pressed(event) => {
                                Keys.key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                                accept
                            }
                            changed has-focus => {
                                if !self.has-focus && Keys.capturing { Keys.cancel-capture(); }
                            }
                        }
                    }
                    if Keys.capturing: Button {
                        horizontal-stretch: 0;
                        small: true;
                        text: "Esc";
                        clicked => { Keys.bind-escape(); }
                    }
                    Button {
                        horizontal-stretch: 0;
                        text: Keys.reset-text;
                        enabled: Keys.can-reset;
                        clicked => { Keys.reset-one(); }
                    }
                    Button {
                        horizontal-stretch: 0;
                        text: "全部解绑";
                        enabled: Keys.can-unbind;
                        clicked => { Keys.unbind-all(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    visible: Keys.pending;
                    spacing: 6px;
                    Text {
                        horizontal-stretch: 1;
                        text: Keys.pending-text;
                        color: Theme.accent;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Button { horizontal-stretch: 0; text: "替换"; enabled: Keys.pending; clicked => { Keys.replace(); } }
                    Button { horizontal-stretch: 0; text: "取消"; enabled: Keys.pending; clicked => { Keys.cancel-replace(); } }
                }
            }
            Text {
                height: 18px;
                text: Keys.message;
                color: Keys.message-warn ? Theme.accent : Theme.text-dim;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        HorizontalLayout {
            height: Theme.button-height;
            spacing: 6px;
            Button { horizontal-stretch: 0; width: 94px; text: "恢复全部默认…"; clicked => { Keys.reset-all(); } }
            Button { horizontal-stretch: 0; width: 72px; text: "导出列表…"; clicked => { Keys.export(); } }
            Check {
                y: (Theme.button-height - self.height) / 2;
                text: "忽略默认快捷键";
                checked: Keys.ignore;
                clicked => { Keys.toggle-ignore(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

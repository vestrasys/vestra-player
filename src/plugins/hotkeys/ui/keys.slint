// Keyboard Shortcuts (J01) as a page of the options window (category Keys and Mouse,
// id hotkeys.keyboard): filters, the command list (Command | Shortcut |
// Status), the selected command's bindings with capture, and the global
// buttons. Texts are @tr; the plugin passes codes and data.
// Page width 440: 6px padding and the list border leave 426; row padding
// 3 + 6 (clear of the overlay scroll bar) and two 4px gaps leave 409, so
// Shortcut 140 + Status 60 give Command ≈ 209. Top row: 190 + 90 + 128 + 2×6 = 420.
// Edit row: 72 + 150 + 41 + 66 + 66 + 4×6 = 419. Height 436 (fits the
// options window's page area at its default size; it scrolls when smaller).
import { LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Icon } from "@vestra/icons.slint";
import { Button, Check, Choice, ToolTipArea } from "@vestra/widgets.slint";
import { Cell, Conflict, Input, Label, Message, Words } from "parts.slint";

export struct KeyRow {
    key: string,
    command: string,
    keys: string,
    // 0 default (text-list), 1 changed (text), 2 conflict (accent), 3 ignored, 4 not loaded (dim)
    state: int,
    selected: bool,
    // state 2: the inputs taken by other commands
    conflicts: [Conflict],
}

export struct KeyTag {
    input: string,
    label: Input,
}

export global Keys {
    in property <[KeyRow]> rows;
    // The list is still being read (otherwise nothing matches the filters).
    in property <bool> loading;
    in-out property <int> status-index;
    in property <[string]> source-model;
    in-out property <int> source-index;
    in-out property <string> search-text;
    in property <string> sort;
    in property <bool> descending;
    in property <bool> has-selection;
    // The selected command: its path, source (plugin id or "host"), panel
    // scope, and whether its plugin is loaded.
    in property <string> edit-command;
    in property <string> edit-source;
    in property <bool> edit-panel;
    in property <bool> edit-loaded;
    in property <[KeyTag]> tags;
    in property <bool> can-add;
    in property <bool> can-reset;
    in property <bool> can-unbind;
    // A command of a plugin that is not loaded: its change can be deleted.
    in property <bool> orphan;
    in property <bool> capturing;
    in property <bool> pending;
    // "quit" (⌘Q of Quit) or "used"; the key and the command holding it.
    in property <string> pending-kind;
    in property <string> pending-key;
    in property <string> pending-command;
    in property <Message> message;
    in property <bool> ignore;
    callback search(string);
    callback status-filter(int);
    callback source-filter(int);
    callback sort-by(string);
    callback select(string);
    callback remove-tag(string);
    callback add-key();
    callback key(string, bool, bool, bool, bool);
    callback bind-escape();
    callback cancel-capture();
    callback reset-one();
    callback unbind-all();
    callback replace();
    callback cancel-replace();
    callback reset-all();
    callback export();
    callback toggle-ignore();
}

component Row inherits Rectangle {
    in property <KeyRow> item;
    // The status column (measured in the page).
    in property <length> status-width: 60px;
    callback select();
    private property <color> ink: root.item.state == 1 ? Theme.text
        : root.item.state == 2 ? Theme.accent
        : root.item.state >= 3 ? Theme.text-dim : Theme.text-list;
    height: 18px;
    background: root.item.selected ? Theme.selected-bg : transparent;
    HorizontalLayout {
        padding-left: 3px;
        padding-right: 6px;
        spacing: 4px;
        Cell { horizontal-stretch: 1; text: root.item.command; color: root.ink; }
        Cell { width: 140px; text: root.item.state == 3 && root.item.keys != "" ? @tr("({})", root.item.keys) : root.item.keys; color: root.ink; }
        Cell {
            width: root.status-width;
            text: root.item.state == 1 ? @tr("Changed")
                : root.item.state == 2 ? @tr("Conflict")
                : root.item.state == 3 ? @tr("Ignored")
                : root.item.state == 4 ? @tr("Not loaded") : @tr("Default");
            color: root.ink;
        }
    }
    // ToolTipArea has no size of its own: without the explicit 100% it was
    // 0×0 and the row could not be clicked.
    ToolTipArea {
        width: 100%;
        height: 100%;
        text: root.item.state == 2 ? Words.conflicts(root.item.conflicts)
            : root.item.state == 3 ? @tr("Default shortcuts are ignored (Settings ▸ Ignore Default Shortcuts)")
            : root.item.state == 4 ? @tr("The plugin is not loaded; this change works again when it is back") : "";
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.select(); }
        }
    }
}

// Column title; `sorted` draws the direction arrow, `clicked` sorts by it.
component Head {
    in property <string> text;
    in property <bool> sortable;
    in property <bool> sorted;
    in property <bool> descending;
    callback clicked();
    HorizontalLayout {
        spacing: 2px;
        Cell {
            text: root.text;
            color: touch.has-hover && root.sortable ? Theme.accent : Theme.text-dim;
        }
        if root.sorted: VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            Icon { name: root.descending ? "sort-desc" : "sort-asc"; color: Theme.text-dim; }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    touch := TouchArea {
        enabled: root.sortable;
        clicked => { root.clicked(); }
    }
}

// One binding of the selected command: label and ×.
component Tag {
    in property <string> text;
    callback remove();
    height: 18px;
    Rectangle {
        border-radius: Theme.radius-control;
        background: Theme.button-bg;
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 3px;
        spacing: 3px;
        Text { text: root.text; color: Theme.text; font-size: Theme.font-body; vertical-alignment: center; }
        Rectangle {
            width: 13px;
            // Not stretchable: the tag keeps its label's width.
            horizontal-stretch: 0;
            Icon {
                name: "tag-remove";
                color: x-touch.has-hover ? Theme.accent : Theme.text-dim;
            }
            x-touch := TouchArea { clicked => { root.remove(); } }
        }
    }
}

export component KeysPage inherits Rectangle {
    height: 436px;
    private property <bool> capturing: Keys.capturing;
    changed capturing => {
        if self.capturing { capture.focus(); }
    }
    // Widths that follow the interface language, never under the original ones. The status
    // column fits its header and every status; a drop-down its widest item + 21px (6 + 5
    // padding, 2 gap, 8 caret).
    private property <length> status-width: max(60px, status-measure.preferred-width);
    private property <length> filter-width: max(90px, filter-measure.preferred-width + 21px);
    // The edit buttons' row (Add Key…, the capture field at its 40px minimum, Restore Default /
    // Delete Entry, Unbind All) does not fit the page: it takes two rows.
    private property <bool> edit-wrap: edit-measure.preferred-width > root.width - 12px;
    Rectangle {
        visible: false;
        width: 0;
        height: 0;
        status-measure := VerticalLayout {
            for text in [@tr("Status"), @tr("Changed"), @tr("Conflict"), @tr("Ignored"), @tr("Not loaded"), @tr("Default")]: Cell { text: text; }
        }
        edit-measure := HorizontalLayout {
            spacing: 6px;
            Button { width: max(72px, self.preferred-width); text: @tr("Add Key…"); }
            Rectangle { width: 40px; }
            VerticalLayout {
                Button { text: @tr("Delete Entry"); }
                Button { text: @tr("Restore Default"); }
            }
            Button { text: @tr("Unbind All"); }
        }
        filter-measure := VerticalLayout {
            for text in [@tr("All"), @tr("Changed"), @tr("Conflicts"), @tr("Unbound")]: Cell { text: text; }
        }
    }

    VerticalLayout {
        padding: 6px;
        spacing: 6px;
        HorizontalLayout {
            height: Theme.input-height;
            spacing: 6px;
            LineEdit {
                width: 190px;
                height: Theme.input-height;
                font-size: Theme.font-body;
                placeholder-text: @tr("Search commands or keys (e.g. Ctrl+)");
                text <=> Keys.search-text;
                edited(text) => { Keys.search(text); }
            }
            Choice {
                width: root.filter-width;
                popup-min-width: 120px;
                model: [@tr("All"), @tr("Changed"), @tr("Conflicts"), @tr("Unbound")];
                current-index <=> Keys.status-index;
                selected(index) => { Keys.status-filter(index); }
            }
            Choice {
                width: 128px;
                max-visible-rows: 12;
                popup-min-width: 120px;
                model: Keys.source-model;
                current-index <=> Keys.source-index;
                selected(index) => { Keys.source-filter(index); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-list;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                padding: 1px;
                HorizontalLayout {
                    height: 18px;
                    padding-left: 3px;
                    padding-right: 6px;
                    spacing: 4px;
                    Head {
                        horizontal-stretch: 1;
                        text: @tr("Command");
                        sortable: true;
                        sorted: Keys.sort == "command";
                        descending: Keys.descending;
                        clicked => { Keys.sort-by("command"); }
                    }
                    Head {
                        width: 140px;
                        text: @tr("Shortcut");
                        sortable: true;
                        sorted: Keys.sort == "keys";
                        descending: Keys.descending;
                        clicked => { Keys.sort-by("keys"); }
                    }
                    Head { width: root.status-width; text: @tr("Status"); }
                }
                Rectangle { height: 1px; background: Theme.line; }
                ListView {
                    vertical-stretch: 1;
                    for row in Keys.rows: Row {
                        item: row;
                        status-width: root.status-width;
                        select => { Keys.select(row.key); }
                    }
                }
            }
            if Keys.rows.length == 0: Label {
                y: 19px;
                width: 100%;
                height: parent.height - 19px;
                horizontal-alignment: center;
                color: Theme.text-dim;
                text: Keys.loading ? @tr("Loading…") : @tr("No matching commands");
            }
        }
        // Edit area (87px): path · source · scope, bindings, actions, message.
        VerticalLayout {
            spacing: 4px;
            Text {
                height: 18px;
                text: !Keys.has-selection ? @tr("Select a command to change its shortcuts")
                    : !Keys.edit-loaded ? @tr("{} (not loaded)", Keys.edit-command)
                    : Keys.edit-source == "host" ? (Keys.edit-panel ? @tr("{} (Player · in panel)", Keys.edit-command) : @tr("{} (Player)", Keys.edit-command))
                    : Keys.edit-panel ? @tr("{0} ({1} · in panel)", Keys.edit-command, Keys.edit-source)
                    : @tr("{0} ({1})", Keys.edit-command, Keys.edit-source);
                color: Keys.has-selection ? Theme.text : Theme.text-dim;
                font-size: Theme.font-body;
                font-weight: Keys.has-selection ? 700 : 400;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                height: 18px;
                clip: true;
                HorizontalLayout {
                    spacing: 4px;
                    for tag in Keys.tags: Tag {
                        text: Words.input(tag.label);
                        remove => { Keys.remove-tag(tag.input); }
                    }
                    if Keys.has-selection && Keys.tags.length == 0: Label { text: @tr("Unbound"); color: Theme.text-dim; }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            // One row; two when the translated buttons do not fit beside the capture field
            // (Restore Default and Unbind All go to the second row).
            Rectangle {
                height: root.edit-wrap && !Keys.pending ? 2 * Theme.button-height + 4px : Theme.button-height;
                HorizontalLayout {
                    y: 0;
                    height: Theme.button-height;
                    visible: !Keys.pending;
                    spacing: 6px;
                    Button {
                        horizontal-stretch: 0;
                        width: max(72px, self.preferred-width);
                        text: @tr("Add Key…");
                        enabled: Keys.can-add;
                        clicked => { Keys.add-key(); }
                    }
                    // 150px; narrower when longer translated buttons need the room.
                    Rectangle {
                        min-width: 40px;
                        preferred-width: 150px;
                        max-width: 150px;
                        border-radius: Theme.radius-control;
                        border-width: 1px;
                        border-color: Keys.capturing ? Theme.accent : Theme.line;
                        background: Theme.bg-list;
                        Text {
                            x: 4px;
                            width: parent.width - 8px;
                            text: Keys.capturing ? @tr("Press a shortcut (Esc cancels)") : "";
                            color: Theme.accent;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        TouchArea {
                            enabled: Keys.can-add;
                            clicked => { Keys.add-key(); }
                        }
                        capture := FocusScope {
                            enabled: Keys.capturing;
                            key-pressed(event) => {
                                Keys.key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                                accept
                            }
                            changed has-focus => {
                                if !self.has-focus && Keys.capturing { Keys.cancel-capture(); }
                            }
                        }
                    }
                    if Keys.capturing: Button {
                        horizontal-stretch: 0;
                        small: true;
                        // i18n-ignore: the key's name
                        text: "Esc";
                        clicked => { Keys.bind-escape(); }
                    }
                    if !root.edit-wrap: Button {
                        horizontal-stretch: 0;
                        text: Keys.orphan ? @tr("Delete Entry") : @tr("Restore Default");
                        enabled: Keys.can-reset;
                        clicked => { Keys.reset-one(); }
                    }
                    if !root.edit-wrap: Button {
                        horizontal-stretch: 0;
                        text: @tr("Unbind All");
                        enabled: Keys.can-unbind;
                        clicked => { Keys.unbind-all(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.edit-wrap: HorizontalLayout {
                    y: Theme.button-height + 4px;
                    height: Theme.button-height;
                    visible: !Keys.pending;
                    spacing: 6px;
                    Button {
                        horizontal-stretch: 0;
                        text: Keys.orphan ? @tr("Delete Entry") : @tr("Restore Default");
                        enabled: Keys.can-reset;
                        clicked => { Keys.reset-one(); }
                    }
                    Button {
                        horizontal-stretch: 0;
                        text: @tr("Unbind All");
                        enabled: Keys.can-unbind;
                        clicked => { Keys.unbind-all(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    y: 0;
                    height: Theme.button-height;
                    visible: Keys.pending;
                    spacing: 6px;
                    Text {
                        horizontal-stretch: 1;
                        text: Keys.pending-kind == "quit" ? @tr("⌘Q is the default shortcut to quit Vestra Player. Change it to “{}”?", Keys.pending-command)
                            : Keys.pending-kind == "used" ? @tr("{0} is already used by “{1}”", Keys.pending-key, Keys.pending-command) : "";
                        color: Theme.accent;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Button { horizontal-stretch: 0; text: @tr("Replace"); enabled: Keys.pending; clicked => { Keys.replace(); } }
                    Button { horizontal-stretch: 0; text: @tr("Cancel"); enabled: Keys.pending; clicked => { Keys.cancel-replace(); } }
                }
            }
            Text {
                height: 18px;
                text: Words.message(Keys.message);
                color: Keys.message.warn ? Theme.accent : Theme.text-dim;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        // One row; taller only when the check box's label wraps.
        HorizontalLayout {
            min-height: Theme.button-height;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Button { horizontal-stretch: 0; width: max(94px, self.preferred-width); text: @tr("Restore All Defaults…"); clicked => { Keys.reset-all(); } }
            }
            VerticalLayout {
                alignment: center;
                Button { horizontal-stretch: 0; width: max(72px, self.preferred-width); text: @tr("Export List…"); clicked => { Keys.export(); } }
            }
            // The plugin owns the state: turning it on asks first, so the box
            // stays clear while the question is open and follows `ignore` after.
            Check {
                text: @tr("Ignore default shortcuts");
                self-toggle: false;
                checked: Keys.ignore;
                toggled(on) => { Keys.toggle-ignore(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

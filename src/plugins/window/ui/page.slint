// Options ▸ Playback ▸ Window: the settings page for G-02, H05 / IA-WIN-03 and B30 / G-06
// (440 wide, the options window's page area). The same preferences as the menu items.
// The radios and checks are the library's (@vestra/widgets.slint).
// Heights (padding 14, spacing 6): title 24, section 14, radios 18, check 18 (more if it wraps),
//   note (its wrapped height: two lines at 412 wide), gap 8, section 14, radios 18, gap 8, section 14, check 18.
import { Theme } from "@vestra/theme.slint";
import { Check, RadioGroup } from "@vestra/widgets.slint";

export global WindowPage {
    in-out property <int> auto-index: 2;
    in-out property <bool> auto-once: false;
    in-out property <int> top-index: 3;
    in-out property <bool> hide-cursor: true;
    callback set-auto(int);
    callback set-auto-once(bool);
    callback set-top(int);
    callback set-hide-cursor(bool);
}

component Section inherits Text {
    height: Theme.label-height;
    font-size: Theme.font-body;
    color: Theme.text-dim;
}

export component WindowSettingsPage inherits Rectangle {
    background: Theme.bg-panel;
    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: 6px;
        alignment: start;
        Text {
            height: 24px;
            text: @tr("Window");
            font-size: Theme.font-title;
            font-weight: 700;
            vertical-alignment: center;
            color: Theme.text;
        }
        Section { text: @tr("Window size when playback starts"); }
        // One row of radios, 12px apart; one Tab stop, the arrows move the choice.
        RadioGroup {
            // TRANSLATORS: one row of radio buttons on a 412-point-wide page; keep them short.
            model: [@tr("Off"), @tr("0.5×"), @tr("1×"), @tr("1.5×"), @tr("2×"), @tr("Fit aspect ratio")];
            current-index <=> WindowPage.auto-index;
            selected(index) => { WindowPage.set-auto(index); }
        }
        // No fixed height: a long translation wraps (one row is the check's minimum).
        Check {
            text: @tr("Only once (only the first video of this run)");
            checked <=> WindowPage.auto-once;
            toggled(on) => { WindowPage.set-auto-once(on); }
        }
        // No fixed height: the layout gives the wrapped text all its lines.
        Text {
            text: @tr("Each new file is resized once, when its video size is known, keeping the window's top left corner. Not in fullscreen, mini size or picture-in-picture; after you drag the window while it plays, that file is left alone.");
            font-size: Theme.font-body;
            color: Theme.text-dim;
            wrap: word-wrap;
            line-height-factor: 1.25;
        }
        Rectangle { height: 8px; }
        Section { text: @tr("Always on top"); }
        RadioGroup {
            // TRANSLATORS: one row of radio buttons on a 412-point-wide page; keep them short.
            model: [@tr("Never"), @tr("Always"), @tr("While playing"), @tr("Playing in fullscreen")];
            current-index <=> WindowPage.top-index;
            selected(index) => { WindowPage.set-top(index); }
        }
        Rectangle { height: 8px; }
        Section { text: @tr("Mouse pointer"); }
        Check {
            text: @tr("Hide the pointer while playing");
            checked <=> WindowPage.hide-cursor;
            toggled(on) => { WindowPage.set-hide-cursor(on); }
        }
    }
}

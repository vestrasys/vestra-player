// The Playback panel in the adjust column (menu redesign §3.2, mockup 03 left): Speed, A-B Loop
// (mockup 32; moved here from the marks plugin), Jump, Step and Seek steps in one column, 317px by
// default and usable from 280px. It replaces Playback ▸ Speed and Seek, the Jump to Time and custom
// speed windows and the Seek Steps window.
// Every row is a layout and every text one line (elided, its whole wording in a tooltip); the
// elements are always there and change only their values, never per hover. Key caps come from the
// player's binding table (`plugin.commands.keys` for this plugin's commands, `plugin.bindings` for
// the player's own); an empty one takes no room. Every text is @tr (English source;
// locales/<lang>.po translate it); the plugin passes data.
import { LineEdit, ScrollView, Switch } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Check, Choice, KeyHint, ToolTipArea, ToolTipKey } from "@vestra/widgets.slint";

// The first key of each command, "" without one. back1 / forward1 are the player's ← / →.
export struct Keys {
    slower: string,
    faster: string,
    normal: string,
    jump: string,
    start: string,
    frameback: string,
    frameforward: string,
    keyback: string,
    keyforward: string,
    back1: string,
    forward1: string,
    back2: string,
    forward2: string,
    back3: string,
    forward3: string,
    back4: string,
    forward4: string,
    // A-B Loop (this plugin's ab.* commands).
    seta: string,
    cleara: string,
    aback: string,
    aforward: string,
    setb: string,
    clearb: string,
    bback: string,
    bforward: string,
    abtoggle: string,
    absegment: string,
}

export global PlaybackPanelBridge {
    in property <Keys> keys;
    // The speed can change now; the speed as "1.25" (no trailing zeros).
    in property <bool> can-rate;
    in property <string> rate-text: "1";
    // Where the speed sits on the ruler (0–1; speed.ts maps it) and the tick it is
    // (0.25, 0.5, 1, 1.25, 1.5, 2, 4 → 0–6), -1 for none.
    in property <float> rate-position: 0.5;
    in property <int> tick: 2;
    // Jump to a time (a seekable source with a duration), Jump to Start, a frame step.
    in property <bool> can-jump;
    in property <bool> can-start;
    in property <bool> can-frame;
    // Keyframe steps; else why not: "video" (no video) or "source" (the source cannot).
    in property <bool> can-keyframe;
    in property <string> keyframe-reason;
    // The four seek steps in seconds ("5", "2.5").
    in property <[string]> steps: ["5", "30", "60", "300"];
    in property <bool> keyframes-only: true;
    // The typed value was refused: the seek step row (0–3, -1 none), the time, the speed.
    in property <int> invalid-step: -1;
    in property <bool> jump-invalid;
    in property <bool> rate-invalid;
    // Bumped by the commands: G focuses the time, Custom… types the speed, Seek Steps… shows the steps.
    in property <int> edit-jump;
    in property <int> edit-rate;
    in property <int> reveal-steps;
    // Bumped when a typed value was applied: the fields close and the time field empties.
    in property <int> done;
    // A-B Loop (mockup 32). The commands can run now; else why not: "media" (no media open) or
    // "source" (the source cannot loop).
    in property <bool> ab-usable;
    in property <string> ab-reason;
    // The points as "4:02.3", "" while unset.
    in property <string> ab-a;
    in property <string> ab-b;
    // A loop runs (whoever set it): the switch; it can be switched (A and B set, or a loop runs).
    in property <bool> ab-on;
    in property <bool> ab-can-loop;
    // The Loop Count choice (0 Endless, 1 Once, 2, 3, 5, 10 → 2–5).
    in property <int> ab-count;
    // The mini timeline's top-right text: "∞" or "2 / 5" while looping, the position before A is set.
    in property <string> ab-status;
    // Fractions of the duration (0–1): the position, A, B, the span drawn (the running loop, else
    // A–B in grey) and the chapter ticks (`M<x> 0V1` in a 1000 × 1 view box).
    in property <float> ab-at;
    in property <float> ab-a-at;
    in property <float> ab-b-at;
    in property <bool> ab-span;
    in property <float> ab-span-a;
    in property <float> ab-span-b;
    in property <string> ab-ticks;
    // The typed point that was refused: "a", "b" or "".
    in property <string> ab-invalid;

    // -1 slower, +1 faster (the player's X / C; the ruler's mouse wheel).
    callback rate-step(int);
    // A click on a tick's label (0–6).
    callback set-tick(int);
    // The ruler is dragged to a position (0–1); it snaps to a tick within the second
    // value (the same unit: a few pixels of the track). speed-release ends the drag.
    callback speed-drag(float, float);
    callback speed-release();
    // A double click on the ruler: 1×.
    callback speed-normal();
    // The typed speed ("1.3").
    callback apply-rate(string);
    // The typed time ("1:02:03.5").
    callback apply-jump(string);
    callback jump-start();
    // -1 back, +1 forward.
    callback frame-step(int);
    callback keyframe-step(int);
    // A seek step row (0–3) and its typed seconds; reset-step gives the row its default.
    callback apply-step(int, string);
    callback reset-step(int);
    callback set-keyframes-only(bool);
    // A-B Loop: the point ("a" or "b") set at the position (the [ / ] keys), cleared, nudged 0.1 s
    // (-1 back, +1 forward; repeats while held) or typed; the switch, a count (its index), the
    // current chapter or bookmark range (Alt+\).
    callback ab-set(string);
    callback ab-clear(string);
    callback ab-nudge(string, int);
    callback ab-type(string, string);
    callback ab-toggle();
    callback ab-count-chosen(int);
    callback ab-segment();
    // A text field ("jump", "rate", "step0"–"step3", "a", "b") took or lost the focus; any focused one keeps the fullscreen column out.
    callback focus-changed(string, bool);
}

// Glyphs of this panel only, in the V-Line style of @vestra/icons.slint (1.5px round-capped lines), 14×12 boxes.
global Glyphs {
    out property <string> previous: "M 9.5 2 L 4.5 6 L 9.5 10 Z";
    out property <string> next: "M 4.5 2 L 9.5 6 L 4.5 10 Z";
    out property <string> start: "M 3.5 2 V 10 M 11 2 L 6 6 L 11 10 Z";
    out property <string> less: "M 8.5 2.5 L 5 6 L 8.5 9.5";
    out property <string> more: "M 5.5 2.5 L 9 6 L 5.5 9.5";
    out property <string> clear: "M 4 2.5 L 10 9.5 M 10 2.5 L 4 9.5";
    out property <string> again: "M 10.5 6 A 3.5 3.5 0 1 1 9.4 3.4 M 10.2 1 V 3.6 H 7.6";
}

component Glyph inherits Path {
    in property <string> glyph;
    in property <brush> color: Theme.text-list;
    width: 14px;
    height: 12px;
    viewbox-width: 14;
    viewbox-height: 12;
    commands: self.glyph;
    fill: transparent;
    stroke: self.color;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

// One line of text that never wraps: it takes the width its row leaves and elides there, with
// its whole wording in a tooltip when it does not fit.
component Line {
    in property <string> text;
    in property <brush> color: Theme.text-list;
    in property <length> min: 0px;
    min-height: 16px;
    min-width: root.min;
    preferred-width: root.min;
    horizontal-stretch: 1;
    ToolTipArea {
        text: label.preferred-width > root.width ? root.text : "";
        label := Text {
            width: root.width;
            text: root.text;
            color: root.color;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// A row's label in the label column (elided, the whole label in a tooltip).
component RowLabel inherits Line {
    in property <length> column;
    color: Theme.text;
    min: root.column;
    width: root.column;
    horizontal-stretch: 0;
}

// A section heading: its name and a line to the right edge.
component Heading {
    in property <string> text;
    min-height: 24px;
    HorizontalLayout {
        spacing: 8px;
        padding-top: 6px;
        Text {
            text: root.text.to-uppercase();
            color: Theme.text-dim;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 0;
        }
        VerticalLayout {
            alignment: center;
            padding-top: 1px;
            Rectangle { height: 1px; background: Theme.line; }
        }
    }
}

// A compact button (21px): a glyph and/or a label, and its key cap inside when `key` is given
// (proposal §3.5); the tooltip names it with its keys. `on` draws the current choice.
component Btn {
    in property <string> text;
    in property <string> glyph;
    in property <string> key;
    in property <bool> enabled: true;
    in property <bool> on;
    in property <string> tip;
    in property <[ToolTipKey]> tip-keys;
    in property <string> tip-detail;
    callback clicked();
    min-height: Theme.button-height;
    preferred-height: Theme.button-height;
    min-width: max(22px, row.min-width);
    preferred-width: max(22px, row.preferred-width);
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: root.text != "" ? root.text : root.tip;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    ToolTipArea {
        text: root.tip;
        keys: root.tip-keys;
        detail: root.tip-detail;
        Rectangle {
            border-radius: Theme.radius-control;
            border-width: root.on ? 1px : 0px;
            border-color: root.enabled ? Theme.accent : Theme.accent-disabled;
            background: !root.enabled ? Theme.button-disabled
                : touch.pressed ? Theme.button-press
                : touch.has-hover ? Theme.button-hover : Theme.button-bg;
            // No spacing of its own: a part that is not there (no glyph, no label, no key) takes no room.
            row := HorizontalLayout {
                padding-left: root.text == "" ? 4px : 6px;
                padding-right: root.text == "" ? 4px : 6px;
                alignment: center;
                Rectangle {
                    visible: root.glyph != "";
                    width: !self.visible ? 0px : root.text != "" ? 18px : 14px;
                    HorizontalLayout {
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Glyph { glyph: root.glyph; color: root.enabled ? Theme.text-list : Theme.icon-disabled; }
                        }
                    }
                }
                label := Text {
                    text: root.text;
                    color: !root.enabled ? Theme.text-dim : root.on ? Theme.text : Theme.text-list;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    overflow: elide;
                }
                VerticalLayout {
                    alignment: center;
                    padding-left: root.key != "" ? 5px : 0px;
                    KeyHint { text: root.key; }
                }
            }
            touch := TouchArea {
                enabled: root.enabled;
                clicked => { root.clicked(); }
            }
        }
    }
}

// The key caps at a row's right end (up to three: `a`, `b`, `c`, each with what it does), in a
// tooltip that names them. A key that is not bound takes no room.
component Caps {
    in property <string> tip;
    in property <string> a;
    in property <string> a-text;
    in property <string> b;
    in property <string> b-text;
    in property <string> c;
    in property <string> c-text;
    visible: root.a != "" || root.b != "" || root.c != "";
    horizontal-stretch: 0;
    width: self.visible ? row.preferred-width : 0px;
    ToolTipArea {
        text: root.tip;
        keys: [{ key: root.a, text: root.a-text }, { key: root.b, text: root.b-text }, { key: root.c, text: root.c-text }];
        row := HorizontalLayout {
            alignment: end;
            VerticalLayout {
                alignment: center;
                KeyHint { text: root.a; }
            }
            VerticalLayout {
                alignment: center;
                padding-left: root.a != "" && root.b != "" ? 3px : 0px;
                KeyHint { text: root.b; }
            }
            VerticalLayout {
                alignment: center;
                padding-left: (root.a != "" || root.b != "") && root.c != "" ? 3px : 0px;
                KeyHint { text: root.c; }
            }
        }
    }
}

// A value that a click opens for typing: Enter applies (the plugin answers with `done`, or marks
// it `invalid` and the field stays open), Esc or leaving the field keeps the old value. A double
// click restores the default when `resettable`.
component EditValue {
    in property <string> text;
    // What the field starts with.
    in property <string> value;
    in property <bool> enabled: true;
    in property <bool> invalid;
    in property <bool> resettable;
    in property <string> tip;
    in property <string> tip-detail;
    in property <length> box: 64px;
    in property <int> done;
    callback apply(string);
    callback reset();
    callback focus-changed(bool);
    private property <bool> typing;
    // A click on a resettable value, waiting to see whether a second one follows.
    private property <bool> pending;
    changed done => { root.stop(); }
    public function start() {
        if !root.enabled { return; }
        root.typing = true;
        field.text = root.value;
        field.focus();
        field.select-all();
    }
    function stop() {
        root.typing = false;
        field.clear-focus();
    }
    min-width: root.box;
    preferred-width: max(root.box, label.preferred-width + 14px);
    height: Theme.input-height;
    horizontal-stretch: 0;
    Rectangle {
        visible: !root.typing;
        border-radius: Theme.radius-control;
        border-width: 1px;
        border-color: touch.has-hover && root.enabled ? Theme.accent : Theme.line;
        background: Theme.bg-list;
        area := ToolTipArea {
            text: root.tip;
            detail: root.enabled ? root.tip-detail : "";
            label := Text {
                width: area.width;
                height: area.height;
                text: root.text;
                color: root.enabled ? Theme.text : Theme.text-dim;
                font-size: Theme.font-body;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            touch := TouchArea {
                enabled: root.enabled;
                mouse-cursor: MouseCursor.text;
                // A resettable value waits a moment: a second click makes it a double click (Default),
                // not typing.
                clicked => {
                    if root.resettable { root.pending = true; } else { root.start(); }
                }
                double-clicked => {
                    if root.resettable {
                        root.pending = false;
                        root.reset();
                    }
                }
            }
        }
    }
    Timer {
        interval: 300ms;
        running: root.pending;
        triggered => {
            root.pending = false;
            root.start();
        }
    }
    // The refused value: an accent ring around the open field.
    Rectangle {
        visible: root.typing && root.invalid;
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-control + 2px;
        border-width: 1px;
        border-color: Theme.accent;
    }
    FocusScope {
        visible: root.typing;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.stop(); return accept; }
            return reject;
        }
        field := LineEdit {
            width: parent.width;
            height: parent.height;
            font-size: Theme.font-body;
            horizontal-alignment: center;
            enabled: root.typing;
            accepted(text) => { root.apply(text); }
            changed has-focus => {
                root.focus-changed(self.has-focus);
                if !self.has-focus { root.typing = false; }
            }
        }
    }
}

// A check box with a one-line label (elided, the whole label in a tooltip). The plugin owns the
// state: a click asks with `toggled` and the plugin sets `checked`.
component CheckRow {
    in property <string> text;
    in property <bool> checked;
    in property <string> tip;
    callback toggled(bool);
    min-height: Theme.checkbox-row-height;
    HorizontalLayout {
        spacing: 5px;
        box := Check {
            text: "";
            self-toggle: false;
            checked: root.checked;
            horizontal-stretch: 0;
            toggled(on) => { root.toggled(on); }
        }
        label-area := ToolTipArea {
            text: root.tip != "" ? root.tip : (label.preferred-width > self.width ? root.text : "");
            horizontal-stretch: 1;
            label := Text {
                width: label-area.width;
                height: label-area.height;
                text: root.text;
                color: Theme.text;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
            }
            TouchArea {
                clicked => { box.toggle(); }
            }
        }
    }
}

// One seek step: the back key, the seconds (click to type, double click for the default), the
// forward key; centred, the keys written on both sides.
component StepRow {
    in property <int> index;
    in property <string> value;
    in property <string> back;
    in property <string> forward;
    in property <int> done;
    callback focus-changed(bool);
    private property <bool> refused: PlaybackPanelBridge.invalid-step == root.index;
    HorizontalLayout {
        spacing: 6px;
        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: end;
            VerticalLayout {
                alignment: center;
                KeyHint { text: root.back; }
            }
        }
        EditValue {
            // TRANSLATORS: {} is a number of seconds ("30").
            text: @tr("{} s", root.value);
            value: root.value;
            box: 70px;
            invalid: root.refused;
            resettable: true;
            done: root.done;
            tip: root.refused ? @tr("Range 0.1–3600 s, at most one decimal place") : @tr("Seek step");
            tip-detail: @tr("click: type a value · double-click: Default");
            apply(text) => { PlaybackPanelBridge.apply-step(root.index, text); }
            reset => { PlaybackPanelBridge.reset-step(root.index); }
            focus-changed(on) => { root.focus-changed(on); }
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: start;
            VerticalLayout {
                alignment: center;
                KeyHint { text: root.forward; }
            }
        }
    }
}

// One tick of the speed ruler: its mark under the track and its label, which a click jumps to;
// the current speed's label is outlined. Fixed elements: the hover only recolours them.
component SpeedTick {
    in property <int> index;
    in property <string> text;
    // The tick's x in the ruler and the track's centre line.
    in property <length> at;
    in property <length> track-y;
    private property <bool> on: PlaybackPanelBridge.tick == root.index;
    private property <bool> enabled: PlaybackPanelBridge.can-rate;
    Rectangle {
        x: root.at - 0.5px;
        y: root.track-y + 7px;
        width: 1px;
        height: 5px;
        background: root.enabled ? Theme.text-dim : Theme.icon-disabled;
    }
    Rectangle {
        // Narrow enough for 1.25 and 1.5 one tick apart at 280px.
        width: label.preferred-width + 6px;
        height: 16px;
        x: root.at - self.width / 2;
        y: root.track-y + 14px;
        border-radius: 3px;
        border-width: root.on ? 1px : 0px;
        border-color: root.enabled ? Theme.accent : Theme.accent-disabled;
        background: touch.has-hover && root.enabled ? Theme.button-hover : transparent;
        label := Text {
            width: parent.width;
            height: parent.height;
            text: root.text;
            color: !root.enabled ? Theme.text-dim : root.on || touch.has-hover ? Theme.text : Theme.text-dim;
            font-size: Theme.font-body;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        touch := TouchArea {
            width: parent.width;
            height: parent.height;
            enabled: root.enabled;
            clicked => { PlaybackPanelBridge.set-tick(root.index); }
        }
    }
}

// The speed ruler (menu redesign "Speed B", mockup 12): a track with the seven presets as
// labelled ticks, 1× in the centre, linear between ticks (speed.ts maps position ↔ speed).
// Drag: the plugin snaps near a tick and moves in 0.05 steps between them; a bubble shows the
// value while the button is down (● on a tick). A label click jumps there, a double click is
// 1×, the wheel ±0.1 (the player's X / C). The tooltip names the keys.
component SpeedRuler {
    in property <string> tip;
    in property <string> tip-detail;
    in property <[ToolTipKey]> tip-keys;
    private property <bool> enabled: PlaybackPanelBridge.can-rate;
    // The first and last labels stay inside: the track is inset by half a label.
    private property <length> inset: 14px;
    private property <length> track-y: 30px;
    private property <length> span: max(1px, self.width - 2 * self.inset);
    private property <length> thumb-x: self.inset + clamp(PlaybackPanelBridge.rate-position, 0, 1) * self.span;
    private property <length> one-x: self.inset + 0.5 * self.span;
    private property <bool> dragging: drag.pressed;
    function sample(x: length) {
        // Snap within 5px of a tick.
        PlaybackPanelBridge.speed-drag((x - root.inset) / root.span, 5px / root.span);
    }
    height: 62px;
    min-width: 200px;
    horizontal-stretch: 1;
    ToolTipArea {
        width: root.width;
        height: root.height;
        text: root.tip;
        keys: root.tip-keys;
        detail: root.enabled ? root.tip-detail : "";
        // The track, and the fill from 1× to the speed.
        Rectangle {
            x: root.inset;
            y: root.track-y - 1px;
            width: root.span;
            height: 2px;
            border-radius: 1px;
            background: Theme.line;
        }
        Rectangle {
            x: min(root.one-x, root.thumb-x);
            y: root.track-y - 1px;
            width: abs(root.thumb-x - root.one-x);
            height: 2px;
            border-radius: 1px;
            background: root.enabled ? Theme.accent-fill : Theme.icon-disabled;
        }
        // 1×: a taller mark at the centre.
        Rectangle {
            x: root.one-x - 0.5px;
            y: root.track-y - 6px;
            width: 1px;
            height: 5px;
            background: root.enabled ? Theme.text-dim : Theme.icon-disabled;
        }
        drag := TouchArea {
            x: 0;
            y: root.track-y - 10px;
            width: root.width;
            height: 22px;
            enabled: root.enabled;
            mouse-cursor: MouseCursor.pointer;
            // A drag that ends without a release (the window loses the pointer, the ruler is
            // disabled mid-drag) is cancelled: it ends like a release, so the value never sticks.
            pointer-event(event) => {
                if event.kind == PointerEventKind.cancel {
                    PlaybackPanelBridge.speed-release();
                } else if event.button == PointerEventButton.left {
                    if event.kind == PointerEventKind.down { root.sample(self.mouse-x); }
                    if event.kind == PointerEventKind.up { PlaybackPanelBridge.speed-release(); }
                }
            }
            moved => { if self.pressed { root.sample(self.mouse-x); } }
            double-clicked => { PlaybackPanelBridge.speed-normal(); }
            scroll-event(event) => {
                if event.delta-y > 0 { PlaybackPanelBridge.rate-step(1); }
                if event.delta-y < 0 { PlaybackPanelBridge.rate-step(-1); }
                accept
            }
        }
        SpeedTick { x: 0; y: 0; width: root.width; height: root.height; index: 0; text: "0.25"; at: root.inset; track-y: root.track-y; }
        SpeedTick { x: 0; y: 0; width: root.width; height: root.height; index: 1; text: "0.5"; at: root.inset + 0.25 * root.span; track-y: root.track-y; }
        SpeedTick { x: 0; y: 0; width: root.width; height: root.height; index: 2; text: @tr("1×"); at: root.inset + 0.5 * root.span; track-y: root.track-y; }
        SpeedTick { x: 0; y: 0; width: root.width; height: root.height; index: 3; text: "1.25"; at: root.inset + 0.625 * root.span; track-y: root.track-y; }
        SpeedTick { x: 0; y: 0; width: root.width; height: root.height; index: 4; text: "1.5"; at: root.inset + 0.75 * root.span; track-y: root.track-y; }
        SpeedTick { x: 0; y: 0; width: root.width; height: root.height; index: 5; text: "2"; at: root.inset + 0.875 * root.span; track-y: root.track-y; }
        SpeedTick { x: 0; y: 0; width: root.width; height: root.height; index: 6; text: "4"; at: root.inset + root.span; track-y: root.track-y; }
        // The thumb (the SDK slider's panel style, 14×12).
        Rectangle {
            x: root.thumb-x - 7px;
            y: root.track-y - 6px;
            width: 14px;
            height: 12px;
            border-radius: Theme.radius-control;
            background: root.enabled ? Theme.text : Theme.icon-disabled;
            border-width: root.dragging ? 1px : 0px;
            border-color: Theme.accent;
        }
        // The value while dragging, above the thumb and kept inside the ruler.
        Rectangle {
            visible: root.dragging;
            width: bubble.preferred-width + 12px;
            height: 18px;
            x: clamp(root.thumb-x - self.width / 2, 0px, root.width - self.width);
            y: root.track-y - 28px;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.bg-list;
            bubble := Text {
                width: parent.width;
                height: parent.height;
                // TRANSLATORS: {} is the playback speed ("1.25"); the × reads "times".
                text: @tr("{}×", PlaybackPanelBridge.rate-text) + (PlaybackPanelBridge.tick >= 0 ? " ●" : "");
                color: Theme.text;
                font-size: Theme.font-body;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// ------------------------------------------------------------------ A-B Loop (mockup 32)

// A point flag on the mini timeline: a 12px badge with its letter and a stem down to the track;
// `set` false draws the outline only (where A would go: the position), without the stem.
component AbFlag {
    in property <string> letter;
    in property <length> at;
    in property <bool> set;
    if root.set: Rectangle {
        x: root.at - 0.5px;
        y: 14px;
        width: 1px;
        height: 6px;
        background: Theme.accent;
    }
    Rectangle {
        x: root.at - 6px;
        y: 2px;
        width: 12px;
        height: 12px;
        border-radius: 3px;
        background: root.set ? Theme.accent : transparent;
        border-width: root.set ? 0px : 1px;
        border-color: Theme.text-dim;
        Text {
            text: root.letter;
            color: root.set ? Theme.text : Theme.text-dim;
            font-size: Theme.font-xs;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// The 30px mini timeline: the track, the chapter ticks, the A–B span (coloured while a loop runs,
// grey while A and B wait for the switch), the A and B flags, the position dot, and at the top right
// the pass ("2 / 5", "∞") or, before A is set, the position.
component AbTimeline {
    private property <length> inset: 7px;
    private property <length> span: max(1px, self.width - 2 * self.inset);
    private property <bool> usable: PlaybackPanelBridge.ab-usable;
    private property <bool> has-a: PlaybackPanelBridge.ab-a != "";
    private property <bool> has-b: PlaybackPanelBridge.ab-b != "";
    height: 30px;
    horizontal-stretch: 1;
    Rectangle {
        x: root.inset;
        y: 17px;
        width: root.span;
        height: 2px;
        border-radius: 1px;
        background: Theme.line;
    }
    if PlaybackPanelBridge.ab-ticks != "": Path {
        x: root.inset;
        y: 15px;
        width: root.span;
        height: 6px;
        commands: PlaybackPanelBridge.ab-ticks;
        viewbox-width: 1000;
        viewbox-height: 1;
        fit: fill;
        stroke: Theme.text-dim;
        stroke-width: 1px;
    }
    if PlaybackPanelBridge.ab-span: Rectangle {
        x: root.inset + PlaybackPanelBridge.ab-span-a * root.span;
        y: 16px;
        width: max(2px, (PlaybackPanelBridge.ab-span-b - PlaybackPanelBridge.ab-span-a) * root.span);
        height: 4px;
        border-radius: 2px;
        background: PlaybackPanelBridge.ab-on ? Theme.accent-fill : Theme.icon-disabled;
    }
    if root.usable || root.has-a: AbFlag {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        letter: "A";
        set: root.has-a;
        at: root.inset + (root.has-a ? PlaybackPanelBridge.ab-a-at : PlaybackPanelBridge.ab-at) * root.span;
    }
    if root.has-b: AbFlag {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        letter: "B";
        set: true;
        at: root.inset + PlaybackPanelBridge.ab-b-at * root.span;
    }
    if root.usable: Rectangle {
        x: root.inset + PlaybackPanelBridge.ab-at * root.span - 4px;
        y: 14px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.text;
        border-width: 1px;
        border-color: Theme.bg-list;
    }
    Text {
        x: 0;
        y: 0;
        width: root.width;
        height: 12px;
        text: PlaybackPanelBridge.ab-status;
        color: PlaybackPanelBridge.ab-on ? Theme.text : Theme.text-dim;
        font-family: Theme.font-mono;
        font-size: Theme.font-xs + 1px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// A ‹ or › nudge: one step on the press, then repeating while it is held (as the held keys).
component NudgeBtn {
    in property <string> glyph;
    in property <bool> enabled: true;
    in property <string> tip;
    in property <[ToolTipKey]> tip-keys;
    callback step();
    // Held past the first delay: repeating.
    private property <bool> repeating;
    min-height: Theme.button-height;
    preferred-height: Theme.button-height;
    min-width: 22px;
    preferred-width: 22px;
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.step(); } }
    ToolTipArea {
        text: root.tip;
        keys: root.tip-keys;
        detail: root.enabled ? @tr("hold to repeat") : "";
        Rectangle {
            border-radius: Theme.radius-control;
            background: !root.enabled ? Theme.button-disabled
                : touch.pressed ? Theme.button-press
                : touch.has-hover ? Theme.button-hover : Theme.button-bg;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Glyph { glyph: root.glyph; color: root.enabled ? Theme.text-list : Theme.icon-disabled; }
                }
            }
            touch := TouchArea {
                enabled: root.enabled;
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        root.repeating = false;
                        root.step();
                    }
                }
            }
        }
    }
    Timer {
        interval: root.repeating ? 60ms : 400ms;
        running: touch.pressed && root.enabled;
        triggered => {
            root.repeating = true;
            root.step();
        }
    }
}

// A point's row: its badge, then either a "Set A here" button (the point at the position, its key
// beside it) or its time (click to type one), the ‹ › nudges and × clear; its set key at the right.
component AbPointRow {
    in property <string> letter;
    // "a" or "b".
    in property <string> point;
    in property <string> value;
    in property <string> set-text;
    in property <string> set-tip;
    in property <string> set-detail;
    in property <string> clear-tip;
    in property <string> back-tip;
    in property <string> forward-tip;
    in property <string> set-key;
    in property <string> clear-key;
    in property <string> back-key;
    in property <string> forward-key;
    in property <string> why;
    in property <int> done;
    private property <bool> usable: PlaybackPanelBridge.ab-usable;
    private property <bool> refused: PlaybackPanelBridge.ab-invalid == root.point;
    private property <bool> has: root.value != "";
    HorizontalLayout {
        spacing: 4px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 3px;
                background: root.has ? Theme.accent : transparent;
                border-width: root.has ? 0px : 1px;
                border-color: Theme.text-dim;
                Text {
                    text: root.letter;
                    color: root.has ? Theme.text : Theme.text-dim;
                    font-size: Theme.font-body - 1px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        if !root.has: Rectangle {
            min-width: 64px;
            preferred-width: max(64px, set-label.preferred-width + 16px);
            height: Theme.button-height;
            horizontal-stretch: 0;
            border-radius: Theme.radius-control;
            border-width: 1px;
            border-color: set-touch.has-hover && root.usable ? Theme.accent : Theme.text-dim;
            background: !root.usable ? transparent : set-touch.pressed ? Theme.button-press
                : set-touch.has-hover ? Theme.button-hover : transparent;
            accessible-role: button;
            accessible-label: root.set-tip;
            accessible-enabled: root.usable;
            accessible-action-default => { if root.usable { PlaybackPanelBridge.ab-set(root.point); } }
            ToolTipArea {
                text: root.usable ? root.set-tip : root.why;
                keys: [{ key: root.set-key, text: "" }];
                detail: root.usable ? root.set-detail : "";
                set-label := Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    text: root.set-text;
                    color: root.usable ? Theme.text-list : Theme.text-dim;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    overflow: elide;
                }
                set-touch := TouchArea {
                    enabled: root.usable;
                    clicked => { PlaybackPanelBridge.ab-set(root.point); }
                }
            }
        }
        if root.has: EditValue {
            text: root.value;
            value: root.value;
            box: 64px;
            enabled: root.usable;
            invalid: root.refused;
            done: root.done;
            tip: !root.usable ? root.why : root.refused ? @tr("Enter a time within the source's duration as HH:MM:SS.mmm")
                : root.letter == "A" ? @tr("Start point") : @tr("End point");
            tip-detail: @tr("click: type a time");
            apply(text) => { PlaybackPanelBridge.ab-type(root.point, text); }
            focus-changed(on) => { PlaybackPanelBridge.focus-changed(root.point, on); }
        }
        if root.has: NudgeBtn {
            glyph: Glyphs.less;
            enabled: root.usable;
            tip: root.usable ? root.back-tip : root.why;
            tip-keys: [{ key: root.back-key, text: "" }];
            step => { PlaybackPanelBridge.ab-nudge(root.point, -1); }
        }
        if root.has: NudgeBtn {
            glyph: Glyphs.more;
            enabled: root.usable;
            tip: root.usable ? root.forward-tip : root.why;
            tip-keys: [{ key: root.forward-key, text: "" }];
            step => { PlaybackPanelBridge.ab-nudge(root.point, 1); }
        }
        if root.has: Btn {
            glyph: Glyphs.clear;
            enabled: root.usable;
            tip: root.usable ? root.clear-tip : root.why;
            tip-keys: [{ key: root.clear-key, text: "" }];
            clicked => { PlaybackPanelBridge.ab-clear(root.point); }
        }
        Rectangle { horizontal-stretch: 1; }
        Caps {
            tip: root.set-tip;
            a: root.set-key;
        }
    }
}

export component PlaybackPanel inherits Rectangle {
    background: Theme.bg-panel;
    // The label column: the widest label, 52–84px (a longer translation elides, whole in its tooltip).
    private property <length> column: clamp(label-measure.preferred-width, 52px, 84px);
    private property <string> unsupported: @tr("Not supported by the current source");
    private property <int> jump-request: PlaybackPanelBridge.edit-jump;
    private property <int> rate-request: PlaybackPanelBridge.edit-rate;
    private property <int> steps-request: PlaybackPanelBridge.reveal-steps;
    private property <int> done: PlaybackPanelBridge.done;
    changed jump-request => {
        jump-field.focus();
        jump-field.select-all();
    }
    changed rate-request => { rate-value.start(); }
    changed steps-request => {
        scroll.viewport-y = -min(steps-heading.y, max(0px, content.preferred-height - scroll.visible-height));
    }
    changed done => {
        jump-field.text = "";
        jump-field.clear-focus();
    }
    // Why the keyframe steps cannot run.
    private property <string> keyframe-why: PlaybackPanelBridge.keyframe-reason == "video" ? @tr("No video") : root.unsupported;
    // Why the A-B Loop controls cannot run.
    private property <string> ab-why: PlaybackPanelBridge.ab-reason == "media" ? @tr("No media open") : @tr("This source doesn't support A-B loop");
    // The switch and the Count list change themselves on a click; they follow the plugin's values again.
    private property <bool> ab-on: PlaybackPanelBridge.ab-on;
    private property <int> ab-count: PlaybackPanelBridge.ab-count;
    changed ab-on => { loop-switch.checked = self.ab-on; }
    changed ab-count => { count-choice.current-index = self.ab-count; }

    Rectangle {
        visible: false;
        width: 0;
        height: 0;
        label-measure := VerticalLayout {
            for text in [@tr("Speed"), @tr("Go to"), @tr("Start"), @tr("Frame"), @tr("Keyframe")]: Text {
                text: text;
                font-size: Theme.font-body;
            }
        }
    }

    scroll := ScrollView {
        viewport-width: content.width;
        viewport-height: content.preferred-height;
        content := VerticalLayout {
            width: scroll.visible-width;
            padding: 10px;
            padding-top: 8px;
            spacing: 6px;
            alignment: start;

            // ------------------------------------------------------------ Speed
            Heading { text: @tr("Speed"); }
            HorizontalLayout {
                spacing: 4px;
                RowLabel { column: root.column; text: @tr("Speed"); }
                Rectangle { horizontal-stretch: 1; }
                // The speed; a click types any speed in the player's range (this was Custom…).
                rate-value := EditValue {
                    // TRANSLATORS: {} is the playback speed ("1.25"); the × reads "times".
                    text: @tr("{}×", PlaybackPanelBridge.rate-text);
                    value: PlaybackPanelBridge.rate-text;
                    enabled: PlaybackPanelBridge.can-rate;
                    invalid: PlaybackPanelBridge.rate-invalid;
                    done: root.done;
                    tip: !PlaybackPanelBridge.can-rate ? root.unsupported
                        : PlaybackPanelBridge.rate-invalid ? @tr("Speed must be between 0.25× and 4×") : @tr("Playback speed");
                    tip-detail: @tr("click: type a value");
                    apply(text) => { PlaybackPanelBridge.apply-rate(text); }
                    focus-changed(on) => { PlaybackPanelBridge.focus-changed("rate", on); }
                }
                Caps {
                    tip: @tr("Playback speed");
                    a: PlaybackPanelBridge.keys.slower;
                    a-text: "−";
                    b: PlaybackPanelBridge.keys.faster;
                    b-text: "+";
                    c: PlaybackPanelBridge.keys.normal;
                    c-text: @tr("1×");
                }
            }
            SpeedRuler {
                tip: PlaybackPanelBridge.can-rate ? @tr("Speed") : root.unsupported;
                tip-detail: @tr("drag or scroll · double-click: 1×");
                tip-keys: [
                    { key: PlaybackPanelBridge.keys.slower, text: "−" },
                    { key: PlaybackPanelBridge.keys.faster, text: "+" },
                    { key: PlaybackPanelBridge.keys.normal, text: @tr("1×") },
                ];
            }

            // ------------------------------------------------------------ A-B Loop
            HorizontalLayout {
                spacing: 6px;
                Heading { text: @tr("A-B Loop"); horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: end;
                    Caps {
                        tip: @tr("A-B Loop On/Off");
                        a: PlaybackPanelBridge.keys.abtoggle;
                    }
                }
            }
            AbTimeline { }
            AbPointRow {
                letter: "A";
                point: "a";
                value: PlaybackPanelBridge.ab-a;
                // TRANSLATORS: the button that sets the loop's start point A at the current position.
                set-text: @tr("Set A here");
                set-tip: @tr("Set Start Point");
                set-detail: @tr("at the current position");
                clear-tip: @tr("Clear Start Point");
                back-tip: @tr("Start Point Back 0.1 s");
                forward-tip: @tr("Start Point Forward 0.1 s");
                set-key: PlaybackPanelBridge.keys.seta;
                clear-key: PlaybackPanelBridge.keys.cleara;
                back-key: PlaybackPanelBridge.keys.aback;
                forward-key: PlaybackPanelBridge.keys.aforward;
                why: root.ab-why;
                done: root.done;
            }
            AbPointRow {
                letter: "B";
                point: "b";
                value: PlaybackPanelBridge.ab-b;
                // TRANSLATORS: the button that sets the loop's end point B at the current position.
                set-text: @tr("Set B here");
                set-tip: @tr("Set End Point");
                set-detail: @tr("at the current position · the loop starts at once");
                clear-tip: @tr("Clear End Point");
                back-tip: @tr("End Point Back 0.1 s");
                forward-tip: @tr("End Point Forward 0.1 s");
                set-key: PlaybackPanelBridge.keys.setb;
                clear-key: PlaybackPanelBridge.keys.clearb;
                back-key: PlaybackPanelBridge.keys.bback;
                forward-key: PlaybackPanelBridge.keys.bforward;
                why: root.ab-why;
                done: root.done;
            }
            HorizontalLayout {
                spacing: 6px;
                ToolTipArea {
                    horizontal-stretch: 0;
                    text: !PlaybackPanelBridge.ab-usable ? root.ab-why
                        : PlaybackPanelBridge.ab-can-loop ? @tr("A-B Loop On/Off") : @tr("Set the start and end points first");
                    keys: [{ key: PlaybackPanelBridge.keys.abtoggle, text: "" }];
                    loop-switch := Switch {
                        text: "";
                        enabled: PlaybackPanelBridge.ab-can-loop;
                        checked: PlaybackPanelBridge.ab-on;
                        // The plugin owns the state: ask, and show the plugin's answer again.
                        toggled => {
                            PlaybackPanelBridge.ab-toggle();
                            self.checked = PlaybackPanelBridge.ab-on;
                        }
                    }
                }
                Line {
                    // TRANSLATORS: the A-B loop's on/off switch.
                    text: @tr("Loop");
                    color: PlaybackPanelBridge.ab-can-loop ? Theme.text : Theme.text-dim;
                }
                Line {
                    // TRANSLATORS: how many times the A-B loop repeats (Endless, Once, 2 Times…).
                    text: @tr("Count");
                    color: Theme.text-dim;
                    horizontal-stretch: 0;
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    count-choice := Choice {
                        width: 66px;
                        max-visible-rows: 6;
                        popup-min-width: 90px;
                        model: [@tr("Endless"), @tr("Once"), @tr("2 Times"), @tr("3 Times"), @tr("5 Times"), @tr("10 Times")];
                        current-index: PlaybackPanelBridge.ab-count;
                        selected(index) => { PlaybackPanelBridge.ab-count-chosen(index); }
                    }
                }
                Btn {
                    // TRANSLATORS: a short button: loop the current chapter or bookmark range.
                    text: @tr("Chapter");
                    glyph: Glyphs.again;
                    enabled: PlaybackPanelBridge.ab-usable;
                    tip: PlaybackPanelBridge.ab-usable ? @tr("Loop Current Chapter or Bookmark Range") : root.ab-why;
                    tip-keys: [{ key: PlaybackPanelBridge.keys.absegment, text: "" }];
                    clicked => { PlaybackPanelBridge.ab-segment(); }
                }
            }

            // ------------------------------------------------------------ Jump
            Heading { text: @tr("Jump"); }
            HorizontalLayout {
                spacing: 4px;
                RowLabel { column: root.column; text: @tr("Go to"); }
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 60px;
                    height: Theme.input-height;
                    // The refused time: an accent ring around the field.
                    Rectangle {
                        visible: PlaybackPanelBridge.jump-invalid;
                        x: -2px;
                        y: -2px;
                        width: parent.width + 4px;
                        height: parent.height + 4px;
                        border-radius: Theme.radius-control + 2px;
                        border-width: 1px;
                        border-color: Theme.accent;
                    }
                    ToolTipArea {
                        text: PlaybackPanelBridge.jump-invalid ? @tr("Enter a time within the source's duration as HH:MM:SS.mmm")
                            : PlaybackPanelBridge.can-jump ? @tr("Jump to Time") : root.unsupported;
                        FocusScope {
                            focus-on-click: false;
                            focus-on-tab-navigation: false;
                            capture-key-pressed(event) => {
                                if event.text == Key.Escape { jump-field.clear-focus(); return accept; }
                                return reject;
                            }
                            jump-field := LineEdit {
                                width: parent.width;
                                height: parent.height;
                                font-size: Theme.font-body;
                                enabled: PlaybackPanelBridge.can-jump;
                                // TRANSLATORS: the format of the time to jump to (hours, minutes, seconds).
                                placeholder-text: @tr("hh:mm:ss");
                                accepted(text) => { PlaybackPanelBridge.apply-jump(text); }
                                changed has-focus => { PlaybackPanelBridge.focus-changed("jump", self.has-focus); }
                            }
                        }
                    }
                }
                Btn {
                    text: @tr("Go");
                    enabled: PlaybackPanelBridge.can-jump;
                    tip: PlaybackPanelBridge.can-jump ? @tr("Jump to Time") : root.unsupported;
                    clicked => { PlaybackPanelBridge.apply-jump(jump-field.text); }
                }
                Caps {
                    tip: @tr("Jump to Time");
                    a: PlaybackPanelBridge.keys.jump;
                }
            }
            HorizontalLayout {
                spacing: 4px;
                RowLabel { column: root.column; text: @tr("Start"); }
                Btn {
                    text: @tr("Jump to Start");
                    glyph: Glyphs.start;
                    enabled: PlaybackPanelBridge.can-start;
                    tip: PlaybackPanelBridge.can-start ? @tr("Jump to Start") : root.unsupported;
                    tip-keys: [{ key: PlaybackPanelBridge.keys.start, text: "" }];
                    clicked => { PlaybackPanelBridge.jump-start(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Caps {
                    tip: @tr("Jump to Start");
                    a: PlaybackPanelBridge.keys.start;
                }
            }

            // ------------------------------------------------------------ Step
            Heading { text: @tr("Step"); }
            HorizontalLayout {
                spacing: 4px;
                RowLabel { column: root.column; text: @tr("Frame"); }
                Btn {
                    glyph: Glyphs.previous;
                    enabled: PlaybackPanelBridge.can-frame;
                    tip: PlaybackPanelBridge.can-frame ? @tr("Previous Frame") : root.unsupported;
                    tip-keys: [{ key: PlaybackPanelBridge.keys.frameback, text: "" }];
                    clicked => { PlaybackPanelBridge.frame-step(-1); }
                }
                Btn {
                    glyph: Glyphs.next;
                    enabled: PlaybackPanelBridge.can-frame;
                    tip: PlaybackPanelBridge.can-frame ? @tr("Next Frame") : root.unsupported;
                    tip-keys: [{ key: PlaybackPanelBridge.keys.frameforward, text: "" }];
                    clicked => { PlaybackPanelBridge.frame-step(1); }
                }
                Rectangle { horizontal-stretch: 1; }
                Caps {
                    tip: @tr("Frame");
                    a: PlaybackPanelBridge.keys.frameback;
                    a-text: "◀";
                    b: PlaybackPanelBridge.keys.frameforward;
                    b-text: "▶";
                }
            }
            HorizontalLayout {
                spacing: 4px;
                RowLabel { column: root.column; text: @tr("Keyframe"); }
                Btn {
                    glyph: Glyphs.previous;
                    enabled: PlaybackPanelBridge.can-keyframe;
                    tip: PlaybackPanelBridge.can-keyframe ? @tr("Previous Keyframe") : root.keyframe-why;
                    tip-keys: [{ key: PlaybackPanelBridge.keys.keyback, text: "" }];
                    clicked => { PlaybackPanelBridge.keyframe-step(-1); }
                }
                Btn {
                    glyph: Glyphs.next;
                    enabled: PlaybackPanelBridge.can-keyframe;
                    tip: PlaybackPanelBridge.can-keyframe ? @tr("Next Keyframe") : root.keyframe-why;
                    tip-keys: [{ key: PlaybackPanelBridge.keys.keyforward, text: "" }];
                    clicked => { PlaybackPanelBridge.keyframe-step(1); }
                }
                Rectangle { horizontal-stretch: 1; }
                Caps {
                    tip: @tr("Keyframe");
                    a: PlaybackPanelBridge.keys.keyback;
                    a-text: "◀";
                    b: PlaybackPanelBridge.keys.keyforward;
                    b-text: "▶";
                }
            }

            // ------------------------------------------------------------ Seek steps
            steps-heading := Heading { text: @tr("Seek steps"); }
            StepRow {
                index: 0;
                value: PlaybackPanelBridge.steps[0];
                back: PlaybackPanelBridge.keys.back1;
                forward: PlaybackPanelBridge.keys.forward1;
                done: root.done;
                focus-changed(on) => { PlaybackPanelBridge.focus-changed("step0", on); }
            }
            StepRow {
                index: 1;
                value: PlaybackPanelBridge.steps[1];
                back: PlaybackPanelBridge.keys.back2;
                forward: PlaybackPanelBridge.keys.forward2;
                done: root.done;
                focus-changed(on) => { PlaybackPanelBridge.focus-changed("step1", on); }
            }
            StepRow {
                index: 2;
                value: PlaybackPanelBridge.steps[2];
                back: PlaybackPanelBridge.keys.back3;
                forward: PlaybackPanelBridge.keys.forward3;
                done: root.done;
                focus-changed(on) => { PlaybackPanelBridge.focus-changed("step2", on); }
            }
            StepRow {
                index: 3;
                value: PlaybackPanelBridge.steps[3];
                back: PlaybackPanelBridge.keys.back4;
                forward: PlaybackPanelBridge.keys.forward4;
                done: root.done;
                focus-changed(on) => { PlaybackPanelBridge.focus-changed("step3", on); }
            }
            CheckRow {
                text: @tr("Jump to keyframes only");
                tip: @tr("The seek steps and the seek bar land on keyframes: fast on any file, up to one keyframe interval off");
                checked: PlaybackPanelBridge.keyframes-only;
                toggled(on) => { PlaybackPanelBridge.set-keyframes-only(on); }
            }
        }
    }
}

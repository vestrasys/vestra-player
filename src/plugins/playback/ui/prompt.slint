// Small one-input tool window: Jump to Time (UI-DLG-01, time group only) and the custom speed.
import { LineEdit } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button } from "@vestra/widgets.slint";

export component PromptWindow inherits Window {
    // "jump" or "rate".
    in property <string> kind;
    // The message line (prompt.ts `Notice`): "", "stale", "source", "time-range", "rate-range", "other".
    in property <string> notice;
    // The player's message for "source" and "other".
    in property <string> detail;
    in-out property <string> value;
    callback confirm(string);
    callback cancel();
    private property <string> message: root.notice == "stale" ? @tr("The source changed; open this window again")
        : root.notice == "source" ? @tr("Source operation failed: {}", root.detail)
        : root.notice == "time-range" ? @tr("Enter a time within the source's duration as HH:MM:SS.mmm")
        : root.notice == "rate-range" ? @tr("Speed must be between 0.25× and 4×")
        : root.detail;
    title: root.kind == "rate" ? @tr("Custom Speed") : @tr("Jump to Time");
    preferred-width: 357px;
    min-width: 260px;
    background: Theme.bg-bar;
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: 8px;
            Rectangle {
                background: Theme.bg-panel;
                border-color: Theme.line;
                border-width: 1px;
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    Text {
                        text: root.kind == "rate" ? @tr("Speed (0.25–4×)") : @tr("Time (h:mm:ss.ms)");
                        color: Theme.text;
                        font-size: Theme.font-body;
                        height: Theme.label-height;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        input := LineEdit {
                            width: 140px;
                            height: Theme.input-height;
                            font-size: Theme.font-body;
                            text <=> root.value;
                            accepted => { root.confirm(self.text); }
                        }
                        Button {
                            text: root.kind == "rate" ? @tr("OK") : @tr("Go");
                            clicked => { root.confirm(root.value); }
                        }
                    }
                }
            }
            Text {
                text: root.message;
                color: Theme.text-dim;
                font-size: Theme.font-body;
                min-height: Theme.label-height;
                wrap: word-wrap;
                line-height-factor: 1.25;
            }
        }
    }
    init => { input.focus(); }
}

// Small one-input tool window: 跳转到 (UI-DLG-01, time group only) and the custom speed.
import { LineEdit } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button } from "@vestra/widgets.slint";

export component PromptWindow inherits Window {
    in property <string> window-title;
    in property <string> group-title;
    in property <string> action-label;
    in property <string> message;
    in-out property <string> value;
    callback confirm(string);
    callback cancel();
    title: root.window-title;
    preferred-width: 357px;
    min-width: 260px;
    background: Theme.bg-bar;
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: 8px;
            Rectangle {
                background: Theme.bg-panel;
                border-color: Theme.line;
                border-width: 1px;
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    Text {
                        text: root.group-title;
                        color: Theme.text;
                        font-size: Theme.font-body;
                        height: Theme.label-height;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        input := LineEdit {
                            width: 140px;
                            height: Theme.input-height;
                            font-size: Theme.font-body;
                            text <=> root.value;
                            accepted => { root.confirm(self.text); }
                        }
                        Button {
                            text: root.action-label;
                            clicked => { root.confirm(root.value); }
                        }
                    }
                }
            }
            Text {
                text: root.message;
                color: Theme.text-dim;
                font-size: Theme.font-body;
                min-height: Theme.label-height;
                wrap: word-wrap;
                line-height-factor: 1.25;
            }
        }
    }
    init => { input.focus(); }
}

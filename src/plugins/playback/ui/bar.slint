// Bottom control bar (doc/product/ui-spec.md §4): a 22px seek row and a
// 40px button row, 62px in total. Icons come from @vestra/icons.slint; colours,
// corners and font sizes from Theme.
import { Theme } from "@vestra/theme.slint";
import { Icon } from "@vestra/icons.slint";
import { Slider, ToolTipArea } from "@vestra/widgets.slint";
import { BarButtonsHost } from "@vestra/bar-buttons.slint";

// B22: one mark of `timeline.marks` for the hover search; `at` is the fraction
// of the duration, `tip` the hover text ("Title  01:23", or the time alone).
// The ticks are drawn from the `*-ticks` Path commands, not from these rows.
export struct SeekMark {
    at: float,
    tip: string,
}

// A half-open index range of the binary search over the marks.
struct MarkRange {
    lo: int,
    hi: int,
}

export global PlaybackBridge {
    in-out property <string> elapsed-label: "--:--";
    in-out property <string> total-label: "--:--";
    in-out property <float> progress;
    in-out property <bool> can-seek;
    // I06: source duration in seconds and the Show Time on Seek Bar Hover option.
    in-out property <float> duration;
    in-out property <bool> hover-time;
    // I07: the picture box (option on, a local file with video) and the source's
    // sprite: `preview-count` cells of 160×90 in 10×10 sheets (cell c on sheet
    // c / 100); `preview-map[cell]` is the made cell to show there (-1: none yet).
    in-out property <bool> hover-thumbnail;
    in-out property <int> preview-count;
    in-out property <[int]> preview-map;
    in-out property <image> preview-sheet-a;
    in-out property <image> preview-sheet-b;
    // B22: marks sorted by time (4096 at most), and the A-B loop, as fractions of the duration.
    in-out property <[SeekMark]> marks;
    // B22: each kind's ticks as SVG path commands, `M<x> 0V1` per tick with x
    // the whole physical px column on the line (0…tick-span): one Path per kind.
    in-out property <string> chapter-ticks;
    in-out property <string> bookmark-ticks;
    in-out property <string> marker-ticks;
    // The line's span in physical px the plugin built the ticks for (0: none
    // yet); it answers `span-changed`.
    in-out property <float> tick-span;
    in-out property <bool> has-loop;
    in-out property <float> loop-a;
    in-out property <float> loop-b;
    in-out property <bool> can-pause;
    in-out property <bool> playing;
    in-out property <bool> can-stop;
    in-out property <bool> can-previous;
    in-out property <bool> can-next;
    in-out property <bool> can-open: true;
    in-out property <bool> muted;
    in-out property <float> volume: 100;
    in-out property <bool> can-mute: true;
    in-out property <bool> can-volume: true;
    // UI-BAR-05 (0.2.4): the main window is fullscreen (`window.state`); the
    // fullscreen button shows `exit-fullscreen` then, `fullscreen` otherwise.
    in-out property <bool> fullscreen;
    // G-07: tooltips (600 ms, ToolTipArea) name the keys the user has bound
    // (the menu text, "" for none) and the volume.
    in-out property <string> key-play-pause;
    in-out property <string> key-stop;
    in-out property <string> key-previous;
    in-out property <string> key-next;
    in-out property <string> key-open;
    in-out property <string> key-mute;
    in-out property <string> key-fullscreen;
    in-out property <int> volume-percent: 100;
    // G-14: the time label shows the remaining time.
    in-out property <bool> remaining-time;
    // `title (key)`, or the title alone without a key.
    pure function with-key(title: string, key: string) -> string {
        // TRANSLATORS: a tooltip: a button's action and its key, e.g. "Pause (Space)".
        return key == "" ? title : @tr("{} ({})", title, key);
    }
    out property <string> tip-play-pause: with-key(playing ? @tr("Pause") : @tr("Play"), key-play-pause);
    out property <string> tip-stop: with-key(@tr("Stop"), key-stop);
    // 0.2.14: the playlist's previous and next item, as PgUp / PgDn.
    out property <string> tip-previous: with-key(@tr("Previous"), key-previous);
    out property <string> tip-next: with-key(@tr("Next"), key-next);
    out property <string> tip-open: with-key(@tr("Open file"), key-open);
    out property <string> tip-fullscreen: with-key(fullscreen ? @tr("Leave fullscreen") : @tr("Fullscreen"), key-fullscreen);
    out property <string> tip-time: remaining-time ? @tr("Click to show the elapsed time") : @tr("Click to show the remaining time");
    out property <string> tip-mute: with-key(muted ? @tr("Unmute") : @tr("Mute"), key-mute);
    out property <string> tip-volume: @tr("Volume: {}%", volume-percent);
    // A core action id (`host.run`), or "open".
    callback action(string);
    callback seek-changed(float);
    callback seek-cancelled();
    callback dragging(bool);
    // I07: the pointer came onto the seek line (hover or drag) or left it; the
    // sprite sheets are sent only meanwhile (the player decodes each on its UI thread).
    callback pointing(bool);
    // B22: the seek line's span (its width less the 4px insets) in whole
    // physical px, at start and whenever it changes (width or scale factor);
    // the plugin rebuilds the ticks (after a 100 ms pause while it changes).
    callback span-changed(float);
    callback volume-changed(float);
    callback volume-released(float);
    callback toggle-time();
}

// 0.2.14: the previous / next icons (⏮ ⏭), which @vestra/icons.slint does not
// have, drawn in its V-Line style: a bar beside the double V of back / forward,
// round-capped 1.5px lines in a 14×10 box, never filled. Other names: "".
global BarIcons {
    public pure function commands(name: string) -> string {
        if name == "previous" { return "M 1.75 1.25 V 8.75 M 8 1.25 L 4.25 5 L 8 8.75 M 12.5 1.25 L 8.75 5 L 12.5 8.75"; }
        if name == "next" { return "M 12.25 1.25 V 8.75 M 6 1.25 L 9.75 5 L 6 8.75 M 1.5 1.25 L 5.25 5 L 1.5 8.75"; }
        return "";
    }
}

// 41×40 icon button; hover and press light a 32×32 rounded plate in the
// middle of the cell (no dividers between the buttons). `tip` is the tooltip
// (G-07).
component BarButton inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    in property <bool> enabled: true;
    // The bar's own icon (BarIcons), "" for one of @vestra/icons.slint.
    private property <string> own-icon: BarIcons.commands(root.icon);
    callback clicked();
    width: 41px;
    height: 40px;
    accessible-role: button;
    accessible-label: root.icon;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Rectangle {
        x: 4px;
        y: 4px;
        width: parent.width - 9px;
        height: parent.height - 8px;
        border-radius: Theme.radius-panel;
        background: !root.enabled ? transparent
            : touch.pressed ? Theme.press-bg
            : touch.has-hover ? Theme.hover-bg : transparent;
    }
    Icon {
        visible: root.own-icon == "";
        x: (root.width - 1px - self.width) / 2;
        y: (root.height - self.height) / 2;
        name: root.icon;
        color: root.enabled ? Theme.text : Theme.icon-disabled;
    }
    Path {
        visible: root.own-icon != "";
        x: (root.width - 1px - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 14px;
        height: 10px;
        viewbox-width: 14;
        viewbox-height: 10;
        commands: root.own-icon;
        stroke: root.enabled ? Theme.text : Theme.icon-disabled;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    ToolTipArea {
        width: 100%;
        height: 100%;
        text: root.tip;
        touch := TouchArea {
            enabled: root.enabled;
            clicked => { if root.enabled { root.clicked(); } }
        }
    }
}

// Seek line: 2px round-ended line (unplayed Theme.line, played
// Theme.accent-fill), 8px thumb: a white core in a 2px accent ring.
// 0.2.10: the pointer area (hover, preview, press and drag) is the whole 22px
// seek row, as PotPlayer's, from 10px left of the line to 8px before the mute
// button; the drawing is where it was (the line 10px below the row's top).
// Outside the line a press or hover takes its nearer end.
// B22: 1×6 marks across the line (chapter Theme.text-dim, bookmark Theme.accent,
// marker Theme.playing) and the A-B loop: a 2px Theme.playing band under the
// line with 1×8 ends. Marks take no input: a click seeks as before.
// The marks are one Path per kind (a 1 physical px stroke from the plugin's
// commands), never an element per mark. Each tick fills one whole physical
// pixel column and whole pixels top to bottom at any scale factor (125%,
// 150%…), as the snapped 1px Rectangles before 0.2.6 did. Slint fits the
// viewbox into the element less the stroke width and offsets it by half the
// stroke (`Path::fitted_path_events`); the software renderer draws that at
// the element's unrounded physical position. So: the element's left edge on a
// physical pixel (from the seek bar's `absolute-position`), `columns + 1`
// physical px wide over a viewbox `columns` wide (scale 1phx a unit), and x n
// of the commands (a whole number) centres the stroke on that edge + n + 0.5
// physical px: one column. Vertically the element starts half a physical px
// above a pixel row, so the butt-capped tick (viewbox 0…1 over `rows`
// physical px) runs from that row over whole rows: 2px…8px below the line's
// box (`inset-y` above it), as before 0.2.10.
component MarkTicks inherits Path {
    // The seek bar's position in the window, and the line's span in physical px.
    in property <length> origin-x;
    in property <length> origin-y;
    // Where the line's box starts in the seek bar (0.2.10: the pointer band around it).
    in property <length> inset-x;
    in property <length> inset-y;
    in property <int> columns;
    private property <int> rows: Math.round(6px / 1phx);
    x: Math.round((self.origin-x + self.inset-x + 4px) / 1phx) * 1phx - self.origin-x;
    y: Math.round((self.origin-y + self.inset-y + 2px) / 1phx) * 1phx - 0.5phx - self.origin-y;
    width: (self.columns + 1) * 1phx;
    height: (self.rows + 1) * 1phx;
    // The span the commands were built for; while the plugin catches up with a
    // resize, the ticks stretch to the new width for that moment.
    viewbox-width: PlaybackBridge.tick-span > 0 ? PlaybackBridge.tick-span : max(1, self.columns);
    viewbox-height: 1;
    fit: fill;
    stroke-width: 1phx;
}

component SeekBar inherits Rectangle {
    // 0.2.10: the pointer band around the line's 10px box (which the drawing
    // keeps): `lead` left of it, `trail` right of it, `line-top` above it; the band
    // is the seek row's 22px.
    in property <length> lead: 10px;
    in property <length> trail: 12px;
    in property <length> line-top: 6px;
    // 0.2.11 (user request): the pointer band also reaches `reach` above the
    // seek bar, over the bottom of the video (nothing below the row). The
    // player does not clip the bottom bar, and the bar lies in front of the
    // video's own pointer area, so these rows hover, press and drag like the rest.
    in property <length> reach: 4px;
    private property <float> ratio: clamp(PlaybackBridge.progress, 0, 1);
    private property <length> span: max(1px, root.width - root.lead - root.trail - 8px);
    // I06: the pointer is over the click area (or dragging), and the time under it.
    out property <bool> pointing: touch.has-hover || touch.pressed;
    out property <length> pointer-x: touch.mouse-x;
    out property <string> pointer-time: root.clock(root.fraction(touch.mouse-x) * PlaybackBridge.duration);
    // B22: the mark within 3px of the pointer (-1: none).
    out property <int> near-mark: root.pointing ? root.nearest(touch.mouse-x) : -1;
    // I07: the fraction under the pointer; the preview box picks its cell from it.
    out property <float> pointer-fraction: root.fraction(touch.mouse-x);
    changed pointing => { PlaybackBridge.pointing(self.pointing); }
    // B22: the plugin builds the ticks for this span in whole physical pixels
    // (it follows the width and the scale factor).
    private property <int> columns: Math.floor(root.span / 1phx);
    init => { PlaybackBridge.span-changed(root.columns); }
    changed columns => { PlaybackBridge.span-changed(self.columns); }
    // Again when marks come for another span (a report the plugin never got).
    private property <bool> stale-ticks: PlaybackBridge.marks.length > 0 && PlaybackBridge.tick-span != root.columns;
    changed stale-ticks => { if self.stale-ticks { PlaybackBridge.span-changed(root.columns); } }
    height: 22px;
    // The line's fraction under `x` (the band's own x), clamped to the ends.
    function fraction(x: length) -> float {
        return clamp((x - root.lead - 4px) / root.span, 0, 1);
    }
    // `MM:SS`, or `H:MM:SS` from one hour: the same text as the plugin's time labels.
    pure function two-digits(value: int) -> string {
        return (value < 10 ? "0" : "") + value;
    }
    pure function clock(seconds: float) -> string {
        let whole: int = Math.floor(Math.max(0, seconds));
        let s: int = Math.mod(whole, 60);
        let m: int = Math.mod(Math.floor(whole / 60), 60);
        let h: int = Math.floor(whole / 3600);
        return whole >= 3600 ? h + ":" + root.two-digits(m) + ":" + root.two-digits(s) : root.two-digits(m) + ":" + root.two-digits(s);
    }
    // One step of the lower-bound search: the first mark at or after `at` is in [lo, hi].
    pure function narrow(r: MarkRange, at: float) -> MarkRange {
        if r.lo >= r.hi {
            return r;
        }
        let mid: int = Math.floor((r.lo + r.hi) / 2);
        if PlaybackBridge.marks[mid].at < at {
            return { lo: mid + 1, hi: r.hi };
        }
        return { lo: r.lo, hi: mid };
    }
    // 13 steps cover the 4096 marks the plugin sends at most (a range of n rows
    // needs floor(log2 n) + 1 halvings to close; Slint has no loops).
    pure function lower-bound(at: float) -> int {
        let r1 = root.narrow({ lo: 0, hi: PlaybackBridge.marks.length }, at);
        let r2 = root.narrow(r1, at);
        let r3 = root.narrow(r2, at);
        let r4 = root.narrow(r3, at);
        let r5 = root.narrow(r4, at);
        let r6 = root.narrow(r5, at);
        let r7 = root.narrow(r6, at);
        let r8 = root.narrow(r7, at);
        let r9 = root.narrow(r8, at);
        let r10 = root.narrow(r9, at);
        let r11 = root.narrow(r10, at);
        let r12 = root.narrow(r11, at);
        let r13 = root.narrow(r12, at);
        return r13.lo;
    }
    pure function nearest(x: length) -> int {
        let count: int = PlaybackBridge.marks.length;
        if count == 0 || !PlaybackBridge.can-seek {
            return -1;
        }
        let at: float = root.fraction(x);
        let i: int = root.lower-bound(at);
        let right: length = i < count ? Math.abs(PlaybackBridge.marks[i].at - at) * root.span : 1000px;
        let left: length = i > 0 ? Math.abs(PlaybackBridge.marks[i - 1].at - at) * root.span : 1000px;
        if left <= right && left <= 3px {
            return i - 1;
        }
        return right <= 3px ? i : -1;
    }
    // The line's box: `lead`…width - `trail`, `line-top`…`line-top` + 10px.
    Rectangle {
        x: root.lead;
        y: root.line-top + 4px;
        width: root.width - root.lead - root.trail;
        height: 2px;
        border-radius: 1px;
        background: Theme.line;
    }
    Rectangle {
        x: root.lead;
        y: root.line-top + 4px;
        width: 4px + root.ratio * root.span;
        height: 2px;
        border-radius: 1px;
        background: PlaybackBridge.can-seek ? Theme.accent-fill : Theme.icon-disabled;
    }
    if PlaybackBridge.has-loop: Rectangle {
        x: root.lead + 4px + PlaybackBridge.loop-a * root.span;
        y: root.line-top + 6px;
        width: max(1px, (PlaybackBridge.loop-b - PlaybackBridge.loop-a) * root.span);
        height: 2px;
        background: Theme.playing;
    }
    // Chapters under markers under bookmarks (the user's own on top).
    MarkTicks {
        origin-x: root.absolute-position.x;
        origin-y: root.absolute-position.y;
        inset-x: root.lead;
        inset-y: root.line-top;
        columns: root.columns;
        commands: PlaybackBridge.chapter-ticks;
        stroke: Theme.text-dim;
    }
    MarkTicks {
        origin-x: root.absolute-position.x;
        origin-y: root.absolute-position.y;
        inset-x: root.lead;
        inset-y: root.line-top;
        columns: root.columns;
        commands: PlaybackBridge.marker-ticks;
        stroke: Theme.playing;
    }
    MarkTicks {
        origin-x: root.absolute-position.x;
        origin-y: root.absolute-position.y;
        inset-x: root.lead;
        inset-y: root.line-top;
        columns: root.columns;
        commands: PlaybackBridge.bookmark-ticks;
        stroke: Theme.accent;
    }
    if PlaybackBridge.has-loop: Rectangle {
        x: root.lead + Math.floor((4px + PlaybackBridge.loop-a * root.span) / 1px) * 1px;
        y: root.line-top + 1px;
        width: 1px;
        height: 8px;
        background: Theme.playing;
    }
    if PlaybackBridge.has-loop: Rectangle {
        x: root.lead + Math.floor((4px + PlaybackBridge.loop-b * root.span) / 1px) * 1px;
        y: root.line-top + 1px;
        width: 1px;
        height: 8px;
        background: Theme.playing;
    }
    if PlaybackBridge.can-seek: Rectangle {
        x: root.lead + root.ratio * root.span;
        y: root.line-top + 1px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Colors.white;
        border-width: 2px;
        border-color: touch.pressed ? Theme.accent-press : Theme.accent;
    }
    // The whole band: the seek bar's own size and `reach` above it.
    touch := TouchArea {
        x: 0;
        y: -root.reach;
        width: 100%;
        height: root.height + root.reach;
        enabled: PlaybackBridge.can-seek;
        pointer-event(event) => {
            if event.kind == PointerEventKind.cancel {
                PlaybackBridge.seek-cancelled();
            } else if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down {
                    PlaybackBridge.dragging(true);
                    PlaybackBridge.seek-changed(root.fraction(self.mouse-x));
                } else if event.kind == PointerEventKind.up {
                    PlaybackBridge.seek-changed(root.fraction(self.mouse-x));
                    PlaybackBridge.dragging(false);
                }
            }
        }
        moved => { if self.pressed { PlaybackBridge.seek-changed(root.fraction(self.mouse-x)); } }
    }
}

// 13×10 speaker; a cross replaces the waves while muted.
component MuteButton inherits Rectangle {
    width: 13px;
    height: 10px;
    private property <color> icon-color: !PlaybackBridge.can-mute ? Theme.icon-disabled
        : touch.pressed ? Theme.accent-press
        : touch.has-hover ? Theme.accent : Theme.text-dim;
    accessible-role: button;
    accessible-label: PlaybackBridge.muted ? @tr("accessibility" => "Unmute") : @tr("Mute");
    accessible-action-default => { if PlaybackBridge.can-mute { PlaybackBridge.action("mute"); } }
    Icon {
        name: PlaybackBridge.muted ? "mute" : "volume";
        color: root.icon-color;
    }
    ToolTipArea {
        width: 100%;
        height: 100%;
        text: PlaybackBridge.tip-mute;
        touch := TouchArea {
            enabled: PlaybackBridge.can-mute;
            clicked => { PlaybackBridge.action("mute"); }
        }
    }
}

export component PlaybackBar inherits Rectangle {
    min-height: 62px;
    max-height: 62px;
    background: Theme.bg-bar;
    // UI-BAR-10 (SDK 1.6.8): what the button row needs left of the player's
    // strip; the player gives the strip the rest of the width, less 4px.
    out property <length> content-min-width: row.left-width;

    // Seek row: padding 0 10px 0 5px; seek line with 10px margins; mute 13×10; volume 70×10.
    // One hairline separates the bar from the video above.
    seek-row := Rectangle {
        y: 0;
        height: 22px;
        Rectangle { y: 0; height: 1px; background: Theme.line; }
        // 0.2.10: the band is the whole row, x 5px to 8px before the mute
        // button (at width - 97px); the line's box stays at 15px…width - 117px,
        // y 6px…16px.
        seek-bar := SeekBar {
            x: 5px;
            y: 0;
            height: 22px;
            width: max(0px, root.width - 110px);
        }
        MuteButton {
            x: root.width - 97px;
            y: 6px;
        }
        ToolTipArea {
            x: root.width - 80px;
            y: 6px;
            width: 70px;
            height: 10px;
            text: PlaybackBridge.tip-volume;
            // Out of the Tab chain: with Tab unbound (or the default shortcuts
            // ignored), Tab must not land here and turn the arrows from seeking
            // into volume steps. The mouse works as before.
            Slider {
                width: 100%;
                height: 100%;
                focusable: false;
                minimum: 0;
                maximum: 100;
                enabled: PlaybackBridge.can-volume;
                value <=> PlaybackBridge.volume;
                changed(value) => { PlaybackBridge.volume-changed(value); }
                released(value) => { PlaybackBridge.volume-released(value); }
            }
        }
    }

    // Button row: play/pause, stop, previous, next, open, fullscreen, time.
    // The player draws its strip of command buttons at the bar's right end
    // (SDK 1.6.8, menu redesign step 3a): `[plugin buttons…][»][🔍][Sidebar]`,
    // its own cells (`BarButtonsHost.fixed`, 41px each, 4px from the edge)
    // always shown. The bar ends its row left of it and reports what the row
    // needs (`content-min-width`); the strip gets the rest, so plugin buttons
    // never cover the time.
    row := Rectangle {
        y: 22px;
        height: 40px;
        // UI-BAR-10: the time is never covered. As the bar narrows, plugin
        // buttons go to the player's » first; then the bar drops its own less
        // important controls, one step at a time, so the time stays clear of
        // the player's own cells (as responsive players' bars shed controls):
        // Fullscreen, then Stop, then Previous and Next, then Open. Each shows
        // while the controls up to it, the 10px gap, the time, 8px to spare and
        // the player's own cells fit:
        //   Fullscreen from 6 × 41 + 10 + time + 8 + fixed × 41 + 4 px,
        //   Stop from 5 × 41 + …, Previous / Next from 4 × 41 + …,
        //   Open from 2 × 41 + … (Play / Pause always shows).
        // With 🔍 and Sidebar (fixed = 2) and the time measured, not a constant
        // (`0:00:00 / 0:00:00` in the 11px body font is about 85px): Fullscreen
        // from about 435px, Stop from about 394px, Previous / Next from about
        // 353px, Open from about 271px; the time stays clear down to about
        // 230px. The time is at its widest for this file:
        // the elapsed part as wide as "-" + the total (the remaining time), so the
        // thresholds do not move while the time runs (9:59 → 10:00) or when it
        // switches to the remaining time; only an elapsed text wider than that
        // (a source without a duration) widens it. Hidden is `visible: false`
        // with no width, a persistent element, never `if`.
        // None of this reads `BarButtonsHost.width`: the player sizes its
        // strip from `content-min-width`.
        property <length> time-width: max(elapsed.preferred-width, widest-elapsed.preferred-width) + total.preferred-width;
        property <bool> fullscreen-fits: root.width >= 6 * 41px + 10px + row.time-width + 8px + BarButtonsHost.fixed * 41px + 4px;
        property <bool> stop-fits: root.width >= 5 * 41px + 10px + row.time-width + 8px + BarButtonsHost.fixed * 41px + 4px;
        property <bool> skip-fits: root.width >= 4 * 41px + 10px + row.time-width + 8px + BarButtonsHost.fixed * 41px + 4px;
        property <bool> open-fits: root.width >= 2 * 41px + 10px + row.time-width + 8px + BarButtonsHost.fixed * 41px + 4px;
        // The bar's buttons that show: Play / Pause and those that fit.
        property <int> buttons: 1 + (row.stop-fits ? 1 : 0) + (row.skip-fits ? 2 : 0) + (row.open-fits ? 1 : 0) + (row.fullscreen-fits ? 1 : 0);
        // What the left side takes: the buttons that show, the gap, the time
        // and 8px to spare.
        property <length> left-width: row.buttons * 41px + 10px + row.time-width + 8px;
        // Measures the widest elapsed text (never drawn, outside the layout).
        widest-elapsed := Text {
            visible: false;
            text: "-" + PlaybackBridge.total-label;
            font-size: Theme.font-body;
        }
        HorizontalLayout {
            spacing: 0px;
            alignment: start;
            BarButton {
                icon: PlaybackBridge.playing ? "pause" : "play";
                tip: PlaybackBridge.tip-play-pause;
                enabled: PlaybackBridge.can-pause;
                clicked => { PlaybackBridge.action("play-pause"); }
            }
            BarButton {
                visible: row.stop-fits;
                width: row.stop-fits ? 41px : 0px;
                icon: "stop";
                tip: PlaybackBridge.tip-stop;
                enabled: row.stop-fits && PlaybackBridge.can-stop;
                clicked => { PlaybackBridge.action("stop"); }
            }
            // 0.2.14: the playlist's previous / next item, the core Previous / Next
            // actions (PgUp / PgDn), enabled as they are (the playlist decides,
            // with repeat and shuffle).
            BarButton {
                visible: row.skip-fits;
                width: row.skip-fits ? 41px : 0px;
                icon: "previous";
                tip: PlaybackBridge.tip-previous;
                enabled: row.skip-fits && PlaybackBridge.can-previous;
                clicked => { PlaybackBridge.action("previous"); }
            }
            BarButton {
                visible: row.skip-fits;
                width: row.skip-fits ? 41px : 0px;
                icon: "next";
                tip: PlaybackBridge.tip-next;
                enabled: row.skip-fits && PlaybackBridge.can-next;
                clicked => { PlaybackBridge.action("next"); }
            }
            BarButton {
                visible: row.open-fits;
                width: row.open-fits ? 41px : 0px;
                icon: "open";
                tip: PlaybackBridge.tip-open;
                enabled: row.open-fits && PlaybackBridge.can-open;
                clicked => { PlaybackBridge.action("open"); }
            }
            // UI-BAR-05 (0.2.4): toggles fullscreen like the Toggle Fullscreen key, Escape by default (`host.run("fullscreen")`).
            BarButton {
                visible: row.fullscreen-fits;
                // Hidden: not actionable from the accessibility tree either.
                enabled: row.fullscreen-fits;
                width: row.fullscreen-fits ? 41px : 0px;
                icon: PlaybackBridge.fullscreen ? "exit-fullscreen" : "fullscreen";
                tip: PlaybackBridge.tip-fullscreen;
                clicked => { PlaybackBridge.action("fullscreen"); }
            }
            // G-14: only the current time is clickable (hand pointer); the total is not.
            HorizontalLayout {
                padding-left: 10px;
                ToolTipArea {
                    width: elapsed.preferred-width;
                    text: PlaybackBridge.tip-time;
                    elapsed := Text {
                        height: 100%;
                        text: PlaybackBridge.elapsed-label;
                        color: Theme.text;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { PlaybackBridge.toggle-time(); }
                    }
                }
                total := Text {
                    text: " / " + PlaybackBridge.total-label;
                    color: Theme.text-dim;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                }
            }
        }
    }

    // I06 hover time: centred on the pointer, 2px inside the bar's edges, its
    // bottom 4px above the line, so it draws over the video above the bar. It
    // takes no input and follows the pointer without a plugin round trip.
    // B22: within 3px of a mark it reads "Title  01:23" (the mark's time).
    // I07: a 160×90 picture above the text, on hover and while dragging (a dark
    // box until a cell is made): the cell under the pointer, or the nearest
    // made one, cropped from its sheet here, so it follows without a round trip.
    // 0.2.3: the box and its two sheet images are permanent elements shown with
    // `visible:`, never `if`: an element made on pointer enter (and an Image
    // made when the cell crosses from sheet A to B) uploads its 1600×900
    // texture again (about 4 ms on the player's UI thread) and rebuilds the
    // window's accessibility tree. Nothing under the pointer toggles `if` on hover.
    tip := Rectangle {
        visible: (PlaybackBridge.hover-time || PlaybackBridge.hover-thumbnail || seek-bar.near-mark >= 0) && PlaybackBridge.can-seek && PlaybackBridge.duration > 0 && seek-bar.pointing;
        property <bool> picture: PlaybackBridge.hover-thumbnail;
        // 5px at the sides; above: 5px over a picture, 2px over the text alone; 2px between and below.
        x: clamp(seek-bar.x + seek-bar.pointer-x - self.width / 2, 2px, max(2px, root.width - self.width - 2px));
        // 4px above the line (its top at the band's `line-top` + 4px), as before 0.2.10.
        y: seek-bar.y + seek-bar.line-top + 4px - 4px - self.height;
        width: (self.picture ? max(160px, label.preferred-width) : label.preferred-width) + 10px;
        height: (self.picture ? 5px + 90px + 2px : 2px) + label.preferred-height + 2px;
        background: Theme.bg-panel;
        border-color: Theme.line;
        border-width: 1px;
        border-radius: Theme.radius-control;
        preview := Rectangle {
            visible: tip.picture;
            property <int> cell: PlaybackBridge.preview-count <= 0 ? -1
                : PlaybackBridge.preview-map[clamp(Math.floor(seek-bar.pointer-fraction * PlaybackBridge.preview-count), 0, PlaybackBridge.preview-count - 1)];
            property <int> slot: Math.mod(Math.max(self.cell, 0), 100);
            x: (parent.width - self.width) / 2;
            y: 5px;
            width: 160px;
            height: 90px;
            background: Theme.bg-video;
            // One Image per sheet, each shown for its half of the cells.
            Image {
                visible: preview.cell >= 0 && preview.cell < 100;
                width: 160px;
                height: 90px;
                source: PlaybackBridge.preview-sheet-a;
                source-clip-x: Math.mod(preview.slot, 10) * 160;
                source-clip-y: Math.floor(preview.slot / 10) * 90;
                source-clip-width: 160;
                source-clip-height: 90;
                image-fit: contain;
            }
            Image {
                visible: preview.cell >= 100;
                width: 160px;
                height: 90px;
                source: PlaybackBridge.preview-sheet-b;
                source-clip-x: Math.mod(preview.slot, 10) * 160;
                source-clip-y: Math.floor(preview.slot / 10) * 90;
                source-clip-width: 160;
                source-clip-height: 90;
                image-fit: contain;
            }
        }
        label := Text {
            x: 5px;
            y: tip.picture ? 5px + 90px + 2px : 2px;
            width: parent.width - 10px;
            horizontal-alignment: center;
            text: seek-bar.near-mark < 0 ? seek-bar.pointer-time : PlaybackBridge.marks[seek-bar.near-mark].tip;
            color: Theme.text;
            font-size: Theme.font-body;
        }
    }
}

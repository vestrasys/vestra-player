// 打开链接 (A02, UI-DLG-02 "输入链接" window): explanation, the shared
// UrlInputRow (multi-line input + [打开] [取消]), the clipboard option and a
// message line. Enter in the input opens, Shift+Enter starts a new line, Esc cancels.
import { CheckBox } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { UrlInputRow } from "@vestra/widgets.slint";

export component OpenUrlWindow inherits Window {
    in property <string> message;
    in property <bool> busy;
    // The input was filled from the clipboard: select it all when the window opens.
    in property <bool> select-all;
    in-out property <string> value;
    in-out property <bool> paste-from-clipboard: true;
    callback confirm(string);
    callback cancel(string);
    callback paste-changed(bool);
    title: "打开链接";
    width: 464px;
    background: Theme.bg-bar;
    // Esc also cancels while the focus is outside the input (the option, or the busy, disabled input).
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel(root.value);
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: 6px;
            Text {
                text: "在下方输入您需要播放的文件网址。";
                color: Theme.text;
                font-size: Theme.font-body;
                height: Theme.label-height;
            }
            Text {
                text: "例) https://example.com/video.mp4";
                color: Theme.text-dim;
                font-size: Theme.font-body;
                height: Theme.label-height;
            }
            row := UrlInputRow {
                text <=> root.value;
                placeholder: "https://…";
                // While opening: 「正在打开…」, and Enter or the button are ignored.
                enabled: !root.busy;
                confirm-text: root.busy ? "正在打开…" : "打开";
                accepted(text) => { root.confirm(text); }
                cancelled => { root.cancel(root.value); }
            }
            CheckBox {
                height: Theme.checkbox-row-height;
                text: "默认使用剪贴板中可用地址";
                checked <=> root.paste-from-clipboard;
                toggled => { root.paste-changed(self.checked); }
            }
            Text {
                text: root.message;
                color: Theme.text-dim;
                font-size: Theme.font-body;
                min-height: Theme.label-height;
                wrap: word-wrap;
                line-height-factor: 1.25;
            }
        }
    }
    init => {
        row.focus-input();
        if root.select-all { row.select-all(); }
    }
}

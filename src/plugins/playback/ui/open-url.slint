// Open URL (A02, UI-DLG-02 "输入链接" window): explanation, the shared
// UrlInputRow (multi-line input + [Open] [Cancel]), the clipboard option and a
// message line. Enter in the input opens, Shift+Enter starts a new line, Esc cancels.
import { CheckBox } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { UrlInputRow } from "@vestra/widgets.slint";

export component OpenUrlWindow inherits Window {
    // The message line (open-url.ts `UrlNotice`): "", "invalid", "firstLine", "failed".
    in property <string> notice;
    // The player's message for "failed".
    in property <string> detail;
    in property <bool> busy;
    // The input was filled from the clipboard: select it all when the window opens.
    in property <bool> select-all;
    in-out property <string> value;
    in-out property <bool> paste-from-clipboard: true;
    callback confirm(string);
    callback cancel(string);
    callback paste-changed(bool);
    title: @tr("Open URL");
    width: 464px;
    background: Theme.bg-bar;
    // Esc also cancels while the focus is outside the input (the option, or the busy, disabled input).
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel(root.value);
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: 6px;
            Text {
                text: @tr("Enter the address of the file to play below.");
                color: Theme.text;
                font-size: Theme.font-body;
                height: Theme.label-height;
            }
            Text {
                text: @tr("Example: {}", "https://example.com/video.mp4");
                color: Theme.text-dim;
                font-size: Theme.font-body;
                height: Theme.label-height;
            }
            row := UrlInputRow {
                text <=> root.value;
                placeholder: "https://…"; // i18n-ignore: an address, not text
                // While opening: "Opening…", and Enter or the button are ignored.
                enabled: !root.busy;
                confirm-text: root.busy ? @tr("Opening…") : @tr("Open");
                accepted(text) => { root.confirm(text); }
                cancelled => { root.cancel(root.value); }
            }
            CheckBox {
                height: Theme.checkbox-row-height;
                text: @tr("Use an address from the clipboard by default");
                checked <=> root.paste-from-clipboard;
                toggled => { root.paste-changed(self.checked); }
            }
            Text {
                text: root.notice == "invalid" ? @tr("Not a valid link")
                    : root.notice == "firstLine" ? @tr("Only the first line is opened; to open several links, add them to the playlist")
                    : root.notice == "failed" ? @tr("Open failed: {}", root.detail)
                    : "";
                color: Theme.text-dim;
                font-size: Theme.font-body;
                min-height: Theme.label-height;
                wrap: word-wrap;
                line-height-factor: 1.25;
            }
        }
    }
    init => {
        row.focus-input();
        if root.select-all { row.select-all(); }
    }
}

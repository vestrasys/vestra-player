// Seek Steps (B06): four rows of seconds for the relative-seek tiers.
// Each row: label → input (60px) → s → [Default]; an invalid row is marked on
// its right. [OK] [Cancel] at the bottom; Esc cancels, Enter in an input confirms.
import { LineEdit } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button } from "@vestra/widgets.slint";

component StepRow inherits HorizontalLayout {
    in property <string> label;
    in property <bool> invalid;
    in-out property <string> value;
    callback reset();
    callback accepted();
    // The label column (150px, wider for longer translations).
    in property <length> column: 150px;
    spacing: 6px;
    alignment: start;
    Text {
        width: root.column;
        text: root.label;
        color: Theme.text;
        font-size: Theme.font-body;
        vertical-alignment: center;
    }
    LineEdit {
        width: 60px;
        height: Theme.input-height;
        font-size: Theme.font-body;
        text <=> root.value;
        accepted => { root.accepted(); }
    }
    Text {
        // TRANSLATORS: the unit after a number of seconds.
        text: @tr("s");
        color: Theme.text;
        font-size: Theme.font-body;
        vertical-alignment: center;
    }
    Button {
        text: @tr("Default");
        small: true;
        clicked => { root.reset(); }
    }
    Text {
        width: 10px;
        text: root.invalid ? "!" : "";
        color: Theme.accent;
        font-size: Theme.font-body;
        vertical-alignment: center;
    }
}

export component TimeJumpWindow inherits Window {
    // A row is invalid: show the allowed range.
    in property <bool> out-of-range;
    in property <bool> invalid1;
    in property <bool> invalid2;
    in property <bool> invalid3;
    in property <bool> invalid4;
    in-out property <string> value1;
    in-out property <string> value2;
    in-out property <string> value3;
    in-out property <string> value4;
    callback confirm(string, string, string, string);
    callback cancel();
    callback reset(int);
    title: @tr("Seek Steps");
    // 357px, wider only when a longer translated label needs it.
    preferred-width: 357px + root.column - 150px;
    background: Theme.bg-bar;
    // The label column: 150px, or the widest label.
    private property <length> column: max(150px, label-measure.preferred-width);
    Rectangle {
        visible: false;
        width: 0;
        height: 0;
        label-measure := VerticalLayout {
            for text in [@tr("Left/Right arrow keys:"), @tr("Ctrl + Left/Right arrow keys:"), @tr("Shift + Left/Right arrow keys:"), @tr("Ctrl + Alt + Left/Right arrow keys:")]: Text {
                text: text;
                font-size: Theme.font-body;
            }
        }
    }
    function submit() {
        root.confirm(root.value1, root.value2, root.value3, root.value4);
    }
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: 6px;
            Text {
                text: @tr("Set how far each seek key moves during playback.");
                color: Theme.text;
                font-size: Theme.font-body;
                height: Theme.label-height;
            }
            StepRow {
                column: root.column;
                label: @tr("Left/Right arrow keys:");
                invalid: root.invalid1;
                value <=> root.value1;
                reset => { root.reset(0); }
                accepted => { root.submit(); }
            }
            StepRow {
                column: root.column;
                label: @tr("Ctrl + Left/Right arrow keys:");
                invalid: root.invalid2;
                value <=> root.value2;
                reset => { root.reset(1); }
                accepted => { root.submit(); }
            }
            StepRow {
                column: root.column;
                label: @tr("Shift + Left/Right arrow keys:");
                invalid: root.invalid3;
                value <=> root.value3;
                reset => { root.reset(2); }
                accepted => { root.submit(); }
            }
            StepRow {
                column: root.column;
                label: @tr("Ctrl + Alt + Left/Right arrow keys:");
                invalid: root.invalid4;
                value <=> root.value4;
                reset => { root.reset(3); }
                accepted => { root.submit(); }
            }
            Text {
                text: root.out-of-range ? @tr("Range 0.1–3600 s, at most one decimal place") : "";
                color: root.out-of-range ? Theme.accent : Theme.text-dim;
                font-size: Theme.font-body;
                min-height: Theme.label-height;
                wrap: word-wrap;
                line-height-factor: 1.25;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                Button {
                    text: @tr("OK");
                    clicked => { root.submit(); }
                }
                Button {
                    text: @tr("Cancel");
                    clicked => { root.cancel(); }
                }
            }
        }
    }
}

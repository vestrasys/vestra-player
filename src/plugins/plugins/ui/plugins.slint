// 插件管理 (J07): the plugin list (id | 版本 | 来源 | 状态 | 数据), the selected
// plugin's details (label 80 | value), a message line and the buttons.
// 600×420, at least 520×320. Columns: 70 + 70 + 70 + 60 plus four 6px gaps
// and 14px row padding leave the id ≥ 190px at the minimum width; the
// buttons (66 + 66 + 94 + 66 | 82 + 66 and five gaps = 470) fit in 500.
import { ListView } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button, ToolTipArea } from "@vestra/widgets.slint";

export struct PluginRow {
    id: string,
    version: string,
    origin: string,
    state: string,
    size: string,
    dim: bool,
    failed: bool,
    selected: bool,
}

export struct DetailLine {
    label: string,
    text: string,
    warn: bool,
}

component Cell inherits Text {
    font-size: Theme.font-body;
    vertical-alignment: center;
    overflow: elide;
}

component Row inherits Rectangle {
    in property <PluginRow> item;
    callback select();
    private property <color> ink: root.item.dim ? Theme.text-dim : Theme.text-list;
    height: 18px;
    background: root.item.selected ? Theme.selected-bg : transparent;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 10px;
        spacing: 6px;
        Cell { horizontal-stretch: 1; text: root.item.id; color: root.item.dim ? Theme.text-dim : Theme.text; }
        Cell { width: 70px; text: root.item.version; color: root.ink; }
        Cell { width: 70px; text: root.item.origin; color: root.ink; }
        Cell { width: 70px; text: root.item.state; color: root.item.failed ? Theme.accent : root.ink; }
        Cell { width: 60px; text: root.item.size; color: root.ink; horizontal-alignment: right; }
    }
    TouchArea { clicked => { root.select(); } }
}

component Head inherits Cell {
    color: Theme.text-dim;
}

export component PluginsWindow inherits Window {
    title: "插件管理";
    preferred-width: 600px;
    preferred-height: 420px;
    min-width: 520px;
    min-height: 320px;
    background: Theme.bg-panel;

    in property <[PluginRow]> rows;
    in property <bool> has-selection;
    in property <[DetailLine]> details;
    in property <string> toggle-text: "停用";
    in property <bool> can-toggle;
    in property <string> toggle-tip;
    in property <bool> can-reload;
    in property <bool> can-rollback;
    in property <bool> can-uninstall;
    in property <string> uninstall-tip;
    in property <bool> can-open;
    in property <string> message;
    in property <bool> message-warn;
    callback select(string);
    callback toggle();
    callback reload();
    callback rollback();
    callback uninstall();
    callback open-data();
    callback close();

    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        Rectangle {
            vertical-stretch: 1;
            min-height: 110px;
            preferred-height: 220px;
            background: Theme.bg-list;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                padding: 1px;
                HorizontalLayout {
                    height: 18px;
                    padding-left: 4px;
                    padding-right: 10px;
                    spacing: 6px;
                    Head { horizontal-stretch: 1; text: "插件"; }
                    Head { width: 70px; text: "版本"; }
                    Head { width: 70px; text: "来源"; }
                    Head { width: 70px; text: "状态"; }
                    Head { width: 60px; text: "数据"; horizontal-alignment: right; }
                }
                Rectangle { height: 1px; background: Theme.line; }
                ListView {
                    vertical-stretch: 1;
                    for row in root.rows: Row {
                        item: row;
                        select => { root.select(row.id); }
                    }
                }
            }
        }
        // Details: 6 lines of 18px show at once, more scroll.
        Rectangle {
            height: 6 * 18px + 2px;
            background: Theme.bg-list;
            border-width: 1px;
            border-color: Theme.line;
            if !root.has-selection: Cell {
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                color: Theme.text-dim;
                text: "选择一个插件查看详情";
            }
            ListView {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                for line in root.details: HorizontalLayout {
                    height: 18px;
                    padding-left: 6px;
                    padding-right: 10px;
                    spacing: 6px;
                    Cell { width: 80px; text: line.label; color: Theme.text-dim; }
                    // Long paths and failure reasons elide; hovering shows all of it.
                    ToolTipArea {
                        horizontal-stretch: 1;
                        text: line.text;
                        Cell {
                            width: 100%;
                            height: 100%;
                            text: line.text;
                            color: line.warn ? Theme.accent : Theme.text-list;
                        }
                    }
                }
            }
        }
        Cell {
            height: 18px;
            text: root.message;
            color: root.message-warn ? Theme.accent : Theme.text-dim;
        }
        HorizontalLayout {
            height: Theme.button-height;
            spacing: 6px;
            ToolTipArea {
                width: 66px;
                text: root.toggle-tip;
                Button {
                    width: 100%;
                    height: 100%;
                    text: root.toggle-text;
                    enabled: root.can-toggle;
                    clicked => { root.toggle(); }
                }
            }
            Button { horizontal-stretch: 0; text: "重新加载"; enabled: root.can-reload; clicked => { root.reload(); } }
            Button { horizontal-stretch: 0; width: 94px; text: "回退到上一版本"; enabled: root.can-rollback; clicked => { root.rollback(); } }
            ToolTipArea {
                width: 66px;
                text: root.uninstall-tip;
                Button {
                    width: 100%;
                    height: 100%;
                    text: "卸载…";
                    enabled: root.can-uninstall;
                    clicked => { root.uninstall(); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Button { horizontal-stretch: 0; width: 82px; text: "打开数据目录"; enabled: root.can-open; clicked => { root.open-data(); } }
            Button { horizontal-stretch: 0; text: "关闭"; clicked => { root.close(); } }
        }
    }
}

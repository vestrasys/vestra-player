// Plugin Manager (J07) as a page of the options window (category Plugins,
// id plugins.manage): the plugin list (id | Version | Source | Status |
// Data), the selected plugin's details (label 64 | value), a message line
// and the buttons. Width 440: 6px padding and the list border leave 426; row
// padding 3 + 6 and four 4px gaps leave 401, so Version 50 + Source 56 +
// Status 56 + Data 50 give the id ≈ 189. Buttons 66 + 66 + 94 + 66 + 82 and
// four 6px gaps = 398 (Open Data Folder grows when its text is longer).
// Height 436: list (header + 12 rows) 238, details 6 × 18 + 2, message 18,
// buttons 21, gaps and padding 48.
//
// TypeScript passes codes and data (see manager.ts); the words are here.
import { ListView } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button, ToolTipArea } from "@vestra/widgets.slint";

export struct PluginRow {
    id: string,
    version: string,
    origin: string,
    state: string,
    size: string,
    dim: bool,
    failed: bool,
    selected: bool,
}

export struct DetailLine {
    label: string,
    kind: string,
    value: string,
    url: string,
    warn: bool,
}

export struct Message {
    kind: string,
    id: string,
    code: string,
    text: string,
    warn: bool,
}

// Codes → words. An unknown code (a newer player) shows as it is.
global Words {
    public pure function state(code: string) -> string {
        if code == "running" { return @tr("Running"); }
        if code == "starting" { return @tr("Starting"); }
        if code == "disabled" { return @tr("Disabled"); }
        // TRANSLATORS: a plugin's state in the list: it failed to start.
        if code == "failed" { return @tr("plugin state" => "Failed"); }
        if code == "stopped" { return @tr("Stopped"); }
        return code;
    }
    // Where a plugin came from: a source kind, or the origin.
    public pure function source(code: string) -> string {
        if code == "repository" { return @tr("Repository"); }
        if code == "link" { return @tr("Link"); }
        if code == "file" { return @tr("Local file"); }
        if code == "workshop" { return @tr("Plugin Workshop"); }
        if code == "bundled" { return @tr("Built-in"); }
        if code == "installed" { return @tr("Installed"); }
        if code == "development" { return @tr("Development"); }
        return code;
    }
    public pure function capability(id: string) -> string {
        if id == "commands" { return @tr("Menu commands and shortcuts"); }
        if id == "ui.window" { return @tr("Open tool windows"); }
        if id == "ui.mount" { return @tr("Bottom bar and sidebar panels"); }
        if id == "ui.dialog" { return @tr("System dialogs"); }
        if id == "ui.osd" { return @tr("On-screen messages"); }
        if id == "playback.read" { return @tr("Read the playback state"); }
        if id == "events" { return @tr("Receive live state"); }
        if id == "playback.control" { return @tr("Control playback"); }
        if id == "producer.av" { return @tr("Generate audio and video streams"); }
        if id == "processing.video" { return @tr("Process the picture"); }
        if id == "processing.audio" { return @tr("Process the sound"); }
        if id == "subtitles.read" { return @tr("Read subtitles"); }
        if id == "subtitles.control" { return @tr("Control subtitles"); }
        if id == "media.read" { return @tr("Read the picture (snapshots)"); }
        if id == "media.control" { return @tr("Snapshots and export"); }
        if id == "source.resolve" { return @tr("Resolve web addresses"); }
        if id == "plugins.manage" { return @tr("Manage plugins"); }
        if id == "clipboard" { return @tr("Clipboard"); }
        if id == "window.control" { return @tr("Control the main window"); }
        if id == "bindings.manage" { return @tr("Change shortcuts"); }
        return "";
    }
    // A package change's status (uninstall).
    public pure function change(status: string) -> string {
        if status == "preparing" { return @tr("Preparing"); }
        if status == "activating" { return @tr("Activating"); }
        if status == "restoring" { return @tr("Restoring"); }
        if status == "committed" { return @tr("Done"); }
        if status == "cancelled" { return @tr("Cancelled"); }
        // TRANSLATORS: an uninstall did not complete.
        if status == "failed" { return @tr("change status" => "Failed"); }
        if status == "tooLate" { return @tr("Too late to cancel"); }
        return status;
    }
    // A refused package call; `text` is the player's message.
    public pure function failure(code: string, text: string) -> string {
        if code == "self" { return @tr("Plugin Manager cannot disable or uninstall itself"); }
        if code == "development" { return @tr("Development-loaded plugins cannot be uninstalled"); }
        if code == "builtin" { return @tr("Built-in plugins come with the player and cannot be uninstalled or disabled"); }
        if code == "missing" { return @tr("This plugin no longer exists"); }
        if code == "busy" { return @tr("Plugins are being installed or cleaned up, please try again later"); }
        return text;
    }
    // Why a button is off.
    public pure function tip(code: string) -> string {
        if code == "self" { return @tr("Plugin Manager cannot disable itself"); }
        if code == "busy" { return @tr("Updating"); }
        if code == "builtin" { return @tr("Built-in plugins come with the player and cannot be uninstalled or disabled"); }
        if code == "not-installed" { return @tr("Only installed plugins can be uninstalled"); }
        return "";
    }
    // Detail labels; the column is 64px wide.
    public pure function label(code: string) -> string {
        if code == "failure" { return @tr("Error"); }
        if code == "warning" { return @tr("Warning"); }
        if code == "note" { return @tr("Note"); }
        if code == "source" { return @tr("Source"); }
        // TRANSLATORS: detail label: the folder the plugin's package is in.
        if code == "package" { return @tr("Package"); }
        // TRANSLATORS: detail label: the folder with the plugin's settings and data.
        if code == "data" { return @tr("Data folder"); }
        if code == "capabilities" { return @tr("Capabilities"); }
        return code;
    }
    public pure function detail(line: DetailLine) -> string {
        if line.kind == "development" { return @tr("Development load: disabling lasts only for this run; cannot be uninstalled"); }
        if line.kind == "self" { return @tr("Plugin Manager cannot disable itself"); }
        if line.kind == "builtin" { return @tr("Built-in plugin: installed and updated with the player; cannot be uninstalled or disabled"); }
        if line.kind == "unavailable" { return @tr("Unavailable"); }
        if line.kind == "none" { return @tr("(none)"); }
        if line.kind == "source" && line.url != "" && line.value == "repository" { return @tr("Repository ({})", line.url); }
        if line.kind == "source" && line.url != "" && line.value == "link" { return @tr("Link ({})", line.url); }
        if line.kind == "source" { return Words.source(line.value); }
        if line.kind == "capability" && Words.capability(line.value) != "" {
            // TRANSLATORS: a capability id, two spaces, what it lets a plugin do.
            return @tr("{0}  {1}", line.value, Words.capability(line.value));
        }
        return line.value;
    }
    public pure function message(m: Message) -> string {
        if m.kind == "enabled" { return @tr("Enabled {}", m.id); }
        if m.kind == "disabled" { return @tr("Disabled {}", m.id); }
        if m.kind == "reloaded" { return @tr("Reloaded {}", m.id); }
        if m.kind == "uninstalled" { return @tr("Uninstalled {}", m.id); }
        // TRANSLATORS: progress or result of an uninstall: plugin id, status.
        if m.kind == "uninstall" && m.text == "" { return @tr("Uninstall {0}: {1}", m.id, Words.change(m.code)); }
        // TRANSLATORS: plugin id, status, the player's message.
        if m.kind == "uninstall" { return @tr("Uninstall {0}: {1} ({2})", m.id, Words.change(m.code), m.text); }
        if m.kind == "failure" { return Words.failure(m.code, m.text); }
        if m.kind == "list-failed" { return @tr("Cannot read the plugin list: {}", Words.failure(m.code, m.text)); }
        if m.kind == "confirm-failed" { return @tr("Cannot ask for confirmation: {}", m.text); }
        if m.kind == "no-data-folder" { return @tr("The data folder does not exist (the plugin has not saved any settings or data yet)"); }
        if m.kind == "data-folder-failed" { return @tr("Data folder unavailable: {}", m.text); }
        return "";
    }
}

component Cell inherits Text {
    font-size: Theme.font-body;
    vertical-alignment: center;
    overflow: elide;
}

// Column widths: the header and every word the column can show, never under the original
// widths (Version 50, Source 56, Status 56, Data 50); measured in the page (`Columns`).
component Row inherits Rectangle {
    in property <PluginRow> item;
    in property <length> version-width: 50px;
    in property <length> source-width: 56px;
    in property <length> state-width: 56px;
    in property <length> size-width: 50px;
    callback select();
    private property <color> ink: root.item.dim ? Theme.text-dim : Theme.text-list;
    height: 18px;
    background: root.item.selected ? Theme.selected-bg : transparent;
    HorizontalLayout {
        padding-left: 3px;
        padding-right: 6px;
        spacing: 4px;
        Cell { horizontal-stretch: 1; text: root.item.id; color: root.item.dim ? Theme.text-dim : Theme.text; }
        // TRANSLATORS: the version column of a development-loaded plugin (50px wide).
        Cell { width: root.version-width; text: root.item.version == "" ? @tr("Dev") : root.item.version; color: root.ink; }
        Cell { width: root.source-width; text: Words.source(root.item.origin); color: root.ink; }
        Cell { width: root.state-width; text: Words.state(root.item.state); color: root.item.failed ? Theme.accent : root.ink; }
        Cell { width: root.size-width; text: root.item.size; color: root.ink; horizontal-alignment: right; }
    }
    TouchArea { clicked => { root.select(); } }
}

component Head inherits Cell {
    color: Theme.text-dim;
}

export global Plugins {
    in property <[PluginRow]> rows;
    in property <bool> has-selection;
    in property <[DetailLine]> details;
    in property <bool> toggle-enables;
    in property <bool> can-toggle;
    in property <string> toggle-tip;
    in property <bool> can-reload;
    in property <bool> can-uninstall;
    in property <string> uninstall-tip;
    in property <bool> can-open;
    in property <Message> message;
    callback select(string);
    callback toggle();
    callback reload();
    callback uninstall();
    callback open-data();
}

export component PluginsPage inherits Rectangle {
    height: 436px;
    private property <length> version-width: max(50px, version-measure.preferred-width);
    private property <length> source-width: max(56px, source-measure.preferred-width);
    private property <length> state-width: max(56px, state-measure.preferred-width);
    private property <length> size-width: max(50px, size-measure.preferred-width);
    // Detail labels: 64px, or the widest label.
    private property <length> label-width: max(64px, label-measure.preferred-width);
    // Buttons that take a fixed width: at least that, or their label with the button padding.
    private property <length> toggle-width: max(66px, toggle-measure.preferred-width + 2 * Theme.button-padding);
    // The button row is wider than the page (6px padding each side): it takes two rows.
    private property <bool> buttons-wrap: buttons-measure.preferred-width > root.width - 12px;
    Rectangle {
        visible: false;
        width: 0;
        height: 0;
        version-measure := VerticalLayout {
            for text in [@tr("Version"), @tr("Dev")]: Cell { text: text; }
        }
        source-measure := VerticalLayout {
            for code in ["repository", "link", "file", "workshop", "bundled", "installed", "development"]: Cell { text: Words.source(code); }
            Cell { text: @tr("Source"); }
        }
        state-measure := VerticalLayout {
            for code in ["running", "starting", "disabled", "failed", "stopped"]: Cell { text: Words.state(code); }
            Cell { text: @tr("Status"); }
        }
        size-measure := Cell { text: @tr("Data"); }
        label-measure := VerticalLayout {
            for code in ["failure", "warning", "note", "source", "package", "data", "capabilities"]: Cell { text: Words.label(code); }
        }
        buttons-measure := HorizontalLayout {
            spacing: 6px;
            Rectangle { width: root.toggle-width; }
            Button { text: @tr("Reload"); }
            Button { width: max(66px, self.preferred-width); text: @tr("Uninstall…"); }
            Button { min-width: 82px; text: @tr("Open Data Folder"); }
        }
        toggle-measure := VerticalLayout {
            for text in [@tr("Enable"), @tr("Disable")]: Cell { text: text; }
        }
    }

    VerticalLayout {
        padding: 6px;
        spacing: 6px;
        Rectangle {
            vertical-stretch: 1;

            background: Theme.bg-list;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                padding: 1px;
                HorizontalLayout {
                    height: 18px;
                    padding-left: 3px;
                    padding-right: 6px;
                    spacing: 4px;
                    Head { horizontal-stretch: 1; text: @tr("Plugin"); }
                    Head { width: root.version-width; text: @tr("Version"); }
                    Head { width: root.source-width; text: @tr("Source"); }
                    Head { width: root.state-width; text: @tr("Status"); }
                    // TRANSLATORS: column header: the size of the plugin's data folder.
                    Head { width: root.size-width; text: @tr("Data"); horizontal-alignment: right; }
                }
                Rectangle { height: 1px; background: Theme.line; }
                ListView {
                    vertical-stretch: 1;
                    for row in Plugins.rows: Row {
                        item: row;
                        version-width: root.version-width;
                        source-width: root.source-width;
                        state-width: root.state-width;
                        size-width: root.size-width;
                        select => { Plugins.select(row.id); }
                    }
                }
            }
        }
        // Details: 6 lines of 18px show at once, more scroll.
        Rectangle {
            height: 6 * 18px + 2px;
            background: Theme.bg-list;
            border-width: 1px;
            border-color: Theme.line;
            if !Plugins.has-selection: Cell {
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                color: Theme.text-dim;
                text: @tr("Select a plugin to see its details");
            }
            ListView {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                for line in Plugins.details: HorizontalLayout {
                    height: 18px;
                    padding-left: 6px;
                    padding-right: 10px;
                    spacing: 6px;
                    Cell { width: root.label-width; text: Words.label(line.label); color: Theme.text-dim; }
                    // Long paths and failure reasons elide; hovering shows all of it.
                    ToolTipArea {
                        horizontal-stretch: 1;
                        text: Words.detail(line);
                        Cell {
                            width: 100%;
                            height: 100%;
                            text: Words.detail(line);
                            color: line.warn ? Theme.accent : Theme.text-list;
                        }
                    }
                }
            }
        }
        Cell {
            height: 18px;
            text: Words.message(Plugins.message);
            color: Plugins.message.warn ? Theme.accent : Theme.text-dim;
        }
        // One row; Open Data Folder moves to a second row when the translated buttons do not fit.
        HorizontalLayout {
            height: Theme.button-height;
            spacing: 6px;
            ToolTipArea {
                width: root.toggle-width;
                text: Words.tip(Plugins.toggle-tip);
                Button {
                    width: 100%;
                    height: 100%;
                    text: Plugins.toggle-enables ? @tr("Enable") : @tr("Disable");
                    enabled: Plugins.can-toggle;
                    clicked => { Plugins.toggle(); }
                }
            }
            Button { horizontal-stretch: 0; text: @tr("Reload"); enabled: Plugins.can-reload; clicked => { Plugins.reload(); } }
            ToolTipArea {
                width: max(66px, uninstall-button.preferred-width);
                text: Words.tip(Plugins.uninstall-tip);
                uninstall-button := Button {
                    width: 100%;
                    height: 100%;
                    text: @tr("Uninstall…");
                    enabled: Plugins.can-uninstall;
                    clicked => { Plugins.uninstall(); }
                }
            }
            if !root.buttons-wrap: Button { horizontal-stretch: 0; min-width: 82px; text: @tr("Open Data Folder"); enabled: Plugins.can-open; clicked => { Plugins.open-data(); } }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.buttons-wrap: HorizontalLayout {
            height: Theme.button-height;
            Button { horizontal-stretch: 0; min-width: 82px; text: @tr("Open Data Folder"); enabled: Plugins.can-open; clicked => { Plugins.open-data(); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

// 插件管理 (J07) as a page of the options window (category 插件, id
// plugins.manage): the plugin list (id | 版本 | 来源 | 状态 | 数据), the
// selected plugin's details (label 64 | value), a message line and the
// buttons. Width 440: 6px padding and the list border leave 426; row padding
// 3 + 6 and four 4px gaps leave 401, so 版本 50 + 来源 56 + 状态 56 + 数据 50
// give the id ≈ 189. Buttons 66 + 66 + 94 + 66 + 82 and four 6px gaps = 398.
// Height 436: list (header + 12 rows) 238, details 6 × 18 + 2, message 18,
// buttons 21, gaps and padding 48.
import { ListView } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button, ToolTipArea } from "@vestra/widgets.slint";

export struct PluginRow {
    id: string,
    version: string,
    origin: string,
    state: string,
    size: string,
    dim: bool,
    failed: bool,
    selected: bool,
}

export struct DetailLine {
    label: string,
    text: string,
    warn: bool,
}

component Cell inherits Text {
    font-size: Theme.font-body;
    vertical-alignment: center;
    overflow: elide;
}

component Row inherits Rectangle {
    in property <PluginRow> item;
    callback select();
    private property <color> ink: root.item.dim ? Theme.text-dim : Theme.text-list;
    height: 18px;
    background: root.item.selected ? Theme.selected-bg : transparent;
    HorizontalLayout {
        padding-left: 3px;
        padding-right: 6px;
        spacing: 4px;
        Cell { horizontal-stretch: 1; text: root.item.id; color: root.item.dim ? Theme.text-dim : Theme.text; }
        Cell { width: 50px; text: root.item.version; color: root.ink; }
        Cell { width: 56px; text: root.item.origin; color: root.ink; }
        Cell { width: 56px; text: root.item.state; color: root.item.failed ? Theme.accent : root.ink; }
        Cell { width: 50px; text: root.item.size; color: root.ink; horizontal-alignment: right; }
    }
    TouchArea { clicked => { root.select(); } }
}

component Head inherits Cell {
    color: Theme.text-dim;
}

export global Plugins {
    in property <[PluginRow]> rows;
    in property <bool> has-selection;
    in property <[DetailLine]> details;
    in property <string> toggle-text: "停用";
    in property <bool> can-toggle;
    in property <string> toggle-tip;
    in property <bool> can-reload;
    in property <bool> can-rollback;
    in property <bool> can-uninstall;
    in property <string> uninstall-tip;
    in property <bool> can-open;
    in property <string> message;
    in property <bool> message-warn;
    callback select(string);
    callback toggle();
    callback reload();
    callback rollback();
    callback uninstall();
    callback open-data();
}

export component PluginsPage inherits Rectangle {
    height: 436px;

    VerticalLayout {
        padding: 6px;
        spacing: 6px;
        Rectangle {
            vertical-stretch: 1;

            background: Theme.bg-list;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                padding: 1px;
                HorizontalLayout {
                    height: 18px;
                    padding-left: 3px;
                    padding-right: 6px;
                    spacing: 4px;
                    Head { horizontal-stretch: 1; text: "插件"; }
                    Head { width: 50px; text: "版本"; }
                    Head { width: 56px; text: "来源"; }
                    Head { width: 56px; text: "状态"; }
                    Head { width: 50px; text: "数据"; horizontal-alignment: right; }
                }
                Rectangle { height: 1px; background: Theme.line; }
                ListView {
                    vertical-stretch: 1;
                    for row in Plugins.rows: Row {
                        item: row;
                        select => { Plugins.select(row.id); }
                    }
                }
            }
        }
        // Details: 6 lines of 18px show at once, more scroll.
        Rectangle {
            height: 6 * 18px + 2px;
            background: Theme.bg-list;
            border-width: 1px;
            border-color: Theme.line;
            if !Plugins.has-selection: Cell {
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                color: Theme.text-dim;
                text: "选择一个插件查看详情";
            }
            ListView {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                for line in Plugins.details: HorizontalLayout {
                    height: 18px;
                    padding-left: 6px;
                    padding-right: 10px;
                    spacing: 6px;
                    Cell { width: 64px; text: line.label; color: Theme.text-dim; }
                    // Long paths and failure reasons elide; hovering shows all of it.
                    ToolTipArea {
                        horizontal-stretch: 1;
                        text: line.text;
                        Cell {
                            width: 100%;
                            height: 100%;
                            text: line.text;
                            color: line.warn ? Theme.accent : Theme.text-list;
                        }
                    }
                }
            }
        }
        Cell {
            height: 18px;
            text: Plugins.message;
            color: Plugins.message-warn ? Theme.accent : Theme.text-dim;
        }
        HorizontalLayout {
            height: Theme.button-height;
            spacing: 6px;
            ToolTipArea {
                width: 66px;
                text: Plugins.toggle-tip;
                Button {
                    width: 100%;
                    height: 100%;
                    text: Plugins.toggle-text;
                    enabled: Plugins.can-toggle;
                    clicked => { Plugins.toggle(); }
                }
            }
            Button { horizontal-stretch: 0; text: "重新加载"; enabled: Plugins.can-reload; clicked => { Plugins.reload(); } }
            Button { horizontal-stretch: 0; width: 94px; text: "回退到上一版本"; enabled: Plugins.can-rollback; clicked => { Plugins.rollback(); } }
            ToolTipArea {
                width: 66px;
                text: Plugins.uninstall-tip;
                Button {
                    width: 100%;
                    height: 100%;
                    text: "卸载…";
                    enabled: Plugins.can-uninstall;
                    clicked => { Plugins.uninstall(); }
                }
            }
            Button { horizontal-stretch: 0; width: 82px; text: "打开数据目录"; enabled: Plugins.can-open; clicked => { Plugins.open-data(); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

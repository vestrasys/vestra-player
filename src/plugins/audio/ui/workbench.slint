import { Theme } from "@vestra/theme.slint";
import { Icon } from "@vestra/icons.slint";
import { Button, Slider, ToolTipArea } from "@vestra/widgets.slint";

// A row of a drop-down. `kind` "text", "device" and "track" show `text` (data); the other
// kinds are words of this file. A "track" without `text` is "Track {n}" (with its codec);
// `external` and `disconnected` add a note.
struct Row { kind: string, text: string, n: int, codec: string, external: bool, disconnected: bool }

global Words {
    pure public function track(r: Row) -> string {
        if r.text != "" { return r.external ? @tr("{} (external)", r.text) : r.text; }
        if r.codec != "" { return r.external ? @tr("Track {} ({}) (external)", r.n, r.codec) : @tr("Track {} ({})", r.n, r.codec); }
        return r.external ? @tr("Track {} (external)", r.n) : @tr("Track {}", r.n);
    }
    pure public function name(r: Row) -> string {
        return r.kind == "system-default" ? @tr("System Default")
            : r.kind == "unnamed-device" ? @tr("Unnamed device")
            : r.kind == "selected-device" ? @tr("Selected device")
            : r.kind == "no-devices" ? @tr("No output devices available")
            : r.kind == "loading" ? @tr("Loading")
            : r.kind == "no-tracks" ? @tr("No audio tracks")
            : r.kind == "track" ? Words.track(r)
            : r.text;
    }
    // What the drop-down shows for the row.
    pure public function row(r: Row) -> string {
        return r.disconnected ? @tr("{} (not connected)", Words.name(r)) : Words.name(r);
    }
    // The output device's tip: its full name, and why it is not used.
    pure public function device-tip(r: Row) -> string {
        return r.disconnected ? @tr("{}: device not connected, using System Default", Words.name(r)) : Words.name(r);
    }
    pure public function status(state: string) -> string {
        return state == "loading" ? @tr("Loading audio…")
            : state == "no-track" ? @tr("No audio track selected")
            : state == "applying" ? @tr("Applying…")
            : state == "failed" ? @tr("Audio processing failed")
            : state == "applied" ? @tr("Applied")
            : @tr("Ready");
    }
}

// 14px box + 11px text (the panel switch).
component Check {
    in-out property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    callback toggled(bool);
    min-height: Theme.checkbox-row-height;
    accessible-role: checkbox;
    accessible-checked: root.checked;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    HorizontalLayout {
        spacing: 4px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 12px;
                height: 12px;
                background: Theme.bg-bar;
                border-color: !root.enabled ? Theme.icon-disabled : touch.has-hover ? Theme.text-list : Theme.text-dim;
                border-width: 1px;
                if root.checked: Rectangle {
                    width: 6px;
                    height: 6px;
                    background: root.enabled ? Theme.playing : Theme.icon-disabled;
                }
            }
        }
        Text {
            text: root.text;
            color: root.enabled ? Theme.text : Theme.text-dim;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Vertical panel slider 14×70 (EQ bands): 2px line, blue fill from the bottom, 14×12 thumb.
component VSlider {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <bool> enabled: true;
    callback changed(float);
    private property <length> thumb: 12px;
    private property <float> span: max(0.000001, root.maximum - root.minimum);
    private property <float> ratio: clamp((root.value - root.minimum) / root.span, 0, 1);
    width: 14px;
    height: 70px;
    accessible-role: slider;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    function set-from(y: length) {
        root.value = root.maximum - clamp((y - root.thumb / 2) / max(1px, root.height - root.thumb), 0, 1) * root.span;
        root.changed(root.value);
    }
    Rectangle {
        x: (parent.width - 2px) / 2;
        width: 2px;
        background: Theme.bg-bar;
    }
    Rectangle {
        x: (parent.width - 2px) / 2;
        width: 2px;
        height: root.thumb / 2 + root.ratio * (root.height - root.thumb);
        y: parent.height - self.height;
        background: root.enabled ? Theme.playing : Theme.icon-disabled;
    }
    Rectangle {
        y: (1 - root.ratio) * (root.height - root.thumb);
        width: 14px;
        height: root.thumb;
        background: root.enabled ? Theme.text : Theme.icon-disabled;
    }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.set-from(self.mouse-y); }
        }
        moved => { if self.pressed { root.set-from(self.mouse-y); } }
    }
}

// One EQ band in a 23px column: value above, slider, frequency below.
component Band {
    in property <string> caption;
    in property <float> gain;
    in property <bool> available;
    callback edited(float);
    // A drag writes the slider's value and drops the binding; re-push model changes.
    changed gain => { slider.value = root.gain; }
    width: 23px;
    VerticalLayout {
        spacing: 2px;
        Text { text: round(root.gain * 10) / 10; color: Theme.text-list; font-size: Theme.font-xs; horizontal-alignment: center; }
        HorizontalLayout {
            alignment: center;
            slider := VSlider { minimum: -6; maximum: 6; value: root.gain; enabled: root.available; changed(v) => { root.edited(v); } }
        }
        Text { text: root.caption; color: Theme.text-dim; font-size: Theme.font-xs; horizontal-alignment: center; }
    }
}

// Effect row (UI-TOOL-04): label 56 (right, 11px) + panel slider 100 + value 60 + Default 41, 4px apart:
// 269px, inside the 285px the 301px window leaves after its 8px padding ("-10000 ms" needs ~57).
component EffectRow {
    in property <string> label;
    in property <string> shown;
    in property <bool> available;
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    callback edited(float);
    callback reset();
    in property <length> column: 56px;
    height: 24px;
    HorizontalLayout {
        spacing: 4px;
        alignment: start;
        Text { width: root.column; text: root.label; color: root.available ? Theme.text : Theme.text-dim; font-size: Theme.font-body; horizontal-alignment: right; vertical-alignment: center; }
        Slider {
            width: 100px;
            panel: true;
            minimum: root.minimum;
            maximum: root.maximum;
            enabled: root.available;
            value <=> root.value;
            changed(v) => { root.edited(v); }
        }
        Text { width: 60px; text: root.shown; color: Theme.text-list; font-size: Theme.font-body; vertical-alignment: center; }
        VerticalLayout {
            alignment: center;
            Button { width: max(41px, self.preferred-width); text: @tr("Default"); small: true; enabled: root.available; clicked => { root.reset(); } }
        }
    }
}

// One popup row of a Choice: radio dot for the current item, menu-style hover.
component ChoiceItem {
    in property <string> text;
    in property <bool> selected;
    callback picked();
    height: 20px;
    Rectangle { background: touch.has-hover ? Theme.press-bg : transparent; }
    HorizontalLayout {
        padding-left: 5px;
        spacing: 4px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.selected ? Theme.playing : transparent;
            }
        }
        Text {
            text: root.text;
            color: touch.has-hover ? Theme.accent : Theme.text-list;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea { clicked => { root.picked(); } }
}

// Compact 21px drop-down with an 11px label; the list opens below it. `max-rows` > 0 caps
// the list's height (it scrolls with the wheel), so a long list stays inside the window.
component Choice {
    in property <[Row]> model;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    in property <int> max-rows: 0;
    callback selected(int);
    private property <int> rows: root.max-rows > 0 && root.model.length > root.max-rows ? root.max-rows : root.model.length;
    height: 21px;
    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-value: root.current-index >= 0 && root.current-index < root.model.length ? Words.row(root.model[root.current-index]) : "";
    Rectangle {
        border-radius: Theme.radius-control;
        background: !root.enabled ? Theme.button-disabled
            : touch.pressed ? Theme.button-press
            : touch.has-hover ? Theme.button-hover : Theme.button-bg;
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 5px;
        spacing: 2px;
        Text {
            horizontal-stretch: 1;
            text: root.current-index >= 0 && root.current-index < root.model.length ? Words.row(root.model[root.current-index]) : "";
            color: root.enabled ? Theme.text-list : Theme.text-dim;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
        }
        // The drop-down arrow: a small V.
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            Icon { name: "caret-down"; color: root.enabled ? Theme.text-dim : Theme.icon-disabled; }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { list.show(); }
    }
    list := PopupWindow {
        x: 0;
        y: root.height;
        width: root.width;
        height: root.rows * 20px + 2px;
        Rectangle {
            background: Theme.bg-list;
            border-color: Theme.line;
            border-width: 1px;
            Flickable {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                content-height: root.model.length * 20px;
                VerticalLayout {
                    width: root.width - 2px;
                    for item[index] in root.model: ChoiceItem {
                        text: Words.row(item);
                        selected: index == root.current-index;
                        picked => {
                            root.current-index = index;
                            root.selected(index);
                        }
                    }
                }
            }
        }
    }
}

// One 74×31 page tab of the strip (same strip as the playlist sidebar).
component Tab {
    in property <string> text;
    in property <bool> selected;
    callback picked();
    width: max(74px, tab-label.preferred-width + 12px);
    height: 31px;
    accessible-role: tab;
    accessible-label: root.text;
    // Hover lights a rounded plate; the selected tab has a 28px gradient stroke under its label.
    Rectangle {
        x: 3px;
        y: 4px;
        width: parent.width - 6px;
        height: parent.height - 8px;
        border-radius: Theme.radius-control;
        background: !root.selected && touch.has-hover ? Theme.hover-bg : transparent;
    }
    if root.selected: Rectangle {
        x: (parent.width - 28px) / 2;
        y: parent.height - 3px;
        width: 28px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent-fill;
    }
    tab-label := Text {
        text: root.text;
        color: root.selected ? Theme.text : Theme.text-dim;
        font-size: Theme.font-tab;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.picked(); } }
}

// One popup row: radio dot for the current preset, menu-style hover.
component PresetItem {
    in property <string> text;
    in property <bool> selected;
    callback picked();
    height: 22px;
    Rectangle { background: touch.has-hover ? Theme.press-bg : transparent; }
    HorizontalLayout {
        padding-left: 6px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.selected ? Theme.playing : transparent;
            }
        }
        Text {
            text: root.text;
            color: touch.has-hover ? Theme.accent : Theme.text-list;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { clicked => { root.picked(); } }
}

export component AudioWorkbench inherits Window {
    title: @tr("Audio Workbench");
    // 301px, wider only when the content needs it in this language.
    width: max(301px, tab-strip.min-width, max(equalizer-page.min-width, effects-page.min-width, output-page.min-width) + 16px);
    height: 260px;
    background: Theme.bg-panel;
    // "loading", "no-track", "applying", "failed", "applied" or "ready" (Words.status).
    in property <string> status;
    in property <bool> source-ready;
    in property <bool> is-busy;
    in property <bool> has-error;
    in property <string> error-detail;
    in-out property <int> tab-index: 0;
    in property <bool> equalizer-enabled: true;
    in property <int> preset-index: 0;
    in property <[float]> gain-values: [0, 0, 0, 0, 0, 0];
    in property <float> delay-ms;
    in property <bool> normalize-enabled;
    in property <bool> clarity-enabled;
    in property <float> clarity-db: 3;
    in property <int> sync-keep-index: 0;
    in property <[Row]> track-rows: [{ kind: "no-tracks", text: "", n: 0, codec: "", external: false, disconnected: false }];
    in property <int> track-index: 0;
    in property <bool> tracks-available;
    in property <bool> can-load;
    in property <int> channel-index: 0;
    in property <bool> channels-available;
    in property <bool> mono-track;
    in property <bool> auto-load;
    in property <[Row]> device-rows: [{ kind: "system-default", text: "", n: 0, codec: "", external: false, disconnected: false }];
    in property <int> device-index: 0;
    in property <bool> devices-available;
    in property <Row> device-tip;
    callback tab-changed(int);
    callback gain-changed(int, float);
    callback equalizer-changed(bool);
    callback delay-changed(float);
    callback delay-reset();
    callback normalize-changed(bool);
    callback clarity-toggled(bool);
    callback clarity-changed(float);
    callback clarity-reset();
    callback sync-keep-selected(int);
    callback preset-selected(int);
    callback reset-requested();
    callback retry-requested();
    callback track-selected(int);
    callback load-requested();
    callback channel-selected(int);
    callback auto-load-changed(bool);
    callback device-selected(int);
    // The presets of model.ts, in the same order.
    private property <[string]> preset-names: [@tr("Flat"), @tr("Voice"), @tr("Music"), @tr("Cinema")];
    private property <[string]> tab-names: [@tr("Equalizer"), @tr("Effects"), @tr("Output")];
    // Label columns: Effects 56px, Output 65px, or the widest label there (a check adds its 12px box and 4px gap).
    private property <length> effects-column: max(56px, effects-measure.preferred-width, effects-check-measure.preferred-width + 16px);
    private property <length> output-column: max(65px, output-measure.preferred-width);
    // The preset drop-down: 97px, or the widest preset with the button padding and the caret.
    private property <length> preset-width: max(97px, preset-measure.preferred-width + 2 * Theme.button-padding + 12px);
    Rectangle {
        visible: false;
        width: 0;
        height: 0;
        effects-measure := VerticalLayout {
            Text { text: @tr("Audio sync"); font-size: Theme.font-body; }
        }
        effects-check-measure := VerticalLayout {
            for text in [@tr("Normalize"), @tr("Crystalizer")]: Text { text: text; font-size: Theme.font-body; }
        }
        output-measure := VerticalLayout {
            for text in [@tr("Track"), @tr("Channels"), @tr("Device"), @tr("Keep sync")]: Text { text: text; font-size: Theme.font-body; }
        }
        preset-measure := VerticalLayout {
            for text in [@tr("Flat"), @tr("Voice"), @tr("Music"), @tr("Cinema"), @tr("Custom")]: Text { text: text; font-size: Theme.font-body; }
        }
    }
    changed delay-ms => { delay.value = root.delay-ms; }
    changed clarity-db => { clarity.value = root.clarity-db; }
    changed normalize-enabled => { norm.checked = root.normalize-enabled; }
    changed clarity-enabled => { clarity-check.checked = root.clarity-enabled; }
    changed equalizer-enabled => { eq.checked = root.equalizer-enabled; }
    changed sync-keep-index => { keep-combo.current-index = root.sync-keep-index; }
    changed track-index => { track-combo.current-index = root.track-index; }
    changed channel-index => { channel-combo.current-index = root.channel-index; }
    changed auto-load => { auto-check.checked = root.auto-load; }
    changed device-index => { device-combo.current-index = root.device-index; }
    changed device-rows => { device-combo.current-index = root.device-index; }
    VerticalLayout {
        // Page tabs, 31px; the last picked page is remembered by the plugin.
        Rectangle {
            height: 31px;
            background: Theme.bg-bar;
            tab-strip := HorizontalLayout {
                for name[index] in root.tab-names: Tab {
                    text: name;
                    selected: index == root.tab-index;
                    picked => {
                        root.tab-index = index;
                        root.tab-changed(index);
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            Rectangle {
                vertical-stretch: 1;
                equalizer-page := VerticalLayout {
                    x: 0; y: 0; width: parent.width; height: parent.height;
                    visible: root.tab-index == 0;
                    spacing: 6px;
                    HorizontalLayout {
                        height: 22px;
                        spacing: 6px;
                        eq := Check {
                            width: max(82px, self.preferred-width);
                            text: @tr("Equalizer");
                            checked: root.equalizer-enabled;
                            enabled: root.source-ready;
                            toggled(on) => { root.equalizer-changed(on); }
                        }
                        Rectangle {
                            width: root.preset-width;
                            preset-button := Button {
                                width: 100%;
                                height: 100%;
                                enabled: root.source-ready;
                                text: root.preset-index >= 0 ? root.preset-names[root.preset-index] : @tr("Custom");
                                clicked => { presets.show(); }
                            }
                            Icon {
                                x: parent.width - Theme.button-padding - self.width;
                                name: "caret-down";
                                color: root.source-ready ? Theme.text-dim : Theme.icon-disabled;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button { text: @tr("Reset"); small: true; enabled: root.source-ready; clicked => { root.reset-requested(); } }
                        }
                        Rectangle { }
                    }
                    HorizontalLayout {
                        padding-left: 3px;
                        spacing: 0px;
                        for value[index] in root.gain-values: Band {
                            // i18n-ignore: frequencies
                        caption: ["60", "170", "350", "1k", "3.5k", "10k"][index];
                            gain: value;
                            available: root.source-ready;
                            edited(gain) => { root.gain-changed(index, gain); }
                        }
                        VerticalLayout {
                            padding-left: 6px;
                            padding-top: 11px;
                            padding-bottom: 13px;
                            Text { text: "+6 dB"; color: Theme.text-dim; font-size: Theme.font-xs; vertical-alignment: top; } // i18n-ignore: unit
                            Text { text: "0"; color: Theme.text-dim; font-size: Theme.font-xs; vertical-alignment: center; }
                            Text { text: "-6 dB"; color: Theme.text-dim; font-size: Theme.font-xs; vertical-alignment: bottom; } // i18n-ignore: unit
                        }
                        Rectangle { }
                    }
                    Rectangle { }
                }
                effects-page := VerticalLayout {
                    x: 0; y: 0; width: parent.width; height: parent.height;
                    visible: root.tab-index == 1;
                    spacing: 0px;
                    delay := EffectRow {
                        column: root.effects-column;
                        label: @tr("Audio sync");
                        shown: @tr("{} ms", round(root.delay-ms));
                        minimum: -10000;
                        maximum: 10000;
                        value: root.delay-ms;
                        available: root.source-ready;
                        edited(v) => { root.delay-changed(v); }
                        reset => { root.delay-reset(); }
                    }
                    HorizontalLayout {
                        height: 24px;
                        norm := Check {
                            width: root.effects-column;
                            text: @tr("Normalize");
                            checked: root.normalize-enabled;
                            enabled: root.source-ready;
                            toggled(on) => { root.normalize-changed(on); }
                        }
                        Rectangle { }
                    }
                    HorizontalLayout {
                        height: 24px;
                        spacing: 4px;
                        alignment: start;
                        clarity-check := Check {
                            width: root.effects-column;
                            text: @tr("Crystalizer");
                            checked: root.clarity-enabled;
                            enabled: root.source-ready;
                            toggled(on) => { root.clarity-toggled(on); }
                        }
                        // Off keeps the strength but greys the slider out.
                        clarity := Slider {
                            width: 100px;
                            panel: true;
                            minimum: 0;
                            maximum: 6;
                            value: root.clarity-db;
                            enabled: root.source-ready && root.clarity-enabled;
                            changed(v) => { root.clarity-changed(v); }
                        }
                        Text { width: 60px; text: @tr("{} dB", round(root.clarity-db * 10) / 10); color: root.clarity-enabled ? Theme.text-list : Theme.text-dim; font-size: Theme.font-body; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Button { width: max(41px, self.preferred-width); text: @tr("Default"); small: true; enabled: root.source-ready; clicked => { root.clarity-reset(); } }
                        }
                    }
                    Rectangle { }
                }
                output-page := VerticalLayout {
                    x: 0; y: 0; width: parent.width; height: parent.height;
                    visible: root.tab-index == 2;
                    spacing: 4px;
                    // Track (G03) + Load… (A11): 65 + 6 + 140 + 6 + 50 = 267 of 285.
                    track-row := HorizontalLayout {
                        height: 24px;
                        spacing: 6px;
                        alignment: start;
                        Text { width: root.output-column; text: @tr("Track"); color: Theme.text; font-size: Theme.font-body; horizontal-alignment: right; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            track-combo := Choice {
                                width: 140px;
                                enabled: root.tracks-available;
                                model: root.track-rows;
                                current-index: root.track-index;
                                selected(i) => { root.track-selected(i); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button { width: max(50px, self.preferred-width); text: @tr("Load…"); small: true; enabled: root.can-load; clicked => { root.load-requested(); } }
                        }
                    }
                    // Channels (G05): 65 + 6 + 140 = 211.
                    ToolTipArea {
                        height: 24px;
                        text: root.mono-track ? @tr("The current track is mono") : "";
                        channel-row := HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text { width: root.output-column; text: @tr("Channels"); color: root.channels-available ? Theme.text : Theme.text-dim; font-size: Theme.font-body; horizontal-alignment: right; vertical-alignment: center; }
                            VerticalLayout {
                                alignment: center;
                                channel-combo := Choice {
                                    width: 140px;
                                    enabled: root.channels-available;
                                    // The channel modes of model.ts, in the same order.
                                    model: [
                                        { kind: "text", text: @tr("Stereo") },
                                        { kind: "text", text: @tr("Left Channel") },
                                        { kind: "text", text: @tr("Right Channel") },
                                        { kind: "text", text: @tr("Mono Mix") },
                                        { kind: "text", text: @tr("Swap Left and Right") },
                                    ];
                                    current-index: root.channel-index;
                                    selected(i) => { root.channel-selected(i); }
                                }
                            }
                        }
                    }
                    // Output device (G16): 65 + 6 + 200 = 271 of 285; the full name on hover. The list
                    // opens at y ≈ 117 of 260, so 7 rows (142) fit below; longer lists scroll.
                    ToolTipArea {
                        height: 24px;
                        text: Words.device-tip(root.device-tip);
                        device-row := HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text { width: root.output-column; text: @tr("Device"); color: root.devices-available ? Theme.text : Theme.text-dim; font-size: Theme.font-body; horizontal-alignment: right; vertical-alignment: center; }
                            VerticalLayout {
                                alignment: center;
                                device-combo := Choice {
                                    width: 200px;
                                    max-rows: 7;
                                    enabled: root.devices-available;
                                    model: root.device-rows;
                                    current-index: root.device-index;
                                    selected(i) => { root.device-selected(i); }
                                }
                            }
                        }
                    }
                    // Auto-load (A11): indented to the controls, 71 + check.
                    HorizontalLayout {
                        height: 24px;
                        padding-left: root.output-column + 6px;
                        auto-check := Check {
                            text: @tr("Auto-load audio files with the same name");
                            checked: root.auto-load;
                            toggled(on) => { root.auto-load-changed(on); }
                        }
                    }
                    keep-row := HorizontalLayout {
                        height: 24px;
                        spacing: 6px;
                        Text { width: root.output-column; text: @tr("Keep sync"); color: Theme.text; font-size: Theme.font-body; horizontal-alignment: right; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            keep-combo := Choice {
                                width: 140px;
                                // The keep modes of model.ts, in the same order.
                                model: [
                                    { kind: "text", text: @tr("Don't Keep") },
                                    { kind: "text", text: @tr("Keep for This Run") },
                                    { kind: "text", text: @tr("Always Keep") },
                                ];
                                current-index: root.sync-keep-index;
                                selected(i) => { root.sync-keep-selected(i); }
                            }
                        }
                        Rectangle { }
                    }
                    Rectangle { }
                }
            }
            HorizontalLayout {
                height: 20px;
                spacing: 6px;
                ToolTipArea {
                    text: root.error-detail;
                    Text {
                        text: Words.status(root.status);
                        color: root.has-error ? Theme.accent : Theme.text-dim;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if root.has-error: VerticalLayout {
                    alignment: center;
                    Button { text: @tr("Retry"); small: true; enabled: !root.is-busy; clicked => { root.retry-requested(); } }
                }
            }
        }
    }
    presets := PopupWindow {
        x: preset-button.absolute-position.x - root.absolute-position.x;
        y: preset-button.absolute-position.y - root.absolute-position.y + preset-button.height;
        width: preset-button.width;
        Rectangle {
            background: Theme.bg-list;
            border-color: Theme.line;
            border-width: 1px;
            VerticalLayout {
                padding: 1px;
                for name[index] in root.preset-names: PresetItem {
                    text: name;
                    selected: index == root.preset-index;
                    picked => { root.preset-selected(index); }
                }
                Rectangle { height: 7px; Rectangle { height: 1px; background: Theme.line; } }
                PresetItem { text: @tr("Default"); picked => { root.reset-requested(); } }
            }
        }
    }
}

import { Theme } from "@vestra/theme.slint";
import { Button, Slider, ToolTipArea } from "@vestra/widgets.slint";

// 14px box + 11px text (reference player panel switch).
component Check {
    in-out property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    callback toggled(bool);
    min-height: Theme.checkbox-row-height;
    accessible-role: checkbox;
    accessible-checked: root.checked;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    HorizontalLayout {
        spacing: 4px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 12px;
                height: 12px;
                background: Theme.bg-bar;
                border-color: !root.enabled ? Theme.icon-disabled : touch.has-hover ? Theme.text-list : Theme.text-dim;
                border-width: 1px;
                if root.checked: Rectangle {
                    width: 6px;
                    height: 6px;
                    background: root.enabled ? Theme.playing : Theme.icon-disabled;
                }
            }
        }
        Text {
            text: root.text;
            color: root.enabled ? Theme.text : Theme.text-dim;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Vertical panel slider 14×70 (reference player EQ): 2px line, blue fill from the bottom, 14×12 thumb.
component VSlider {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <bool> enabled: true;
    callback changed(float);
    private property <length> thumb: 12px;
    private property <float> span: max(0.000001, root.maximum - root.minimum);
    private property <float> ratio: clamp((root.value - root.minimum) / root.span, 0, 1);
    width: 14px;
    height: 70px;
    accessible-role: slider;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    function set-from(y: length) {
        root.value = root.maximum - clamp((y - root.thumb / 2) / max(1px, root.height - root.thumb), 0, 1) * root.span;
        root.changed(root.value);
    }
    Rectangle {
        x: (parent.width - 2px) / 2;
        width: 2px;
        background: Theme.bg-bar;
    }
    Rectangle {
        x: (parent.width - 2px) / 2;
        width: 2px;
        height: root.thumb / 2 + root.ratio * (root.height - root.thumb);
        y: parent.height - self.height;
        background: root.enabled ? Theme.playing : Theme.icon-disabled;
    }
    Rectangle {
        y: (1 - root.ratio) * (root.height - root.thumb);
        width: 14px;
        height: root.thumb;
        background: root.enabled ? Theme.text : Theme.icon-disabled;
    }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.set-from(self.mouse-y); }
        }
        moved => { if self.pressed { root.set-from(self.mouse-y); } }
    }
}

// One EQ band in a 23px column: value above, slider, frequency below.
component Band {
    in property <string> caption;
    in property <float> gain;
    in property <bool> available;
    callback edited(float);
    // A drag writes the slider's value and drops the binding; re-push model changes.
    changed gain => { slider.value = root.gain; }
    width: 23px;
    VerticalLayout {
        spacing: 2px;
        Text { text: round(root.gain * 10) / 10; color: Theme.text-list; font-size: Theme.font-xs; horizontal-alignment: center; }
        HorizontalLayout {
            alignment: center;
            slider := VSlider { minimum: -6; maximum: 6; value: root.gain; enabled: root.available; changed(v) => { root.edited(v); } }
        }
        Text { text: root.caption; color: Theme.text-dim; font-size: Theme.font-xs; horizontal-alignment: center; }
    }
}

// Effect row (UI-TOOL-04): label 56 (right, 11px) + panel slider 100 + value 60 + 默认 41, 4px apart:
// 269px, inside the 285px the 301px window leaves after its 8px padding ("-10000 ms" needs ~57).
component EffectRow {
    in property <string> label;
    in property <string> shown;
    in property <bool> available;
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    callback edited(float);
    callback reset();
    height: 24px;
    HorizontalLayout {
        spacing: 4px;
        alignment: start;
        Text { width: 56px; text: root.label; color: root.available ? Theme.text : Theme.text-dim; font-size: Theme.font-body; horizontal-alignment: right; vertical-alignment: center; }
        Slider {
            width: 100px;
            panel: true;
            minimum: root.minimum;
            maximum: root.maximum;
            enabled: root.available;
            value <=> root.value;
            changed(v) => { root.edited(v); }
        }
        Text { width: 60px; text: root.shown; color: Theme.text-list; font-size: Theme.font-body; vertical-alignment: center; }
        VerticalLayout {
            alignment: center;
            Button { width: 41px; text: "默认"; small: true; enabled: root.available; clicked => { root.reset(); } }
        }
    }
}

// One popup row of a Choice: radio dot for the current item, menu-style hover.
component ChoiceItem {
    in property <string> text;
    in property <bool> selected;
    callback picked();
    height: 20px;
    Rectangle { background: touch.has-hover ? Theme.press-bg : transparent; }
    HorizontalLayout {
        padding-left: 5px;
        spacing: 4px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.selected ? Theme.playing : transparent;
            }
        }
        Text {
            text: root.text;
            color: touch.has-hover ? Theme.accent : Theme.text-list;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea { clicked => { root.picked(); } }
}

// Compact 21px drop-down with an 11px label; the list opens below it (short lists only,
// so it stays inside the window).
component Choice {
    in property <[string]> model;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    callback selected(int);
    height: 21px;
    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-value: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
    Rectangle {
        border-radius: Theme.radius-control;
        background: !root.enabled ? Theme.button-disabled
            : touch.pressed ? Theme.button-press
            : touch.has-hover ? Theme.button-hover : Theme.button-bg;
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 5px;
        spacing: 2px;
        Text {
            horizontal-stretch: 1;
            text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
            color: root.enabled ? Theme.text-list : Theme.text-dim;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
        }
        Text { text: "▾"; color: root.enabled ? Theme.text-dim : Theme.icon-disabled; font-size: Theme.font-body; vertical-alignment: center; }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { list.show(); }
    }
    list := PopupWindow {
        x: 0;
        y: root.height;
        width: root.width;
        Rectangle {
            background: Theme.bg-list;
            border-color: Theme.line;
            border-width: 1px;
            VerticalLayout {
                padding: 1px;
                for name[index] in root.model: ChoiceItem {
                    text: name;
                    selected: index == root.current-index;
                    picked => {
                        root.current-index = index;
                        root.selected(index);
                    }
                }
            }
        }
    }
}

// One 74×31 page tab of the strip (same strip as the playlist sidebar).
component Tab {
    in property <string> text;
    in property <bool> selected;
    callback picked();
    width: 74px;
    height: 31px;
    accessible-role: tab;
    accessible-label: root.text;
    Rectangle { background: root.selected ? Theme.bg-panel : touch.has-hover ? Theme.hover-bg : transparent; }
    Text {
        text: root.text;
        color: root.selected ? Theme.text : Theme.text-dim;
        font-size: Theme.font-tab;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.picked(); } }
}

// One popup row: radio dot for the current preset, menu-style hover.
component PresetItem {
    in property <string> text;
    in property <bool> selected;
    callback picked();
    height: 22px;
    Rectangle { background: touch.has-hover ? Theme.press-bg : transparent; }
    HorizontalLayout {
        padding-left: 6px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.selected ? Theme.playing : transparent;
            }
        }
        Text {
            text: root.text;
            color: touch.has-hover ? Theme.accent : Theme.text-list;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { clicked => { root.picked(); } }
}

export component AudioWorkbench inherits Window {
    title: "音频工作台";
    width: 301px;
    height: 260px;
    background: Theme.bg-panel;
    in property <string> status-text;
    in property <bool> source-ready;
    in property <bool> is-busy;
    in property <bool> has-error;
    in property <string> error-detail;
    in-out property <int> tab-index: 0;
    in property <bool> equalizer-enabled: true;
    in property <int> preset-index: 0;
    in property <[float]> gain-values: [0, 0, 0, 0, 0, 0];
    in property <float> delay-ms;
    in property <bool> normalize-enabled;
    in property <bool> clarity-enabled;
    in property <float> clarity-db: 3;
    in property <int> sync-keep-index: 0;
    in property <[string]> track-names: ["没有音轨"];
    in property <int> track-index: 0;
    in property <bool> tracks-available;
    in property <bool> can-load;
    in property <int> channel-index: 0;
    in property <bool> channels-available;
    in property <string> channel-tip;
    in property <bool> auto-load;
    in property <string> devices-tip;
    callback tab-changed(int);
    callback gain-changed(int, float);
    callback equalizer-changed(bool);
    callback delay-changed(float);
    callback delay-reset();
    callback normalize-changed(bool);
    callback clarity-toggled(bool);
    callback clarity-changed(float);
    callback clarity-reset();
    callback sync-keep-selected(int);
    callback preset-selected(int);
    callback reset-requested();
    callback retry-requested();
    callback track-selected(int);
    callback load-requested();
    callback channel-selected(int);
    callback auto-load-changed(bool);
    private property <[string]> preset-names: ["平直", "人声", "音乐", "影院"];
    private property <[string]> tab-names: ["均衡器", "效果", "声道与输出"];
    changed delay-ms => { delay.value = root.delay-ms; }
    changed clarity-db => { clarity.value = root.clarity-db; }
    changed normalize-enabled => { norm.checked = root.normalize-enabled; }
    changed clarity-enabled => { clarity-check.checked = root.clarity-enabled; }
    changed equalizer-enabled => { eq.checked = root.equalizer-enabled; }
    changed sync-keep-index => { keep-combo.current-index = root.sync-keep-index; }
    changed track-index => { track-combo.current-index = root.track-index; }
    changed channel-index => { channel-combo.current-index = root.channel-index; }
    changed auto-load => { auto-check.checked = root.auto-load; }
    VerticalLayout {
        // Page tabs, 31px; the last picked page is remembered by the plugin.
        Rectangle {
            height: 31px;
            background: Theme.bg-bar;
            HorizontalLayout {
                for name[index] in root.tab-names: Tab {
                    text: name;
                    selected: index == root.tab-index;
                    picked => {
                        root.tab-index = index;
                        root.tab-changed(index);
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            Rectangle {
                vertical-stretch: 1;
                VerticalLayout {
                    x: 0; y: 0; width: parent.width; height: parent.height;
                    visible: root.tab-index == 0;
                    spacing: 6px;
                    HorizontalLayout {
                        height: 22px;
                        spacing: 6px;
                        eq := Check {
                            width: 82px;
                            text: "均衡器";
                            checked: root.equalizer-enabled;
                            enabled: root.source-ready;
                            toggled(on) => { root.equalizer-changed(on); }
                        }
                        preset-button := Button {
                            width: 97px;
                            enabled: root.source-ready;
                            text: (root.preset-index >= 0 ? root.preset-names[root.preset-index] : "自定义") + " ▾";
                            clicked => { presets.show(); }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button { text: "复位"; small: true; enabled: root.source-ready; clicked => { root.reset-requested(); } }
                        }
                        Rectangle { }
                    }
                    HorizontalLayout {
                        padding-left: 3px;
                        spacing: 0px;
                        for value[index] in root.gain-values: Band {
                            caption: ["60", "170", "350", "1k", "3.5k", "10k"][index];
                            gain: value;
                            available: root.source-ready;
                            edited(gain) => { root.gain-changed(index, gain); }
                        }
                        VerticalLayout {
                            padding-left: 6px;
                            padding-top: 11px;
                            padding-bottom: 13px;
                            Text { text: "+6 dB"; color: Theme.text-dim; font-size: Theme.font-xs; vertical-alignment: top; }
                            Text { text: "0"; color: Theme.text-dim; font-size: Theme.font-xs; vertical-alignment: center; }
                            Text { text: "-6 dB"; color: Theme.text-dim; font-size: Theme.font-xs; vertical-alignment: bottom; }
                        }
                        Rectangle { }
                    }
                    Rectangle { }
                }
                VerticalLayout {
                    x: 0; y: 0; width: parent.width; height: parent.height;
                    visible: root.tab-index == 1;
                    spacing: 0px;
                    delay := EffectRow {
                        label: "声音同步";
                        shown: round(root.delay-ms) + " ms";
                        minimum: -10000;
                        maximum: 10000;
                        value: root.delay-ms;
                        available: root.source-ready;
                        edited(v) => { root.delay-changed(v); }
                        reset => { root.delay-reset(); }
                    }
                    HorizontalLayout {
                        height: 24px;
                        norm := Check {
                            width: 56px;
                            text: "规格化";
                            checked: root.normalize-enabled;
                            enabled: root.source-ready;
                            toggled(on) => { root.normalize-changed(on); }
                        }
                        Rectangle { }
                    }
                    HorizontalLayout {
                        height: 24px;
                        spacing: 4px;
                        alignment: start;
                        clarity-check := Check {
                            width: 56px;
                            text: "晶化";
                            checked: root.clarity-enabled;
                            enabled: root.source-ready;
                            toggled(on) => { root.clarity-toggled(on); }
                        }
                        // Off keeps the strength but greys the slider out.
                        clarity := Slider {
                            width: 100px;
                            panel: true;
                            minimum: 0;
                            maximum: 6;
                            value: root.clarity-db;
                            enabled: root.source-ready && root.clarity-enabled;
                            changed(v) => { root.clarity-changed(v); }
                        }
                        Text { width: 60px; text: round(root.clarity-db * 10) / 10 + " dB"; color: root.clarity-enabled ? Theme.text-list : Theme.text-dim; font-size: Theme.font-body; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Button { width: 41px; text: "默认"; small: true; enabled: root.source-ready; clicked => { root.clarity-reset(); } }
                        }
                    }
                    Rectangle { }
                }
                VerticalLayout {
                    x: 0; y: 0; width: parent.width; height: parent.height;
                    visible: root.tab-index == 2;
                    spacing: 4px;
                    // 音轨 (G03) + 载入… (A11): 65 + 6 + 140 + 6 + 50 = 267 of 285.
                    HorizontalLayout {
                        height: 24px;
                        spacing: 6px;
                        alignment: start;
                        Text { width: 65px; text: "音轨"; color: Theme.text; font-size: Theme.font-body; horizontal-alignment: right; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            track-combo := Choice {
                                width: 140px;
                                enabled: root.tracks-available;
                                model: root.track-names;
                                current-index: root.track-index;
                                selected(i) => { root.track-selected(i); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button { width: 50px; text: "载入…"; small: true; enabled: root.can-load; clicked => { root.load-requested(); } }
                        }
                    }
                    // 声道 (G05): 65 + 6 + 140 = 211.
                    ToolTipArea {
                        height: 24px;
                        text: root.channel-tip;
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text { width: 65px; text: "声道"; color: root.channels-available ? Theme.text : Theme.text-dim; font-size: Theme.font-body; horizontal-alignment: right; vertical-alignment: center; }
                            VerticalLayout {
                                alignment: center;
                                channel-combo := Choice {
                                    width: 140px;
                                    enabled: root.channels-available;
                                    model: ["立体声", "左声道", "右声道", "单声道混合", "左右互换"];
                                    current-index: root.channel-index;
                                    selected(i) => { root.channel-selected(i); }
                                }
                            }
                        }
                    }
                    // 输出设备 (G16, later round): 65 + 6 + 190 = 261, greyed with the reason on hover.
                    ToolTipArea {
                        height: 24px;
                        text: root.devices-tip;
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text { width: 65px; text: "输出设备"; color: Theme.text-dim; font-size: Theme.font-body; horizontal-alignment: right; vertical-alignment: center; }
                            VerticalLayout {
                                alignment: center;
                                Choice { width: 190px; enabled: false; model: ["系统默认"]; current-index: 0; }
                            }
                        }
                    }
                    // 自动载入 (A11): indented to the controls, 71 + check.
                    HorizontalLayout {
                        height: 24px;
                        padding-left: 71px;
                        auto-check := Check {
                            text: "自动载入同名音频文件";
                            checked: root.auto-load;
                            toggled(on) => { root.auto-load-changed(on); }
                        }
                    }
                    HorizontalLayout {
                        height: 24px;
                        spacing: 6px;
                        Text { width: 65px; text: "同步保持"; color: Theme.text; font-size: Theme.font-body; horizontal-alignment: right; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            keep-combo := Choice {
                                width: 140px;
                                model: ["不保持", "本次运行内保持", "始终保持"];
                                current-index: root.sync-keep-index;
                                selected(i) => { root.sync-keep-selected(i); }
                            }
                        }
                        Rectangle { }
                    }
                    Rectangle { }
                }
            }
            HorizontalLayout {
                height: 20px;
                spacing: 6px;
                ToolTipArea {
                    text: root.error-detail;
                    Text {
                        text: root.status-text;
                        color: root.has-error ? Theme.accent : Theme.text-dim;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if root.has-error: VerticalLayout {
                    alignment: center;
                    Button { text: "重试"; small: true; enabled: !root.is-busy; clicked => { root.retry-requested(); } }
                }
            }
        }
    }
    presets := PopupWindow {
        x: preset-button.absolute-position.x - root.absolute-position.x;
        y: preset-button.absolute-position.y - root.absolute-position.y + preset-button.height;
        width: preset-button.width;
        Rectangle {
            background: Theme.bg-list;
            border-color: Theme.line;
            border-width: 1px;
            VerticalLayout {
                padding: 1px;
                for name[index] in root.preset-names: PresetItem {
                    text: name;
                    selected: index == root.preset-index;
                    picked => { root.preset-selected(index); }
                }
                Rectangle { height: 7px; Rectangle { height: 1px; background: Theme.line; } }
                PresetItem { text: "默认"; picked => { root.reset-requested(); } }
            }
        }
    }
}

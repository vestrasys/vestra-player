import { Theme } from "@vestra/theme.slint";
import { Button, ToolTipArea } from "@vestra/widgets.slint";

export component NesWindow inherits Window {
    title: "NES";
    width: 320px;
    height: 71px;
    background: Theme.bg-panel;
    in property <string> status: "请选择 iNES ROM 文件。";
    in property <bool> running: false;
    callback open-rom();
    callback stop();
    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: 8px;
        // One line; the full text is in the tooltip.
        ToolTipArea {
            height: Theme.label-height;
            text: root.status;
            Text {
                text: root.status;
                color: Theme.text-list;
                font-size: Theme.font-body;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Rectangle { horizontal-stretch: 1; }
            Button { text: "打开 ROM…"; clicked => { root.open-rom(); } }
            Button { text: "停止"; enabled: root.running; clicked => { root.stop(); } }
        }
    }
}

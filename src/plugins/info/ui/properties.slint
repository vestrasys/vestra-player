// Playback Properties (I05): three read-only pages. Texts are @tr (English source;
// locales/<lang>.po translate them); the rows are data from main.ts.
// Widths at the minimum window width 400 (content 380 after the 10px side padding):
//   tab strip       3 × 74                                              = 222 of 400
//   table row       label 120 + 8 + value ≥ 240 (scroll bar 12 inside)  = 380
//   button row      status ≥ 50 + Refresh 66 + Copy 84 + Save As… 66 + Close 66 + 4 × 4 = 348 of 380
// Height at the minimum 320: tabs 31 + 10 + table ≥ 237 + 10 + buttons 21 + 10 = 319.
import { ListView, Palette } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button, Tabs } from "@vestra/widgets.slint";

export struct PropertyRow {
    label: string,
    value: string,
    heading: bool,
}

export component PropertiesWindow inherits Window {
    title: @tr("Playback Properties");
    preferred-width: 460px;
    preferred-height: 420px;
    min-width: 400px;
    min-height: 320px;
    background: Theme.bg-panel;
    in-out property <int> tab-index: 0;
    in property <[PropertyRow]> rows;
    // The page's widest label (dialog.ts picks it, properties.ts `widestLabel`); "" = none.
    in property <string> label-sample;
    // "", "copy-failed", or "save-failed" with the reason in status-detail.
    in property <string> status;
    in property <string> status-detail;
    in property <bool> can-refresh;
    callback tab-changed(int);
    callback refresh();
    callback copy-page();
    callback save-page();
    callback close-window();
    private property <[string]> tab-names: [@tr("tab" => "Playback"), @tr("tab" => "File"), @tr("tab" => "System")];
    // The label column: 120px, or the page's widest label. Only that one label is laid out
    // here; the list builds the rows in view.
    private property <length> label-width: max(120px, label-measure.preferred-width);
    Rectangle {
        visible: false;
        width: 0;
        height: 0;
        label-measure := Text { text: root.label-sample; font-size: Theme.font-body; }
    }

    VerticalLayout {
        Tabs {
            model: root.tab-names;
            current-index <=> root.tab-index;
            selected(index) => { root.tab-changed(index); }
        }
        VerticalLayout {
            padding: 10px;
            spacing: 10px;
            Rectangle {
                vertical-stretch: 1;
                background: Theme.bg-list;
                border-width: 1px;
                border-color: Theme.line;
                // Rows differ in height (a value wraps); 6px around the list, 2px between rows.
                ListView {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    for row[index] in root.rows: VerticalLayout {
                        padding-left: 6px;
                        padding-right: 8px;
                        padding-top: index == 0 ? 6px : 0px;
                        padding-bottom: index == root.rows.length - 1 ? 6px : 2px;
                        if row.heading: Text {
                            height: 20px;
                            text: row.label;
                            color: Theme.text;
                            font-size: Theme.font-body;
                            font-weight: 700;
                            vertical-alignment: bottom;
                        }
                        if !row.heading: HorizontalLayout {
                            spacing: row.label == "" ? 0px : 8px;
                            Text {
                                width: row.label == "" ? 0px : root.label-width;
                                text: row.label;
                                color: Theme.text-dim;
                                font-size: Theme.font-body;
                                horizontal-alignment: right;
                                overflow: elide;
                            }
                            TextInput {
                                horizontal-stretch: 1;
                                text: row.value;
                                read-only: true;
                                single-line: false;
                                wrap: char-wrap;
                                color: Theme.text;
                                font-size: Theme.font-body;
                                // The std-widgets LineEdit's selection colours, legible in both palettes
                                // (Theme.selected-bg is close to the field in the dark one).
                                selection-background-color: Palette.selection-background;
                                selection-foreground-color: Palette.selection-foreground;
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 4px;
                Text {
                    horizontal-stretch: 1;
                    min-width: 50px;
                    text: root.status == "copy-failed" ? @tr("Copy failed")
                        : root.status == "save-failed" ? @tr("Save failed: {}", root.status-detail)
                        : "";
                    color: Theme.text-list;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Button { width: max(66px, self.preferred-width); text: @tr("Refresh"); enabled: root.can-refresh; clicked => { root.refresh(); } }
                Button { width: max(66px, self.preferred-width); text: @tr("Copy"); clicked => { root.copy-page(); } }
                Button { width: max(66px, self.preferred-width); text: @tr("Save As…"); clicked => { root.save-page(); } }
                Button { width: max(66px, self.preferred-width); text: @tr("Close"); clicked => { root.close-window(); } }
            }
        }
    }
}

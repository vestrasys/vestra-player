// About Vestra Player (I09): a fixed 360-wide window: the product, then the loaded plugins.
// Heights (padding 12 top and bottom):
//   12 + header 96 + 6 + components 5 × 18 + rendering + 6 + list head 18 + list 8 × 18 + 2 + 6 + spacer ≥ 0 + 6 + buttons 21 + 12 = 419 of 420 + rendering
//   rendering   0 when the player does not report it (before 0.5.12), else one 18px row or
//               more: its reason wraps, and the window grows by exactly that height
// Widths (content 360 − 28 = 332):
//   header      logo 96 + 12 + name / version text (elided)
//   components  label 100 + 8 + value 224 (elided; the rendering value wraps)
//   plugin list 1 + 6 + id ≥ 100 + 6 + version 56 + 6 + origin 56 + 6 + state 48 + 6 + scroll bar 12 + 1 ≤ 332
//   buttons     status ≥ 50 + 4 + Copy Info 66 + 4 + Close 66 = 190 of 332
// Texts are @tr (English source; locales/<lang>.po translate them); versions, ids and
// the plugin's origin and state codes are data from main.ts.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button } from "@vestra/widgets.slint";

export struct PluginRow {
    id: string,
    version: string,
    origin: string,
    state: string,
}

// One component row: label 100px right-aligned, value elided. 18px: an elided 11px
// line in a shorter box is not drawn at all.
component VersionLine {
    in property <string> label;
    in property <string> value;
    in property <length> label-width: 100px;
    height: 18px;
    HorizontalLayout {
        spacing: 8px;
        Text { width: root.label-width; text: root.label; color: Theme.text-dim; font-size: Theme.font-body; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
        Text { horizontal-stretch: 1; text: root.value; color: Theme.text; font-size: Theme.font-body; vertical-alignment: center; overflow: elide; }
    }
}

// One plugin-list line: id, version, origin, state (18px).
component PluginLine {
    in property <string> id;
    in property <string> version;
    in property <string> origin;
    in property <string> state;
    in property <bool> heading;
    // Column widths: the header and the words a column can show, never under 56 / 56 / 48.
    in property <length> version-width: 56px;
    in property <length> origin-width: 56px;
    in property <length> state-width: 48px;
    height: 18px;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 6px;
        Text { horizontal-stretch: 1; min-width: 100px; text: root.id; color: root.heading ? Theme.text : Theme.text-list; font-size: Theme.font-body; font-weight: root.heading ? 700 : 400; vertical-alignment: center; overflow: elide; }
        Text { width: root.version-width; text: root.version; color: root.heading ? Theme.text : Theme.text-list; font-size: Theme.font-body; font-weight: root.heading ? 700 : 400; vertical-alignment: center; overflow: elide; }
        Text { width: root.origin-width; text: root.origin; color: root.heading ? Theme.text : Theme.text-list; font-size: Theme.font-body; font-weight: root.heading ? 700 : 400; vertical-alignment: center; overflow: elide; }
        Text { width: root.state-width; text: root.state; color: root.heading ? Theme.text : Theme.text-list; font-size: Theme.font-body; font-weight: root.heading ? 700 : 400; vertical-alignment: center; overflow: elide; }
    }
}

export component AboutWindow inherits Window {
    title: @tr("About Vestra Player");
    preferred-width: 360px;
    preferred-height: 420px + rendering-line.height;
    min-width: 360px;
    max-width: 360px;
    min-height: 420px + rendering-line.height;
    max-height: 420px + rendering-line.height;
    background: Theme.bg-panel;
    in property <string> version;
    // "" without a build hash.
    in property <string> build;
    // Component versions; "" = not known.
    in property <string> api;
    in property <string> mpv;
    in property <string> ffmpeg;
    in property <string> slint;
    in property <string> node;
    in property <[PluginRow]> plugins;
    // packages.list failed: the list is empty and says so.
    in property <bool> plugins-unknown;
    // The renderer drawing now: "gpu", "software", or "" when the player does not
    // report it (the row is left out).
    in property <string> rendering;
    // The player's reason (English, shown as it is); "" = none shown.
    in property <string> rendering-reason;
    // "" or "copy-failed".
    in property <string> status;
    callback copy-info();
    callback close-window();

    pure function known(version: string) -> string {
        return version != "" ? version : @tr("Unknown");
    }
    // A plugin's source, in the words of the plugin manager and the store.
    pure function origin-name(code: string) -> string {
        return code == "bundled" ? @tr("Built-in")
            : code == "repository" ? @tr("Repository")
            : code == "link" ? @tr("Link")
            : code == "file" ? @tr("Local file")
            : code == "workshop" ? @tr("Workshop")
            : code == "installed" ? @tr("Installed")
            : code == "development" ? @tr("Development")
            : code;
    }
    // "Software — <reason>", "GPU" (about.ts renderingValue words the copied text the same way).
    pure function rendering-name(mode: string) -> string {
        return mode == "gpu" ? @tr("GPU") : @tr("Software");
    }
    pure function rendering-value(mode: string, reason: string) -> string {
        return reason == "" ? root.rendering-name(mode) : @tr("{} — {}", root.rendering-name(mode), reason);
    }
    pure function state-name(code: string) -> string {
        return code == "starting" ? @tr("Starting")
            : code == "running" ? @tr("Running")
            : code == "disabled" ? @tr("Disabled")
            : code == "failed" ? @tr("Failed")
            : code == "stopped" ? @tr("Stopped")
            : code;
    }

    private property <length> label-width: max(100px, label-measure.preferred-width);
    private property <length> version-width: max(56px, version-measure.preferred-width);
    private property <length> origin-width: max(56px, origin-measure.preferred-width);
    private property <length> state-width: max(48px, state-measure.preferred-width);
    Rectangle {
        visible: false;
        width: 0;
        height: 0;
        label-measure := VerticalLayout {
            Text { text: @tr("Plugin API"); font-size: Theme.font-body; }
            Text { text: @tr("Rendering"); font-size: Theme.font-body; }
        }
        // Headings are bold.
        version-measure := VerticalLayout {
            Text { text: @tr("Version"); font-size: Theme.font-body; font-weight: 700; }
            Text { text: @tr("Unknown"); font-size: Theme.font-body; }
        }
        origin-measure := VerticalLayout {
            Text { text: @tr("Source"); font-size: Theme.font-body; font-weight: 700; }
            for code in ["bundled", "repository", "link", "file", "workshop", "installed", "development"]: Text { text: root.origin-name(code); font-size: Theme.font-body; }
        }
        state-measure := VerticalLayout {
            Text { text: @tr("State"); font-size: Theme.font-body; font-weight: 700; }
            for code in ["starting", "running", "disabled", "failed", "stopped"]: Text { text: root.state-name(code); font-size: Theme.font-body; }
        }
    }

    body := VerticalLayout {
        padding-left: Theme.dialog-padding;
        padding-right: Theme.dialog-padding;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 6px;
        HorizontalLayout {
            height: 96px;
            alignment: center;
            spacing: 12px;
            Image {
                width: 96px;
                height: 96px;
                source: @image-url("logo.png");
                image-fit: contain;
                accessible-role: image;
                accessible-label: "Vestra Player"; // i18n-ignore: the product's name
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                // i18n-ignore: the product's name
                Text { text: "Vestra Player"; color: Theme.text; font-size: Theme.font-title; font-weight: 700; }
                Text { max-width: 200px; text: root.build != "" ? @tr("Version {} (build {})", root.version, root.build) : @tr("Version {}", root.version); color: Theme.text-dim; font-size: Theme.font-body; overflow: elide; }
            }
        }
        VerticalLayout {
            VersionLine { label-width: root.label-width; label: @tr("Plugin API"); value: root.api; }
            // i18n-ignore: component names
            VersionLine { label-width: root.label-width; label: "mpv"; value: root.known(root.mpv); }
            // i18n-ignore
            VersionLine { label-width: root.label-width; label: "FFmpeg"; value: root.known(root.ffmpeg); }
            // i18n-ignore
            VersionLine { label-width: root.label-width; label: "Slint"; value: root.known(root.slint); }
            // i18n-ignore
            VersionLine { label-width: root.label-width; label: "Node"; value: root.known(root.node); }
            // Rendering: label and value top-aligned, 2px down, so a one-line value sits like
            // a VersionLine; the reason wraps (it can name the adapter, the driver and where to
            // choose a GPU). Height 0 when the player does not report the renderer.
            rendering-line := HorizontalLayout {
                height: root.rendering == "" ? 0px : max(18px, rendering-text.preferred-height + 4px);
                padding-top: 2px;
                padding-bottom: 2px;
                spacing: 8px;
                Text { width: root.label-width; text: root.rendering == "" ? "" : @tr("Rendering"); color: Theme.text-dim; font-size: Theme.font-body; horizontal-alignment: right; vertical-alignment: top; overflow: elide; }
                rendering-text := Text {
                    horizontal-stretch: 1;
                    text: root.rendering == "" ? "" : root.rendering-value(root.rendering, root.rendering-reason);
                    color: Theme.text;
                    font-size: Theme.font-body;
                    vertical-alignment: top;
                    wrap: word-wrap;
                }
            }
        }
        VerticalLayout {
            PluginLine { version-width: root.version-width; origin-width: root.origin-width; state-width: root.state-width; id: @tr("Loaded plugins"); version: @tr("Version"); origin: @tr("Source"); state: @tr("State"); heading: true; }
            Rectangle {
                height: 8 * 18px + 2px;
                background: Theme.bg-list;
                border-width: 1px;
                border-color: Theme.line;
                if root.plugins-unknown: Text {
                    x: 7px;
                    y: 1px;
                    width: parent.width - 14px;
                    height: 18px;
                    text: @tr("Unknown (cannot read the plugin list)");
                    color: Theme.text-dim;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    overflow: elide;
                }
                list := ScrollView {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    VerticalLayout {
                        width: list.visible-width;
                        for plugin in root.plugins: PluginLine {
                            version-width: root.version-width;
                            origin-width: root.origin-width;
                            state-width: root.state-width;
                            id: plugin.id;
                            version: root.known(plugin.version);
                            origin: root.origin-name(plugin.origin);
                            state: root.state-name(plugin.state);
                        }
                    }
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 4px;
            Text {
                horizontal-stretch: 1;
                min-width: 50px;
                text: root.status == "copy-failed" ? @tr("Copy failed") : "";
                color: Theme.text-list;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
            }
            Button { width: max(66px, self.preferred-width); text: @tr("Copy Info"); clicked => { root.copy-info(); } }
            Button { width: max(66px, self.preferred-width); text: @tr("Close"); clicked => { root.close-window(); } }
        }
    }
}

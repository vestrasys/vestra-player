// 关于 Vestra Player (I09): a fixed 360×420 window, PotPlayer Dialog(301) plus the loaded plugins.
// Heights (padding 12 top and bottom):
//   12 + header 96 + 6 + components 5 × 18 + 6 + list head 18 + list 8 × 18 + 2 + 6 + spacer ≥ 0 + 6 + buttons 21 + 12 = 419 of 420
// Widths (content 360 − 28 = 332):
//   header      logo 96 + 12 + name / version text (elided)
//   components  label 100 + 8 + value 224 (elided)
//   plugin list 1 + 6 + id ≥ 100 + 6 + version 56 + 6 + origin 56 + 6 + state 48 + 6 + scroll bar 12 + 1 ≤ 332
//   buttons     status ≥ 50 + 4 + 复制信息 66 + 4 + 关闭 66 = 190 of 332
import { ScrollView } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button } from "@vestra/widgets.slint";

export struct ComponentRow {
    label: string,
    value: string,
}

export struct PluginRow {
    id: string,
    version: string,
    origin: string,
    state: string,
}

// One component row: label 100px right-aligned, value elided. 18px: an elided 11px
// line in a shorter box is not drawn at all.
component VersionLine {
    in property <string> label;
    in property <string> value;
    height: 18px;
    HorizontalLayout {
        spacing: 8px;
        Text { width: 100px; text: root.label; color: Theme.text-dim; font-size: Theme.font-body; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
        Text { horizontal-stretch: 1; text: root.value; color: Theme.text; font-size: Theme.font-body; vertical-alignment: center; overflow: elide; }
    }
}

// One plugin-list line: id, version, origin, state (18px).
component PluginLine {
    in property <string> id;
    in property <string> version;
    in property <string> origin;
    in property <string> state;
    in property <bool> heading;
    height: 18px;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 6px;
        Text { horizontal-stretch: 1; min-width: 100px; text: root.id; color: root.heading ? Theme.text : Theme.text-list; font-size: Theme.font-body; font-weight: root.heading ? 700 : 400; vertical-alignment: center; overflow: elide; }
        Text { width: 56px; text: root.version; color: root.heading ? Theme.text : Theme.text-list; font-size: Theme.font-body; font-weight: root.heading ? 700 : 400; vertical-alignment: center; overflow: elide; }
        Text { width: 56px; text: root.origin; color: root.heading ? Theme.text : Theme.text-list; font-size: Theme.font-body; font-weight: root.heading ? 700 : 400; vertical-alignment: center; overflow: elide; }
        Text { width: 48px; text: root.state; color: root.heading ? Theme.text : Theme.text-list; font-size: Theme.font-body; font-weight: root.heading ? 700 : 400; vertical-alignment: center; overflow: elide; }
    }
}

export component AboutWindow inherits Window {
    title: "关于 Vestra Player";
    preferred-width: 360px;
    preferred-height: 420px;
    min-width: 360px;
    max-width: 360px;
    min-height: 420px;
    max-height: 420px;
    background: Theme.bg-panel;
    in property <string> version;
    in property <[ComponentRow]> components;
    in property <[PluginRow]> plugins;
    in property <string> plugins-note;
    in property <string> status;
    callback copy-info();
    callback close-window();

    body := VerticalLayout {
        padding-left: Theme.dialog-padding;
        padding-right: Theme.dialog-padding;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 6px;
        HorizontalLayout {
            height: 96px;
            alignment: center;
            spacing: 12px;
            Image {
                width: 96px;
                height: 96px;
                source: @image-url("logo.png");
                image-fit: contain;
                accessible-role: image;
                accessible-label: "Vestra Player";
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text { text: "Vestra Player"; color: Theme.text; font-size: Theme.font-title; font-weight: 700; }
                Text { max-width: 200px; text: root.version; color: Theme.text-dim; font-size: Theme.font-body; overflow: elide; }
            }
        }
        VerticalLayout {
            for row in root.components: VersionLine { label: row.label; value: row.value; }
        }
        VerticalLayout {
            PluginLine { id: "已加载插件"; version: "版本"; origin: "来源"; state: "状态"; heading: true; }
            Rectangle {
                height: 8 * 18px + 2px;
                background: Theme.bg-list;
                border-width: 1px;
                border-color: Theme.line;
                if root.plugins-note != "": Text {
                    x: 7px;
                    y: 1px;
                    width: parent.width - 14px;
                    height: 18px;
                    text: root.plugins-note;
                    color: Theme.text-dim;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    overflow: elide;
                }
                list := ScrollView {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    VerticalLayout {
                        width: list.visible-width;
                        for plugin in root.plugins: PluginLine {
                            id: plugin.id;
                            version: plugin.version;
                            origin: plugin.origin;
                            state: plugin.state;
                        }
                    }
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 4px;
            Text {
                horizontal-stretch: 1;
                min-width: 50px;
                text: root.status;
                color: Theme.text-list;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
            }
            Button { width: 66px; text: "复制信息"; clicked => { root.copy-info(); } }
            Button { width: 66px; text: "关闭"; clicked => { root.close-window(); } }
        }
    }
}

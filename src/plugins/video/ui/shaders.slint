// 着色器列表 (E17): the enabled list (in order) with 〔添加…〕〔移除〕〔上移〕〔下移〕〔清空〕 beside it,
// and the shader folder's other files below (double-click adds one).
// Widths (window 301, content 285 after the 8px side padding):
//   list 219 + spacing 6 + buttons 60                                   = 285
// Height: padding 8 + heading 16 + 4 + list 113 (5 × 21 buttons, 2 apart) + 4 + heading 16 + 4
//   + folder list 62 (3 rows) + 4 + bottom row 21 + padding 8           = 260
import { Theme } from "@vestra/theme.slint";
import { Button } from "@vestra/widgets.slint";

// A plain 20px-row list: click selects, double-click activates; `empty` shows when there are no rows.
// A row whose `missing` entry is true is a file that no longer exists.
component NameList {
    in property <[string]> model;
    in property <[bool]> missing;
    in property <int> selected: -1;
    in property <string> empty;
    callback picked(int);
    callback activated(int);
    accessible-role: list;
    Rectangle {
        background: Theme.bg-list;
        border-color: Theme.line;
        border-width: 1px;
    }
    Flickable {
        x: 1px;
        y: 1px;
        width: root.width - 2px;
        height: root.height - 2px;
        content-height: root.model.length * 20px;
        VerticalLayout {
            width: root.width - 2px;
            height: root.model.length * 20px;
            for name[index] in root.model: Rectangle {
                height: 20px;
                background: index == root.selected ? Theme.selected-bg : touch.has-hover ? Theme.press-bg : transparent;
                Text {
                    x: 5px;
                    width: parent.width - 10px;
                    text: index < root.missing.length && root.missing[index] ? @tr("{} (file missing)", name) : name;
                    color: Theme.text-list;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    overflow: elide;
                }
                touch := TouchArea {
                    clicked => { root.picked(index); }
                    double-clicked => { root.activated(index); }
                }
            }
        }
    }
    if root.model.length == 0: Text {
        text: root.empty;
        color: Theme.text-dim;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component ShadersWindow inherits Window {
    title: @tr("Shader List");
    // 301px, wider only when a translation needs it.
    width: Math.max(301px, body.min-width);
    height: 260px;
    background: Theme.bg-panel;
    in property <[string]> names;
    in property <int> selected: -1;
    in property <[string]> available;
    in property <[bool]> missing;
    in property <int> count: 0;
    in property <int> max: 16;
    in property <bool> render-ready: true;
    in property <bool> shaders-enabled;
    callback select(int);
    callback add();
    callback pick(int);
    callback remove();
    callback up();
    callback down();
    callback clear();
    callback open-folder();
    // The side buttons' column: 60px, or the widest label with the button padding.
    private property <length> side-width: Math.max(60px, side-measure.preferred-width + 2 * Theme.button-padding);
    Rectangle {
        visible: false;
        width: 0;
        height: 0;
        side-measure := VerticalLayout {
            for text in [@tr("Add…"), @tr("Remove"), @tr("Move Up"), @tr("Move Down"), @tr("Clear")]: Text { text: text; font-size: Theme.font-body; }
        }
    }
    body := VerticalLayout {
        padding: 8px;
        spacing: 4px;
        Text { height: 16px; text: @tr("Enabled {}/{} (run in order)", root.count, root.max); color: Theme.text; font-size: Theme.font-body; vertical-alignment: center; }
        HorizontalLayout {
            height: 113px;
            spacing: 6px;
            NameList {
                width: 219px;
                model: root.names;
                missing: root.missing;
                selected: root.selected;
                empty: @tr("No shaders");
                picked(i) => { root.select(i); }
            }
            VerticalLayout {
                width: root.side-width;
                spacing: 2px;
                Button { text: @tr("Add…"); height: 21px; clicked => { root.add(); } }
                Button { text: @tr("Remove"); height: 21px; enabled: root.selected >= 0; clicked => { root.remove(); } }
                Button { text: @tr("Move Up"); height: 21px; enabled: root.selected > 0; clicked => { root.up(); } }
                Button { text: @tr("Move Down"); height: 21px; enabled: root.selected >= 0 && root.selected < root.names.length - 1; clicked => { root.down(); } }
                Button { text: @tr("Clear"); height: 21px; enabled: root.names.length > 0; clicked => { root.clear(); } }
            }
        }
        Text { height: 16px; text: @tr("Other files in the shader folder (double-click to add)"); color: Theme.text-dim; font-size: Theme.font-body; vertical-alignment: center; }
        NameList {
            height: 62px;
            model: root.available;
            empty: @tr("No other .glsl files");
            activated(i) => { root.pick(i); }
        }
        HorizontalLayout {
            height: 21px;
            spacing: 6px;
            Text {
                horizontal-stretch: 1;
                text: !root.render-ready ? @tr("Needs GPU rendering (currently software rendering)") : root.shaders-enabled ? "" : @tr("“Use Shaders” is off");
                color: Theme.accent;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
            }
            Button { text: @tr("Open Folder"); width: Math.max(80px, self.preferred-width); clicked => { root.open-folder(); } }
        }
    }
}

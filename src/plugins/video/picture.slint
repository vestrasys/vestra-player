// The Picture panel in the adjust column (menu redesign v3, mockups 30 and 31): one scrolling column
// with five sections headed in place (no jump tabs): Rendering (the GPU switch with its status line,
// AI Upscaling under it), Colour (the presets in its heading row), Effects, Geometry and Advanced (a
// disclosure row, closed by default, with a summary of its values). Every row is a layout and every
// text one line (elided, the full text in a tooltip), so nothing overlaps when a row changes; rows
// that come and go are persistent elements shown with `visible` (only the Advanced fold is an `if`,
// opened by a click). Effects are on/off chips (Frames' Doubling and Interpolate among them) with a
// strength row per effect that is on and the Denoise card; Geometry is the editor (`Editor`: a still
// picture placed by the real settings).
// Lists are written out (no `for` in the scrolling column: the host's slint_lists test).
// Key caps come from `plugin.commands.keys` (`Keys`): the user's current keys, "" for none.
// The file keeps its name and the names `Picture` / `PictureBridge`, which the host's measurement
// of the adjust column's first opening uses (composition.rs).
import { ScrollView, Switch as StdSwitch } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Icon } from "@vestra/icons.slint";
import { Button, Check, Choice, KeyHint, Slider, ToolTipArea, ToolTipKey } from "@vestra/widgets.slint";

// The first key of each command shown in the panel ("" without one).
export struct Keys {
    brightnessdown: string,
    brightnessup: string,
    contrastdown: string,
    contrastup: string,
    saturationdown: string,
    saturationup: string,
    huedown: string,
    hueup: string,
    sharpen: string,
    edge: string,
    blur: string,
    deblock: string,
    deband: string,
    d3: string,
    gradual: string,
    temporal: string,
    doubling: string,
    interpolation: string,
    aspect: string,
    rotate: string,
    flipv: string,
    fliph: string,
    zoomout: string,
    zoomin: string,
    panleft: string,
    panup: string,
    pandown: string,
    panright: string,
    centre: string,
    framing: string,
    deinterlace: string,
    shaders: string,
    gpu: string,
    reset: string,
    // Reset All (`video.resetPanel`, no default key).
    resetpanel: string,
}

// The renderer switch (`plugin.rendering`). `ongpu`: this run draws on the GPU; `nextgpu`: the next
// start will; `reason`: the player's own message why the GPU is not used (greyed, or ruled out at the
// next start), "" when there is nothing to say; `name`: the GPU's name where known, else "".
export struct Gpu {
    shown: bool,
    checked: bool,
    enabled: bool,
    busy: bool,
    pending: bool,
    ongpu: bool,
    nextgpu: bool,
    reason: string,
    name: string,
}

// AI Upscaling (`plugin.video.upscaling`, RTX Video Super Resolution). `checked`: the saved choice.
// `kind` says what the status line words: "off"; "on" (on, not read yet); "upscaling" (`from`p to
// `to`p on `gpu`; 0 / "" when not known); "idle" (on, the video is not shown larger than its size);
// "effects" (waits: this panel's adjustments need the frames in memory); "plugins" (waits: other
// plugins' filters need the frames in memory); "copy-back" (waits: decoded with copy-back, no
// plugin named); "hwdec-off" (waits: hardware decoding is off); "software" (waits: this video is
// decoded in software); "other-hwdec" (waits: another hardware decoder); "waiting" (waits:
// `detail`); "rendering" (needs GPU rendering); "platform" (not on this system); "gpu" (not on
// this GPU: `detail`); "other" (`detail`). `detail` is the player's own message, except for
// "plugins": there `detail` is the status line (short, what to do) and `tip` its tooltip (why);
// the other waiting kinds word both here (`up-status`, `up-tip`).
export struct Upscaling {
    checked: bool,
    enabled: bool,
    busy: bool,
    kind: string,
    detail: string,
    // With kind "plugins": the status line's tooltip, the reason (`detail` is the line).
    tip: string,
    from: int,
    to: int,
    gpu: string,
}

export global PictureBridge {
    // Colour
    in-out property <float> brightness: 0;
    in-out property <float> contrast: 0;
    in-out property <float> saturation: 0;
    in-out property <float> hue: 0;
    in-out property <float> gamma: 0;
    // Effects
    in property <bool> blur-enabled;
    in-out property <float> blur-strength: 3;
    in property <bool> sharpen-enabled;
    in-out property <float> sharpen-strength: 50;
    in property <bool> edge-enabled;
    in-out property <float> edge-strength: 50;
    // The three denoisers: independent filters, each with its own switch and strength.
    in property <bool> d3-enabled;
    in-out property <float> d3-strength: 40;
    in property <bool> gradual-enabled;
    in-out property <float> gradual-strength: 40;
    in property <bool> temporal-enabled;
    in-out property <float> temporal-strength: 40;
    in property <bool> deblock-enabled;
    in-out property <float> deblock-strength: 25;
    in property <bool> deband-enabled;
    in-out property <float> deband-strength: 40;
    // Frames: 0 off, 1 frame doubling, 2 motion interpolation (they exclude each other).
    in property <int> frames-index: 0;
    // The source is smooth enough: frame doubling adds nothing.
    in property <bool> blend-enough;
    // Geometry
    in property <int> fit-index: 0;
    // The last custom ratio typed ("" = none); it adds a choice after the presets.
    in property <string> custom-ratio;
    in-out property <int> aspect-index: 0;
    // The aspect override as a number (0 = the source's own), the source's width / height (0 = not known).
    in property <float> display-aspect: 0;
    in property <float> source-aspect: 0;
    // Crop/stretch: 0 none, 1 stretch (pad), 2 crop; the ratio (index and value); its position, 0–100 % (50 centred).
    in property <int> reframe-index: 0;
    in property <int> ratio-index: 1;
    in property <float> ratio-aspect: 1.7778;
    in property <int> crop-x: 50;
    in property <int> crop-y: 50;
    in property <int> rotate-index: 0;
    in property <bool> flip-v;
    in property <bool> flip-h;
    // Framing: zoom 0.25–4, pan −1–1 (fractions of the shown picture, as mpv's video-pan), and the same in percent.
    in property <float> zoom: 1;
    in property <float> pan-x-value: 0;
    in property <float> pan-y-value: 0;
    in property <int> zoom-percent: 100;
    in property <int> pan-x: 0;
    in property <int> pan-y: 0;
    // Advanced
    in-out property <bool> advanced-open;
    in-out property <int> deinterlace-index: 0;
    in property <int> output-index: 0;
    // GPU render options (HDR, shaders, motion interpolation); greyed with a reason under software rendering.
    in property <bool> render-ready: true;
    in-out property <int> tone-index: 0;
    in-out property <float> target-peak: 203;
    // The target brightness as saved (the slider's value while dragging is not rounded); the source is known to be SDR.
    in property <int> peak-nits: 203;
    in property <bool> peak-detect: true;
    in property <bool> not-hdr;
    in property <bool> shaders-enabled;
    in property <int> shader-count: 0;
    in property <Gpu> gpu;
    in property <Upscaling> upscaling;
    // Bottom
    in property <bool> effect-enabled: true;
    in property <bool> failed;
    // What failed: "no-picture", "filter", "view", "shader", "render-conflict", "render" ("" = nothing).
    in property <string> status;
    // The player's message; with `conflict`, another plugin owns the display or the render options.
    in property <string> detail;
    in property <bool> conflict;
    in property <Keys> keys;
    // HDR Settings… opens Advanced and asks to see it: each new `advanced-serial` scrolls there.
    in property <int> advanced-serial;

    // (field, value) while dragging; commit on release.
    callback adjust(string, float);
    callback commit(string, float);
    // A slider's double-click: back to its default.
    callback reset-field(string);
    callback preset(string);
    callback toggle-effect(bool);
    callback toggle(string, bool);
    callback choose(string, int);
    // One of the plugin's commands, by id (the editor's keys and buttons, Reset All, the GPU and
    // upscaling switches, Restart).
    callback run(string);
    // The geometry editor: a framing asked for by a drag, a corner or the wheel (zoom, pan x, pan y);
    // `done` on release (and for a wheel notch), so the plugin treats a drag as one action.
    callback frame-edit(float, float, float, bool);
    // The editor's crop box (or the picture inside the bars) dragged to x, y in %; `done` on release.
    callback crop-at(float, float, bool);
    callback set-advanced(bool);
    callback retry();
    callback custom-aspect();
    callback shader-list();
}

// Glyphs of this panel, in the V-Line style of @vestra/icons.slint (1.5px round-capped lines), 14×12 boxes.
global Glyphs {
    // Quarter turns: an open arc with the arrow head at its start.
    out property <string> rotl: "M 2.5 4.5 A 4.6 4.6 0 1 1 3.4 9 M 2.5 1.5 V 4.5 H 5.5";
    out property <string> rotr: "M 11.5 4.5 A 4.6 4.6 0 1 0 10.6 9 M 11.5 1.5 V 4.5 H 8.5";
    out property <string> crop: "M 4 0.8 V 8.5 H 13 M 1 3.5 H 10 V 11.2";
    out property <string> centre: "M 7 0.8 V 3.5 M 7 8.5 V 11.2 M 1.5 6 H 4.5 M 9.5 6 H 12.5 M 8.2 6 A 1.2 1.2 0 1 1 5.8 6 A 1.2 1.2 0 1 1 8.2 6 Z";
    out property <string> reset: "M 3.5 3 A 4.5 4.5 0 1 1 2.5 7 M 3.5 0.8 V 3 H 5.7";
    out property <string> flipv: "M 7 1 V 11 M 4.5 3.5 L 7 1 L 9.5 3.5 M 4.5 8.5 L 7 11 L 9.5 8.5";
    out property <string> fliph: "M 1.5 6 H 12.5 M 4 3.5 L 1.5 6 L 4 8.5 M 10 3.5 L 12.5 6 L 10 8.5";
    out property <string> info: "M 11.5 6 A 4.5 4.5 0 1 1 2.5 6 A 4.5 4.5 0 1 1 11.5 6 Z M 7 5.5 V 8.5 M 7 3.6 L 7 3.65";
    out property <string> more: "M 3.5 6 L 3.5 6.05 M 7 6 L 7 6.05 M 10.5 6 L 10.5 6.05";
}

// Width of the label column: labels elide there, the whole label is in the row's tooltip.
global Layout {
    out property <length> column: 64px;
    out property <length> row: 22px;
    // The Rendering section's status lines.
    out property <length> status: 14px;
    // Indent of a status line under its switch: the switch (std-widgets, 40 px) and the gap after it,
    // so the dot lines up with the label (mockups 30 and 31).
    out property <length> status-indent: 46px;
    // A switch with its label in a row of its own (the Denoise card): the switch, the gap, a label column.
    out property <length> switch-column: 46px + 64px;
}

// Status colours of the Rendering section (mockup 31): on (green), waiting for a restart (amber).
// The theme has no such tokens; both read on the dark and the light palette.
global Status {
    out property <color> on: #4ad17a;
    out property <color> pending: #e0a800;
}

// A row label: one line, elided.
component Name inherits Text {
    in property <bool> enabled: true;
    width: Layout.column;
    color: root.enabled ? Theme.text : Theme.text-dim;
    font-size: Theme.font-body;
    vertical-alignment: center;
    overflow: elide;
}

// A section heading (upper case) with a rule after it; children go to the right of the rule.
component Head {
    in property <string> text;
    min-height: 18px;
    HorizontalLayout {
        spacing: 6px;
        padding-top: 2px;
        Text {
            text: root.text.to-uppercase();
            color: Theme.text-dim;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 8px;
            alignment: center;
            Rectangle { height: 1px; background: Theme.line; }
        }
        @children
    }
}

// A colour preset in the Colour heading: a compact button whose label elides.
component Preset inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: Theme.button-small-height;
    min-width: 24px;
    preferred-width: label.preferred-width + 12px;
    horizontal-stretch: 0;
    border-radius: Theme.radius-control;
    background: touch.pressed ? Theme.button-press : touch.has-hover ? Theme.button-hover : Theme.button-bg;
    label := Text {
        x: 6px;
        width: parent.width - 12px;
        text: root.text;
        color: Theme.text-list;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A small rounded tag after a switch's label ("RTX VSR"), with its own tooltip.
component Badge {
    in property <string> text;
    in property <string> tip;
    in property <bool> lit;
    horizontal-stretch: 0;
    min-width: 20px;
    preferred-width: tag.preferred-width + 10px;
    ToolTipArea {
        width: 100%;
        height: 100%;
        text: root.tip;
        VerticalLayout {
            width: 100%;
            height: 100%;
            alignment: center;
            Rectangle {
                height: 14px;
                border-radius: 7px;
                border-width: 1px;
                border-color: root.lit ? Theme.accent : Theme.line;
                tag := Text {
                    x: 5px;
                    width: parent.width - 10px;
                    text: root.text;
                    color: root.lit ? Theme.accent : Theme.text-dim;
                    font-size: Theme.font-xs;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

// The status line under a Rendering switch: a dot (filled green: on; filled amber: waiting for a
// restart; hollow: off or not available) and one line of text, elided, the whole text in the tip
// (or `tip`, where the line is short and the tooltip says why).
component StatusLine {
    in property <string> text;
    in property <string> tip: root.text;
    // "on", "pending" or "off".
    in property <string> tone;
    height: Layout.status;
    ToolTipArea {
        width: 100%;
        height: 100%;
        text: root.tip;
        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: Layout.status-indent;
            spacing: 5px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.tone == "on" ? Status.on : root.tone == "pending" ? Status.pending : transparent;
                    border-width: root.tone == "off" ? 1px : 0px;
                    border-color: Theme.text-dim;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: root.text;
                color: root.tone == "pending" ? Status.pending : Theme.text-dim;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// A key cap, centred in its row (nothing and no room when `text` is "").
component Cap {
    in property <string> text;
    VerticalLayout {
        alignment: center;
        KeyHint { text: root.text; }
    }
}

// The panel slider: the library Slider (its track, keys and focus) with a tick at the default in
// the middle; the pointer is this element's, so a double-click returns the slider to its default.
component Fader {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <bool> enabled: true;
    // A tick in the middle, where the default (0) is.
    in property <bool> centre;
    callback edited(float);
    callback committed(float);
    callback reset();
    min-width: 40px;
    horizontal-stretch: 1;
    min-height: 14px;
    function set-from(x: length) {
        slider.set-value(root.minimum + clamp((x - 7px) / max(1px, root.width - 14px), 0, 1) * (root.maximum - root.minimum));
    }
    Rectangle {
        visible: root.centre;
        x: (root.width - 1px) / 2;
        y: (root.height - 8px) / 2;
        width: 1px;
        height: 8px;
        background: Theme.text-dim;
    }
    slider := Slider {
        width: 100%;
        height: 100%;
        panel: true;
        minimum: root.minimum;
        maximum: root.maximum;
        enabled: root.enabled;
        value <=> root.value;
        changed(v) => { root.edited(v); }
        released(v) => { root.committed(v); }
    }
    TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.set-from(self.mouse-x); }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up { root.committed(root.value); }
        }
        moved => { if self.pressed { root.set-from(self.mouse-x); } }
        double-clicked => { root.reset(); }
    }
}

// A sliding switch with a one-line label (elided): the Playback panel's Loop switch (std-widgets
// `Switch`, focusable: Space toggles it); a click on the label asks too. The plugin owns the state:
// a toggle asks for the other state and the switch shows `checked` again until the plugin answers.
component Switch {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    min-height: Theme.checkbox-row-height;
    horizontal-stretch: 1;
    changed checked => { knob.checked = root.checked; }
    HorizontalLayout {
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            knob := StdSwitch {
                text: "";
                checked: root.checked;
                enabled: root.enabled;
                toggled => {
                    root.toggled(self.checked);
                    self.checked = root.checked;
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            Text {
                width: 100%;
                height: 100%;
                horizontal-alignment: left;
                text: root.text;
                color: root.enabled ? Theme.text : Theme.text-dim;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
            }
            TouchArea {
                enabled: root.enabled;
                clicked => { root.toggled(!root.checked); }
            }
        }
    }
}

// A check box with a one-line label (elided), for the footer's master switch (a check box in the
// mockup too); a click anywhere on it asks for the other state, and the plugin sets `checked` (the
// library Check's plugin-decided mode).
component CheckRow {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    min-height: Theme.checkbox-row-height;
    horizontal-stretch: 1;
    HorizontalLayout {
        spacing: 4px;
        // The box keeps its own width; the label takes the rest, left-aligned.
        box := Check {
            horizontal-stretch: 0;
            text: "";
            panel: true;
            self-toggle: false;
            checked: root.checked;
            enabled: root.enabled;
            toggled(on) => { root.toggled(on); }
        }
        Text {
            horizontal-stretch: 1;
            horizontal-alignment: left;
            text: root.text;
            color: root.enabled ? Theme.text : Theme.text-dim;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { box.toggle(); }
    }
}

// A segmented choice: a bar of equal parts (`Segment`, written out at each use), the current one lit.
component SegmentBar inherits Rectangle {
    min-height: 22px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-control;
    background: Theme.bg-bar;
    HorizontalLayout {
        padding: 1px;
        spacing: 1px;
        @children
    }
}

// One part of a SegmentBar; its label elides.
component Segment inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();
    horizontal-stretch: 1;
    min-width: 20px;
    border-radius: Theme.radius-control;
    background: root.selected ? (root.enabled ? Theme.selected-bg : Theme.button-disabled)
        : touch.has-hover && root.enabled ? Theme.hover-bg : transparent;
    Text {
        x: 3px;
        width: parent.width - 6px;
        height: parent.height;
        text: root.text;
        color: !root.enabled ? Theme.text-dim : root.selected ? Theme.text : Theme.text-list;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A 22px glyph button with a tooltip that names it and its key.
component Glyph {
    in property <string> glyph;
    in property <string> tip;
    in property <string> key;
    in property <bool> enabled: true;
    in property <bool> checked;
    callback clicked();
    width: 22px;
    height: 22px;
    ToolTipArea {
        width: 100%;
        height: 100%;
        text: root.tip;
        keys: [{ key: root.key, text: "" }];
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: Theme.radius-control;
            background: root.checked ? Theme.selected-bg : transparent;
            border-width: root.checked ? 1px : 0px;
            border-color: Theme.playing;
            Button {
                width: 100%;
                height: 100%;
                icon: root.glyph;
                stroked: true;
                enabled: root.enabled;
                accessible-label: root.tip;
                clicked => { root.clicked(); }
            }
        }
    }
}

// Colour row: label, slider with its centre tick, the value, the minus and plus keys.
component ColourRow {
    in property <string> label;
    in-out property <float> value;
    in property <string> down;
    in property <string> up;
    callback edited(float);
    callback committed(float);
    callback reset();
    height: Layout.row;
    ToolTipArea {
        width: 100%;
        height: 100%;
        text: root.label;
        keys: [{ key: root.down, text: "−" }, { key: root.up, text: "+" }];
        detail: @tr("· double-click: Default");
        HorizontalLayout {
            width: 100%;
            height: 100%;
            spacing: 6px;
            Name { text: root.label; }
            Fader {
                centre: true;
                minimum: -100;
                maximum: 100;
                value <=> root.value;
                edited(v) => { root.edited(v); }
                committed(v) => { root.committed(v); }
                reset => { root.reset(); }
            }
            Text {
                width: 26px;
                text: round(root.value);
                color: Theme.text-list;
                font-size: Theme.font-body;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            HorizontalLayout {
                spacing: 3px;
                Cap { text: root.down; }
                Cap { text: root.up; }
            }
        }
    }
}

// A strength value as shown beside its slider (Gaussian blur's 0–10 with one decimal).
component Amount inherits Text {
    in property <float> value;
    in property <bool> decimal;
    width: 26px;
    text: root.decimal ? round(root.value * 10) / 10 : round(root.value);
    color: Theme.text-list;
    font-size: Theme.font-body;
    horizontal-alignment: right;
    vertical-alignment: center;
}

// An effect chip of the Effects grid: a dot (filled while on), the name, and the key cap when
// the command has a key. A click, or Space while focused (Tab), asks for the other state; the
// plugin sets `checked`. A disabled chip (Interpolate without GPU rendering) is dimmed and its
// tip gives the reason.
component Chip {
    in property <string> text;
    in property <string> tip;
    in property <string> key;
    // The tooltip's keys: the chip's own key unless set.
    in property <[ToolTipKey]> tip-keys: [{ key: root.key, text: "" }];
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: 24px;
    min-width: 40px;
    horizontal-stretch: 1;
    ToolTipArea {
        width: 100%;
        height: 100%;
        text: root.tip;
        keys: root.tip-keys;
        detail: root.enabled ? @tr("· click: on or off") : "";
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: Theme.radius-control;
            background: !root.enabled ? Theme.bg-bar : touch.pressed ? Theme.press-bg : touch.has-hover ? Theme.hover-bg : root.checked ? Theme.selected-bg : Theme.bg-bar;
            border-width: 1px;
            border-color: root.checked ? Theme.accent : transparent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 5px;
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: root.checked ? Theme.accent : transparent;
                        border-width: root.checked ? 0px : 1px;
                        border-color: Theme.text-dim;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.text;
                    color: !root.enabled ? Theme.text-dim : root.checked ? Theme.text : Theme.text-list;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Cap { text: root.key; }
            }
            touch := TouchArea {
                enabled: root.enabled;
                clicked => { root.toggled(!root.checked); }
            }
        }
    }
    // The focus ring, 2px outside the chip.
    Rectangle {
        visible: chip-keys.has-focus;
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
        border-radius: Theme.radius-control + 2px;
        border-width: 1px;
        border-color: Theme.accent;
    }
    chip-keys := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Space && root.enabled {
                root.toggled(!root.checked);
                return accept;
            }
            reject
        }
    }
}

// One effect's strength under the chips, there only while the effect is on (the value is kept
// while it is off): label, slider, value. A double-click on the slider returns the default.
component StrengthRow {
    in property <string> label;
    in property <string> tip;
    in property <string> key;
    in property <bool> shown;
    in-out property <float> value;
    in property <float> maximum: 100;
    callback edited(float);
    callback committed(float);
    callback reset();
    height: root.shown ? Layout.row : 0px;
    visible: root.shown;
    ToolTipArea {
        width: 100%;
        height: 100%;
        text: root.tip;
        keys: [{ key: root.key, text: "" }];
        detail: @tr("· double-click: Default");
        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-top: 2px;
            padding-bottom: 2px;
            spacing: 6px;
            Name { text: root.label; }
            Fader {
                maximum: root.maximum;
                value <=> root.value;
                edited(v) => { root.edited(v); }
                committed(v) => { root.committed(v); }
                reset => { root.reset(); }
            }
            Amount { value: root.value; decimal: root.maximum <= 10; }
        }
    }
}

// A denoiser's row in the Denoise card: its own switch, and its strength while it is on.
component DenoiseRow {
    in property <string> label;
    in property <string> tip;
    in property <string> key;
    in property <bool> checked;
    in-out property <float> value;
    callback toggled(bool);
    callback edited(float);
    callback committed(float);
    callback reset();
    height: 22px;
    ToolTipArea {
        width: 100%;
        height: 100%;
        text: root.tip;
        keys: [{ key: root.key, text: "" }];
        detail: root.checked ? @tr("· double-click: Default") : "";
        HorizontalLayout {
            width: 100%;
            height: 100%;
            spacing: 6px;
            Switch {
                horizontal-stretch: 0;
                width: Layout.switch-column;
                text: root.label;
                checked: root.checked;
                toggled(on) => { root.toggled(on); }
            }
            Fader {
                visible: root.checked;
                value <=> root.value;
                edited(v) => { root.edited(v); }
                committed(v) => { root.committed(v); }
                reset => { root.reset(); }
            }
            Amount { visible: root.checked; value: root.value; }
        }
    }
}

// A row: label, control(s), key cap; no tooltip (`Row` adds one where the row has something to say).
component Line {
    in property <string> label;
    in property <string> key;
    in property <bool> enabled: true;
    height: Layout.row;
    HorizontalLayout {
        spacing: 6px;
        Name { text: root.label; enabled: root.enabled; }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            @children
        }
        Cap { text: root.key; }
    }
}

// A Line whose tooltip names or explains the row, with its key.
component Row {
    in property <string> label;
    in property <string> tip;
    in property <string> key;
    in property <bool> enabled: true;
    in property <string> detail;
    height: Layout.row;
    ToolTipArea {
        width: 100%;
        height: 100%;
        text: root.tip != "" ? root.tip : root.label;
        keys: [{ key: root.key, text: "" }];
        detail: root.detail;
        Line {
            width: 100%;
            height: 100%;
            label: root.label;
            key: root.key;
            enabled: root.enabled;
            @children
        }
    }
}

// The still as the video shows it, filling this element: the crop window of the source
// (crop), or the source between bars (stretch), flipped, then turned (the user flips first, as
// the plugin's transform node says). Rotation and mirroring use Slint transforms, which the
// software renderer ignores (there the still is shown upright and unmirrored).
component Still {
    in property <float> source-aspect;
    // 0 none, 1 stretch (pad), 2 crop.
    in property <int> mode;
    in property <float> ratio;
    // The crop or bars position, 0–100 %.
    in property <float> pos-x: 50;
    in property <float> pos-y: 50;
    in property <int> rotate-index;
    in property <bool> flip-h;
    in property <bool> flip-v;
    private property <bool> quarter: root.rotate-index == 1 || root.rotate-index == 3;
    // The part of the still a crop keeps: across (ratio narrower than the source) or down.
    private property <bool> crop-across: root.mode == 2 && root.ratio < root.source-aspect;
    private property <bool> crop-down: root.mode == 2 && root.ratio > root.source-aspect;
    turned := Rectangle {
        width: root.quarter ? root.height : root.width;
        height: root.quarter ? root.width : root.height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: root.mode == 1 ? #000000 : transparent;
        transform-rotation: root.rotate-index * 90deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        Rectangle {
            width: 100%;
            height: 100%;
            transform-scale-x: root.flip-h ? -100% : 100%;
            transform-scale-y: root.flip-v ? -100% : 100%;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            Image {
                source: @image-url("assets/still.jpg");
                image-fit: fill;
                // Stretch: the source between bars along the longer side of the ratio.
                width: root.mode == 1 && root.source-aspect < root.ratio ? parent.width * root.source-aspect / root.ratio : parent.width;
                height: root.mode == 1 && root.source-aspect > root.ratio ? parent.height * root.ratio / root.source-aspect : parent.height;
                x: (parent.width - self.width) * root.pos-x / 100;
                y: (parent.height - self.height) * root.pos-y / 100;
                source-clip-width: root.crop-across ? round(self.source.width * root.ratio / root.source-aspect) : self.source.width;
                source-clip-height: root.crop-down ? round(self.source.height * root.source-aspect / root.ratio) : self.source.height;
                source-clip-x: round((self.source.width - self.source-clip-width) * root.pos-x / 100);
                source-clip-y: round((self.source.height - self.source-clip-height) * root.pos-y / 100);
            }
        }
    }
}

// A corner handle of the editor's picture frame, lit while the pointer is on it.
component Handle inherits Rectangle {
    in property <bool> lit;
    width: 7px;
    height: 7px;
    background: root.lit ? Theme.accent : #ffffff;
    border-width: 1px;
    border-color: Theme.accent;
}

// The geometry editor (Picture panel, Geometry): a fixed screen frame and, inside it, the
// picture as the video shows it, from the real settings (crop/stretch, rotation, flip, aspect,
// fit, zoom, pan). It is a still image, not the live video (user ruling 2026-11-08); every
// change goes to the real video at once (`frame-edit`, `crop-at`, `run`) and the still follows
// the plugin's values. What the screen cuts off shows dimmed.
//   Move mode: drag the picture to pan (it snaps to the centre), drag a corner to zoom about
//   the picture's centre, the wheel zooms, a double-click centres.
//   Crop mode (`crop-mode`): the source alone with the crop box. The plugin's crop is a ratio
//   and a position (no free edges), so the box is set by the ratio chips and dragged to move it
//   (when stretching, the picture is dragged between the bars). Esc or Enter leaves.
//   Keys while focused (Tab, or entering crop mode): the arrows pan (crop mode: move the box),
//   + and − zoom; they are the plugin's commands, so the OSD says what changed.
component Editor inherits Rectangle {
    in-out property <bool> crop-mode;
    out property <bool> has-focus: editor-keys.has-focus;
    public function take-focus() { editor-keys.focus(); }
    height: 160px;
    border-radius: Theme.radius-control;
    background: Theme.bg-video;
    clip: true;

    // The screen: 16:9, about two thirds of the width, centred.
    private property <float> screen: 16 / 9;
    private property <length> sw: root.width * 0.64;
    private property <length> sh: root.sw / root.screen;
    private property <length> sx: (root.width - root.sw) / 2;
    private property <length> sy: (root.height - root.sh) / 2;

    // Shapes: the source (the still's own 16:9 until the plugin knows the source's), the crop
    // or stretch ratio, the picture as shown (after rotation; an aspect override replaces it).
    private property <float> src-aspect: PictureBridge.source-aspect > 0 ? PictureBridge.source-aspect : 16 / 9;
    private property <int> mode: PictureBridge.reframe-index;
    private property <float> ratio: PictureBridge.ratio-aspect;
    private property <bool> quarter: PictureBridge.rotate-index == 1 || PictureBridge.rotate-index == 3;
    private property <float> framed: root.mode == 0 ? root.src-aspect : root.ratio;
    private property <float> shown: PictureBridge.display-aspect > 0 ? PictureBridge.display-aspect : root.quarter ? 1 / root.framed : root.framed;

    // A drag in progress: 0 none, 1 pan, 2 zoom (a corner), 3 the crop box. While one is, the
    // editor draws from its own values (`live-…`), so the picture follows the pointer at once.
    private property <int> drag;
    private property <length> start-x;
    private property <length> start-y;
    private property <float> start-zoom: 1;
    private property <float> start-px;
    private property <float> start-py;
    private property <float> start-dist: 1;
    // The crop position at the press: the plugin's value follows every move (`crop-at`), so the
    // drag adds its displacement to this, never to the moving value.
    private property <float> start-cx: 50;
    private property <float> start-cy: 50;
    private property <float> live-zoom: 1;
    private property <float> live-px;
    private property <float> live-py;
    private property <float> live-cx: 50;
    private property <float> live-cy: 50;
    private property <bool> framing: root.drag == 1 || root.drag == 2;
    private property <float> cur-zoom: root.framing ? root.live-zoom : PictureBridge.zoom;
    private property <float> cur-px: root.framing ? root.live-px : PictureBridge.pan-x-value;
    private property <float> cur-py: root.framing ? root.live-py : PictureBridge.pan-y-value;
    private property <float> pos-x: root.drag == 3 ? root.live-cx : PictureBridge.crop-x;
    private property <float> pos-y: root.drag == 3 ? root.live-cy : PictureBridge.crop-y;

    // Move mode: the picture fitted in the screen (Keep: inside; Stretch: the screen; Fill:
    // covering it), then zoomed and moved by the pan (a fraction of the zoomed size, as mpv).
    private property <length> base-w: PictureBridge.fit-index == 1 ? root.sw
        : (PictureBridge.fit-index == 2) == (root.shown >= root.screen) ? root.sh * root.shown : root.sw;
    private property <length> base-h: PictureBridge.fit-index == 1 ? root.sh : root.base-w / root.shown;
    private property <length> vw: root.base-w * root.cur-zoom;
    private property <length> vh: root.base-h * root.cur-zoom;
    private property <length> cx: root.sx + root.sw / 2 + root.cur-px * root.vw;
    private property <length> cy: root.sy + root.sh / 2 + root.cur-py * root.vh;
    private property <length> vx: root.cx - root.vw / 2;
    private property <length> vy: root.cy - root.vh / 2;

    // Crop mode: the outer shape fitted in the screen (crop: the source; stretch: the ratio with
    // its bars) and the inner one that moves (crop: the window; stretch: the source).
    private property <float> outer: root.mode == 1 ? root.ratio : root.src-aspect;
    private property <float> inner: root.mode == 1 ? root.src-aspect : root.ratio;
    private property <length> ow: root.outer >= root.screen ? root.sw : root.sh * root.outer;
    private property <length> oh: root.ow / root.outer;
    private property <length> ox: root.sx + (root.sw - root.ow) / 2;
    private property <length> oy: root.sy + (root.sh - root.oh) / 2;
    private property <length> iw: root.inner >= root.outer ? root.ow : root.oh * root.inner;
    private property <length> ih: root.inner >= root.outer ? root.ow / root.inner : root.oh;
    private property <length> inner-x: root.ox + (root.ow - root.iw) * root.pos-x / 100;
    private property <length> inner-y: root.oy + (root.oh - root.ih) * root.pos-y / 100;

    // The corner under the pointer (1 top left, 2 top right, 3 bottom left, 4 bottom right).
    private property <int> corner: root.drag == 2 ? root.corner-at(root.start-x, root.start-y)
        : !touch.has-hover || root.crop-mode || root.drag != 0 ? 0 : root.corner-at(touch.mouse-x, touch.mouse-y);

    pure function corner-at(x: length, y: length) -> int {
        let near-left = abs(x - root.vx) <= 6px;
        let near-right = abs(x - root.vx - root.vw) <= 6px;
        let near-top = abs(y - root.vy) <= 6px;
        let near-bottom = abs(y - root.vy - root.vh) <= 6px;
        if near-top && near-left { return 1; }
        if near-top && near-right { return 2; }
        if near-bottom && near-left { return 3; }
        if near-bottom && near-right { return 4; }
        return 0;
    }
    pure function distance(x: length, y: length) -> float {
        return sqrt(pow((x - root.cx) / 1px, 2) + pow((y - root.cy) / 1px, 2));
    }
    // A new zoom about the picture's centre: the pan is a fraction of the zoomed size, so it
    // scales back by the same factor and the centre stays where it is.
    function zoom-to(zoom: float, done: bool) {
        let next = clamp(zoom, 0.25, 4);
        root.live-px = clamp(root.start-px * root.start-zoom / next, -1, 1);
        root.live-py = clamp(root.start-py * root.start-zoom / next, -1, 1);
        root.live-zoom = next;
        PictureBridge.frame-edit(next, root.live-px, root.live-py, done);
    }
    function press(x: length, y: length) {
        root.start-x = x;
        root.start-y = y;
        if root.crop-mode {
            editor-keys.focus();
            if root.mode != 0 {
                root.start-cx = PictureBridge.crop-x;
                root.start-cy = PictureBridge.crop-y;
                root.live-cx = root.start-cx;
                root.live-cy = root.start-cy;
                root.drag = 3;
            }
        } else {
            root.start-zoom = PictureBridge.zoom;
            root.start-px = PictureBridge.pan-x-value;
            root.start-py = PictureBridge.pan-y-value;
            root.live-zoom = root.start-zoom;
            root.live-px = root.start-px;
            root.live-py = root.start-py;
            root.start-dist = max(1, root.distance(x, y));
            root.drag = root.corner-at(x, y) != 0 ? 2 : 1;
        }
    }
    function drag-to(x: length, y: length) {
        if root.drag == 1 {
            // The picture follows the pointer and snaps to the centre within 4 px.
            let off-x = root.start-px * root.vw + (x - root.start-x);
            let off-y = root.start-py * root.vh + (y - root.start-y);
            root.live-px = clamp((abs(off-x) < 4px ? 0px : off-x) / max(1px, root.vw), -1, 1);
            root.live-py = clamp((abs(off-y) < 4px ? 0px : off-y) / max(1px, root.vh), -1, 1);
            PictureBridge.frame-edit(root.live-zoom, root.live-px, root.live-py, false);
        } else if root.drag == 2 {
            root.zoom-to(root.start-zoom * root.distance(x, y) / root.start-dist, false);
        } else if root.drag == 3 {
            let free-x = root.ow - root.iw;
            let free-y = root.oh - root.ih;
            if free-x > 1px {
                root.live-cx = clamp(root.start-cx + (x - root.start-x) / free-x * 100, 0, 100);
            }
            if free-y > 1px {
                root.live-cy = clamp(root.start-cy + (y - root.start-y) / free-y * 100, 0, 100);
            }
            PictureBridge.crop-at(round(root.live-cx), round(root.live-cy), false);
        }
    }
    // The end of a drag: the pointer released, or the grab cancelled (another window took the
    // pointer, the focus left); either way the last live values are committed and the drag ends.
    function release() {
        if root.drag == 3 {
            PictureBridge.crop-at(round(root.live-cx), round(root.live-cy), true);
        } else if root.drag != 0 {
            PictureBridge.frame-edit(root.live-zoom, root.live-px, root.live-py, true);
        }
        root.drag = 0;
    }

    // ---------------------------------------------------------------- move mode
    // The whole picture, dimmed; then the part inside the screen at full strength.
    Still {
        visible: !root.crop-mode;
        x: root.vx;
        y: root.vy;
        width: root.vw;
        height: root.vh;
        opacity: 0.22;
        source-aspect: root.src-aspect;
        mode: root.mode;
        ratio: root.ratio;
        pos-x: PictureBridge.crop-x;
        pos-y: PictureBridge.crop-y;
        rotate-index: PictureBridge.rotate-index;
        flip-h: PictureBridge.flip-h;
        flip-v: PictureBridge.flip-v;
    }
    Rectangle {
        visible: !root.crop-mode;
        x: root.sx;
        y: root.sy;
        width: root.sw;
        height: root.sh;
        clip: true;
        Still {
            x: root.vx - root.sx;
            y: root.vy - root.sy;
            width: root.vw;
            height: root.vh;
            source-aspect: root.src-aspect;
            mode: root.mode;
            ratio: root.ratio;
            pos-x: PictureBridge.crop-x;
            pos-y: PictureBridge.crop-y;
            rotate-index: PictureBridge.rotate-index;
            flip-h: PictureBridge.flip-h;
            flip-v: PictureBridge.flip-v;
        }
    }
    // The picture's frame and its corner handles.
    Rectangle {
        visible: !root.crop-mode;
        x: root.vx;
        y: root.vy;
        width: root.vw;
        height: root.vh;
        border-width: 1px;
        border-color: #ffffff;
    }
    Handle { visible: !root.crop-mode; x: root.vx - 3px; y: root.vy - 3px; lit: root.corner == 1; }
    Handle { visible: !root.crop-mode; x: root.vx + root.vw - 4px; y: root.vy - 3px; lit: root.corner == 2; }
    Handle { visible: !root.crop-mode; x: root.vx - 3px; y: root.vy + root.vh - 4px; lit: root.corner == 3; }
    Handle { visible: !root.crop-mode; x: root.vx + root.vw - 4px; y: root.vy + root.vh - 4px; lit: root.corner == 4; }

    // ---------------------------------------------------------------- crop mode
    // Crop: the source dimmed, the window at full strength. Stretch: the bars' frame and the
    // source inside it. No ratio yet: the source alone.
    Image {
        visible: root.crop-mode && root.mode != 1;
        x: root.ox;
        y: root.oy;
        width: root.ow;
        height: root.oh;
        source: @image-url("assets/still.jpg");
        image-fit: fill;
        opacity: root.mode == 2 ? 0.35 : 1;
    }
    Rectangle {
        visible: root.crop-mode && root.mode == 1;
        x: root.ox;
        y: root.oy;
        width: root.ow;
        height: root.oh;
        background: #000000;
        border-width: 1px;
        border-color: Theme.text-dim;
    }
    Rectangle {
        visible: root.crop-mode && root.mode != 0;
        x: root.inner-x;
        y: root.inner-y;
        width: root.iw;
        height: root.ih;
        clip: true;
        Image {
            x: root.mode == 2 ? root.ox - root.inner-x : 0px;
            y: root.mode == 2 ? root.oy - root.inner-y : 0px;
            width: root.mode == 2 ? root.ow : root.iw;
            height: root.mode == 2 ? root.oh : root.ih;
            source: @image-url("assets/still.jpg");
            image-fit: fill;
        }
    }
    Rectangle {
        visible: root.crop-mode && root.mode != 0;
        x: root.inner-x;
        y: root.inner-y;
        width: root.iw;
        height: root.ih;
        border-width: 1px;
        border-color: #ffffff;
    }

    // The screen, fixed, on top.
    Rectangle {
        x: root.sx;
        y: root.sy;
        width: root.sw;
        height: root.sh;
        border-width: 1px;
        border-color: Theme.text-dim;
        Text {
            x: 4px;
            y: 2px;
            text: root.crop-mode && root.mode == 0 ? @tr("Pick a ratio below") : @tr("Screen");
            color: Theme.text-dim;
            font-family: Theme.font-mono;
            font-size: Theme.font-xs;
        }
    }

    touch := TouchArea {
        mouse-cursor: root.drag == 1 || root.drag == 3 ? MouseCursor.grabbing
            : root.corner == 1 || root.corner == 4 ? MouseCursor.nwse-resize
            : root.corner == 2 || root.corner == 3 ? MouseCursor.nesw-resize
            : root.crop-mode && root.mode == 0 ? MouseCursor.default : MouseCursor.grab;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.press(self.mouse-x, self.mouse-y); }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up { root.release(); }
            if event.kind == PointerEventKind.cancel { root.release(); }
        }
        moved => {
            if self.pressed { root.drag-to(self.mouse-x, self.mouse-y); }
        }
        // The wheel zooms by the keys' 5 % a notch, about the picture's centre.
        scroll-event(event) => {
            if root.crop-mode || root.drag != 0 || event.delta-y == 0 {
                return reject;
            }
            root.start-zoom = PictureBridge.zoom;
            root.start-px = PictureBridge.pan-x-value;
            root.start-py = PictureBridge.pan-y-value;
            root.zoom-to(root.start-zoom * pow(1.05, clamp(event.delta-y / 60px, -3, 3)), true);
            accept
        }
        double-clicked => {
            if !root.crop-mode { PictureBridge.run("video.frame.centre"); }
        }
    }
    editor-keys := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        focus-on-click: false;
        key-pressed(event) => {
            // Only plain keys: Ctrl / Alt / Meta (and Shift with an arrow) are the player's and
            // other plugins' shortcuts, which pass through. "+" is Shift+= on many keyboards.
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta { return reject; }
            if root.crop-mode {
                if event.text == Key.Escape || event.text == Key.Return {
                    root.crop-mode = false;
                    return accept;
                }
                if event.modifiers.shift { return reject; }
                if event.text == Key.LeftArrow { PictureBridge.run("video.reframe.left"); return accept; }
                if event.text == Key.RightArrow { PictureBridge.run("video.reframe.right"); return accept; }
                if event.text == Key.UpArrow { PictureBridge.run("video.reframe.up"); return accept; }
                if event.text == Key.DownArrow { PictureBridge.run("video.reframe.down"); return accept; }
                return reject;
            }
            if !event.modifiers.shift {
                if event.text == Key.LeftArrow { PictureBridge.run("video.frame.left"); return accept; }
                if event.text == Key.RightArrow { PictureBridge.run("video.frame.right"); return accept; }
                if event.text == Key.UpArrow { PictureBridge.run("video.frame.up"); return accept; }
                if event.text == Key.DownArrow { PictureBridge.run("video.frame.down"); return accept; }
            }
            if event.text == "+" || event.text == "=" { PictureBridge.run("video.frame.zoom-in"); return accept; }
            if event.text == "-" { PictureBridge.run("video.frame.zoom-out"); return accept; }
            reject
        }
    }
    // The focus ring (pink), inside the editor's edge.
    Rectangle {
        visible: editor-keys.has-focus;
        border-radius: Theme.radius-control;
        border-width: 1px;
        border-color: Theme.accent;
    }
}

// A thin upright rule between groups of the editor toolbar.
component Rule {
    width: 9px;
    Rectangle {
        x: 4px;
        y: (parent.height - 14px) / 2;
        width: 1px;
        height: 14px;
        background: Theme.line;
    }
}

// One figure of the editor readout: dim monospace, one line.
component Readout inherits Text {
    color: Theme.text-dim;
    font-family: Theme.font-mono;
    font-size: Theme.font-body;
    vertical-alignment: center;
    overflow: elide;
}

export component Picture inherits Rectangle {
    background: Theme.bg-panel;
    // The height the panel needs to show everything without scrolling (its column, the failure
    // line and the footer), for measuring it against the adjust column's height.
    out property <length> natural-height: content.preferred-height + failure.height + 1px + footer.preferred-height;
    // The GPU-only controls' reason while greyed: the switch is the Rendering section's.
    private property <string> render-reason: @tr("Needs GPU rendering: turn it on under Rendering, then restart");
    private property <string> status-text: PictureBridge.status == "no-picture" ? @tr("No picture in the current source")
        : PictureBridge.status == "filter" ? @tr("Picture processing failed")
        : PictureBridge.status == "view" ? @tr("Display unavailable")
        : PictureBridge.status == "shader" ? @tr("Shader failed to load")
        : PictureBridge.status == "render-conflict" ? @tr("Render options unavailable")
        : PictureBridge.status == "render" ? @tr("Render settings failed")
        : "";
    private property <string> detail-text: !PictureBridge.conflict ? PictureBridge.detail
        : PictureBridge.status == "view" ? @tr("Another plugin controls the display")
        : @tr("Another plugin controls the render options");
    private property <[string]> aspect-names: PictureBridge.custom-ratio == ""
        ? [@tr("Default (Source)"), "4:3", "16:9", "16:10", "1.85:1", "2.35:1"]
        : [@tr("Default (Source)"), "4:3", "16:9", "16:10", "1.85:1", "2.35:1", @tr("Custom ({})", PictureBridge.custom-ratio)];
    private property <Keys> keys: PictureBridge.keys;
    // Denoise: any of the three on (the chip and the card), and which ones ("3D + Temporal").
    private property <bool> any-denoise: PictureBridge.d3-enabled || PictureBridge.gradual-enabled || PictureBridge.temporal-enabled;
    private property <string> denoise-first: PictureBridge.d3-enabled ? @tr("3D") : "";
    private property <string> denoise-second: root.denoise-first
        + (PictureBridge.gradual-enabled ? (root.denoise-first != "" ? " + " : "") + @tr("Gradual") : "");
    private property <string> denoise-summary: root.denoise-second
        + (PictureBridge.temporal-enabled ? (root.denoise-second != "" ? " + " : "") + @tr("Temporal") : "");
    // The readout's crop: "—", the ratio, or the ratio stretched to (with bars).
    private property <string> ratio-label: ["4:3", "16:9", "16:10", "1.85:1", "2.35:1"][PictureBridge.ratio-index];
    private property <string> crop-text: PictureBridge.reframe-index == 0 ? "—"
        : PictureBridge.reframe-index == 1 ? @tr("{} with bars", root.ratio-label) : root.ratio-label;
    // The Advanced choices' names, for the Choice boxes and the closed row's summary.
    private property <[string]> deinterlace-names: [@tr("Auto"), @tr("Always"), @tr("Never")];
    private property <[string]> tone-names: [@tr("Auto"), @tr("Off"), "BT.2390", "Hable", "Mobius", "Reinhard", @tr("Clip")];
    private property <string> advanced-title: @tr("Advanced");
    private property <string> shaders-text: @tr("{n} shader" | "{n} shaders" % PictureBridge.shader-count);
    // TRANSLATORS: the closed Advanced row's summary: {0} the deinterlace mode, {1} the HDR tone mapping, {2} "3 shaders".
    private property <string> advanced-summary: @tr("Deinterlace {0} · HDR {1} · {2}",
        root.deinterlace-names[PictureBridge.deinterlace-index], root.tone-names[PictureBridge.tone-index], root.shaders-text);
    // The GPU switch's status line (mockup 31) and its dot.
    private property <string> gpu-status: PictureBridge.gpu.busy ? @tr("Switching…")
        : PictureBridge.gpu.pending ? (PictureBridge.gpu.nextgpu ? @tr("Restart to apply · GPU from the next start")
            : @tr("Restart to apply · software rendering from the next start"))
        : PictureBridge.gpu.ongpu ? (PictureBridge.gpu.name != "" ? @tr("On the GPU · {}", PictureBridge.gpu.name) : @tr("On the GPU"))
        : PictureBridge.gpu.reason != "" ? @tr("Software rendering · {}", PictureBridge.gpu.reason)
        : @tr("Software rendering · turn on, then restart");
    private property <string> gpu-tone: PictureBridge.gpu.busy ? "off" : PictureBridge.gpu.pending ? "pending"
        : PictureBridge.gpu.ongpu ? "on" : "off";
    // The upscaling switch's status line.
    private property <string> up-kind: PictureBridge.upscaling.kind;
    private property <string> up-status: PictureBridge.upscaling.busy ? @tr("Switching…")
        : root.up-kind == "upscaling" ? (PictureBridge.upscaling.from > 0 && PictureBridge.upscaling.to > 0
            ? (PictureBridge.upscaling.gpu != ""
                // TRANSLATORS: {0} and {1} are the video's height and the shown height in pixels (1080, 2160), {2} the GPU's name.
                ? @tr("Upscaling {0}p → {1}p on {2}", PictureBridge.upscaling.from, PictureBridge.upscaling.to, PictureBridge.upscaling.gpu)
                : @tr("Upscaling {0}p → {1}p", PictureBridge.upscaling.from, PictureBridge.upscaling.to))
            : @tr("Upscaling on the GPU"))
        : root.up-kind == "on" ? @tr("On · upscales video shown larger than its size")
        : root.up-kind == "idle" ? @tr("On · this video is not shown larger than its size")
        // Waiting: a short line (the narrowest adjust column shows about 36 characters), its
        // tooltip the reason (`up-tip`). Only what the user can change in the player is worded as
        // something to do (this panel, other plugins' effects): hardware decoding has no setting.
        : root.up-kind == "effects" ? @tr("Waiting · reset picture adjustments")
        : root.up-kind == "plugins" ? PictureBridge.upscaling.detail
        : root.up-kind == "copy-back" ? @tr("Waiting · frames copied to memory")
        : root.up-kind == "hwdec-off" ? @tr("Waiting · hardware decoding is off")
        : root.up-kind == "software" ? @tr("Waiting · video decoded in software")
        : root.up-kind == "other-hwdec" ? @tr("Waiting · another hardware decoder")
        : root.up-kind == "waiting" ? @tr("Waiting · {}", PictureBridge.upscaling.detail)
        : root.up-kind == "rendering" ? @tr("Needs GPU rendering (software rendering now)")
        : root.up-kind == "platform" ? @tr("Not available on this system (Windows with an NVIDIA RTX GPU)")
        : root.up-kind == "gpu" ? @tr("Not available on this GPU · {}", PictureBridge.upscaling.detail)
        : root.up-kind == "other" ? PictureBridge.upscaling.detail
        : @tr("Off · sharpens video shown larger than its size");
    // Its tooltip: why it waits, where the line only says what to do; else the line itself.
    private property <string> up-tip: PictureBridge.upscaling.busy ? root.up-status
        : root.up-kind == "effects" ? @tr("Colour, Effects or Geometry (flip, rotation, crop/stretch) away from their defaults, or Deinterlace Always, need the frames in memory, but upscaling needs them on the GPU. Reset them to upscale.")
        : root.up-kind == "plugins" ? PictureBridge.upscaling.tip
        : root.up-kind == "copy-back" ? @tr("The video is decoded on the GPU, but its frames are copied to memory, and upscaling needs them on the GPU.")
        : root.up-kind == "hwdec-off" ? @tr("Hardware decoding is off, and upscaling needs the video decoded on the GPU.")
        : root.up-kind == "software" ? @tr("This video is decoded in software (for example a format the GPU does not decode), but upscaling needs it decoded on the GPU. Videos the GPU decodes are upscaled.")
        : root.up-kind == "other-hwdec" ? @tr("This video is decoded with another hardware decoder, and upscaling needs it decoded on the GPU that renders it.")
        : root.up-status;
    private property <string> up-tone: root.up-kind == "upscaling" ? "on"
        : root.up-kind == "effects" || root.up-kind == "plugins" || root.up-kind == "copy-back"
            || root.up-kind == "hwdec-off" || root.up-kind == "software" || root.up-kind == "other-hwdec"
            || root.up-kind == "waiting" ? "pending" : "off";
    private property <int> advanced-serial: PictureBridge.advanced-serial;

    // +3, 0, -2 (a figure of the readout).
    pure function signed(n: int) -> string {
        return n > 0 ? "+" + n : "" + n;
    }

    // HDR Settings…: the plugin opened Advanced (`advanced-open`); scroll so that its row is at the
    // top, or as far as the column scrolls.
    function show-advanced() {
        scroll.viewport-y = -max(0px, min(advanced-head.y, content.preferred-height - scroll.visible-height));
    }
    changed advanced-serial => { root.show-advanced(); }
    init => {
        if root.advanced-serial > 0 { root.show-advanced(); }
    }

    VerticalLayout {
        scroll := ScrollView {
            vertical-stretch: 1;
            viewport-width: content.width;
            viewport-height: content.preferred-height;
            content := VerticalLayout {
                width: scroll.width - 12px;
                padding-left: 10px;
                padding-right: 4px;
                padding-top: 4px;
                padding-bottom: 6px;
                spacing: 4px;
                alignment: start;

                // ---------------------------------------------------------------- Rendering
                // The renderer for the next start (the player keeps the choice; Restart applies it
                // now) and AI Upscaling, each a switch over a status line.
                Head { text: @tr("Rendering"); }
                VerticalLayout {
                    visible: PictureBridge.gpu.shown;
                    height: PictureBridge.gpu.shown ? gpu-rows.preferred-height : 0px;
                    gpu-rows := VerticalLayout {
                        spacing: 0px;
                        HorizontalLayout {
                            height: 20px;
                            spacing: 6px;
                            ToolTipArea {
                                horizontal-stretch: 0;
                                min-width: 40px;
                                preferred-width: gpu-switch.preferred-width;
                                text: PictureBridge.gpu.busy ? @tr("Switching…")
                                    : !PictureBridge.gpu.enabled && PictureBridge.gpu.reason != "" ? PictureBridge.gpu.reason
                                    : PictureBridge.gpu.pending ? @tr("Restart Vestra Player to apply")
                                    : @tr("Draw the video on the GPU from the next start");
                                keys: [{ key: root.keys.gpu, text: "" }];
                                gpu-switch := Switch {
                                    width: 100%;
                                    height: 100%;
                                    text: @tr("GPU Rendering");
                                    enabled: PictureBridge.gpu.enabled && !PictureBridge.gpu.busy;
                                    checked: PictureBridge.gpu.checked;
                                    toggled(on) => { PictureBridge.run("video.gpu-rendering"); }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout {
                                alignment: center;
                                width: PictureBridge.gpu.pending ? restart.preferred-width : 0px;
                                visible: PictureBridge.gpu.pending;
                                restart := Button {
                                    text: @tr("Restart");
                                    small: true;
                                    enabled: !PictureBridge.gpu.busy;
                                    clicked => { PictureBridge.run("video.gpu-rendering.restart"); }
                                }
                            }
                            Cap { text: root.keys.gpu; }
                        }
                        StatusLine { text: root.gpu-status; tone: root.gpu-tone; }
                    }
                }
                VerticalLayout {
                    spacing: 0px;
                    HorizontalLayout {
                        height: 20px;
                        spacing: 6px;
                        ToolTipArea {
                            horizontal-stretch: 0;
                            min-width: 40px;
                            preferred-width: up-switch.preferred-width;
                            text: @tr("NVIDIA RTX Video Super Resolution: sharpens video shown larger than its size. Needs GPU rendering on an NVIDIA RTX GPU, and Super Resolution turned on in the NVIDIA app (System ▸ Video ▸ RTX Video Enhancement).");
                            up-switch := Switch {
                                width: 100%;
                                height: 100%;
                                text: @tr("AI Upscaling");
                                enabled: PictureBridge.upscaling.enabled && !PictureBridge.upscaling.busy;
                                checked: PictureBridge.upscaling.checked;
                                toggled(on) => { PictureBridge.run("video.upscaling"); }
                            }
                        }
                        Badge {
                            // i18n-ignore: the product's name
                            text: "RTX VSR";
                            tip: @tr("NVIDIA RTX Video Super Resolution");
                            lit: root.up-kind == "upscaling";
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    StatusLine { text: root.up-status; tip: root.up-tip; tone: root.up-tone; }
                }

                // ---------------------------------------------------------------- Colour
                // The presets sit in the heading row, after its rule.
                Head {
                    text: @tr("Colour");
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 3px;
                        VerticalLayout { alignment: center; Preset { text: @tr("Original"); clicked => { PictureBridge.preset("original"); } } }
                        VerticalLayout { alignment: center; Preset { text: @tr("Vivid"); clicked => { PictureBridge.preset("vivid"); } } }
                        VerticalLayout { alignment: center; Preset { text: @tr("Cinema"); clicked => { PictureBridge.preset("cinema"); } } }
                        VerticalLayout { alignment: center; Preset { text: @tr("Soft"); clicked => { PictureBridge.preset("soft"); } } }
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    ColourRow {
                        label: @tr("Brightness");
                        down: root.keys.brightnessdown;
                        up: root.keys.brightnessup;
                        value <=> PictureBridge.brightness;
                        edited(v) => { PictureBridge.adjust("brightness", v); }
                        committed(v) => { PictureBridge.commit("brightness", v); }
                        reset => { PictureBridge.reset-field("brightness"); }
                    }
                    ColourRow {
                        label: @tr("Contrast");
                        down: root.keys.contrastdown;
                        up: root.keys.contrastup;
                        value <=> PictureBridge.contrast;
                        edited(v) => { PictureBridge.adjust("contrast", v); }
                        committed(v) => { PictureBridge.commit("contrast", v); }
                        reset => { PictureBridge.reset-field("contrast"); }
                    }
                    ColourRow {
                        label: @tr("Saturation");
                        down: root.keys.saturationdown;
                        up: root.keys.saturationup;
                        value <=> PictureBridge.saturation;
                        edited(v) => { PictureBridge.adjust("saturation", v); }
                        committed(v) => { PictureBridge.commit("saturation", v); }
                        reset => { PictureBridge.reset-field("saturation"); }
                    }
                    ColourRow {
                        label: @tr("Hue");
                        down: root.keys.huedown;
                        up: root.keys.hueup;
                        value <=> PictureBridge.hue;
                        edited(v) => { PictureBridge.adjust("hue", v); }
                        committed(v) => { PictureBridge.commit("hue", v); }
                        reset => { PictureBridge.reset-field("hue"); }
                    }
                    ColourRow {
                        label: @tr("Gamma");
                        value <=> PictureBridge.gamma;
                        edited(v) => { PictureBridge.adjust("gamma", v); }
                        committed(v) => { PictureBridge.commit("gamma", v); }
                        reset => { PictureBridge.reset-field("gamma"); }
                    }
                }

                // ---------------------------------------------------------------- Effects
                // Eight chips (click: on or off), the last two Frames' Doubling and Interpolate
                // (they exclude each other; Interpolate needs GPU rendering); under them a strength
                // row for each effect that is on, and the Denoise card while any denoiser is on.
                effects-head := Head { text: @tr("Effects"); }
                GridLayout {
                    spacing: 3px;
                    Chip {
                        row: 0;
                        col: 0;
                        text: @tr("Sharpen");
                        tip: @tr("Sharpen");
                        key: root.keys.sharpen;
                        checked: PictureBridge.sharpen-enabled;
                        toggled(on) => { PictureBridge.toggle("sharpen", on); }
                    }
                    Chip {
                        row: 0;
                        col: 1;
                        text: @tr("Edges");
                        tip: @tr("Wide-radius sharpening that mainly strengthens outlines");
                        key: root.keys.edge;
                        checked: PictureBridge.edge-enabled;
                        toggled(on) => { PictureBridge.toggle("edge", on); }
                    }
                    Chip {
                        row: 1;
                        col: 0;
                        text: @tr("Blur");
                        tip: @tr("Gaussian Blur");
                        key: root.keys.blur;
                        checked: PictureBridge.blur-enabled;
                        toggled(on) => { PictureBridge.toggle("blur", on); }
                    }
                    Chip {
                        row: 1;
                        col: 1;
                        text: @tr("Deblock");
                        tip: @tr("Deblock");
                        key: root.keys.deblock;
                        checked: PictureBridge.deblock-enabled;
                        toggled(on) => { PictureBridge.toggle("deblock", on); }
                    }
                    Chip {
                        row: 2;
                        col: 0;
                        text: @tr("Deband");
                        tip: @tr("Deband");
                        key: root.keys.deband;
                        checked: PictureBridge.deband-enabled;
                        toggled(on) => { PictureBridge.toggle("deband", on); }
                    }
                    // The master switch of the three denoisers (lit while any is on); it has no
                    // key of its own, so the tip names the denoisers' keys.
                    Chip {
                        row: 2;
                        col: 1;
                        text: @tr("Denoise");
                        tip: @tr("Denoise: turns the denoisers on or off");
                        tip-keys: [{ key: root.keys.d3, text: @tr("3D") }, { key: root.keys.temporal, text: @tr("Temporal") }];
                        checked: root.any-denoise;
                        toggled(on) => { PictureBridge.toggle("denoise", on); }
                    }
                    Chip {
                        row: 3;
                        col: 0;
                        text: @tr("Doubling");
                        tip: PictureBridge.blend-enough ? @tr("Rate already high enough")
                            : @tr("Doubles the frame rate (up to 60), blending each in-between frame from its neighbours");
                        key: root.keys.doubling;
                        checked: PictureBridge.frames-index == 1;
                        toggled(on) => { PictureBridge.choose("frames", on ? 1 : 0); }
                    }
                    Chip {
                        row: 3;
                        col: 1;
                        text: @tr("Interpolate");
                        tip: PictureBridge.render-ready ? @tr("GPU interpolation to the display refresh rate; excludes frame doubling") : root.render-reason;
                        key: root.keys.interpolation;
                        enabled: PictureBridge.render-ready;
                        checked: PictureBridge.frames-index == 2;
                        toggled(on) => { PictureBridge.choose("frames", on ? 2 : 0); }
                    }
                }
                // The strengths of the effects that are on and the Denoise card: one layout without
                // spacing, each row 0 px high while off, so nothing shows for an effect that is off.
                VerticalLayout {
                    spacing: 0px;
                    StrengthRow {
                        label: @tr("Sharpen");
                        tip: @tr("Sharpen");
                        key: root.keys.sharpen;
                        shown: PictureBridge.sharpen-enabled;
                        value <=> PictureBridge.sharpen-strength;
                        edited(v) => { PictureBridge.adjust("sharpen", v); }
                        committed(v) => { PictureBridge.commit("sharpen", v); }
                        reset => { PictureBridge.reset-field("sharpen"); }
                    }
                    StrengthRow {
                        label: @tr("Edges");
                        tip: @tr("Wide-radius sharpening that mainly strengthens outlines");
                        key: root.keys.edge;
                        shown: PictureBridge.edge-enabled;
                        value <=> PictureBridge.edge-strength;
                        edited(v) => { PictureBridge.adjust("edge", v); }
                        committed(v) => { PictureBridge.commit("edge", v); }
                        reset => { PictureBridge.reset-field("edge"); }
                    }
                    StrengthRow {
                        label: @tr("Blur");
                        tip: @tr("Gaussian Blur");
                        key: root.keys.blur;
                        maximum: 10;
                        shown: PictureBridge.blur-enabled;
                        value <=> PictureBridge.blur-strength;
                        edited(v) => { PictureBridge.adjust("blurStrength", v); }
                        committed(v) => { PictureBridge.commit("blurStrength", v); }
                        reset => { PictureBridge.reset-field("blurStrength"); }
                    }
                    StrengthRow {
                        label: @tr("Deblock");
                        tip: @tr("Below 50 is weak, 50 and above strong; most visible on low-bitrate MPEG-2/MPEG-4");
                        key: root.keys.deblock;
                        shown: PictureBridge.deblock-enabled;
                        value <=> PictureBridge.deblock-strength;
                        edited(v) => { PictureBridge.adjust("deblock", v); }
                        committed(v) => { PictureBridge.commit("deblock", v); }
                        reset => { PictureBridge.reset-field("deblock"); }
                    }
                    StrengthRow {
                        label: @tr("Deband");
                        tip: @tr("Deband");
                        key: root.keys.deband;
                        shown: PictureBridge.deband-enabled;
                        value <=> PictureBridge.deband-strength;
                        edited(v) => { PictureBridge.adjust("deband", v); }
                        committed(v) => { PictureBridge.commit("deband", v); }
                        reset => { PictureBridge.reset-field("deband"); }
                    }
                    Rectangle { height: root.any-denoise ? 4px : 0px; }
                    // Denoise: one card, a row per denoiser (three independent filters, each with
                    // its own switch and strength); the title line sums up which are on.
                    Rectangle {
                        visible: root.any-denoise;
                        height: root.any-denoise ? card.preferred-height : 0px;
                        border-radius: Theme.radius-control;
                        border-width: 1px;
                        border-color: Theme.line;
                        background: Theme.bg-list;
                        card := VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 0px;
                            HorizontalLayout {
                                height: 20px;
                                spacing: 6px;
                                Text {
                                    text: @tr("Denoise");
                                    color: Theme.text;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.denoise-summary;
                                    color: Theme.text-dim;
                                    font-size: Theme.font-body;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            DenoiseRow {
                                label: @tr("3D");
                                tip: @tr("3D Denoise");
                                key: root.keys.d3;
                                checked: PictureBridge.d3-enabled;
                                value <=> PictureBridge.d3-strength;
                                toggled(on) => { PictureBridge.toggle("d3", on); }
                                edited(v) => { PictureBridge.adjust("d3", v); }
                                committed(v) => { PictureBridge.commit("d3", v); }
                                reset => { PictureBridge.reset-field("d3"); }
                            }
                            DenoiseRow {
                                label: @tr("Gradual");
                                tip: @tr("Gradual Denoise");
                                key: root.keys.gradual;
                                checked: PictureBridge.gradual-enabled;
                                value <=> PictureBridge.gradual-strength;
                                toggled(on) => { PictureBridge.toggle("gradual", on); }
                                edited(v) => { PictureBridge.adjust("gradual", v); }
                                committed(v) => { PictureBridge.commit("gradual", v); }
                                reset => { PictureBridge.reset-field("gradual"); }
                            }
                            DenoiseRow {
                                label: @tr("Temporal");
                                tip: @tr("Temporal Denoise");
                                key: root.keys.temporal;
                                checked: PictureBridge.temporal-enabled;
                                value <=> PictureBridge.temporal-strength;
                                toggled(on) => { PictureBridge.toggle("temporal", on); }
                                edited(v) => { PictureBridge.adjust("temporal", v); }
                                committed(v) => { PictureBridge.commit("temporal", v); }
                                reset => { PictureBridge.reset-field("temporal"); }
                            }
                        }
                    }
                }

                // ---------------------------------------------------------------- Geometry
                // The editor (see `Editor`), its toolbar, one line of numbers, the crop ratios
                // (crop mode only), then Aspect and Fit.
                geometry-head := Head { text: @tr("Geometry"); }
                editor := Editor { }
                HorizontalLayout {
                    spacing: 2px;
                    Glyph {
                        glyph: Glyphs.rotl;
                        tip: @tr("Rotate Left");
                        clicked => { PictureBridge.choose("rotate", PictureBridge.rotate-index == 0 ? 3 : PictureBridge.rotate-index - 1); }
                    }
                    Glyph {
                        glyph: Glyphs.rotr;
                        tip: @tr("Rotate Right");
                        key: root.keys.rotate;
                        clicked => { PictureBridge.choose("rotate", PictureBridge.rotate-index == 3 ? 0 : PictureBridge.rotate-index + 1); }
                    }
                    Text {
                        width: 30px;
                        text: (PictureBridge.rotate-index * 90) + "°";
                        color: Theme.text-dim;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                    }
                    Rule { }
                    Glyph {
                        glyph: Glyphs.flipv;
                        tip: @tr("Flip Vertically");
                        key: root.keys.flipv;
                        checked: PictureBridge.flip-v;
                        clicked => { PictureBridge.toggle("flipV", !PictureBridge.flip-v); }
                    }
                    Glyph {
                        glyph: Glyphs.fliph;
                        tip: @tr("Flip Horizontally");
                        key: root.keys.fliph;
                        checked: PictureBridge.flip-h;
                        clicked => { PictureBridge.toggle("flipH", !PictureBridge.flip-h); }
                    }
                    Rule { }
                    Glyph {
                        glyph: Glyphs.crop;
                        tip: editor.crop-mode ? @tr("Leave Crop Mode") : @tr("Crop: pick a ratio, then drag the box");
                        key: editor.crop-mode ? "Esc" : "";
                        checked: editor.crop-mode;
                        clicked => {
                            editor.crop-mode = !editor.crop-mode;
                            if editor.crop-mode { editor.take-focus(); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Glyph { glyph: Glyphs.centre; tip: @tr("Center Frame"); key: root.keys.centre; clicked => { PictureBridge.run("video.frame.centre"); } }
                    Glyph { glyph: Glyphs.reset; tip: @tr("Reset Framing"); key: root.keys.framing; clicked => { PictureBridge.run("video.frame.reset"); } }
                }
                // The numbers, one dim monospace line; the crop ratios below it in crop mode.
                VerticalLayout {
                    spacing: 0px;
                    HorizontalLayout {
                        height: 16px;
                        spacing: 10px;
                        Readout { text: @tr("Zoom {}%", PictureBridge.zoom-percent); }
                        Readout {
                            visible: !editor.crop-mode || PictureBridge.reframe-index == 0;
                            width: self.visible ? self.preferred-width : 0px;
                            // TRANSLATORS: {0} and {1} are the picture's offset in percent, across and down (+3, -2).
                            text: @tr("Offset {0}, {1}", root.signed(PictureBridge.pan-x), root.signed(PictureBridge.pan-y));
                        }
                        Readout { text: @tr("Crop {}", root.crop-text); }
                        Readout {
                            visible: editor.crop-mode && PictureBridge.reframe-index != 0;
                            horizontal-stretch: 1;
                            // TRANSLATORS: the crop box's position in percent, across and down (50 = centred).
                            text: @tr("at {0}%, {1}%", PictureBridge.crop-x, PictureBridge.crop-y);
                        }
                    }
                    Rectangle {
                        visible: editor.crop-mode;
                        height: editor.crop-mode ? crop-rows.preferred-height : 0px;
                        crop-rows := VerticalLayout {
                            padding-top: 4px;
                            spacing: 4px;
                            ToolTipArea {
                                height: Layout.row;
                                text: @tr("Crop to a ratio; drag the box in the editor to choose the part kept");
                                VerticalLayout {
                                    width: 100%;
                                    height: 100%;
                                    alignment: center;
                                    SegmentBar {
                                        Segment { text: @tr("Off"); selected: PictureBridge.reframe-index == 0; clicked => { PictureBridge.choose("crop", 0); } }
                                        Segment { text: "4:3"; selected: PictureBridge.reframe-index != 0 && PictureBridge.ratio-index == 0; clicked => { PictureBridge.choose("crop", 1); } }
                                        Segment { text: "16:9"; selected: PictureBridge.reframe-index != 0 && PictureBridge.ratio-index == 1; clicked => { PictureBridge.choose("crop", 2); } }
                                        Segment { text: "16:10"; selected: PictureBridge.reframe-index != 0 && PictureBridge.ratio-index == 2; clicked => { PictureBridge.choose("crop", 3); } }
                                        Segment { text: "1.85"; selected: PictureBridge.reframe-index != 0 && PictureBridge.ratio-index == 3; clicked => { PictureBridge.choose("crop", 4); } }
                                        Segment { text: "2.35"; selected: PictureBridge.reframe-index != 0 && PictureBridge.ratio-index == 4; clicked => { PictureBridge.choose("crop", 5); } }
                                    }
                                }
                            }
                            // Crop/Stretch's other half: the ratio by adding bars instead of cutting.
                            ToolTipArea {
                                height: Theme.checkbox-row-height;
                                text: @tr("Stretch to the ratio: add bars instead of cutting the picture");
                                Switch {
                                    width: 100%;
                                    height: 100%;
                                    text: @tr("Add bars instead of cutting");
                                    enabled: PictureBridge.reframe-index != 0;
                                    checked: PictureBridge.reframe-index == 1;
                                    toggled(on) => { PictureBridge.choose("reframe", on ? 1 : 2); }
                                }
                            }
                        }
                    }
                }
                // Aspect and Fit, closer together.
                VerticalLayout {
                    spacing: 2px;
                    Row {
                        label: @tr("Aspect");
                        tip: @tr("Aspect ratio");
                        key: root.keys.aspect;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Choice {
                                window-height: root.height;
                                model: root.aspect-names;
                                current-index <=> PictureBridge.aspect-index;
                                selected(index) => { PictureBridge.choose("aspect", index); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Glyph {
                                glyph: Glyphs.more;
                                tip: @tr("Custom Aspect Ratio…");
                                clicked => { PictureBridge.custom-aspect(); }
                            }
                        }
                    }
                    Row {
                        label: @tr("Fit");
                        tip: PictureBridge.fit-index == 1 ? @tr("Ignore Aspect Ratio") : PictureBridge.fit-index == 2 ? @tr("Fill Window") : @tr("Keep Aspect Ratio");
                        VerticalLayout {
                            alignment: center;
                            SegmentBar {
                                Segment { text: @tr("Keep"); selected: PictureBridge.fit-index == 0; clicked => { PictureBridge.choose("fit", 0); } }
                                Segment { text: @tr("Stretch"); selected: PictureBridge.fit-index == 1; clicked => { PictureBridge.choose("fit", 1); } }
                                Segment { text: @tr("Fill"); selected: PictureBridge.fit-index == 2; clicked => { PictureBridge.choose("fit", 2); } }
                            }
                        }
                    }
                }

                // ---------------------------------------------------------------- Advanced (closed by default)
                // A disclosure row (remembered); closed, it sums up the values inside.
                advanced-head := Rectangle {
                    min-height: 18px;
                    ToolTipArea {
                        width: 100%;
                        height: 100%;
                        text: PictureBridge.advanced-open ? "" : root.advanced-summary;
                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            spacing: 5px;
                            padding-top: 2px;
                            VerticalLayout {
                                alignment: center;
                                Icon { name: PictureBridge.advanced-open ? "caret-down" : "submenu"; color: Theme.text-dim; }
                            }
                            Text {
                                text: root.advanced-title.to-uppercase();
                                color: Theme.text-dim;
                                font-size: Theme.font-body;
                                vertical-alignment: center;
                            }
                            Text {
                                visible: !PictureBridge.advanced-open;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                text: PictureBridge.advanced-open ? "" : root.advanced-summary;
                                color: Theme.text-dim;
                                font-size: Theme.font-body;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            VerticalLayout {
                                horizontal-stretch: PictureBridge.advanced-open ? 1 : 0;
                                min-width: PictureBridge.advanced-open ? 8px : 0px;
                                alignment: center;
                                Rectangle { height: 1px; background: Theme.line; }
                            }
                        }
                        TouchArea {
                            clicked => {
                                PictureBridge.advanced-open = !PictureBridge.advanced-open;
                                PictureBridge.set-advanced(PictureBridge.advanced-open);
                            }
                        }
                    }
                }
                if PictureBridge.advanced-open: VerticalLayout {
                    spacing: 4px;
                    Line {
                        label: @tr("Deinterlace");
                        key: root.keys.deinterlace;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Choice {
                                model: root.deinterlace-names;
                                current-index <=> PictureBridge.deinterlace-index;
                                selected(index) => { PictureBridge.choose("deinterlace", index); }
                            }
                        }
                    }
                    // Auto (index 0) is the player's deinterlacer, always at field rate: Output applies to Always.
                    HorizontalLayout {
                        padding-left: Layout.column + 6px;
                        height: Layout.row;
                        ToolTipArea {
                            text: PictureBridge.deinterlace-index == 0 ? @tr("Auto outputs by field (double rate); this setting applies to Always")
                                : @tr("By Field (Double Rate)");
                            Switch {
                                width: 100%;
                                height: 100%;
                                text: @tr("Double rate");
                                enabled: PictureBridge.deinterlace-index == 1;
                                checked: PictureBridge.deinterlace-index == 0 || PictureBridge.output-index == 1;
                                toggled(on) => { PictureBridge.choose("output", on ? 1 : 0); }
                            }
                        }
                    }
                    Row {
                        label: @tr("HDR");
                        tip: !PictureBridge.render-ready ? root.render-reason
                            : PictureBridge.not-hdr ? @tr("Tone mapping of HDR sources (PQ / HLG) on SDR displays · Not an HDR source")
                            : @tr("Tone mapping of HDR sources (PQ / HLG) on SDR displays");
                        enabled: PictureBridge.render-ready;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Choice {
                                enabled: PictureBridge.render-ready;
                                window-height: root.height;
                                model: root.tone-names;
                                current-index <=> PictureBridge.tone-index;
                                selected(index) => { PictureBridge.choose("toneMapping", index); }
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: Layout.column + 6px;
                        height: Layout.row;
                        ToolTipArea {
                            text: PictureBridge.render-ready ? @tr("Target brightness") : root.render-reason;
                            detail: @tr("· double-click: Default");
                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                spacing: 6px;
                                Fader {
                                    enabled: PictureBridge.render-ready;
                                    minimum: 100;
                                    maximum: 400;
                                    value <=> PictureBridge.target-peak;
                                    edited(v) => { PictureBridge.adjust("targetPeak", v); }
                                    committed(v) => { PictureBridge.commit("targetPeak", v); }
                                    reset => { PictureBridge.reset-field("targetPeak"); }
                                }
                                Text {
                                    width: 54px;
                                    text: @tr("{} nits", PictureBridge.peak-nits);
                                    color: PictureBridge.render-ready ? Theme.text-list : Theme.text-dim;
                                    font-size: Theme.font-body;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: Layout.column + 6px;
                        height: Layout.row;
                        ToolTipArea {
                            text: PictureBridge.render-ready ? @tr("Dynamic Peak Detection") : root.render-reason;
                            Switch {
                                width: 100%;
                                height: 100%;
                                text: @tr("Peak detection");
                                enabled: PictureBridge.render-ready;
                                checked: PictureBridge.peak-detect;
                                toggled(on) => { PictureBridge.toggle("peakDetect", on); }
                            }
                        }
                    }
                    // Shaders: the switch needs GPU rendering; the list stays usable to arrange it beforehand.
                    Row {
                        label: @tr("Shaders");
                        tip: PictureBridge.render-ready ? @tr("mpv user shaders (.glsl), run in list order") : root.render-reason;
                        key: root.keys.shaders;
                        enabled: PictureBridge.render-ready;
                        Switch {
                            text: root.shaders-text;
                            enabled: PictureBridge.render-ready;
                            checked: PictureBridge.shaders-enabled;
                            toggled(on) => { PictureBridge.toggle("shaders", on); }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button { text: @tr("List…"); small: true; clicked => { PictureBridge.shader-list(); } }
                        }
                    }
                }
            }
        }

        // A failure of the chain, the display or the render options: one line, the player's message in the tip.
        failure := Rectangle {
            vertical-stretch: 0;
            height: PictureBridge.failed ? 26px : 0px;
            visible: PictureBridge.failed;
            ToolTipArea {
                text: root.detail-text != "" ? root.detail-text : root.status-text;
                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    Text {
                        horizontal-stretch: 1;
                        text: root.status-text;
                        color: Theme.accent;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    VerticalLayout {
                        alignment: center;
                        Button { text: @tr("Retry"); small: true; clicked => { PictureBridge.retry(); } }
                    }
                }
            }
        }

        // Bottom: the master switch and Reset All (Colour, Effects and Geometry; not the Advanced preferences).
        Rectangle { vertical-stretch: 0; height: 1px; background: Theme.line; }
        footer := HorizontalLayout {
            vertical-stretch: 0;
            padding: 8px;
            padding-left: 10px;
            spacing: 6px;
            ToolTipArea {
                horizontal-stretch: 1;
                min-height: Theme.button-height;
                text: @tr("Enable picture effects");
                CheckRow {
                    width: 100%;
                    height: 100%;
                    text: @tr("Enable picture effects");
                    checked: PictureBridge.effect-enabled;
                    toggled(on) => { PictureBridge.toggle-effect(on); }
                }
            }
            ToolTipArea {
                horizontal-stretch: 0;
                width: reset-all.preferred-width;
                min-height: Theme.button-height;
                text: @tr("Colour, effects and geometry back to their defaults; the Advanced settings stay");
                keys: [{ key: root.keys.resetpanel, text: "" }];
                reset-all := Button {
                    width: 100%;
                    height: 100%;
                    text: @tr("Reset All");
                    clicked => { PictureBridge.run("video.resetPanel"); }
                }
            }
            Cap { text: root.keys.resetpanel; }
        }
    }
}

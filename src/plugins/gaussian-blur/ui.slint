// 仅用于 Slint 实验；本版本界面与接口和最终成品 API 会有很大差异。
import { Button, CheckBox, Slider } from "std-widgets.slint";

export global GaussianBlurState {
    in-out property <bool> enabled: false;
    in-out property <float> sigma: 2;
    in-out property <string> status: "高斯模糊已关闭";
    callback action(string, float);
}

export component GaussianBlurPanel inherits Rectangle {
    background: #202a36;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            CheckBox {
                text: "高斯模糊";
                checked: GaussianBlurState.enabled;
                toggled => { GaussianBlurState.action("enabled", self.checked ? 1 : 0); }
            }
            Text { text: "σ"; color: #dce5ef; vertical-alignment: center; }
            Slider {
                minimum: 1;
                maximum: 12;
                value: GaussianBlurState.sigma;
                changed(value) => { GaussianBlurState.sigma = value; GaussianBlurState.action("sigma", value); }
            }
            Text { text: round(GaussianBlurState.sigma * 10) / 10; color: #dce5ef; vertical-alignment: center; }
            Button { text: "应用"; clicked => { GaussianBlurState.action("apply", 0); } }
        }
        Text { text: GaussianBlurState.status; color: #dce5ef; }
    }
}

#: manifest.json
#, x-machine
msgid "Save or copy the current frame, capture bursts, export clips"
msgstr "Guarda o copia el fotograma actual, captura ráfagas y exporta clips"

#: manifest.json
#, x-machine
msgid ""
"Saves, saves as or copies the current frame (the source frame, or the rendered frame with video effects and subtitles) as PNG, JPEG or BMP; captures a burst of frames; exports part of a video as MP4 and shows its progress in a task list.\n"
"Right-click menu: Video ▸ Snapshot."
msgstr ""
"Guarda, guarda como o copia el fotograma actual (el fotograma original, o el fotograma renderizado con efectos de vídeo y subtítulos) en PNG, JPEG o BMP; captura una ráfaga de fotogramas; exporta parte de un vídeo como MP4 y muestra su progreso en una lista de tareas.\n"
"Menú contextual: Vídeo ▸ Captura."

#: manifest.json
#, x-machine
msgid "video"
msgstr "vídeo"

#: manifest.json
#, x-machine
msgid "snapshot"
msgstr "captura"

#: manifest.json
#, x-machine
msgid "export"
msgstr "exportar"


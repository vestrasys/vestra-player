#: main.ts:68 ui/parts.slint:57
msgid "Enter valid seconds; the end must be after the start."
msgstr "请输入有效的秒数，终点须晚于起点。"

#: main.ts:68 ui/parts.slint:58
msgid "A burst needs 2–20 frames, an interval of 0.1–10 s and a known media duration."
msgstr "连拍需要 2–20 张、间隔 0.1–10 秒，且媒体时长已知。"

#: main.ts:68 ui/parts.slint:59
msgid "The burst runs past the end of the media. Use fewer frames or a shorter interval."
msgstr "连拍超出媒体时长，请减少张数或间隔。"

#: main.ts:68 ui/parts.slint:60
msgid "No free file name found."
msgstr "找不到可用的文件名。"

#: main.ts:68 ui/parts.slint:61
msgid "The current frame cannot be captured. Open a local video file first."
msgstr "当前画面无法截取，请先打开本地视频文件。"

#: main.ts:68 ui/parts.slint:62
msgid "The current frame cannot be exported. Open a local video file first."
msgstr "当前画面无法导出，请先打开本地视频文件。"

#: main.ts:68 ui/parts.slint:63
msgid "Bursts and clips need a known media duration."
msgstr "连拍和导出片段需要已知的媒体时长。"

#: main.ts:68 ui/parts.slint:64
msgid "The selected range is past the end of the media."
msgstr "所选范围超出媒体时长。"

#: main.ts:68 ui/parts.slint:65
msgid "The selected audio track cannot be exported. Choose another track or No Audio."
msgstr "所选音轨无法导出，请换一条音轨或选择无声音。"


#: main.ts:85 main.ts:90
msgid "A burst needs 2–20 frames, an interval of 0.1–10 s and a known media duration."
msgstr "连拍需要 2–20 张、间隔 0.1–10 秒，且媒体时长已知。"

#: main.ts:85 main.ts:90
msgid "The burst runs past the end of the media. Use fewer frames or a shorter interval."
msgstr "连拍超出媒体时长，请减少张数或间隔。"

#: main.ts:85 main.ts:90
msgid "No free file name found."
msgstr "找不到可用的文件名。"

#: main.ts:85 main.ts:90
msgid "The current frame cannot be captured. Open a local video file first."
msgstr "当前画面无法截取，请先打开本地视频文件。"

#: main.ts:85 main.ts:90
msgid "Bursts need a known media duration."
msgstr "连拍需要已知的媒体时长。"

#: main.ts:85 main.ts:90
msgid "The frame is past the end of the media."
msgstr "这一帧已超出媒体末尾。"

#: main.ts:85 main.ts:90
msgid "The media changed; nothing was started."
msgstr "播放内容已变化，未开始。"

#: main.ts:85 main.ts:90
msgid "The player is busy. Try again later."
msgstr "播放器忙，请稍后再试。"

#: main.ts:85 main.ts:90
msgid "The current frame cannot be captured."
msgstr "当前画面无法截取。"

#: main.ts:85 main.ts:90

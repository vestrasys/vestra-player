export component CaptureError inherits Window {
    title: "Capture could not open";
    preferred-width: 520px;
    preferred-height: 200px;
    min-width: 360px;
    min-height: 140px;
    in property <string> message: "Capture could not open. Check the host log.";
    Text {
        x: 16px;
        y: 16px;
        width: parent.width - 32px;
        height: parent.height - 32px;
        text: root.message;
        wrap: word-wrap;
    }
}

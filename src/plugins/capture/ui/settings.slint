// Snapshot Settings (F07, F04): format and quality, where captures go, the rendered frame.
import { LineEdit } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button, Check, Choice, Slider } from "@vestra/widgets.slint";
import { FormLabel, Group, Note } from "parts.slint";

export component CaptureSettings inherits Window {
    title: @tr("Snapshot Settings");
    // 360px, wider only when the content needs it in this language.
    width: max(360px, body.min-width);
    background: Theme.bg-panel;
    in property <string> folder;
    in-out property <int> format-index: 0;
    in-out property <float> quality: 90;
    in-out property <bool> beside-media: false;
    in-out property <bool> screen-subtitles: true;
    callback choose-format(int);
    callback set-quality(int);
    callback pick-folder();
    callback set-beside-media(bool);
    callback set-screen-subtitles(bool);
    // The label column: 60px, or the widest label.
    private property <length> column: max(60px, label-measure.preferred-width);
    Rectangle {
        visible: false;
        width: 0;
        height: 0;
        label-measure := VerticalLayout {
            for text in [@tr("Format:"), @tr("Quality:")]: FormLabel { text: text; }
        }
    }

    body := VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: 5px;
        Group {
            title: @tr("Format");
            HorizontalLayout {
                spacing: 4px;
                FormLabel { width: root.column; text: @tr("Format:"); }
                Choice {
                    model: ["PNG", "JPEG", "BMP"];
                    current-index <=> root.format-index;
                    selected(index) => { root.choose-format(index); }
                }
            }
            HorizontalLayout {
                spacing: 4px;
                FormLabel { width: root.column; text: @tr("Quality:"); }
                Slider {
                    minimum: 1;
                    maximum: 100;
                    value <=> root.quality;
                    enabled: root.format-index == 1;
                    released(v) => { root.set-quality(round(v)); }
                }
                Note { width: 30px; text: round(root.quality); horizontal-alignment: right; }
            }
            // Wraps when a translation is longer than the line.
            Note { text: @tr("Quality applies to JPEG only; copies to the clipboard are always PNG."); color: Theme.text-dim; wrap: word-wrap; overflow: clip; }
        }
        Group {
            title: @tr("Save location");
            HorizontalLayout {
                spacing: 4px;
                LineEdit { height: Theme.input-height; font-size: Theme.font-body; text: root.folder; read-only: true; }
                Button { width: 30px; height: Theme.input-height; text: "…"; clicked => { root.pick-folder(); } }
            }
            Check {
                text: @tr("Save to the media folder when possible");
                checked <=> root.beside-media;
                toggled(on) => { root.set-beside-media(on); }
            }
        }
        Group {
            title: @tr("Rendered frame");
            Check {
                text: @tr("Include subtitles");
                checked <=> root.screen-subtitles;
                toggled(on) => { root.set-screen-subtitles(on); }
            }
            Text {
                text: @tr("The rendered frame is made offline: it includes the plugins' video effects, and subtitles are drawn again in the plugins' style, always inside the picture, so it is not pixel for pixel what the screen shows. On-screen messages are not included.");
                color: Theme.text-dim;
                font-size: Theme.font-body;
                wrap: word-wrap;
                line-height-factor: 1.25;
            }
        }
    }
}

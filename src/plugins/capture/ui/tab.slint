// Snapshots & Clips: the capture plugin's sidebar tab (proposal of 2026-11-07, mockups 01–05).
// One scrolling column: a jump strip (Snapshot | Clip | Results | Settings), the progress card
// while an export runs, then the four sections. Key caps come from `plugin.commands.keys`.
import { LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Icon } from "@vestra/icons.slint";
import { Button, Check, Choice, KeyHint, RadioGroup, Slider, Tabs, ToolTipArea, ToolTipKey } from "@vestra/widgets.slint";
import { Note, Status, Words } from "parts.slint";

// The first key of each command (`plugin.commands.keys`), "" without one. `clip` is
// Export Clip Range's (the Export button), not Export Clip…'s.
export struct Keys {
    save: string,
    copy: string,
    savescreen: string,
    copyscreen: string,
    burst: string,
    clip: string,
    panel: string,
    last: string,
}

// What the player offers (seams.ts `hostSupport`; all of it from player 0.7.6): stream copy (R1), encoder settings (R6), progress (R4).
export struct Support {
    fast: bool,
    encode: bool,
    progress: bool,
}

// The A-B loop, as clock times.
export struct Ab {
    shown: bool,
    a: string,
    b: string,
}

// The explanation under the range: the method and the range it will write.
export struct ClipNote {
    method: string,
    start: string,
    end: string,
    // Seconds a Fast cut starts before the typed start ("2.3"), "" when none.
    early: string,
    snapped: bool,
    // "mp4", "mkv" or "" (Fast only).
    container: string,
}

// The small timeline as ratios 0–1 of its window (clip.ts `timeline`).
export struct Timeline {
    shown: bool,
    wanta: float,
    wantb: float,
    gota: float,
    gotb: float,
    head: float,
    key: float,
    ticks: string,
}

// The estimate: seconds and megabytes as data ("19.0", "46" or "55–80"), the time in seconds.
export struct Estimate {
    length: string,
    size: string,
    timelow: int,
    timehigh: int,
}

// The running task (the progress card).
export struct Card {
    shown: bool,
    id: string,
    kind: string,
    name: string,
    method: string,
    preset: string,
    percent: int,
    left: int,
    elapsed: string,
    queued: int,
}

// One row of Results: a task (id "t…") or a finished result (id "r…").
export struct ResultRow {
    id: string,
    kind: string,
    name: string,
    state: string,
    reason: string,
    raw: string,
    done: int,
    total: int,
    method: string,
    size: string,
    badge: string,
    ago: int,
    percent: int,
    left: int,
    elapsed: string,
    range: string,
    thumb: image,
    cancellable: bool,
    retryable: bool,
    openable: bool,
    copyable: bool,
    revealable: bool,
}

// The names the three templates give now.
export struct Previews {
    image: string,
    clip: string,
    burst: string,
}

export global CaptureBridge {
    // "local", "network", "stream" or "none" (model.ts `tabMode`).
    in property <string> mode: "none";
    in property <bool> can-capture;
    in property <bool> can-clip;
    in property <bool> can-last;
    in property <Keys> keys;
    in property <Support> support;
    // Snapshot
    in-out property <int> format-index;
    in-out property <float> quality: 90;
    in-out property <bool> screen-subtitles: true;
    // Burst (the fields are the tab's while it shows; the plugin writes them on Now and on restore)
    in-out property <bool> burst-open;
    in-out property <string> burst-count: "10";
    in-out property <string> burst-step: "1";
    in-out property <string> burst-start: "0";
    in-out property <bool> burst-from-now: true;
    in-out property <bool> burst-processed;
    in-out property <bool> burst-subtitles;
    in property <bool> burst-busy;
    in property <Status> burst-status;
    // Clip
    in-out property <int> method-index;
    in-out property <string> clip-start;
    in-out property <string> clip-end;
    // A field's problem (a reason code) and which field: "start" or "end".
    in property <string> field-error;
    in property <string> error-field;
    in property <Ab> ab;
    in property <[string]> audio-labels: [@tr("No Audio"), @tr("Current Track")];
    in-out property <int> audio-index: 1;
    in-out property <bool> processed;
    in-out property <bool> burn;
    // 0 Same as source, 1 High quality, 2 Small file, 3 Custom.
    in-out property <int> preset-index: 1;
    in-out property <float> enc-crf: 18;
    // "Same as source": the source video's bitrate instead of the quality number.
    in property <bool> enc-source;
    in-out property <int> enc-speed;
    in-out property <int> enc-height;
    in-out property <int> enc-fps;
    in-out property <int> enc-audio: 1;
    in-out property <bool> advanced-open;
    in property <ClipNote> note;
    in property <Timeline> timeline;
    in property <Estimate> estimate;
    in property <string> clip-name;
    in property <int> last-seconds: 30;
    in-out property <int> last-index: 1;
    in property <bool> clip-busy;
    in property <bool> queue-full;
    in property <Status> clip-status;
    // Results
    in property <Card> card;
    in property <[ResultRow]> results;
    in property <int> result-count;
    in property <Status> results-status;
    // Settings
    in property <string> folder;
    in property <string> folder-shown;
    in-out property <bool> beside-media;
    in-out property <bool> settings-open;
    in-out property <string> template-image;
    in-out property <string> template-clip;
    in-out property <string> template-burst;
    in property <Previews> previews;
    // Each increment of `jump-request` scrolls to section `jump-section` (0–3).
    in property <int> jump-section;
    in property <int> jump-request;

    callback save(bool);
    callback save-as(bool);
    callback copy(bool);
    callback set-screen-subtitles(bool);
    callback choose-format(int);
    callback set-quality(int);
    callback set-burst-open(bool);
    callback burst-now();
    callback burst-edited(string, string, string);
    // (start, count, interval, from now, effects, subtitles)
    callback start-burst(string, string, string, bool, bool, bool);
    callback set-method(int);
    callback clip-edited(string, string);
    // "start" or "end"
    callback clip-now(string);
    callback use-ab();
    callback last();
    callback set-audio(int);
    callback set-processed(bool);
    callback set-burn(bool);
    callback set-preset(int);
    // ("crf" | "speed" | "height" | "fps" | "audio", value or index)
    callback set-encode(string, int);
    callback reset-encode();
    callback set-advanced-open(bool);
    callback export-clip(string, string);
    callback export-as(string, string);
    callback edit-name();
    callback cancel-task(string);
    callback retry-task(string);
    callback open-result(string);
    callback reveal-result(string);
    callback copy-result(string);
    callback remove-result(string);
    callback clear-finished();
    callback open-folder();
    callback pick-folder();
    callback set-beside-media(bool);
    callback set-settings-open(bool);
    // ("image" | "clip" | "burst", text)
    callback template-edited(string, string);
    callback insert-variable(string, string);
    callback reset-template(string);
    callback set-last-seconds(int);
    callback focus-changed(bool);
}

// Glyphs of this tab only, in the V-Line style of @vestra/icons.slint (1.5px round-capped lines), 14×12 boxes.
global Glyphs {
    out property <string> camera: "M 1.5 4 H 4 L 5 2.5 H 9 L 10 4 H 12.5 V 10.5 H 1.5 Z M 9 7.2 A 2 2 0 1 1 5 7.2 A 2 2 0 1 1 9 7.2 Z";
    out property <string> copy: "M 4.5 4 H 11.5 V 11 H 4.5 Z M 2.5 8.5 V 1.5 H 9";
    out property <string> film: "M 1.5 2 H 12.5 V 10 H 1.5 Z M 4 2 V 10 M 10 2 V 10";
    out property <string> burst: "M 3.5 3.5 H 12.5 V 10.5 H 3.5 Z M 1.5 8.5 V 1.5 H 10";
    out property <string> target: "M 11 6 A 4 4 0 1 1 3 6 A 4 4 0 1 1 11 6 Z M 7 6 L 7.01 6";
    out property <string> back: "M 3.5 3 A 4.5 4.5 0 1 1 2.5 7 M 3.5 0.8 V 3 H 5.7";
    out property <string> ab: "M 1 10 L 3.5 2 L 6 10 M 1.8 7.5 H 5.2 M 8 2 V 10 H 11 Q 13 10 13 8 Q 13 6 11 6 H 8 M 8 2 H 10.5 Q 12.3 2 12.3 4 Q 12.3 6 10.5 6";
    out property <string> retry: "M 11 6 A 4.5 4.5 0 1 1 9.5 2.5 M 9.5 0.5 V 2.5 H 11.5";
    out property <string> edit: "M 2 10 L 2.5 7.5 L 9 1 L 11 3 L 4.5 9.5 Z";
    out property <string> info: "M 11.5 6 A 4.5 4.5 0 1 1 2.5 6 A 4.5 4.5 0 1 1 11.5 6 Z M 7 5.5 V 8.5 M 7 3.6 L 7 3.65";
    out property <string> folder: "M 1.5 3.2 Q 1.5 1.5 3.2 1.5 H 5.2 L 6.8 3.2 H 10.8 Q 12.5 3.2 12.5 4.9 V 8.8 Q 12.5 10.5 10.8 10.5 H 3.2 Q 1.5 10.5 1.5 8.8 Z";
    out property <string> open: "M 3.5 2 L 11 6 L 3.5 10 Z";
    out property <string> close: "M 3.5 2.5 L 10.5 9.5 M 10.5 2.5 L 3.5 9.5";
    out property <string> caret: "M 4 4.5 L 7 7.5 L 10 4.5";
    out property <string> fast: "M 8 1 L 3.5 7 H 7 L 6 11 L 10.5 5 H 7 Z";
    out property <string> precise: "M 11 6 A 4 4 0 1 1 3 6 A 4 4 0 1 1 11 6 Z M 7.8 6 A 0.8 0.8 0 1 1 6.2 6 A 0.8 0.8 0 1 1 7.8 6 Z";
}

component Glyph inherits Path {
    in property <string> glyph;
    in property <brush> color: Theme.text-dim;
    width: 14px;
    height: 12px;
    viewbox-width: 14;
    viewbox-height: 12;
    commands: self.glyph;
    stroke: self.color;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

// A button with a glyph, a label and its key cap inside (menu proposal §3.5); the tooltip
// names the command and its key. A primary button is filled with the accent.
component Action {
    in property <string> text;
    in property <string> glyph;
    in property <string> key;
    // false in a narrow tab: the key moves to the tooltip.
    in property <bool> show-key: true;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <string> tip;
    in property <[ToolTipKey]> tip-keys;
    in property <string> tip-detail;
    callback clicked();
    min-height: Theme.button-height;
    preferred-height: Theme.button-height;
    min-width: max(Theme.button-height, row.min-width);
    preferred-width: row.preferred-width;
    accessible-role: button;
    accessible-label: root.text != "" ? root.text : root.tip;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    ToolTipArea {
        text: root.tip;
        keys: root.tip-keys;
        detail: root.tip-detail;
        Rectangle {
            border-radius: Theme.radius-control;
            background: !root.enabled ? Theme.button-disabled
                : root.primary ? (touch.pressed ? Theme.accent-press : Theme.accent-fill)
                : touch.pressed ? Theme.button-press
                : touch.has-hover ? Theme.button-hover : Theme.button-bg;
            row := HorizontalLayout {
                padding-left: root.text == "" ? 4px : Theme.button-padding;
                padding-right: root.text == "" ? 4px : Theme.button-padding;
                spacing: 5px;
                alignment: center;
                if root.glyph != "": VerticalLayout {
                    alignment: center;
                    Glyph {
                        glyph: root.glyph;
                        color: !root.enabled ? Theme.icon-disabled : root.primary ? Theme.text : Theme.text-list;
                    }
                }
                if root.text != "": Text {
                    text: root.text;
                    color: !root.enabled ? Theme.text-dim : root.primary ? Theme.text : Theme.text-list;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                }
                if root.show-key && root.key != "": VerticalLayout {
                    alignment: center;
                    KeyHint { text: root.key; }
                }
            }
            touch := TouchArea {
                enabled: root.enabled;
                clicked => { root.clicked(); }
            }
        }
    }
}

// A 22px icon button (the library Button) with a tooltip.
component IconAction {
    in property <string> glyph;
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked();
    width: 22px;
    height: 22px;
    ToolTipArea {
        width: 22px;
        height: 22px;
        text: root.tip;
        Button {
            width: 22px;
            height: 22px;
            icon: root.glyph;
            stroked: true;
            enabled: root.enabled;
            accessible-label: root.tip;
            clicked => { root.clicked(); }
        }
    }
}

component SectionTitle inherits Text {
    color: Theme.text-dim;
    font-size: Theme.font-body;
    font-weight: 600;
    height: 26px;
    vertical-alignment: bottom;
}

component Label inherits Text {
    width: 52px;
    color: Theme.text;
    font-size: Theme.font-body;
    vertical-alignment: center;
    overflow: elide;
}

component Dim inherits Text {
    color: Theme.text-dim;
    font-size: Theme.font-body;
    vertical-alignment: center;
    wrap: word-wrap;
}

component ErrorText inherits Text {
    color: Theme.danger;
    font-size: Theme.font-body;
    wrap: word-wrap;
}

// A time or number field (the std LineEdit); reports its focus so that the fullscreen sidebar stays.
component Field inherits LineEdit {
    height: Theme.input-height;
    font-size: Theme.font-body;
    changed has-focus => { CaptureBridge.focus-changed(self.has-focus); }
}

// A section's header that opens and closes its rows: caret, title, a summary while closed.
component Fold {
    in property <string> title;
    in property <string> summary;
    in property <bool> open;
    callback toggled(bool);
    min-height: 22px;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.toggled(!root.open); }
    HorizontalLayout {
        spacing: 5px;
        VerticalLayout {
            alignment: center;
            Icon { name: root.open ? "caret-down" : "submenu"; color: Theme.text-dim; }
        }
        Text { text: root.title; color: Theme.text; font-size: Theme.font-body; vertical-alignment: center; }
        Text {
            horizontal-stretch: 1;
            text: root.open ? "" : root.summary;
            color: Theme.text-dim;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    TouchArea { clicked => { root.toggled(!root.open); } }
}

// One choice of the method switch: glyph, name and what it means.
component MethodChoice inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <string> detail;
    in property <bool> selected;
    callback clicked();
    min-height: 36px;
    border-radius: Theme.radius-control;
    background: root.selected ? Theme.selected-bg : touch.has-hover ? Theme.hover-bg : transparent;
    accessible-role: button;
    accessible-label: root.title;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    VerticalLayout {
        alignment: center;
        padding: 3px;
        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            VerticalLayout { alignment: center; Glyph { glyph: root.glyph; color: root.selected ? Theme.accent : Theme.text-dim; } }
            Text { text: root.title; color: root.selected ? Theme.text : Theme.text-list; font-size: Theme.font-body; }
        }
        Text { text: root.detail; color: Theme.text-dim; font-size: Theme.font-xs; horizontal-alignment: center; overflow: elide; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// The small timeline: keyframe ticks, the typed range (outlined), the written range (filled), the playhead.
component MiniTimeline inherits Rectangle {
    in property <Timeline> line;
    in property <string> start;
    in property <string> end;
    height: 34px;
    Rectangle { y: 11px; height: 1px; background: Theme.line; }
    if root.line.ticks != "": Path {
        y: 7px;
        width: root.width;
        height: 9px;
        viewbox-width: 1000;
        viewbox-height: 10;
        commands: root.line.ticks;
        stroke: Theme.icon-disabled;
        stroke-width: 1px;
    }
    Rectangle {
        x: root.line.wanta * root.width;
        y: 4px;
        width: max(2px, (root.line.wantb - root.line.wanta) * root.width);
        height: 15px;
        border-width: 1px;
        border-color: Theme.text-dim;
        border-radius: 2px;
    }
    Rectangle {
        x: root.line.gota * root.width;
        y: 8px;
        width: max(2px, (root.line.gotb - root.line.gota) * root.width);
        height: 7px;
        border-radius: 2px;
        background: Theme.accent-fill;
    }
    if root.line.key >= 0: Rectangle {
        x: root.line.key * root.width - 1px;
        y: 3px;
        width: 2px;
        height: 17px;
        background: Theme.playing;
    }
    if root.line.head >= 0: Rectangle {
        x: root.line.head * root.width;
        y: 1px;
        width: 1px;
        height: 21px;
        background: Theme.text;
    }
    Text {
        x: max(0px, min(root.width - self.width, root.line.gota * root.width - self.width / 2));
        y: 22px;
        text: root.start;
        color: root.line.key >= 0 ? Theme.playing : Theme.text-dim;
        font-family: Theme.font-mono;
        font-size: Theme.font-xs;
    }
    Text {
        x: max(0px, min(root.width - self.width, root.line.gotb * root.width - self.width / 2));
        y: 22px;
        text: root.end;
        color: Theme.text-dim;
        font-family: Theme.font-mono;
        font-size: Theme.font-xs;
    }
}

// One template row of the Settings section: label, field, the name it gives.
component TemplateRow {
    in property <string> label;
    in property <string> kind;
    in property <string> preview;
    in-out property <string> value;
    callback focused(string);
    VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: 4px;
            Label { text: root.label; }
            LineEdit {
                height: Theme.input-height;
                font-size: Theme.font-body;
                text <=> root.value;
                font-family: Theme.font-mono;
                edited(text) => { CaptureBridge.template-edited(root.kind, text); }
                changed has-focus => {
                    CaptureBridge.focus-changed(self.has-focus);
                    if self.has-focus { root.focused(root.kind); }
                }
            }
            IconAction {
                glyph: Glyphs.back;
                tip: @tr("Default name");
                clicked => { CaptureBridge.reset-template(root.kind); }
            }
        }
        HorizontalLayout {
            padding-left: 56px;
            Text {
                text: "→ " + root.preview;
                color: Theme.text-list;
                font-family: Theme.font-mono;
                font-size: Theme.font-xs;
                overflow: elide;
            }
        }
    }
}

// One Results row: thumbnail with its kind and badge, name, state, buttons.
component ResultItem inherits Rectangle {
    in property <ResultRow> entry;
    private property <bool> running: root.entry.state == "preparing" || root.entry.state == "running" || root.entry.state == "cancelling";
    private property <bool> bad: root.entry.state == "failed" || root.entry.state == "gone";
    height: 46px;
    background: area.has-hover ? Theme.hover-bg : transparent;
    area := TouchArea {}
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 64px;
                height: 36px;
                border-radius: 3px;
                clip: true;
                background: Theme.bg-video;
                opacity: root.entry.state == "queued" || root.bad ? 0.55 : 1;
                Image { width: 100%; height: 100%; source: root.entry.thumb; image-fit: cover; }
                Glyph {
                    x: 3px;
                    y: 3px;
                    glyph: root.entry.kind == "clip" ? Glyphs.film : root.entry.kind == "burst" ? Glyphs.burst : Glyphs.camera;
                    color: Theme.text;
                }
                if root.entry.badge != "": Rectangle {
                    x: parent.width - self.width - 2px;
                    y: parent.height - self.height - 2px;
                    width: badge.preferred-width + 6px;
                    height: 12px;
                    border-radius: 2px;
                    background: Theme.bg-bar;
                    badge := Text {
                        // TRANSLATORS: {} is a clip's length in seconds ("3.5") or a burst's number of frames.
                        text: root.entry.kind == "clip" ? @tr("{} s", root.entry.badge) : root.entry.kind == "burst" ? @tr("×{}", root.entry.badge) : root.entry.badge;
                        color: Theme.text;
                        font-size: Theme.font-xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.entry.name; color: Theme.text; font-size: Theme.font-body; overflow: elide; }
            ToolTipArea {
                text: root.entry.state == "failed" && root.entry.raw != "" ? root.entry.raw : "";
                height: line.preferred-height;
                line := Text {
                    width: 100%;
                    color: root.bad ? Theme.danger : Theme.text-dim;
                    font-size: Theme.font-xs;
                    overflow: elide;
                    text: root.entry.state == "gone" ? @tr("File moved or deleted")
                        : root.entry.state == "failed" ? @tr("Failed: {}", Words.reason(root.entry.reason, root.entry.raw))
                        : root.entry.state == "cancelled" ? Words.state("cancelled")
                        // TRANSLATORS: {0} is the number of frames (2–20), {1} the time of the first.
                        : root.entry.state == "queued" ? (root.entry.kind == "burst" ? @tr("Queued · {0} frames from {1}", root.entry.total, root.entry.range)
                            // TRANSLATORS: {} is a time or a time range.
                            : @tr("Queued · {}", root.entry.range))
                        : root.running ? (root.entry.total > 1 ? @tr("{0} · {1}/{2}", Words.state(root.entry.state), root.entry.done, root.entry.total)
                            : root.entry.percent >= 0 ? (root.entry.left >= 0
                                // TRANSLATORS: {0} is a percentage, {1} seconds.
                                ? @tr("Exporting · {0} % · about {1} s left", root.entry.percent, root.entry.left)
                                // TRANSLATORS: {} is a percentage.
                                : @tr("Exporting · {} %", root.entry.percent))
                            // TRANSLATORS: {0} is a task state (Exporting), {1} the time spent (0:12).
                            : @tr("{0} · {1}", Words.state(root.entry.state), root.entry.elapsed))
                        // A finished result: "Fast · 71 MB · 1 min ago", "8.1 MB · 2 min ago", "Burst · 10 frames · 34 MB · 9 min ago".
                        : root.entry.kind == "clip" ? (Words.method(root.entry.method) + (root.entry.size != "" ? " · " + @tr("{} MB", root.entry.size) : "") + " · " + Words.ago(root.entry.ago))
                        // TRANSLATORS: {} is the number of frames (2–20).
                        : root.entry.kind == "burst" ? (@tr("Burst · {} frames", root.entry.total) + (root.entry.size != "" ? " · " + @tr("{} MB", root.entry.size) : "") + " · " + Words.ago(root.entry.ago))
                        : ((root.entry.size != "" ? @tr("{} MB", root.entry.size) + " · " : "") + Words.ago(root.entry.ago));
                }
            }
            if root.running: Rectangle {
                height: 2px;
                background: Theme.line;
                Rectangle {
                    x: 0px;
                    width: root.entry.percent >= 0 ? parent.width * root.entry.percent / 100 : parent.width;
                    background: root.entry.percent >= 0 ? Theme.accent-fill : Theme.accent-disabled;
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 1px;
            if root.entry.cancellable: IconAction {
                glyph: Glyphs.close;
                tip: @tr("Cancel");
                clicked => { CaptureBridge.cancel-task(root.entry.id); }
            }
            if root.entry.retryable && root.entry.state != "cancelling": IconAction {
                glyph: Glyphs.retry;
                tip: @tr("Retry");
                clicked => { CaptureBridge.retry-task(root.entry.id); }
            }
            if root.entry.openable && root.entry.kind == "clip": IconAction {
                glyph: Glyphs.open;
                tip: @tr("Open");
                clicked => { CaptureBridge.open-result(root.entry.id); }
            }
            if root.entry.copyable: IconAction {
                glyph: Glyphs.copy;
                tip: @tr("Copy");
                clicked => { CaptureBridge.copy-result(root.entry.id); }
            }
            if root.entry.openable && root.entry.kind != "clip": IconAction {
                glyph: Glyphs.open;
                tip: root.entry.kind == "burst" ? @tr("Open Folder") : @tr("Open");
                clicked => { CaptureBridge.open-result(root.entry.id); }
            }
            if root.entry.revealable: IconAction {
                glyph: Glyphs.folder;
                tip: @tr("Show in Folder");
                clicked => { CaptureBridge.reveal-result(root.entry.id); }
            }
            if !root.entry.cancellable: IconAction {
                glyph: Glyphs.close;
                tip: @tr("Remove from List");
                clicked => { CaptureBridge.remove-result(root.entry.id); }
            }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
}

export component CaptureTab inherits Rectangle {
    background: Theme.bg-panel;
    // The width classes of proposal §5: wide ≥ 400 px; narrow < 317 px (key caps move to the tooltips).
    private property <bool> wide: root.width >= 400px;
    private property <bool> narrow: root.width < 317px;
    private property <bool> fast: CaptureBridge.support.fast && CaptureBridge.method-index == 0;
    private property <string> chip-target: "image";
    private property <int> request: CaptureBridge.jump-request;
    changed request => { root.jump-to(CaptureBridge.jump-section); }

    function jump-to(index: int) {
        scroll.viewport-y = max(scroll.visible-height - scroll.viewport-height,
            min(0px, -(index == 0 ? snapshot-part.y : index == 1 ? clip-part.y : index == 2 ? results-part.y : settings-part.y)));
        strip.current-index = index;
    }
    function clip-export() { CaptureBridge.export-clip(CaptureBridge.clip-start, CaptureBridge.clip-end); }

    VerticalLayout {
        // The jump strip, and the tab's own key (Alt+S) at its end (design §3.8): the player's tab strip shows titles only.
        Rectangle {
            background: Theme.bg-bar;
            HorizontalLayout {
                strip := Tabs {
                    horizontal-stretch: 1;
                    model: [@tr("Snapshot"), @tr("Clip"),
                        CaptureBridge.result-count > 0 ? @tr("Results ({})", CaptureBridge.result-count) : @tr("Results"), @tr("Settings")];
                    selected(index) => { root.jump-to(index); }
                }
                if CaptureBridge.keys.panel != "" && !root.narrow: VerticalLayout {
                    alignment: center;
                    padding-right: 6px;
                    ToolTipArea {
                        width: panel-key.preferred-width;
                        height: 15px;
                        text: @tr("Show or hide this tab");
                        keys: [{ key: CaptureBridge.keys.panel, text: "" }];
                        panel-key := KeyHint { text: CaptureBridge.keys.panel; }
                    }
                }
            }
        }
        // The progress card: stays at the top while the column scrolls (proposal §3.2 ①).
        if CaptureBridge.card.shown: Rectangle {
            background: Theme.bg-list;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                padding: 6px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 5px;
                    VerticalLayout {
                        alignment: center;
                        Glyph { glyph: CaptureBridge.card.kind == "clip" ? Glyphs.film : CaptureBridge.card.kind == "burst" ? Glyphs.burst : Glyphs.camera; }
                    }
                    Text {
                        horizontal-stretch: 1;
                        // TRANSLATORS: {} is the file or folder name.
                        text: @tr("Exporting {}", CaptureBridge.card.name);
                        color: Theme.text;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    IconAction {
                        glyph: Glyphs.close;
                        tip: @tr("Cancel");
                        clicked => { CaptureBridge.cancel-task("t" + CaptureBridge.card.id); }
                    }
                }
                Rectangle {
                    height: 3px;
                    border-radius: 1px;
                    background: Theme.line;
                    Rectangle {
                        x: 0px;
                        width: CaptureBridge.card.percent >= 0 ? parent.width * CaptureBridge.card.percent / 100 : parent.width;
                        border-radius: 1px;
                        background: CaptureBridge.card.percent >= 0 ? Theme.accent-fill : Theme.accent-disabled;
                    }
                }
                Text {
                    color: Theme.text-dim;
                    font-size: Theme.font-xs;
                    overflow: elide;
                    text: (CaptureBridge.card.method != "" ? Words.method(CaptureBridge.card.method)
                            + (CaptureBridge.card.preset != "" ? " · " + Words.preset(CaptureBridge.card.preset) : "") + " · " : "")
                        // TRANSLATORS: {} is a percentage.
                        + (CaptureBridge.card.percent >= 0 ? @tr("{} %", CaptureBridge.card.percent)
                            // TRANSLATORS: {} is a number of seconds.
                            + (CaptureBridge.card.left >= 0 ? " · " + @tr("about {} s left", CaptureBridge.card.left) : "")
                            : CaptureBridge.card.elapsed)
                        // TRANSLATORS: {} is the number of exports waiting (1–4).
                        + (CaptureBridge.card.queued > 0 ? " · " + @tr("+{} queued", CaptureBridge.card.queued) : "");
                }
            }
        }
        scroll := ScrollView {
            vertical-stretch: 1;
            viewport-width: content.width;
            viewport-height: content.preferred-height;
            changed viewport-y => {
                strip.current-index = -self.viewport-y + 12px >= settings-part.y ? 3
                    : -self.viewport-y + 12px >= results-part.y ? 2
                    : -self.viewport-y + 12px >= clip-part.y ? 1 : 0;
            }
            content := VerticalLayout {
                width: scroll.width - 12px;
                padding-left: 10px;
                padding-right: 2px;
                padding-bottom: 10px;
                spacing: 5px;

                // ---------------------------------------------------------------- Snapshot
                snapshot-part := VerticalLayout {
                    spacing: 5px;
                    SectionTitle { text: @tr("Snapshot"); }
                    if CaptureBridge.mode == "stream": Dim {
                        text: @tr("This picture is made by a plugin. The source is generated live (a game, a visualiser), so there is no file to cut and no frame the player can save.");
                    }
                    Text { text: @tr("Source frame"); color: Theme.text-dim; font-size: Theme.font-body; }
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        Action {
                            text: @tr("Save");
                            glyph: Glyphs.camera;
                            key: CaptureBridge.keys.save;
                            show-key: !root.narrow;
                            enabled: CaptureBridge.can-capture;
                            tip: CaptureBridge.can-capture ? @tr("Save Current Frame") : @tr("No frame to capture");
                            tip-keys: [{ key: CaptureBridge.keys.save, text: "" }];
                            tip-detail: root.wide ? "" : @tr("⌄ Save As…");
                            clicked => { CaptureBridge.save(false); }
                        }
                        if !root.wide: Action {
                            glyph: Glyphs.caret;
                            enabled: CaptureBridge.can-capture;
                            tip: @tr("Save Current Frame As…");
                            clicked => { CaptureBridge.save-as(false); }
                        }
                        Action {
                            text: @tr("Copy");
                            glyph: Glyphs.copy;
                            key: CaptureBridge.keys.copy;
                            show-key: !root.narrow;
                            enabled: CaptureBridge.can-capture;
                            tip: CaptureBridge.can-capture ? @tr("Copy Current Frame") : @tr("No frame to capture");
                            tip-keys: [{ key: CaptureBridge.keys.copy, text: "" }];
                            clicked => { CaptureBridge.copy(false); }
                        }
                        if root.wide: Action {
                            text: @tr("Save As…");
                            enabled: CaptureBridge.can-capture;
                            tip: @tr("Save Current Frame As…");
                            clicked => { CaptureBridge.save-as(false); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 5px;
                        Text { text: @tr("Rendered frame"); color: Theme.text-dim; font-size: Theme.font-body; vertical-alignment: center; }
                        ToolTipArea {
                            width: 14px;
                            height: 14px;
                            text: @tr("The rendered frame is made offline: it includes the plugins' video effects, and subtitles are drawn again in the plugins' style, always inside the picture, so it is not pixel for pixel what the screen shows. On-screen messages are not included.");
                            Glyph { y: 1px; glyph: Glyphs.info; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Check {
                            text: @tr("Subtitles");
                            checked <=> CaptureBridge.screen-subtitles;
                            toggled(on) => { CaptureBridge.set-screen-subtitles(on); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        Action {
                            text: @tr("Save");
                            glyph: Glyphs.camera;
                            key: CaptureBridge.keys.savescreen;
                            show-key: !root.narrow;
                            enabled: CaptureBridge.can-capture;
                            tip: CaptureBridge.can-capture ? @tr("Save Rendered Frame") : @tr("No frame to capture");
                            tip-keys: [{ key: CaptureBridge.keys.savescreen, text: "" }];
                            tip-detail: root.wide ? "" : @tr("⌄ Save As…");
                            clicked => { CaptureBridge.save(true); }
                        }
                        if !root.wide: Action {
                            glyph: Glyphs.caret;
                            enabled: CaptureBridge.can-capture;
                            tip: @tr("Save Rendered Frame As…");
                            clicked => { CaptureBridge.save-as(true); }
                        }
                        Action {
                            text: @tr("Copy");
                            glyph: Glyphs.copy;
                            key: CaptureBridge.keys.copyscreen;
                            show-key: !root.narrow;
                            enabled: CaptureBridge.can-capture;
                            tip: CaptureBridge.can-capture ? @tr("Copy Rendered Frame") : @tr("No frame to capture");
                            tip-keys: [{ key: CaptureBridge.keys.copyscreen, text: "" }];
                            clicked => { CaptureBridge.copy(true); }
                        }
                        if root.wide: Action {
                            text: @tr("Save As…");
                            enabled: CaptureBridge.can-capture;
                            tip: @tr("Save Rendered Frame As…");
                            clicked => { CaptureBridge.save-as(true); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Label { text: @tr("Format"); }
                        Choice {
                            width: 74px;
                            model: ["PNG", "JPEG", "BMP"];
                            current-index <=> CaptureBridge.format-index;
                            selected(index) => { CaptureBridge.choose-format(index); }
                        }
                        if CaptureBridge.format-index == 1: Slider {
                            minimum: 1;
                            maximum: 100;
                            step: 1;
                            value <=> CaptureBridge.quality;
                            released(v) => { CaptureBridge.set-quality(round(v)); }
                        }
                        if CaptureBridge.format-index == 1: Note { width: 26px; text: round(CaptureBridge.quality); horizontal-alignment: right; }
                        if CaptureBridge.format-index != 1: Dim { text: @tr("Quality: JPEG only"); wrap: no-wrap; overflow: elide; }
                    }
                    // Burst (Ctrl+G opens this row).
                    Rectangle {
                        border-width: 1px;
                        border-color: Theme.line;
                        border-radius: Theme.radius-control;
                        VerticalLayout {
                            padding: 6px;
                            spacing: 5px;
                            HorizontalLayout {
                                spacing: 5px;
                                Fold {
                                    horizontal-stretch: 1;
                                    title: @tr("Burst");
                                    open: CaptureBridge.burst-open;
                                    summary: CaptureBridge.burst-from-now
                                        // TRANSLATORS: {0} is the number of frames, {1} the interval in seconds.
                                        ? @tr("{0} frames · every {1} s · from now", CaptureBridge.burst-count, CaptureBridge.burst-step)
                                        // TRANSLATORS: {0} is the number of frames, {1} the interval in seconds, {2} the start time.
                                        : @tr("{0} frames · every {1} s · from {2}", CaptureBridge.burst-count, CaptureBridge.burst-step, CaptureBridge.burst-start);
                                    toggled(open) => {
                                        CaptureBridge.burst-open = open;
                                        CaptureBridge.set-burst-open(open);
                                    }
                                }
                                Action {
                                    text: @tr("Start");
                                    glyph: Glyphs.burst;
                                    key: CaptureBridge.keys.burst;
                                    show-key: !root.narrow && !CaptureBridge.burst-open;
                                    enabled: CaptureBridge.can-capture && !CaptureBridge.burst-busy && !CaptureBridge.queue-full;
                                    tip: CaptureBridge.queue-full ? Words.reason("queueFull", "") : @tr("Start the burst");
                                    clicked => {
                                        CaptureBridge.start-burst(CaptureBridge.burst-start, CaptureBridge.burst-count, CaptureBridge.burst-step,
                                            CaptureBridge.burst-from-now, CaptureBridge.burst-processed, CaptureBridge.burst-subtitles);
                                    }
                                }
                            }
                            if CaptureBridge.burst-open: VerticalLayout {
                                spacing: 5px;
                                HorizontalLayout {
                                    spacing: 4px;
                                    Label { text: @tr("Count"); }
                                    Field {
                                        width: 56px;
                                        text <=> CaptureBridge.burst-count;
                                        edited => { CaptureBridge.burst-edited(CaptureBridge.burst-start, CaptureBridge.burst-count, CaptureBridge.burst-step); }
                                    }
                                    Dim { text: @tr("frames (2–20)"); wrap: no-wrap; }
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    Label { text: @tr("Interval"); }
                                    Field {
                                        width: 56px;
                                        text <=> CaptureBridge.burst-step;
                                        edited => { CaptureBridge.burst-edited(CaptureBridge.burst-start, CaptureBridge.burst-count, CaptureBridge.burst-step); }
                                    }
                                    Dim { text: @tr("s (0.1–10)"); wrap: no-wrap; }
                                }
                                Check { text: @tr("Start at the current position"); checked <=> CaptureBridge.burst-from-now; }
                                if !CaptureBridge.burst-from-now: HorizontalLayout {
                                    spacing: 4px;
                                    Label { text: @tr("Start"); }
                                    Field {
                                        text <=> CaptureBridge.burst-start;
                                        edited => { CaptureBridge.burst-edited(CaptureBridge.burst-start, CaptureBridge.burst-count, CaptureBridge.burst-step); }
                                    }
                                    Action { text: @tr("Now"); glyph: Glyphs.target; clicked => { CaptureBridge.burst-now(); } }
                                }
                                Check { text: @tr("Include video effects"); checked <=> CaptureBridge.burst-processed; }
                                Check { text: @tr("Capture subtitles too"); checked <=> CaptureBridge.burst-subtitles; enabled: CaptureBridge.burst-processed; }
                                if Words.status(CaptureBridge.burst-status) != "": Dim { text: Words.status(CaptureBridge.burst-status); }
                            }
                        }
                    }
                }

                // ---------------------------------------------------------------- Clip
                clip-part := VerticalLayout {
                    spacing: 5px;
                    SectionTitle { text: @tr("Clip"); }
                    if !CaptureBridge.can-clip: Rectangle {
                        border-width: 1px;
                        border-color: Theme.line;
                        border-radius: Theme.radius-control;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            Text {
                                text: CaptureBridge.mode == "stream" ? @tr("This picture is made by a plugin")
                                    : CaptureBridge.mode == "network" ? Words.reason("needLocal", "") : @tr("No frame to capture");
                                color: Theme.text;
                                font-size: Theme.font-body;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                            Dim {
                                horizontal-alignment: center;
                                text: CaptureBridge.mode == "stream" ? @tr("There is no file to cut.")
                                    : CaptureBridge.mode == "network" ? @tr("Frames can still be saved; open a local file to cut clips.")
                                    : @tr("Open a local video file to save frames, bursts and clips.");
                            }
                        }
                    }
                    if CaptureBridge.can-clip: VerticalLayout {
                        spacing: 5px;
                        if CaptureBridge.support.fast: HorizontalLayout {
                            spacing: 2px;
                            MethodChoice {
                                horizontal-stretch: 1;
                                glyph: Glyphs.fast;
                                title: @tr("Fast");
                                detail: root.narrow ? @tr("lossless") : @tr("no re-encode · lossless");
                                selected: CaptureBridge.method-index == 0;
                                clicked => { CaptureBridge.method-index = 0; CaptureBridge.set-method(0); }
                            }
                            MethodChoice {
                                horizontal-stretch: 1;
                                glyph: Glyphs.precise;
                                title: @tr("Precise");
                                detail: root.narrow ? @tr("re-encode") : @tr("re-encode · any frame");
                                selected: CaptureBridge.method-index == 1;
                                clicked => { CaptureBridge.method-index = 1; CaptureBridge.set-method(1); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            Label { text: @tr("Start"); }
                            Field {
                                font-family: Theme.font-mono;
                                placeholder-text: "0:00.000";
                                text <=> CaptureBridge.clip-start;
                                edited => { CaptureBridge.clip-edited(CaptureBridge.clip-start, CaptureBridge.clip-end); }
                                accepted => { root.clip-export(); }
                            }
                            Action { text: @tr("Now"); glyph: Glyphs.target; tip: @tr("Set Clip Start"); clicked => { CaptureBridge.clip-now("start"); } }
                        }
                        if CaptureBridge.error-field == "start": ErrorText { text: Words.reason(CaptureBridge.field-error, ""); }
                        HorizontalLayout {
                            spacing: 4px;
                            Label { text: @tr("End"); }
                            Field {
                                font-family: Theme.font-mono;
                                placeholder-text: "0:10.000";
                                text <=> CaptureBridge.clip-end;
                                edited => { CaptureBridge.clip-edited(CaptureBridge.clip-start, CaptureBridge.clip-end); }
                                accepted => { root.clip-export(); }
                            }
                            Action { text: @tr("Now"); glyph: Glyphs.target; tip: @tr("Set Clip End"); clicked => { CaptureBridge.clip-now("end"); } }
                        }
                        if CaptureBridge.error-field == "end": ErrorText { text: Words.reason(CaptureBridge.field-error, ""); }
                        HorizontalLayout {
                            spacing: 4px;
                            Action {
                                text: @tr("Use A-B range");
                                glyph: Glyphs.ab;
                                enabled: CaptureBridge.ab.shown;
                                tip: CaptureBridge.ab.shown ? @tr("Copy the A-B loop into Start and End") : Words.reason("noLoop", "");
                                clicked => { CaptureBridge.use-ab(); }
                            }
                            Text {
                                horizontal-stretch: 1;
                                // TRANSLATORS: {0} and {1} are the A and B times of the loop.
                                text: root.wide && CaptureBridge.ab.shown ? @tr("A {0} · B {1}", CaptureBridge.ab.a, CaptureBridge.ab.b) : "";
                                color: Theme.text-dim;
                                font-size: Theme.font-xs;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Action {
                                // TRANSLATORS: {} is 10, 30, 60 or 120.
                                text: @tr("Last {} s", CaptureBridge.last-seconds);
                                glyph: Glyphs.back;
                                key: CaptureBridge.keys.last;
                                show-key: !root.narrow;
                                enabled: CaptureBridge.can-last && !CaptureBridge.queue-full;
                                // TRANSLATORS: {} is 10, 30, 60 or 120.
                                tip: @tr("Export Last {} Seconds", CaptureBridge.last-seconds);
                                tip-keys: [{ key: CaptureBridge.keys.last, text: "" }];
                                clicked => { CaptureBridge.last(); }
                            }
                        }
                        if CaptureBridge.timeline.shown: MiniTimeline {
                            line: CaptureBridge.timeline;
                            start: CaptureBridge.note.start;
                            end: CaptureBridge.note.end;
                        }
                        if CaptureBridge.note.start != "": Rectangle {
                            background: Theme.bg-list;
                            border-radius: Theme.radius-control;
                            Rectangle { x: 0px; width: 2px; background: root.fast ? Theme.playing : Theme.accent; }
                            HorizontalLayout {
                                padding: 7px;
                                padding-left: 10px;
                                Text {
                                    color: Theme.text-list;
                                    font-size: Theme.font-body;
                                    wrap: word-wrap;
                                    text: root.fast
                                        ? @tr("Fast cut copies the streams: lossless and done in seconds, but a clip can only start on a keyframe.")
                                            + " " + (CaptureBridge.note.snapped
                                                // TRANSLATORS: {0} and {2} are times, {1} seconds.
                                                ? (CaptureBridge.note.early != "" ? @tr("It will start at {0}, {1} s before your start, and end at {2}.", CaptureBridge.note.start, CaptureBridge.note.early, CaptureBridge.note.end)
                                                    // TRANSLATORS: {0} and {1} are times.
                                                    : @tr("It will start at {0} and end at {1}.", CaptureBridge.note.start, CaptureBridge.note.end))
                                                : @tr("It starts on the keyframe at or before your start."))
                                            + (CaptureBridge.note.container == "mkv" ? " " + @tr("Its streams do not fit in MP4, so it is saved as MKV.") : "")
                                            + (root.narrow ? "" : " " + @tr("Pick Precise to start on the exact frame."))
                                        // TRANSLATORS: {0} and {1} are times.
                                        : @tr("Precise re-encodes from the exact frame {0} to {1}, and can include video effects and subtitles.", CaptureBridge.note.start, CaptureBridge.note.end);
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            Label { text: @tr("Audio"); }
                            Choice {
                                model: CaptureBridge.audio-labels;
                                current-index <=> CaptureBridge.audio-index;
                                selected(index) => { CaptureBridge.set-audio(index); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            Label { text: @tr("Quality"); }
                            if root.fast: Dim { text: @tr("Same as source (stream copy)"); wrap: no-wrap; overflow: elide; }
                            if !root.fast && CaptureBridge.support.encode: Choice {
                                model: CaptureBridge.preset-index == 3
                                    ? [@tr("Same as source"), @tr("High quality"), @tr("Small file"), @tr("Custom")]
                                    : [@tr("Same as source"), @tr("High quality"), @tr("Small file")];
                                current-index <=> CaptureBridge.preset-index;
                                selected(index) => { CaptureBridge.set-preset(index); }
                            }
                            if !root.fast && !CaptureBridge.support.encode: Dim { text: @tr("High quality (H.264 + AAC in MP4)"); wrap: no-wrap; overflow: elide; }
                        }
                        if !root.fast && CaptureBridge.support.encode: VerticalLayout {
                            spacing: 5px;
                            HorizontalLayout {
                                Fold {
                                    horizontal-stretch: 1;
                                    title: @tr("Advanced");
                                    open: CaptureBridge.advanced-open;
                                    // TRANSLATORS: {} is the quality number (14–30).
                                    summary: CaptureBridge.enc-source ? @tr("Source bitrate") : @tr("Quality number {}", round(CaptureBridge.enc-crf));
                                    toggled(open) => {
                                        CaptureBridge.advanced-open = open;
                                        CaptureBridge.set-advanced-open(open);
                                    }
                                }
                                if CaptureBridge.advanced-open: Button { small: true; text: @tr("Reset"); clicked => { CaptureBridge.reset-encode(); } }
                            }
                            if CaptureBridge.advanced-open: VerticalLayout {
                                padding-left: 12px;
                                spacing: 5px;
                                HorizontalLayout {
                                    spacing: 4px;
                                    Label { width: 64px; text: @tr("Resolution"); }
                                    Choice {
                                        model: [@tr("Source"), "1080p", "720p", "480p"];
                                        current-index <=> CaptureBridge.enc-height;
                                        selected(index) => { CaptureBridge.set-encode("height", index); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    Label { width: 64px; text: @tr("Frame rate"); }
                                    Choice {
                                        // TRANSLATORS: {} is frames per second.
                                        model: [@tr("Source"), @tr("{} fps", 60), @tr("{} fps", 30)];
                                        current-index <=> CaptureBridge.enc-fps;
                                        selected(index) => { CaptureBridge.set-encode("fps", index); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    Label { width: 64px; text: @tr("Quality"); }
                                    Slider {
                                        minimum: 14;
                                        maximum: 30;
                                        step: 1;
                                        value <=> CaptureBridge.enc-crf;
                                        released(v) => { CaptureBridge.set-encode("crf", round(v)); }
                                    }
                                    Note { width: 22px; text: CaptureBridge.enc-source ? "—" : round(CaptureBridge.enc-crf); horizontal-alignment: right; }
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    Label { width: 64px; text: @tr("Speed"); }
                                    RadioGroup {
                                        model: [@tr("Faster"), @tr("Balanced"), @tr("Smaller")];
                                        current-index <=> CaptureBridge.enc-speed;
                                        selected(index) => { CaptureBridge.set-encode("speed", index); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    Label { width: 64px; text: @tr("Audio"); }
                                    Choice {
                                        // TRANSLATORS: {} is the audio bit rate in kilobits per second.
                                        model: [@tr("AAC {} kb/s", 128), @tr("AAC {} kb/s", 192), @tr("AAC {} kb/s", 256)];
                                        current-index <=> CaptureBridge.enc-audio;
                                        selected(index) => { CaptureBridge.set-encode("audio", index); }
                                    }
                                }
                                Dim { text: @tr("H.264 + AAC in MP4. Lower quality number = better picture, bigger file."); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            Check {
                                horizontal-stretch: 1;
                                text: @tr("Include video effects");
                                checked <=> CaptureBridge.processed;
                                enabled: !root.fast;
                                toggled(on) => { CaptureBridge.set-processed(on); }
                            }
                            if root.fast: Dim { text: @tr("Precise only"); wrap: no-wrap; }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            Check {
                                horizontal-stretch: 1;
                                text: @tr("Burn in subtitles");
                                checked <=> CaptureBridge.burn;
                                enabled: !root.fast && CaptureBridge.processed;
                                toggled(on) => { CaptureBridge.set-burn(on); }
                            }
                            if root.fast: Dim { text: @tr("Precise only"); wrap: no-wrap; }
                        }
                        if CaptureBridge.estimate.length != "": HorizontalLayout {
                            spacing: 5px;
                            VerticalLayout { alignment: center; Glyph { glyph: Glyphs.info; } }
                            Dim {
                                text: CaptureBridge.estimate.size != ""
                                    // TRANSLATORS: {0} seconds of media, {1} megabytes ("46" or "55–80"), {2} a time span ("2 s", "about 1–3 min").
                                    ? @tr("Length {0} s · ≈ {1} MB · ≈ {2}", CaptureBridge.estimate.length, CaptureBridge.estimate.size, Words.span(CaptureBridge.estimate.timelow, CaptureBridge.estimate.timehigh))
                                    // TRANSLATORS: {0} seconds of media, {1} a time span ("2 s", "about 1–3 min").
                                    : @tr("Length {0} s · ≈ {1}", CaptureBridge.estimate.length, Words.span(CaptureBridge.estimate.timelow, CaptureBridge.estimate.timehigh));
                            }
                        }
                        if CaptureBridge.clip-name != "": Rectangle {
                            background: Theme.bg-list;
                            border-radius: Theme.radius-control;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 2px;
                                spacing: 4px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: CaptureBridge.clip-name;
                                    color: Theme.text-list;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-xs;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                IconAction { glyph: Glyphs.edit; tip: @tr("Change the file names"); clicked => { CaptureBridge.edit-name(); } }
                            }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            Action {
                                horizontal-stretch: 1;
                                primary: true;
                                text: @tr("Export");
                                glyph: Glyphs.film;
                                key: CaptureBridge.keys.clip;
                                show-key: !root.narrow;
                                enabled: !CaptureBridge.clip-busy && !CaptureBridge.queue-full && CaptureBridge.field-error == "";
                                tip: CaptureBridge.queue-full ? Words.reason("queueFull", "") : @tr("Export the range into the snapshot folder");
                                tip-keys: [{ key: CaptureBridge.keys.clip, text: "" }];
                                clicked => { root.clip-export(); }
                            }
                            Action {
                                text: @tr("Export As…");
                                enabled: !CaptureBridge.clip-busy && !CaptureBridge.queue-full && CaptureBridge.field-error == "";
                                tip: @tr("Export the range into a file you choose");
                                clicked => { CaptureBridge.export-as(CaptureBridge.clip-start, CaptureBridge.clip-end); }
                            }
                        }
                        if Words.status(CaptureBridge.clip-status) != "": Dim { text: Words.status(CaptureBridge.clip-status); }
                        // A Fast cut the player could not make: one click to cut precisely instead (design §4, mockup 04-C).
                        if root.fast && CaptureBridge.clip-status.reason == "fastImpossible": HorizontalLayout {
                            alignment: start;
                            Action {
                                text: @tr("Use Precise");
                                glyph: Glyphs.precise;
                                clicked => {
                                    CaptureBridge.method-index = 1;
                                    CaptureBridge.set-method(1);
                                }
                            }
                        }
                    }
                }

                // ---------------------------------------------------------------- Results
                results-part := VerticalLayout {
                    spacing: 5px;
                    SectionTitle { text: @tr("Results"); }
                    if CaptureBridge.results.length == 0: Dim { text: @tr("No snapshots or clips yet."); }
                    // Slint's ListView: only the rows in view are built; at most six rows tall, it scrolls beyond.
                    if CaptureBridge.results.length > 0: ListView {
                        height: min(CaptureBridge.results.length, 6) * 46px;
                        for row in CaptureBridge.results: ResultItem { entry: row; }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Action { text: @tr("Open Snapshot Folder"); glyph: Glyphs.folder; clicked => { CaptureBridge.open-folder(); } }
                        Rectangle { horizontal-stretch: 1; }
                        Action { text: @tr("Clear Finished"); enabled: CaptureBridge.results.length > 0; clicked => { CaptureBridge.clear-finished(); } }
                    }
                    if Words.status(CaptureBridge.results-status) != "": Dim { text: Words.status(CaptureBridge.results-status); }
                }

                // ---------------------------------------------------------------- Settings
                settings-part := VerticalLayout {
                    spacing: 5px;
                    SectionTitle { text: @tr("Settings"); }
                    Fold {
                        title: @tr("Save to");
                        open: CaptureBridge.settings-open;
                        // TRANSLATORS: {0} is the folder, {1} the snapshot name template.
                        summary: @tr("{0} · names: {1}", CaptureBridge.folder-shown, CaptureBridge.template-image);
                        toggled(open) => {
                            CaptureBridge.settings-open = open;
                            CaptureBridge.set-settings-open(open);
                        }
                    }
                    if CaptureBridge.settings-open: VerticalLayout {
                        spacing: 5px;
                        HorizontalLayout {
                            spacing: 4px;
                            LineEdit { height: Theme.input-height; font-size: Theme.font-body; text: CaptureBridge.folder; read-only: true; }
                            Button { width: 30px; height: Theme.input-height; text: "…"; clicked => { CaptureBridge.pick-folder(); } }
                        }
                        Check {
                            text: @tr("Save to the media folder when possible");
                            checked <=> CaptureBridge.beside-media;
                            toggled(on) => { CaptureBridge.set-beside-media(on); }
                        }
                        Text { text: @tr("File names"); color: Theme.text-dim; font-size: Theme.font-body; }
                        TemplateRow {
                            label: @tr("Snapshot");
                            kind: "image";
                            preview: CaptureBridge.previews.image;
                            value <=> CaptureBridge.template-image;
                            focused(kind) => { root.chip-target = kind; }
                        }
                        TemplateRow {
                            label: @tr("Clip");
                            kind: "clip";
                            preview: CaptureBridge.previews.clip;
                            value <=> CaptureBridge.template-clip;
                            focused(kind) => { root.chip-target = kind; }
                        }
                        TemplateRow {
                            label: @tr("Burst");
                            kind: "burst";
                            preview: CaptureBridge.previews.burst;
                            value <=> CaptureBridge.template-burst;
                            focused(kind) => { root.chip-target = kind; }
                        }
                        // Variable chips: a click adds the variable to the template last focused.
                        HorizontalLayout {
                            spacing: 3px;
                            alignment: start;
                            for variable in ["{name}", "{pos}", "{start}", "{end}"]: Button {
                                small: true;
                                text: variable;
                                clicked => { CaptureBridge.insert-variable(root.chip-target, variable); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 3px;
                            alignment: start;
                            for variable in ["{date}", "{time}", "{n}"]: Button {
                                small: true;
                                text: variable;
                                clicked => { CaptureBridge.insert-variable(root.chip-target, variable); }
                            }
                        }
                        Dim { text: @tr("Click a variable to add it to the template you edited last. Existing files are never overwritten: a number is added."); }
                        HorizontalLayout {
                            spacing: 4px;
                            Label { width: 96px; text: @tr("Last clip length"); }
                            Choice {
                                width: 74px;
                                model: [@tr("{} s", 10), @tr("{} s", 30), @tr("{} s", 60), @tr("{} s", 120)];
                                current-index <=> CaptureBridge.last-index;
                                selected(index) => { CaptureBridge.set-last-seconds(index); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
        }
    }
}

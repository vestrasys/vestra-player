// Export Tasks: one two-line row per accepted export (UI-DLG-05).
import { ListView } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button } from "@vestra/widgets.slint";
import { Note, Progress, Status, Words } from "parts.slint";

// One task as the plugin passes it (tasks.ts `rows`): data only.
export struct CaptureTask {
    id: string,
    kind: string,
    name: string,
    range: string,
    progress: Progress,
    cancellable: bool,
    retryable: bool,
    openable: bool,
}

export component TasksWindow inherits Window {
    title: @tr("Export Tasks");
    width: 438px;
    preferred-height: 300px;
    min-height: 160px;
    background: Theme.bg-panel;
    in property <[CaptureTask]> task-rows;
    in property <Status> status;
    callback cancel-task(string);
    callback open-output(string);
    callback retry-task(string);
    callback open-folder();

    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: 5px;
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-list;
            border-width: 1px;
            border-color: Theme.line;
            if root.task-rows.length == 0: Note {
                text: @tr("No export tasks yet.");
                horizontal-alignment: center;
                color: Theme.text-dim;
            }
            // Slint's ListView: only the rows in view are instantiated, so a long
            // session's task list stays cheap (the playlist and marks lists do the same).
            ListView {
                for task in root.task-rows: Rectangle {
                    height: 40px;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 3px;
                        VerticalLayout {
                            alignment: center;
                            Note {
                                text: task.kind == "burst" ? @tr("Burst · {}", task.name) : task.kind == "clip" ? @tr("Clip · {}", task.name) : @tr("Snapshot · {}", task.name);
                                color: Theme.text;
                            }
                            // TRANSLATORS: {0} is the time or time range, {1} the progress (Completed).
                            Note { text: @tr("{0} · {1}", task.range, Words.progress(task.progress)); }
                        }
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 3px;
                                Button { small: true; text: @tr("Cancel"); enabled: task.cancellable; clicked => { root.cancel-task(task.id); } }
                                Button { small: true; text: @tr("Open"); enabled: task.openable; clicked => { root.open-output(task.id); } }
                                Button { small: true; text: @tr("Retry"); enabled: task.retryable; clicked => { root.retry-task(task.id); } }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                }
            }
        }
        HorizontalLayout {
            spacing: 4px;
            Note { text: Words.status(root.status); horizontal-stretch: 1; }
            Button { text: @tr("Open Save Folder"); clicked => { root.open-folder(); } }
        }
    }
}

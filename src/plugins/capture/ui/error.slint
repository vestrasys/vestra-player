// Shown when a capture window cannot open.
import { Theme } from "@vestra/theme.slint";

export component CaptureError inherits Window {
    title: "截图";
    width: 360px;
    height: 80px;
    background: Theme.bg-panel;
    in property <string> message: "截图窗口无法打开。";
    Text {
        x: Theme.dialog-padding;
        width: parent.width - 2 * Theme.dialog-padding;
        text: root.message;
        color: Theme.text;
        font-size: Theme.font-body;
        vertical-alignment: center;
        wrap: word-wrap;
        line-height-factor: 1.25;
    }
}

// Export Clip: options in group boxes (B§6.8; UI-DLG-05).
import { LineEdit } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button, Check, Choice } from "@vestra/widgets.slint";
import { FormLabel, Group, Note, Status, Words } from "parts.slint";

export component ClipDialog inherits Window {
    title: @tr("Export Clip");
    // 400px, wider only when the content needs it in this language.
    width: max(400px, body.min-width);
    background: Theme.bg-panel;
    in property <bool> busy;
    in property <bool> can-export;
    in property <[string]> audio-labels: [@tr("No Audio"), @tr("Current Track")];
    in property <Status> status;
    in-out property <string> start-time: "0";
    in-out property <string> end-time: "10";
    in-out property <int> audio-index: 1;
    in-out property <bool> processed: false;
    in-out property <bool> subtitles: false;
    callback mark-start();
    callback mark-end();
    callback open-tasks();
    callback export-clip(string, string, bool, bool, int);
    // The label column: 100px, or the widest label.
    private property <length> column: max(100px, label-measure.preferred-width);
    Rectangle {
        visible: false;
        width: 0;
        height: 0;
        label-measure := VerticalLayout {
            for text in [@tr("Start (s):"), @tr("End (s):"), @tr("Format:"), @tr("Audio:"), @tr("Status:")]: FormLabel { text: text; }
        }
    }

    body := VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: 5px;
        Group {
            title: @tr("Range");
            HorizontalLayout {
                spacing: 4px;
                FormLabel { width: root.column; text: @tr("Start (s):"); }
                LineEdit { height: Theme.input-height; font-size: Theme.font-body; text <=> root.start-time; enabled: !root.busy; }
                Button { small: true; height: Theme.input-height; text: @tr("Current"); enabled: !root.busy; clicked => { root.mark-start(); } }
            }
            HorizontalLayout {
                spacing: 4px;
                FormLabel { width: root.column; text: @tr("End (s):"); }
                LineEdit { height: Theme.input-height; font-size: Theme.font-body; text <=> root.end-time; enabled: !root.busy; }
                Button { small: true; height: Theme.input-height; text: @tr("Current"); enabled: !root.busy; clicked => { root.mark-end(); } }
            }
        }
        Group {
            title: @tr("Output");
            HorizontalLayout {
                spacing: 4px;
                FormLabel { width: root.column; text: @tr("Format:"); }
                Note { text: @tr("MP4 (H.264 + AAC)"); }
            }
            HorizontalLayout {
                spacing: 4px;
                FormLabel { width: root.column; text: @tr("Audio:"); }
                Choice { model: root.audio-labels; current-index <=> root.audio-index; enabled: !root.busy; }
            }
            HorizontalLayout {
                spacing: 4px;
                Rectangle { width: root.column; }
                Check { text: @tr("Include video effects"); checked <=> root.processed; enabled: !root.busy; }
                Check { text: @tr("Export subtitles too"); checked <=> root.subtitles; enabled: root.processed && !root.busy; }
            }
        }
        Group {
            title: @tr("Information");
            HorizontalLayout {
                spacing: 4px;
                FormLabel { width: root.column; text: @tr("Status:"); }
                Note { text: Words.status(root.status); }
            }
        }
        Rectangle { height: 2px; background: Theme.line; }
        HorizontalLayout {
            spacing: 4px;
            alignment: end;
            Button { height: Theme.button-primary-height; text: @tr("Export Tasks…"); clicked => { root.open-tasks(); } }
            Button {
                height: Theme.button-primary-height;
                text: @tr("Export…");
                enabled: root.can-export && !root.busy;
                clicked => { root.export-clip(root.start-time, root.end-time, root.processed, root.subtitles, root.audio-index); }
            }
        }
    }
}

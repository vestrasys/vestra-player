// 实验原生字幕界面；最终产品 API 与布局可能差异很大。
import { Button, Slider } from "std-widgets.slint";
export global SubtitleWorkbenchState {
    in-out property <string> status: "字幕工作台";
    in-out property <bool> visible: true;
    in-out property <bool> translating: false;
    in-out property <bool> translated: false;
    in-out property <bool> yellow: false;
    in-out property <float> delay: 0;
    in-out property <float> font-size: 24;
    in-out property <float> cue-count: 0;
    in-out property <float> cue-index: 1;
    callback action(string, float);
}
export component SubtitleWorkbenchPanel inherits Rectangle {
    background: #24303b;
    VerticalLayout {
        padding: 8px; spacing: 5px;
        HorizontalLayout {
            Button { text: "加载 SRT"; clicked => { SubtitleWorkbenchState.action("open",0); } }
            Button { text: SubtitleWorkbenchState.visible ? "隐藏字幕" : "显示字幕"; clicked => { SubtitleWorkbenchState.action("toggle",0); } }
            Button { text: "下一条"; clicked => { SubtitleWorkbenchState.action("next-cue",0); } }
            Button { text: "翻译 (Mock)"; enabled: !SubtitleWorkbenchState.translating; clicked => { SubtitleWorkbenchState.action("translate",0); } }
            Button { text: "取消"; enabled: SubtitleWorkbenchState.translating; clicked => { SubtitleWorkbenchState.action("cancel",0); } }
        }
        HorizontalLayout {
            Text { text: "延迟（秒）"; color: white; }
            Slider { minimum: -5; maximum: 5; value: SubtitleWorkbenchState.delay; changed(v) => { SubtitleWorkbenchState.action("delay",v); } }
            Text { text: "字号"; color: white; }
            Slider { minimum: 12; maximum: 64; value: SubtitleWorkbenchState.font-size; changed(v) => { SubtitleWorkbenchState.action("font-size",round(v)); } }
            Button { text: "切换颜色"; clicked => { SubtitleWorkbenchState.action("yellow",0); } }
            Button { text: "原文"; clicked => { SubtitleWorkbenchState.action("original",0); } }
            Button { text: "译文"; clicked => { SubtitleWorkbenchState.action("translated",0); } }
        }
        Text { text: SubtitleWorkbenchState.status; color: white; }
    }
}

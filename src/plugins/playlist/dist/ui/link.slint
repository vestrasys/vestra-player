import { Button, LineEdit } from "std-widgets.slint";
export component AddLink inherits Window {
    title: "添加链接到播放列表";
    preferred-width: 480px;
    preferred-height: 210px;
    min-width: 360px;
    min-height: 190px;
    in-out property <string> message: "输入 HTTP(S) 链接；添加只选择，不自动播放";
    callback add-link(string);
    callback hide();
    VerticalLayout {
        padding: 16px; spacing: 12px;
        Text { text: "网络内容链接"; }
        url := LineEdit { placeholder-text: "https://…"; accepted => { root.add-link(self.text); } }
        Text { text: root.message; wrap: word-wrap; vertical-stretch: 1; }
        HorizontalLayout {
            Button { text: "取消"; clicked => { root.hide(); } }
            Button { text: "添加"; clicked => { root.add-link(url.text); } }
        }
    }
}

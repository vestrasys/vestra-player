// 选项 ▶ 播放 ▶ 播放列表 (IA-PL-02; PotPlayer 播放列表设置, Dialog 373): the open
// and drop options and the same switches as the 播放 ▶ 播放列表 menu items. 440 wide
// (the options window's page area). Combo boxes hold indexes into the plugin's lists.
import { CheckBox, ComboBox } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";

export global PlaylistSettings {
    // 0 仅打开该文件, 1 加入相似文件, 2 加入同文件夹全部文件
    in-out property <int> open-mode;
    in-out property <bool> append-on-open;
    in-out property <bool> drop-at-pointer;
    // 0 不循环, 1 全部, 2 单个
    in-out property <int> repeat;
    in-out property <bool> shuffle;
    in-out property <bool> fast-advance;
    in-out property <bool> remember: true;
    in-out property <bool> confirm-clear: true;
    callback set-open-mode(int);
    callback set-append-on-open(bool);
    callback set-drop-at-pointer(bool);
    callback set-repeat(int);
    callback set-shuffle(bool);
    callback set-fast-advance(bool);
    callback set-remember(bool);
    callback set-confirm-clear(bool);
}

component Section inherits Text {
    height: Theme.label-height;
    font-size: Theme.font-body;
    color: Theme.text-dim;
}

component Label inherits Text {
    width: 96px;
    font-size: Theme.font-body;
    color: Theme.text;
    vertical-alignment: center;
}

component Check inherits CheckBox {
    height: Theme.checkbox-row-height;
}

export component PlaylistSettingsPage inherits Rectangle {
    background: Theme.bg-panel;
    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: 6px;
        alignment: start;
        Text {
            height: 24px;
            text: "播放列表";
            font-size: Theme.font-title;
            font-weight: 700;
            vertical-alignment: center;
            color: Theme.text;
        }
        Section { text: "打开与拖放"; }
        HorizontalLayout {
            height: Theme.input-height;
            spacing: 4px;
            Label { text: "打开文件时："; }
            ComboBox {
                width: 200px;
                model: ["仅打开该文件", "加入相似文件", "加入同文件夹全部文件"];
                current-index <=> PlaylistSettings.open-mode;
                selected => { PlaylistSettings.set-open-mode(self.current-index); }
            }
        }
        Check {
            text: "拖到画面时追加，不清空列表";
            checked <=> PlaylistSettings.append-on-open;
            toggled => { PlaylistSettings.set-append-on-open(self.checked); }
        }
        Check {
            text: "拖到列表时插入到拖放位置";
            checked <=> PlaylistSettings.drop-at-pointer;
            toggled => { PlaylistSettings.set-drop-at-pointer(self.checked); }
        }
        Rectangle { height: 8px; }
        Section { text: "播放"; }
        HorizontalLayout {
            height: Theme.input-height;
            spacing: 4px;
            Label { text: "循环："; }
            ComboBox {
                width: 200px;
                model: ["不循环", "全部", "单个"];
                current-index <=> PlaylistSettings.repeat;
                selected => { PlaylistSettings.set-repeat(self.current-index); }
            }
        }
        Check {
            text: "随机";
            checked <=> PlaylistSettings.shuffle;
            toggled => { PlaylistSettings.set-shuffle(self.checked); }
        }
        Check {
            text: "快速推进到下一个";
            checked <=> PlaylistSettings.fast-advance;
            toggled => { PlaylistSettings.set-fast-advance(self.checked); }
        }
        Rectangle { height: 8px; }
        Section { text: "列表"; }
        Check {
            text: "记住列表";
            checked <=> PlaylistSettings.remember;
            toggled => { PlaylistSettings.set-remember(self.checked); }
        }
        Check {
            text: "移除全部前确认";
            checked <=> PlaylistSettings.confirm-clear;
            toggled => { PlaylistSettings.set-confirm-clear(self.checked); }
        }
    }
}

// Playlist sidebar (ui-spec §5): 31px tab strip, single-line 20px rows (62px rows with a thumbnail, 0.1.11) on
// the list background, 35px bottom bar. Icons come from @vestra/icons.slint.
import { ListView, Palette } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Icon } from "@vestra/icons.slint";
import { ToolTipArea } from "@vestra/widgets.slint";

// One entry of the list. `id` is the row's stable key: the player's row patches (player 0.6.0)
// match rows by it, so a reorder, an insertion or a removal moves row elements instead of
// rewriting rows.
export struct PlaylistRow {
    id: string,
    // The row's place in the whole list (from 1) while a search filters; 0 otherwise, and the
    // row shows its index in the list (so moving a row rewrites no other row).
    number: int,
    // The title.
    label: string,
    duration: string,
    // The source, and the player's message when it failed to play.
    tooltip: string,
    // A reason of the list's own, worded here: "missing", "unreadable", "unplayable" or "".
    problem: string,
    selected: bool,
    current: bool,
    played: bool,
    failed: bool,
    // Beside a thumbnail: what the placeholder draws ("video", "audio", "link" or "") and
    // the line under the title (the file's folder, the link's host); "" without thumbnails.
    media: string,
    detail: string,
    // The 96×54 thumbnail; empty (`null` from the plugin, player 0.6.0) until one is made, and for
    // rows away from the view or without thumbnails. Rows holding images update in place.
    thumb: image,
}

// Glyphs of this panel only, in the V-Line style of @vestra/icons.slint (round-capped
// 1.5px lines, never filled), each in a 13×10 box (the bar's) or 14×14 (placeholders).
global PlaylistGlyphs {
    // The thumbnail toggle shows the current mode: rows with a picture, or compact lines.
    out property <string> thumb-rows: "M 1 1 H 4.5 V 4 H 1 Z M 6.5 2.5 H 12 M 1 6 H 4.5 V 9 H 1 Z M 6.5 7.5 H 12";
    out property <string> compact-rows: "M 1 1.5 H 12 M 1 5 H 12 M 1 8.5 H 12";
    out property <string> audio: "M 5 11.5 V 2.5 L 12 1 V 10 M 5 11.5 A 1.75 1.5 0 1 1 1.5 11.5 A 1.75 1.5 0 1 1 5 11.5 Z M 12 10 A 1.75 1.5 0 1 1 8.5 10 A 1.75 1.5 0 1 1 12 10 Z";
    out property <string> link: "M 12.5 7 A 5.5 5.5 0 1 1 1.5 7 A 5.5 5.5 0 1 1 12.5 7 Z M 1.5 7 H 12.5 M 7 1.5 Q 4.2 7 7 12.5 M 7 1.5 Q 9.8 7 7 12.5";
}

component Glyph inherits Path {
    in property <string> glyph;
    in property <length> box-width: 13px;
    in property <length> box-height: 10px;
    in property <brush> color;
    width: self.box-width;
    height: self.box-height;
    viewbox-width: self.box-width / 1px;
    viewbox-height: self.box-height / 1px;
    commands: self.glyph;
    stroke: self.color;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

export global PlaylistBridge {
    // Every shown row (the whole list, or a search's matches), drawn by a `ListView`: only the
    // rows in view have elements.
    in property <[PlaylistRow]> rows;
    // Rows with a 96×54 thumbnail (62px), or compact single-line rows (20px).
    in property <bool> thumbnails;
    // The total duration ("" when none is known), shown as "Filtered …" while `filtering`.
    in property <string> total;
    in property <bool> detached;
    // Set by the player while it draws its own tab strip above the panel (sidebar tabs):
    // the panel then leaves out its tab strip.
    in property <bool> tabbed;
    in property <bool> can-add: true;
    in property <bool> can-remove;
    in property <bool> can-sort;
    in property <bool> can-top;
    in property <bool> can-up;
    in property <bool> can-down;
    in property <bool> can-bottom;
    // Drag reorder is off while a search filters (C21).
    in property <bool> can-drag: true;
    // A search filters the rows (shows "No matches" when none match).
    in property <bool> filtering;
    // Incremented by "Search" (Ctrl+S): focus the search box and select its text.
    in property <int> focus-search;
    // G-08: each increment of `scroll-request` scrolls the list to `scroll-to-y` (logical px).
    in property <float> scroll-to-y;
    in property <int> scroll-request;
    // Where a newly shown list starts (logical px): the panel is created anew each time it
    // shows (F6, its tab, detached, fullscreen pop-out), and the plugin keeps this at the
    // list's scroll, or while the panel is hidden at the scroll that centres the playing row.
    in property <float> show-y;
    // (row, Ctrl/Cmd held, Shift held)
    callback select-row(string, bool, bool);
    callback play-row(string);
    // (rows to move the cursor by, Shift held)
    callback select-step(int, bool);
    // Drag reorder: (dragged row, insertion index in the current order)
    callback drop-row(string, int);
    // "top" | "up" | "down" | "bottom"
    callback place(string);
    callback remove();
    // Window coordinates for the popups
    callback add-menu(float, float);
    callback sort-menu(float, float);
    callback context-menu(float, float);
    callback hide();
    callback toggle-detached();
    callback toggle-thumbnails();
    callback focus-changed(bool);
    callback dragging(bool);
    // A15 drops on the list: (scrolled by, list area height, list area top) in logical px,
    // so a panel drop point maps to a row (rows start below the 31px tab strip, at 0 when
    // `tabbed`).
    callback list-area(float, float, float);
    // C21 search box: text edited, focus, Enter, ↓ (Esc clears and reports "")
    callback search-changed(string);
    callback search-focus(bool);
    callback search-accept();
    callback search-down();
}

// A 25px icon button (one icon of the set, centred), coloured like the
// @vestra Button icon state.
component IconButton {
    in property <string> icon;
    in property <bool> enabled: true;
    in property <string> tip;
    callback clicked();
    width: 25px;
    private property <color> tint: !root.enabled ? Theme.icon-disabled : touch.has-hover ? (touch.pressed ? Theme.accent-press : Theme.accent) : Theme.text-dim;
    accessible-role: button;
    accessible-label: root.tip;
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        color: root.tint;
    }
    // Sized: an unsized ToolTipArea has no area, and the button took no
    // clicks (found by the 2026-10 geometry check).
    ToolTipArea {
        width: 100%;
        height: 100%;
        text: root.tip;
        touch := TouchArea {
            enabled: root.enabled;
            clicked => { root.clicked(); }
        }
    }
}

// A small button in the bottom bar: an 18px pill (41px, the width of the
// text buttons it replaced; Add, Delete and the thumbnail toggle are 28px
// since 0.1.11), centred vertically, with an icon label (`icon` from the
// library, or a `glyph` of this panel); `text` is its tooltip and accessible name.
component BarButton {
    in property <string> text;
    in property <string> icon;
    in property <string> glyph;
    in property <length> pill-width: Theme.button-small-min-width;
    in property <bool> enabled: true;
    callback clicked(float, float);
    VerticalLayout {
        alignment: center;
        pill := Rectangle {
            height: Theme.button-small-height;
            width: root.pill-width;
            border-radius: Theme.radius-control;
            background: !root.enabled ? Theme.button-disabled
                : touch.pressed ? Theme.button-press
                : touch.has-hover ? Theme.button-hover : Theme.button-bg;
            accessible-role: button;
            accessible-label: root.text;
            accessible-enabled: root.enabled;
            accessible-action-default => { if root.enabled { root.clicked(self.absolute-position.x / 1px, self.absolute-position.y / 1px); } }
            if root.glyph == "": Icon {
                name: root.icon;
                color: root.enabled ? Theme.text-list : Theme.text-dim;
            }
            if root.glyph != "": Glyph {
                glyph: root.glyph;
                color: root.enabled ? Theme.text-list : Theme.text-dim;
            }
            ToolTipArea {
                width: 100%;
                height: 100%;
                text: root.text;
                touch := TouchArea {
                    enabled: root.enabled;
                    clicked => { root.clicked(pill.absolute-position.x / 1px, pill.absolute-position.y / 1px); }
                }
            }
        }
    }
}

export component PlaylistSidebar inherits Rectangle {
    min-width: 240px;
    preferred-width: 317px;
    background: Theme.bg-list;
    private property <length> row-height: PlaylistBridge.thumbnails ? 62px : 20px;
    // The selected-row background (ui-spec §5.2); the theme has no token for it.
    private property <color> selected-bg: Theme.selected-bg;
    private property <int> row-count: PlaylistBridge.rows.length;
    // The thumbnail toggle changes every row's height: the row at the top of the view stays
    // there (0.2.1). `top-row` follows the scroll while the rows keep the height it was
    // measured with (`settled-height`); a scroll reported with the new height before
    // `changed row-height` ran is not taken.
    private property <int> top-row;
    private property <length> settled-height;
    changed row-height => {
        list.content-y = -clamp(root.top-row * root.row-height, 0px, root.max-scroll);
        root.settled-height = root.row-height;
    }
    // Rows removed or added while dragging: the drop index follows the list.
    changed row-count => {
        if root.dragging { root.drop-index = root.drop-index-at(root.drag-y); }
    }
    // Pointer handling is the list's, not the rows' (large lists P3): a `ListView` destroys the
    // element of a row scrolled out of view, so a press, a drag (with edge scrolling) or a
    // double-click is tracked by one TouchArea around the list, and the pointer's y maps to a
    // row by the fixed row height and the list's scroll (`row-at`).
    // The row pressed by the left button ("" below the rows), where, and whether a plain click
    // on it collapses a multi-selection on release (kept for dragging otherwise).
    private property <string> press-row;
    private property <length> press-y;
    private property <bool> collapse;
    // Pressed during this hover: the row shows no tooltip until the pointer leaves it.
    private property <string> quiet-row;
    private property <int> hover-row: pointer.has-hover ? root.row-at(pointer.mouse-y) : -1;
    changed hover-row => { root.quiet-row = ""; }
    private property <bool> dragging;
    private property <int> drop-index: -1;
    // The dragged row.
    private property <string> drag-row;
    // G-08: the pointer's y in the list's frame while dragging; within 20px of the top or
    // bottom edge the list scrolls by one row per 50 ms, up to three nearer the edge.
    private property <length> drag-y;
    private property <length> max-scroll: max(0px, root.row-count * root.row-height - list.visible-height);
    private property <length> edge-depth: root.drag-y < 20px ? 20px - root.drag-y
        : root.drag-y > list.height - 20px ? root.drag-y - (list.height - 20px) : 0px;
    private property <int> edge-rows: min(3, 1 + Math.floor(root.edge-depth / 7px));

    changed scroll-request => { list.content-y = -PlaylistBridge.scroll-to-y * 1px; }
    private property <int> scroll-request: PlaylistBridge.scroll-request;
    // The row at `y` in the list's frame (may be outside 0 … row-count - 1).
    pure function row-at(y: length) -> int {
        return Math.floor((y - list.content-y) / root.row-height);
    }
    pure function drop-index-at(y: length) -> int {
        return clamp(Math.round((y - list.content-y) / root.row-height), 0, root.row-count);
    }
    function end-drag(drop: bool) {
        root.dragging = false;
        PlaylistBridge.dragging(false);
        if drop { PlaylistBridge.drop-row(root.drag-row, root.drop-index); }
        root.drop-index = -1;
    }
    function report-area() {
        PlaylistBridge.list-area(-list.content-y / 1px, list-area.height / 1px, list-area.y / 1px);
    }
    edge-timer := Timer {
        interval: 50ms;
        running: root.dragging && root.max-scroll > 0px && root.edge-depth > 0px;
        triggered => {
            let step: length = root.edge-rows * root.row-height;
            list.content-y = clamp(list.content-y + (root.drag-y < 20px ? step : -step), -root.max-scroll, 0px);
            root.drop-index = root.drop-index-at(root.drag-y);
        }
    }

    changed focus-search-request => { root.open-search(); }
    private property <int> focus-search-request: PlaylistBridge.focus-search;
    // Bottom bar (coordinator ruling): when the room after the controls holds an 80px search box
    // plus the total, both are shown. Otherwise the search box folds into a magnifier icon next to
    // the total; clicking it or Ctrl+S unfolds the box over the total (the total hides) until the
    // box is empty and loses focus (or Esc clears it). A search term keeps it unfolded.
    // Left edge of the search area: the measured controls plus a 4px gap.
    private property <length> bar-fixed: controls.preferred-width + 4px;
    // The total as shown: "Filtered 01:30" while a search filters.
    private property <string> total-text: PlaylistBridge.filtering && PlaylistBridge.total != "" ? @tr("Filtered {}", PlaylistBridge.total) : PlaylistBridge.total;
    // Gap before the total plus its width.
    private property <length> total-width: PlaylistBridge.total == "" ? 0px : total-measure.preferred-width + 4px;
    private property <length> search-room: bar.width - root.bar-fixed - 6px;
    private property <bool> roomy: root.search-room - root.total-width >= 80px;
    // Folded into the icon (only when there is not enough room).
    private property <bool> unfolded;
    // A term or focus keeps the box open, also when the bar narrows while typing.
    private property <bool> folded: !root.roomy && !root.unfolded && search.text == "" && !search.has-focus;
    private property <bool> show-total: PlaylistBridge.total != "" && (root.roomy || root.folded);
    private property <length> search-width: root.roomy ? root.search-room - root.total-width : root.search-room;
    function open-search() {
        root.unfolded = true;
        search.focus();
        search.select-all();
    }
    function fold-search() {
        if search.text == "" && !search.has-focus { root.unfolded = false; }
    }

    list-focus := FocusScope {
        changed has-focus => { PlaylistBridge.focus-changed(self.has-focus); }
        key-pressed(event) => {
            // Ctrl/Cmd/Alt chords (Ctrl+↑, Ctrl+A …) bubble up to the list's key bindings.
            if event.modifiers.control || event.modifiers.meta || event.modifiers.alt { return reject; }
            if event.text == Key.UpArrow { PlaylistBridge.select-step(-1, event.modifiers.shift); return accept; }
            if event.text == Key.DownArrow { PlaylistBridge.select-step(1, event.modifiers.shift); return accept; }
            if event.text == Key.Home { PlaylistBridge.select-step(-1000000, event.modifiers.shift); return accept; }
            if event.text == Key.End { PlaylistBridge.select-step(1000000, event.modifiers.shift); return accept; }
            return reject;
        }
        VerticalLayout {
            // Tab strip with the detach/attach and close buttons at its right end; the
            // player draws its own (with the same buttons) when the sidebar has tabs. An `if`: it
            // changes only when the sidebar gains or loses tabs, and a hidden strip would keep its
            // 31px in the layout.
            if !PlaylistBridge.tabbed: Rectangle {
                height: 31px;
                background: Theme.bg-bar;
                HorizontalLayout {
                    // The one tab: its label over a 28px gradient stroke.
                    Rectangle {
                        width: max(105px, tab-label.preferred-width + 12px);
                        Rectangle {
                            x: (parent.width - 28px) / 2;
                            y: parent.height - 3px;
                            width: 28px;
                            height: 2px;
                            border-radius: 1px;
                            background: Theme.accent-fill;
                        }
                        tab-label := Text {
                            width: 100%;
                            height: 100%;
                            text: @tr("Playlist");
                            color: Theme.text;
                            font-size: Theme.font-tab;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton {
                        tip: PlaylistBridge.detached ? @tr("Attach to main window") : @tr("Detach as floating window");
                        // Detached: arrow into the frame; attached: arrow out of it.
                        icon: PlaylistBridge.detached ? "attach" : "detach";
                        clicked => { PlaylistBridge.toggle-detached(); }
                    }
                    IconButton {
                        tip: @tr("Close list");
                        icon: "close";
                        clicked => { PlaylistBridge.hide(); }
                    }
                    Rectangle { width: 3px; }
                }
            }

            // The list; the empty space below the rows takes the list menu too.
            list-area := Rectangle {
                vertical-stretch: 1;
                background: Theme.bg-list;
                init => {
                    list.content-y = -PlaylistBridge.show-y * 1px;
                    root.settled-height = root.row-height;
                    root.top-row = Math.floor(PlaylistBridge.show-y * 1px / root.row-height);
                    root.report-area();
                }
                changed height => { root.report-area(); }
                changed y => { root.report-area(); }
                // Every press, drag, release and double-click on the list (see `press-row`). The
                // rows hold no TouchArea, so presses reach this one through them; the scroll bar
                // keeps its own. Touch is not a target (user ruling 2026-11-01): on a list that
                // scrolls, the ListView takes a touch press to pan it, so a tap may not select.
                pointer := TouchArea {
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            list-focus.focus();
                            let at = root.row-at(self.mouse-y);
                            let hit = at >= 0 && at < root.row-count;
                            let pressed = hit ? PlaylistBridge.rows[at].id : "";
                            root.quiet-row = pressed;
                            if event.button == PointerEventButton.left {
                                root.press-y = self.mouse-y;
                                root.press-row = pressed;
                                root.collapse = false;
                                // Below the rows: focus only.
                                if hit {
                                    if event.modifiers.shift {
                                        PlaylistBridge.select-row(pressed, false, true);
                                    } else if event.modifiers.control || event.modifiers.meta {
                                        PlaylistBridge.select-row(pressed, true, false);
                                    } else if !PlaylistBridge.rows[at].selected {
                                        PlaylistBridge.select-row(pressed, false, false);
                                    } else {
                                        // Keep a multi-selection for dragging; a plain click collapses it on release.
                                        root.collapse = true;
                                    }
                                }
                            }
                            // Right press selects; the menu opens on release (G-15).
                            if event.button == PointerEventButton.right && hit && !PlaylistBridge.rows[at].selected {
                                PlaylistBridge.select-row(pressed, false, false);
                            }
                        }
                        // The list menu opens when the right button is released (as the main menu, G-15).
                        if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                            PlaylistBridge.context-menu((self.absolute-position.x + self.mouse-x) / 1px, (self.absolute-position.y + self.mouse-y) / 1px);
                        }
                        if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                            if root.dragging {
                                root.end-drag(true);
                            } else if root.collapse {
                                PlaylistBridge.select-row(root.press-row, false, false);
                            }
                            root.collapse = false;
                            root.press-row = "";
                        }
                        // The grab was taken away (the window lost the pointer): no drop.
                        if event.kind == PointerEventKind.cancel {
                            if root.dragging { root.end-drag(false); }
                            root.collapse = false;
                            root.press-row = "";
                        }
                    }
                    moved => {
                        if !self.pressed { return; }
                        if !root.dragging && PlaylistBridge.can-drag && root.press-row != "" && abs(self.mouse-y - root.press-y) > 4px {
                            root.dragging = true;
                            root.drag-row = root.press-row;
                            PlaylistBridge.dragging(true);
                        }
                        if root.dragging {
                            root.drag-y = self.mouse-y;
                            root.drop-index = root.drop-index-at(root.drag-y);
                        }
                    }
                    // Called before the release's pointer event: `press-row` is the second press's row.
                    double-clicked => {
                        if !root.dragging && root.press-row != "" { PlaylistBridge.play-row(root.press-row); }
                    }
                    list := ListView {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: min(parent.height, root.row-count * root.row-height);
                        horizontal-scrollbar-policy: always-off;
                        accessible-item-count: root.row-count;
                        changed content-y => {
                            if root.row-height == root.settled-height { root.top-row = Math.floor(-self.content-y / root.row-height); }
                            root.report-area();
                        }
                        for row[index] in PlaylistBridge.rows: Rectangle {
                            property <color> ink: row.current ? Theme.playing : row.selected ? Theme.text : row.played ? Theme.text-played : Theme.text-list;
                            // Its place in the whole list (also while a search filters) and title.
                            property <string> title: "\{row.number > 0 ? row.number : index + 1}. \{row.label}";
                            property <string> tip: row.problem == "missing" ? @tr("{}\nThe file does not exist", row.tooltip)
                                : row.problem == "unreadable" ? @tr("{}\nThe file does not exist or cannot be read now; can retry", row.tooltip)
                                : row.problem == "unplayable" ? @tr("{}\nCannot open this media", row.tooltip)
                                : row.tooltip;
                            // Fixed per row style: the list maps the pointer to a row (and a drop
                            // point to a row, A15) by this height.
                            height: root.row-height;
                            background: row.selected ? root.selected-bg : transparent;
                            accessible-role: list-item;
                            accessible-label: self.title;
                            accessible-item-index: index;
                            accessible-item-selectable: true;
                            accessible-item-selected: row.selected;
                            // The playing row: a 2px bar in the playing colour at its left edge. Elements
                            // that come and go with a row's state always exist and use `visible` (a
                            // toggled `if` rebuilds the accessibility tree, host rule 2026-10-27).
                            Rectangle {
                                visible: row.current;
                                x: 0;
                                y: 3px;
                                width: 2px;
                                height: parent.height - 6px;
                                border-radius: 1px;
                                background: Theme.playing;
                            }
                            // The row style stays an `if`: it changes only with the bottom bar's toggle, and
                            // both styles always present would double every row's elements.
                            if !PlaylistBridge.thumbnails: HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                padding-left: 6px;
                                padding-right: 6px;
                                // The 4px gaps are explicit, so the failed mark's slot is 0px wide
                                // without it (a hidden element keeps its place in a layout).
                                spacing: 0px;
                                Text {
                                    text: title;
                                    color: ink;
                                    font-size: Theme.font-tab; // 12px (U-06)
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Rectangle {
                                    width: row.failed ? 4px + failed-mark.width : 0px;
                                    failed-mark := Icon {
                                        visible: row.failed;
                                        x: 4px;
                                        y: 5px;
                                        name: "failed";
                                        color: Theme.accent;
                                    }
                                }
                                Rectangle { width: 4px; }
                                Text {
                                    text: row.duration;
                                    color: ink;
                                    font-size: Theme.font-tab;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }
                            // 0.1.11, as VestraTube's rows: a 96×54 thumbnail with the duration on
                            // its bottom right; the title (two lines at most) and the folder beside it.
                            if PlaylistBridge.thumbnails: Rectangle {
                                width: 100%;
                                height: 100%;
                                Rectangle {
                                    x: 8px;
                                    y: 4px;
                                    width: 96px;
                                    height: 54px;
                                    border-radius: 3px;
                                    clip: true;
                                    background: Theme.bg-bar;
                                    // Until a picture is made (and when there is none): an audio or link glyph.
                                    Glyph {
                                        visible: row.thumb.width <= 1 && (row.media == "audio" || row.media == "link");
                                        glyph: row.media == "audio" ? PlaylistGlyphs.audio : PlaylistGlyphs.link;
                                        box-width: 14px;
                                        box-height: 14px;
                                        width: 20px;
                                        height: 20px;
                                        color: Theme.text-dim;
                                    }
                                    Image {
                                        width: 100%;
                                        height: 100%;
                                        source: row.thumb;
                                        image-fit: contain;
                                    }
                                    Rectangle {
                                        visible: row.duration != "";
                                        x: parent.width - self.width - 3px;
                                        y: parent.height - self.height - 3px;
                                        width: badge.preferred-width + 6px;
                                        height: 14px;
                                        border-radius: 2px;
                                        // Drawn over the picture: light text on a dark badge in every palette.
                                        background: #000000c0;
                                        badge := Text {
                                            text: row.duration;
                                            color: #ffffff;
                                            font-size: Theme.font-xs;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Text {
                                    x: 112px;
                                    y: 5px;
                                    width: parent.width - 120px - (row.failed ? 18px : 0px);
                                    height: 32px;
                                    text: title;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    color: ink;
                                    font-size: Theme.font-tab;
                                }
                                Text {
                                    x: 112px;
                                    y: 40px;
                                    width: parent.width - 120px;
                                    height: 16px;
                                    text: row.detail;
                                    overflow: elide;
                                    color: Theme.text-dim;
                                    font-size: Theme.font-xs;
                                    vertical-alignment: center;
                                }
                                Icon {
                                    visible: row.failed;
                                    x: parent.width - 22px;
                                    y: 7px;
                                    name: "failed";
                                    color: Theme.accent;
                                }
                            }
                            // The tooltip only watches the pointer (presses go through to the list's
                            // TouchArea); as the ToolTipArea, none after a press until the pointer leaves.
                            if row.id != root.quiet-row: Tooltip {
                                // Interpolated text is plain: `*` or `_` in it are not markup.
                                text: @markdown("\{tip}");
                            }
                        }
                    }
                    // Insertion marker while dragging: above the row at `drop-index`, or below the
                    // last row; one element for the list (the row at the marker may have none).
                    Rectangle {
                        property <length> at: root.drop-index * root.row-height + list.content-y
                            - (root.drop-index == root.row-count && root.row-count > 0 ? 2px : 0px);
                        visible: root.dragging && root.drop-index >= 0 && self.at >= 0px && self.at <= list.height - 2px;
                        x: 0;
                        y: self.at;
                        width: list.visible-width;
                        height: 2px;
                        background: Theme.accent;
                    }
                }
                Text {
                    visible: PlaylistBridge.filtering && root.row-count == 0;
                    width: 100%;
                    height: 100%;
                    text: @tr("No matches");
                    color: Theme.text-dim;
                    font-size: Theme.font-tab;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Bottom bar: move icons | ADD DEL SORT | search | total duration (hidden first when narrow).
            bar := Rectangle {
                height: 35px;
                background: Theme.bg-panel;
                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: 1px;
                    background: Theme.line;
                }
                // The fixed part is a layout; the search box and the total are placed by hand so
                // hiding the total never feeds back into the sidebar's layout.
                controls := HorizontalLayout {
                    x: 0;
                    width: self.preferred-width;
                    padding-left: 6px;
                    padding-top: 1px;
                    IconButton {
                        tip: @tr("Move to top (Ctrl+Home)");
                        enabled: PlaylistBridge.can-top;
                        icon: "move-top";
                        clicked => { PlaylistBridge.place("top"); }
                    }
                    IconButton {
                        tip: @tr("Move up (Ctrl+↑)");
                        enabled: PlaylistBridge.can-up;
                        icon: "move-up";
                        clicked => { PlaylistBridge.place("up"); }
                    }
                    IconButton {
                        tip: @tr("Move down (Ctrl+↓)");
                        enabled: PlaylistBridge.can-down;
                        icon: "move-down";
                        clicked => { PlaylistBridge.place("down"); }
                    }
                    IconButton {
                        tip: @tr("Move to bottom (Ctrl+End)");
                        enabled: PlaylistBridge.can-bottom;
                        icon: "move-bottom";
                        clicked => { PlaylistBridge.place("bottom"); }
                    }
                    Rectangle { width: 6px; }
                    BarButton {
                        text: @tr("Add");
                        icon: "add";
                        pill-width: 28px;
                        enabled: PlaylistBridge.can-add;
                        clicked(x, y) => { PlaylistBridge.add-menu(x, y); }
                    }
                    Rectangle { width: 4px; }
                    BarButton {
                        text: @tr("Delete");
                        icon: "remove";
                        pill-width: 28px;
                        enabled: PlaylistBridge.can-remove;
                        clicked => { PlaylistBridge.remove(); }
                    }
                    Rectangle { width: 4px; }
                    BarButton {
                        text: @tr("Sort");
                        icon: "sort";
                        enabled: PlaylistBridge.can-sort;
                        clicked(x, y) => { PlaylistBridge.sort-menu(x, y); }
                    }
                    Rectangle { width: 4px; }
                    // 0.1.11: thumbnails on or off; the glyph shows the current mode, the tooltip
                    // what a click does.
                    BarButton {
                        text: PlaylistBridge.thumbnails ? @tr("Hide Thumbnails") : @tr("Show Thumbnails");
                        glyph: PlaylistBridge.thumbnails ? PlaylistGlyphs.thumb-rows : PlaylistGlyphs.compact-rows;
                        pill-width: 28px;
                        clicked => { PlaylistBridge.toggle-thumbnails(); }
                    }
                }
                // C21 search box: about 24px high on `Theme.hover-bg` (UI-PL-09); width from `search-width`.
                // The folded search box: a magnifier icon the size of the bar's other icons.
                IconButton {
                    visible: root.folded;
                    x: root.bar-fixed;
                    y: 1px;
                    height: parent.height - 1px;
                    tip: @tr("Search (Ctrl+S)");
                    icon: "search";
                    clicked => { root.open-search(); }
                }
                search-keys := FocusScope {
                    visible: !root.folded;
                    x: root.bar-fixed;
                    y: (parent.height - self.height) / 2 + 0.5px;
                    width: root.search-width;
                    height: 24px;
                    capture-key-pressed(event) => {
                        if event.text == Key.Escape {
                            search.text = "";
                            PlaylistBridge.search-changed("");
                            list-focus.focus();
                            root.fold-search();
                            return accept;
                        }
                        if event.text == Key.DownArrow {
                            PlaylistBridge.search-down();
                            list-focus.focus();
                            return accept;
                        }
                        if event.text == Key.UpArrow { return accept; }
                        return reject;
                    }
                    Rectangle {
                        background: Theme.hover-bg;
                        border-radius: Theme.radius-control;
                        clip: true;
                        search := TextInput {
                            x: 6px;
                            width: parent.width - 12px;
                            height: 100%;
                            vertical-alignment: center;
                            single-line: true;
                            color: Theme.text;
                            // As the std-widgets LineEdit: legible in both palettes.
                            selection-background-color: Palette.selection-background;
                            selection-foreground-color: Palette.selection-foreground;
                            font-size: Theme.font-body;
                            edited => { PlaylistBridge.search-changed(self.text); }
                            accepted => { PlaylistBridge.search-accept(); }
                            changed has-focus => {
                                PlaylistBridge.search-focus(self.has-focus);
                                root.fold-search();
                            }
                        }
                        Text {
                            visible: search.text == "" && root.search-width >= 56px;
                            x: 6px;
                            height: 100%;
                            text: @tr("Search");
                            color: Theme.text-dim;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                        }
                    }
                }
                Text {
                    visible: root.show-total;
                    x: parent.width - 6px - self.width;
                    y: 0;
                    width: total-measure.preferred-width;
                    height: parent.height;
                    text: root.total-text;
                    color: Theme.text-list;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
                total-measure := Text {
                    visible: false;
                    text: root.total-text;
                    font-size: Theme.font-body;
                }
            }
        }
    }
}

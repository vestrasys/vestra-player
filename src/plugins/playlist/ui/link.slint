import { LineEdit } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button } from "@vestra/widgets.slint";

export component AddLink inherits Window {
    title: "添加链接到播放列表";
    preferred-width: 420px;
    min-width: 360px;
    background: Theme.bg-panel;
    in-out property <string> message: "输入 HTTP(S) 链接；添加只选择，不自动播放";
    callback add-link(string);
    callback hide();
    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: 8px;
        Text { text: "网络内容链接"; color: Theme.text; font-size: Theme.font-body; }
        url := LineEdit {
            height: Theme.input-height;
            placeholder-text: "https://…";
            accepted => { root.add-link(self.text); }
        }
        Text { text: root.message; color: Theme.text-list; font-size: Theme.font-body; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            spacing: 6px;
            Button { text: "添加"; clicked => { root.add-link(url.text); } }
            Button { text: "取消"; clicked => { root.hide(); } }
        }
    }
}

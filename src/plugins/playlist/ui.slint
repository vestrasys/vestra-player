// 仅用于 Slint 实验；本版本界面与接口和最终成品 API 会有很大差异。
// 宿主通过实验 sidebar 挂载点放置该面板；这不是最终的布局 API。
import { Button } from "std-widgets.slint";

export global PlaylistState {
    in-out property <bool> visible: true;
    in-out property <string> items-text: "点击“添加文件”建立播放列表";
    in-out property <string> status: "共 0 个文件";
    in-out property <float> count: 0;
    in-out property <float> page: 0;
    in-out property <bool> has-previous: false;
    in-out property <bool> has-next: false;
    callback action(string, float);
}

export component PlaylistPanel inherits Rectangle {
    preferred-width: 260px;
    min-width: 220px;
    horizontal-stretch: 0;
    visible: PlaylistState.visible;
    background: #202a36;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            Text { text: "播放列表"; color: #dce5ef; vertical-alignment: center; }
            Button { text: "隐藏"; clicked => { PlaylistState.action("hide", 0); } }
        }
        Button { text: "添加文件"; clicked => { PlaylistState.action("add", 0); } }
        Text {
            text: PlaylistState.items-text;
            color: #dce5ef;
            wrap: word-wrap;
        }
        for _[slot] in 3: Button {
            text: "播放第 " + (PlaylistState.page * 3 + slot + 1) + " 项";
            enabled: PlaylistState.page * 3 + slot < PlaylistState.count;
            clicked => { PlaylistState.action("play-index", PlaylistState.page * 3 + slot); }
        }
        HorizontalLayout {
            Button {
                text: "上一页";
                enabled: PlaylistState.has-previous;
                clicked => { PlaylistState.action("previous-page", 0); }
            }
            Button {
                text: "下一页";
                enabled: PlaylistState.has-next;
                clicked => { PlaylistState.action("next-page", 0); }
            }
        }
        Text { text: PlaylistState.status; color: #dce5ef; wrap: word-wrap; }
        Rectangle { vertical-stretch: 1; }
    }
}

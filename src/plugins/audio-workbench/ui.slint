// 实验探针：界面及 API 与最终成品可能相差很大。
import { Button, CheckBox, Slider } from "std-widgets.slint";

export global AudioWorkbenchState {
    in-out property <float> bass: 0;
    in-out property <float> mid: 0;
    in-out property <float> treble: 0;
    in-out property <float> delay-ms: 0;
    in-out property <bool> normalize: false;
    in-out property <bool> voice: false;
    in-out property <string> status: "音频工作台";
    callback action(string, float);
}

export component AudioWorkbenchPanel inherits Rectangle {
    background: #202a36;
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        HorizontalLayout {
            Text { text: "低频 100Hz（dB）"; color: white; }
            Slider { minimum: -12; maximum: 12; value: AudioWorkbenchState.bass;
                changed(v) => { AudioWorkbenchState.action("bass", v); } }
            Text { text: round(AudioWorkbenchState.bass * 10) / 10; color: white; }
        }
        HorizontalLayout {
            Text { text: "中频 1kHz（dB）"; color: white; }
            Slider { minimum: -12; maximum: 12; value: AudioWorkbenchState.mid;
                changed(v) => { AudioWorkbenchState.action("mid", v); } }
            Text { text: round(AudioWorkbenchState.mid * 10) / 10; color: white; }
        }
        HorizontalLayout {
            Text { text: "高频 6kHz（dB）"; color: white; }
            Slider { minimum: -12; maximum: 12; value: AudioWorkbenchState.treble;
                changed(v) => { AudioWorkbenchState.action("treble", v); } }
            Text { text: round(AudioWorkbenchState.treble * 10) / 10; color: white; }
        }
        HorizontalLayout {
            Text { text: "音频延迟（ms，负值提前）"; color: white; }
            Slider { minimum: -2000; maximum: 2000; value: AudioWorkbenchState.delay-ms;
                changed(v) => { AudioWorkbenchState.action("delay-ms", v); } }
            Text { text: round(AudioWorkbenchState.delay-ms); color: white; }
        }
        HorizontalLayout {
            CheckBox { text: "响度规范化"; checked: AudioWorkbenchState.normalize;
                toggled => { AudioWorkbenchState.action("normalize", self.checked ? 1 : 0); } }
            CheckBox { text: "人声增强"; checked: AudioWorkbenchState.voice;
                toggled => { AudioWorkbenchState.action("voice", self.checked ? 1 : 0); } }
            Button { text: "对白预设"; clicked => { AudioWorkbenchState.action("preset", 1); } }
            Button { text: "音乐预设"; clicked => { AudioWorkbenchState.action("preset", 2); } }
            Button { text: "复位"; clicked => { AudioWorkbenchState.action("reset", 0); } }
        }
        Text { text: AudioWorkbenchState.status; color: #dce5ef; wrap: word-wrap; }
    }
}

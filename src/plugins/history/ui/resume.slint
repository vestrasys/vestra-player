// B25 Ask Every Time: "You didn't finish this last time. Continue? (12:34)" [Continue] (default, Enter) [Start Over] (Esc).
import { Theme } from "@vestra/theme.slint";
import { Button } from "@vestra/widgets.slint";

export component ResumeWindow inherits Window {
    title: @tr("Resume Playback");
    preferred-width: 300px;
    preferred-height: 110px;
    min-width: 260px;
    background: Theme.bg-panel;
    // The remembered point, `12:34`.
    in property <string> position;
    callback resume();
    callback restart();
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return {
                root.resume();
                return accept;
            }
            if event.text == Key.Escape {
                root.restart();
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: 12px;
            Text {
                text: @tr("You didn't finish this last time. Continue? ({})", root.position);
                color: Theme.text;
                font-size: Theme.font-body;
                wrap: word-wrap;
                line-height-factor: 1.25;
                vertical-alignment: center;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                // The default button: outlined in the accent colour.
                Rectangle {
                    border-color: Theme.accent;
                    border-width: 1px;
                    border-radius: Theme.radius-control;
                    HorizontalLayout {
                        padding: 1px;
                        Button { text: @tr("Continue"); clicked => { root.resume(); } }
                    }
                }
                Button { text: @tr("Start Over"); clicked => { root.restart(); } }
            }
        }
    }
    init => { keys.focus(); }
}

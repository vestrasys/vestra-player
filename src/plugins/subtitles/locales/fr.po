msgstr "Le fichier de sous-titres doit être un fichier ordinaire de 1 octet à 8 Mio."

#: messages.ts:150
#, x-machine
msgid "The subtitle file is empty or larger than 8 MiB."
msgstr "Le fichier de sous-titres est vide ou dépasse 8 Mio."

#: messages.ts:150
#, x-machine
msgid "Image subtitle files are not supported yet"
msgstr "Les fichiers de sous-titres en image ne sont pas encore pris en charge"

#: messages.ts:150
#, x-machine
msgid "Unknown subtitle format"
msgstr "Format de sous-titres inconnu"

#: messages.ts:150
#, x-machine
msgid "The subtitle file has no subtitles."
msgstr "Le fichier de sous-titres ne contient aucun sous-titre."

#: messages.ts:150
#, x-machine
msgid "The subtitle file is larger than 2 MiB"
msgstr "Le fichier de sous-titres dépasse 2 Mio"

#: messages.ts:150 messages.ts:151
#, x-machine
msgid "The subtitle encoding may be wrong; change the default encoding in Subtitle Settings"
msgstr "L'encodage des sous-titres est peut-être incorrect ; modifiez l'encodage par défaut dans Paramètres des sous-titres"

#: messages.ts:150 messages.ts:151
#, x-machine
msgid "Fonts embedded in the subtitle were ignored"
msgstr "Les polices intégrées aux sous-titres ont été ignorées"


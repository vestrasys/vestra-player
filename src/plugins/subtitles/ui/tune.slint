// Subtitle Tuning: the control box's subtitle page (ui-spec §7.4, UI-TOOL-08).
// Changes apply at once; every row has its own Default (UI-TOOL-04). Every
// text is @tr (English source; locales/<lang>.po translate it); the plugin
// passes data.
import { ComboBox } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button, ToolTipArea } from "@vestra/widgets.slint";
import { Status, StatusText } from "messages.slint";

component RowLabel inherits Text {
    width: 65px;
    color: Theme.text;
    font-size: Theme.font-body;
    horizontal-alignment: right;
    vertical-alignment: center;
    overflow: elide;
}

export component SubtitleTune inherits Window {
    title: @tr("Subtitle Tuning");
    width: 301px;
    background: Theme.bg-panel;
    // The first entry (off) comes from the plugin with the track names (text values, translated by the player).
    in property <[string]> track-labels: [];
    in property <int> selected-track: 0;
    in property <[string]> secondary-labels: [];
    in property <int> selected-secondary: 0;
    in property <bool> busy: false;
    in property <bool> can-style: false;
    in property <bool> can-remove: false;
    in property <Status> style-reason;
    in property <int> subtitle-size: 36;
    in property <int> margin-percent: 5;
    // The offset in seconds with its sign: "+0.5", "−1", "0".
    in property <string> sync-seconds: "0";
    in property <Status> status;
    // A user pick or a model change detaches ComboBox.current-index; re-push model changes.
    changed track-labels => { track-combo.current-index = root.selected-track; }
    changed selected-track => { track-combo.current-index = root.selected-track; }
    changed secondary-labels => { secondary-combo.current-index = root.selected-secondary; }
    changed selected-secondary => { secondary-combo.current-index = root.selected-secondary; }
    callback select-track(int);
    callback select-secondary(int);
    callback load-file();
    callback cancel();
    callback size-step(int);
    callback position-step(int);
    callback sync-step(int);
    callback reset-field(string);
    callback remove-selected();
    callback open-settings();
    callback open-sync();

    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 3px;
            track-combo := ComboBox {
                height: 22px;
                model: root.track-labels;
                current-index: root.selected-track;
                enabled: !root.busy;
                selected(value) => { root.select-track(self.current-index); }
            }
            // While an operation runs the same button cancels it.
            Button {
                width: 51px; height: 22px;
                text: root.busy ? @tr("Cancel") : @tr("Load…");
                clicked => { if root.busy { root.cancel(); } else { root.load-file(); } }
            }
        }
        // Secondary subtitle (A08): as wide as the track list, nothing on the right. The pick shows once
        // the player has it; a refused one (the primary, a bitmap track) snaps back.
        HorizontalLayout {
            spacing: 3px;
            secondary-combo := ComboBox {
                height: 22px;
                model: root.secondary-labels;
                current-index: root.selected-secondary;
                enabled: !root.busy;
                selected(value) => {
                    root.select-secondary(self.current-index);
                    self.current-index = root.selected-secondary;
                }
            }
            Rectangle { width: 51px; }
        }
        HorizontalLayout {
            spacing: 3px;
            RowLabel { text: @tr("Size {}", root.subtitle-size); }
            Button { width: 51px; height: 22px; text: "−"; enabled: root.can-style; clicked => { root.size-step(-1); } }
            Button { width: 51px; height: 22px; text: "+"; enabled: root.can-style; clicked => { root.size-step(1); } }
            Rectangle { }
            Button { width: 41px; height: 22px; text: @tr("Default"); enabled: root.can-style; clicked => { root.reset-field("size"); } }
        }
        HorizontalLayout {
            spacing: 3px;
            RowLabel { text: @tr("Position {}%", root.margin-percent); }
            Button { width: 51px; height: 22px; text: @tr("Up"); enabled: root.can-style; clicked => { root.position-step(1); } }
            Button { width: 51px; height: 22px; text: @tr("Down"); enabled: root.can-style; clicked => { root.position-step(-1); } }
            Rectangle { }
            Button { width: 41px; height: 22px; text: @tr("Default"); enabled: root.can-style; clicked => { root.reset-field("position"); } }
        }
        HorizontalLayout {
            spacing: 3px;
            // The value opens Adjust Sync (D05).
            ToolTipArea {
                text: @tr("In seconds. Positive delays the subtitles, negative advances them. Click to enter a value.");
                width: 65px;
                RowLabel {
                    text: @tr("Sync {}", root.sync-seconds);
                    color: sync-touch.has-hover ? Theme.accent : Theme.text;
                }
                sync-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-sync(); }
                }
            }
            Button { width: 69px; height: 22px; text: @tr("Later"); enabled: root.can-style; clicked => { root.sync-step(1); } }
            Button { width: 69px; height: 22px; text: @tr("Earlier"); enabled: root.can-style; clicked => { root.sync-step(-1); } }
            Button { width: 69px; height: 22px; text: @tr("Default"); enabled: root.can-style; clicked => { root.reset-field("sync"); } }
        }
        HorizontalLayout {
            spacing: 3px;
            StatusText {
                status: root.status;
                fallback: root.style-reason;
                color: Theme.text-list;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Button { height: 22px; text: @tr("Remove"); small: true; enabled: root.can-remove && !root.busy; clicked => { root.remove-selected(); } }
            Button { height: 22px; text: @tr("Settings…"); small: true; clicked => { root.open-settings(); } }
        }
    }
}

import { Button, ComboBox, HorizontalBox, Slider, VerticalBox } from "std-widgets.slint";
export component SubtitleWorkbench inherits Window {
    title: "字幕工作台";
    preferred-width: 620px;
    preferred-height: 650px;
    min-width: 500px;
    min-height: 610px;
    in property <string> status-text: "正在读取字幕…";
    in property <string> source-text: "";
    in property <string> confirmation-text: "";
    in property <[string]> track-labels: ["关闭字幕"];
    in property <int> selected-track: 0;
    in property <bool> busy: false;
    in property <bool> can-style: false;
    in property <bool> can-remove: false;
    in property <string> style-reason: "";
    in property <[string]> font-labels: [];
    in property <int> selected-font: 0;
    in property <float> delay-ms: 0;
    in property <float> font-size: 36;
    in property <float> outline-size: 2;
    in property <float> margin-percent: 5;
    in property <int> selected-color: 0;
    // A user drag writes Slider.value and drops the binding; re-push model changes.
    changed delay-ms => { delay-slider.value = root.delay-ms; }
    changed font-size => { size-slider.value = root.font-size; }
    changed outline-size => { outline-slider.value = root.outline-size; }
    changed margin-percent => { margin-slider.value = root.margin-percent; }
    // A user pick or a model change detaches ComboBox.current-index; re-push model changes.
    changed track-labels => { track-combo.current-index = root.selected-track; }
    changed selected-track => { track-combo.current-index = root.selected-track; }
    changed font-labels => { font-combo.current-index = root.selected-font; }
    changed selected-font => { font-combo.current-index = root.selected-font; }
    changed selected-color => { color-combo.current-index = root.selected-color; }
    callback load-file();
    callback refresh();
    callback cancel();
    callback select-track(int);
    callback remove-selected();
    callback reset-style();
    callback change-delay(float);
    callback change-size(float);
    callback change-outline(float);
    callback change-margin(float);
    callback change-font(int);
    callback change-color(int);
    VerticalBox {
        padding: 20px; spacing: 12px;
        Text { text: "字幕"; font-size: 26px; font-weight: 700; }
        Text { text: root.source-text; wrap: word-wrap; }
        HorizontalBox {
            Button { text: "加载 SRT…"; enabled: !root.busy; clicked => { root.load-file(); } }
            Button { text: "刷新"; enabled: !root.busy; clicked => { root.refresh(); } }
            Button { text: "取消操作"; enabled: root.busy; clicked => { root.cancel(); } }
        }
        Text { text: "字幕轨"; font-weight: 600; }
        track-combo := ComboBox { model: root.track-labels; current-index: root.selected-track; enabled: !root.busy; selected(value) => { root.select-track(self.current-index); } }
        Button { text: "移除选中的外部字幕"; enabled: root.can-remove && !root.busy; clicked => { root.remove-selected(); } }
        Text { text: root.style-reason; wrap: word-wrap; }
        HorizontalBox {
            Text { text: "延迟 " + round(root.delay-ms) + " ms"; min-width: 170px; }
            delay-slider := Slider { minimum: -10000; maximum: 10000; value: root.delay-ms; enabled: root.can-style; changed(value) => { root.change-delay(value); } }
        }
        Text { text: "正值晚出现，负值提前。"; }
        HorizontalBox {
            Text { text: "字号 " + round(root.font-size); min-width: 170px; }
            size-slider := Slider { minimum: 16; maximum: 72; value: root.font-size; enabled: root.can-style; changed(value) => { root.change-size(value); } }
        }
        HorizontalBox {
            Text { text: "描边 " + round(root.outline-size); min-width: 170px; }
            outline-slider := Slider { minimum: 0; maximum: 4; value: root.outline-size; enabled: root.can-style; changed(value) => { root.change-outline(value); } }
        }
        HorizontalBox {
            Text { text: "底部边距 " + round(root.margin-percent) + "%"; min-width: 170px; }
            margin-slider := Slider { minimum: 2; maximum: 15; value: root.margin-percent; enabled: root.can-style; changed(value) => { root.change-margin(value); } }
        }
        HorizontalBox {
            Text { text: "字体"; }
            font-combo := ComboBox { model: root.font-labels; current-index: root.selected-font; enabled: root.can-style; selected(value) => { root.change-font(self.current-index); } }
            color-combo := ComboBox { model: ["白色", "黄色", "青色"]; current-index: root.selected-color; enabled: root.can-style; selected(value) => { root.change-color(self.current-index); } }
        }
        Button { text: "撤销本插件的样式与延迟"; enabled: !root.busy; clicked => { root.reset-style(); } }
        Text { text: root.confirmation-text; wrap: word-wrap; }
        Text { text: root.status-text; wrap: word-wrap; vertical-stretch: 1; }
    }
}

// 手动调整同步 (D05): 350×121, one row
// 「同步值(毫秒)：」 102 right-aligned + field 86×21 + 应用 75×23, 7px apart.
// Enter or 应用 applies; ↑/↓ in the field step by the 同步单位 (the field eats the keys).
import { LineEdit } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button } from "@vestra/widgets.slint";

export component SubtitleSync inherits Window {
    title: "手动调整同步";
    width: 350px;
    height: 121px;
    background: Theme.bg-panel;
    in property <bool> busy: false;
    in property <bool> can-style: false;
    in property <string> style-reason: "";
    in property <string> status-text: "";
    in-out property <string> value-text: "0";
    callback apply(string);
    callback nudge(string, int);

    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: 7px;
        alignment: center;
        HorizontalLayout {
            spacing: 7px;
            alignment: center;
            Text {
                width: 102px;
                text: "同步值(毫秒)：";
                color: root.can-style ? Theme.text : Theme.text-dim;
                font-size: Theme.font-body;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            FocusScope {
                width: 86px;
                height: Theme.input-height;
                focus-on-click: false;
                focus-on-tab-navigation: false;
                capture-key-pressed(event) => {
                    if !root.can-style { return reject; }
                    if event.text == Key.UpArrow { root.nudge(input.text, 1); return accept; }
                    if event.text == Key.DownArrow { root.nudge(input.text, -1); return accept; }
                    return reject;
                }
                input := LineEdit {
                    width: 86px;
                    height: Theme.input-height;
                    font-size: Theme.font-body;
                    horizontal-alignment: right;
                    text <=> root.value-text;
                    enabled: root.can-style;
                    accepted => { root.apply(self.text); }
                }
            }
            Button {
                width: 75px;
                height: 23px;
                text: "应用";
                enabled: root.can-style;
                clicked => { root.apply(root.value-text); }
            }
        }
        Text {
            text: root.status-text != "" ? root.status-text
                : !root.can-style ? root.style-reason
                : "正值字幕滞后，负值超前。";
            color: Theme.text-list;
            font-size: Theme.font-body;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    init => { input.focus(); }
}

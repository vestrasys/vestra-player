// 字幕设置: font, bold, colour, outline, shadow, box, margin, ASS style, sync step,
// fallback encoding (ui-alignment §7.4, UI-TOOL-08).
// Changes apply at once; every row has its own 默认 (UI-TOOL-04).
import { CheckBox, ComboBox } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button, Slider } from "@vestra/widgets.slint";

component RowLabel inherits Text {
    width: 65px;
    color: Theme.text;
    font-size: Theme.font-body;
    horizontal-alignment: right;
    vertical-alignment: center;
    overflow: elide;
}

export component SubtitleSettings inherits Window {
    title: "字幕设置";
    width: 301px;
    background: Theme.bg-panel;
    in property <bool> can-style: false;
    in property <string> font-note: "";
    in-out property <bool> bold: false;
    in-out property <float> shadow-size: 0;
    in-out property <bool> box-on: false;
    in-out property <float> box-opacity: 50;
    in property <int> ass-index: 0;
    in property <[string]> encoding-labels: [];
    in property <int> encoding-index: 0;
    in property <string> style-reason: "";
    in property <string> status-text: "";
    in property <[string]> font-labels: [];
    in property <int> selected-font: 0;
    in property <int> selected-color: 0;
    in-out property <float> outline-size: 2;
    in-out property <float> margin-percent: 5;
    in property <[string]> sync-step-labels: [];
    in property <int> sync-step-index: 3;
    in-out property <bool> auto-reload: false;
    changed font-labels => { font-combo.current-index = root.selected-font; }
    changed selected-font => { font-combo.current-index = root.selected-font; }
    changed selected-color => { color-combo.current-index = root.selected-color; }
    changed sync-step-index => { step-combo.current-index = root.sync-step-index; }
    changed ass-index => { ass-combo.current-index = root.ass-index; }
    changed encoding-labels => { encoding-combo.current-index = root.encoding-index; }
    changed encoding-index => { encoding-combo.current-index = root.encoding-index; }
    callback change-font(int);
    callback change-color(int);
    callback change-outline(float);
    callback change-margin(float);
    // A released slider is snapped back to the whole value the plugin applied.
    callback slider-released();
    callback reset-field(string);
    callback reset-style();
    callback change-sync-step(int);
    callback change-auto-reload(bool);
    callback change-bold(bool);
    callback change-shadow(float);
    callback change-box(bool);
    callback change-box-opacity(float);
    callback change-ass-override(int);
    callback change-encoding(int);

    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 3px;
            RowLabel { text: "字体"; }
            font-combo := ComboBox {
                height: 22px;
                model: root.font-labels;
                current-index: root.selected-font;
                enabled: root.can-style;
                selected(value) => { root.change-font(self.current-index); }
            }
            Button { width: 41px; height: 22px; text: "默认"; enabled: root.can-style; clicked => { root.reset-field("font"); } }
        }
        if root.font-note != "": HorizontalLayout {
            padding-left: 68px;
            Text {
                text: root.font-note;
                color: Theme.text-dim;
                font-size: Theme.font-xs;
                wrap: word-wrap;
                line-height-factor: 1.25;
            }
        }
        HorizontalLayout {
            padding-left: 68px;
            CheckBox {
                height: Theme.checkbox-row-height;
                text: "粗体";
                enabled: root.can-style;
                checked <=> root.bold;
                toggled => { root.change-bold(self.checked); }
            }
        }
        HorizontalLayout {
            spacing: 3px;
            RowLabel { text: "颜色"; }
            color-combo := ComboBox {
                height: 22px;
                model: ["白色", "黄色", "青色"];
                current-index: root.selected-color;
                enabled: root.can-style;
                selected(value) => { root.change-color(self.current-index); }
            }
            Button { width: 41px; height: 22px; text: "默认"; enabled: root.can-style; clicked => { root.reset-field("color"); } }
        }
        HorizontalLayout {
            spacing: 3px;
            RowLabel { text: "描边 " + round(root.outline-size); }
            Slider {
                panel: true; minimum: 0; maximum: 4;
                value <=> root.outline-size;
                enabled: root.can-style;
                changed(value) => { root.change-outline(value); }
                released => { root.slider-released(); }
            }
            Button { width: 41px; height: 22px; text: "默认"; enabled: root.can-style; clicked => { root.reset-field("outline"); } }
        }
        HorizontalLayout {
            spacing: 3px;
            RowLabel { text: "阴影 " + round(root.shadow-size); }
            Slider {
                panel: true; minimum: 0; maximum: 4;
                value <=> root.shadow-size;
                enabled: root.can-style && !root.box-on;
                changed(value) => { root.change-shadow(value); }
                released => { root.slider-released(); }
            }
            Button { width: 41px; height: 22px; text: "默认"; enabled: root.can-style; clicked => { root.reset-field("shadow"); } }
        }
        HorizontalLayout {
            padding-left: 68px;
            CheckBox {
                height: Theme.checkbox-row-height;
                text: "背景框（替代描边与阴影）";
                enabled: root.can-style;
                checked <=> root.box-on;
                toggled => { root.change-box(self.checked); }
            }
        }
        HorizontalLayout {
            spacing: 3px;
            RowLabel { text: "不透明 " + round(root.box-opacity) + "%"; }
            Slider {
                panel: true; minimum: 0; maximum: 100;
                value <=> root.box-opacity;
                enabled: root.can-style && root.box-on;
                changed(value) => { root.change-box-opacity(value); }
                released => { root.slider-released(); }
            }
            Button { width: 41px; height: 22px; text: "默认"; enabled: root.can-style && root.box-on; clicked => { root.reset-field("boxOpacity"); } }
        }
        HorizontalLayout {
            spacing: 3px;
            RowLabel { text: "边距 " + round(root.margin-percent) + "%"; }
            Slider {
                panel: true; minimum: 2; maximum: 15;
                value <=> root.margin-percent;
                enabled: root.can-style;
                changed(value) => { root.change-margin(value); }
                released => { root.slider-released(); }
            }
            Button { width: 41px; height: 22px; text: "默认"; enabled: root.can-style; clicked => { root.reset-field("margin"); } }
        }
        HorizontalLayout {
            spacing: 3px;
            RowLabel { text: "ASS 样式"; }
            ass-combo := ComboBox {
                height: 22px;
                model: ["保留原样式", "统一为字幕设置"];
                current-index: root.ass-index;
                selected(value) => { root.change-ass-override(self.current-index); }
            }
            Button { width: 41px; height: 22px; text: "默认"; clicked => { root.change-ass-override(0); } }
        }
        // Not style fields: they work without a selected track.
        HorizontalLayout {
            spacing: 3px;
            RowLabel { text: "同步单位"; }
            step-combo := ComboBox {
                height: 22px;
                model: root.sync-step-labels;
                current-index: root.sync-step-index;
                selected(value) => { root.change-sync-step(self.current-index); }
            }
            Button { width: 41px; height: 22px; text: "默认"; clicked => { root.change-sync-step(3); } }
        }
        HorizontalLayout {
            spacing: 3px;
            RowLabel { text: "默认编码"; }
            encoding-combo := ComboBox {
                height: 22px;
                model: root.encoding-labels;
                current-index: root.encoding-index;
                selected(value) => { root.change-encoding(self.current-index); }
            }
            Button { width: 41px; height: 22px; text: "默认"; clicked => { root.change-encoding(0); } }
        }
        HorizontalLayout {
            padding-left: 68px;
            CheckBox {
                height: Theme.checkbox-row-height;
                text: "字幕文件改动后自动重载";
                checked <=> root.auto-reload;
                toggled => { root.change-auto-reload(self.checked); }
            }
        }
        HorizontalLayout {
            spacing: 3px;
            Text {
                text: root.status-text != "" ? root.status-text : root.style-reason;
                color: Theme.text-list;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Button { height: 22px; text: "全部默认"; clicked => { root.reset-style(); } }
        }
    }
}

// Subtitle Settings: font, bold, colour, outline, shadow, box, margin, ASS style, sync step,
// fallback encoding (UI-TOOL-08).
// Changes apply at once; every row has its own Default (UI-TOOL-04). Every
// text is @tr (English source; locales/<lang>.po translate it).
import { CheckBox } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button, Choice, Slider } from "@vestra/widgets.slint";

// The row label; `column` is the window's label column (65px, wider for longer translations).
component RowLabel inherits Text {
    in property <length> column: 65px;
    width: root.column;
    color: Theme.text;
    font-size: Theme.font-body;
    horizontal-alignment: right;
    vertical-alignment: center;
    overflow: elide;
}

export component SubtitleSettings inherits Window {
    title: @tr("Subtitle Settings");
    // 301px, wider by what a longer translated label or Default button needs, or for the
    // longest check box (indented to the controls, 10px padding each side).
    width: max(301px + (root.column - 65px) + (root.default-width - 41px),
        root.column + 3px + max(box-check.preferred-width, reload-check.preferred-width, load-check.preferred-width) + 20px);
    background: Theme.bg-panel;
    in property <bool> can-style: false;
    // The selected track is ASS/SSA with its own styles kept: the note under the font.
    in property <bool> ass-note: false;
    in-out property <bool> bold: false;
    in-out property <float> shadow-size: 0;
    in-out property <bool> box-on: false;
    in-out property <float> box-opacity: 50;
    in property <int> ass-index: 0;
    in property <int> encoding-index: 0;
    /** Why styling is off (a text value); "" when it is on. */
    in property <string> style-reason;
    /** The status line (a text value, the player translates it); "" for none. */
    in property <string> status;
    in property <[string]> font-labels: [];
    in property <int> selected-font: 0;
    in property <int> selected-color: 0;
    in-out property <float> outline-size: 2;
    in-out property <float> margin-percent: 5;
    in property <int> sync-step-index: 3;
    in-out property <bool> auto-reload: false;
    in-out property <bool> auto-load: true;
    changed font-labels => { font-combo.current-index = root.selected-font; }
    changed selected-font => { font-combo.current-index = root.selected-font; }
    changed selected-color => { color-combo.current-index = root.selected-color; }
    changed sync-step-index => { step-combo.current-index = root.sync-step-index; }
    changed ass-index => { ass-combo.current-index = root.ass-index; }
    changed encoding-index => { encoding-combo.current-index = root.encoding-index; }
    callback change-font(int);
    callback change-color(int);
    callback change-outline(float);
    callback change-margin(float);
    // A released slider is snapped back to the whole value the plugin applied.
    callback slider-released();
    callback reset-field(string);
    callback reset-style();
    callback change-sync-step(int);
    callback change-auto-reload(bool);
    callback change-auto-load(bool);
    callback change-bold(bool);
    callback change-shadow(float);
    callback change-box(bool);
    callback change-box-opacity(float);
    callback change-ass-override(int);
    callback change-encoding(int);
    // The label column: 65px, or the widest label.
    private property <length> column: max(65px, label-measure.preferred-width);
    // The Default buttons: 41px, or their label with the button padding.
    private property <length> default-width: max(41px, default-measure.preferred-width + 2 * Theme.button-padding);
    Rectangle {
        visible: false;
        width: 0;
        height: 0;
        label-measure := VerticalLayout {
            for text in [@tr("Font"), @tr("Colour"), @tr("Outline {}", round(root.outline-size)), @tr("Shadow {}", round(root.shadow-size)),
                @tr("Opacity {}%", round(root.box-opacity)), @tr("Margin {}%", round(root.margin-percent)), @tr("ASS style"), @tr("Sync step"),
                @tr("Default encoding")]: Text {
                text: text;
                font-size: Theme.font-body;
            }
        }
        default-measure := Text { text: @tr("Default"); font-size: Theme.font-body; }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 3px;
            RowLabel { column: root.column; text: @tr("Font"); }
            font-combo := Choice {
                window-height: root.height;
                model: root.font-labels;
                current-index: root.selected-font;
                enabled: root.can-style;
                selected(index) => { root.change-font(index); }
            }
            Button { width: root.default-width; height: 22px; text: @tr("Default"); enabled: root.can-style; clicked => { root.reset-field("font"); } }
        }
        if root.ass-note: HorizontalLayout {
            padding-left: root.column + 3px;
            Text {
                text: @tr("With the original ASS styles on: fonts follow the subtitle file (missing fonts use the default font); colour, outline, bold, shadow, background box and position have no effect.");
                color: Theme.text-dim;
                font-size: Theme.font-xs;
                wrap: word-wrap;
                line-height-factor: 1.25;
            }
        }
        HorizontalLayout {
            padding-left: root.column + 3px;
            CheckBox {
                height: Theme.checkbox-row-height;
                text: @tr("Bold");
                enabled: root.can-style;
                checked <=> root.bold;
                toggled => { root.change-bold(self.checked); }
            }
        }
        HorizontalLayout {
            spacing: 3px;
            RowLabel { column: root.column; text: @tr("Colour"); }
            // In the order of main.ts COLORS.
            color-combo := Choice {
                model: [@tr("White"), @tr("Yellow"), @tr("Cyan")];
                current-index: root.selected-color;
                enabled: root.can-style;
                selected(index) => { root.change-color(index); }
            }
            Button { width: root.default-width; height: 22px; text: @tr("Default"); enabled: root.can-style; clicked => { root.reset-field("color"); } }
        }
        HorizontalLayout {
            spacing: 3px;
            RowLabel { column: root.column; text: @tr("Outline {}", round(root.outline-size)); }
            Slider {
                panel: true; minimum: 0; maximum: 4;
                value <=> root.outline-size;
                enabled: root.can-style;
                changed(value) => { root.change-outline(value); }
                released => { root.slider-released(); }
            }
            Button { width: root.default-width; height: 22px; text: @tr("Default"); enabled: root.can-style; clicked => { root.reset-field("outline"); } }
        }
        HorizontalLayout {
            spacing: 3px;
            RowLabel { column: root.column; text: @tr("Shadow {}", round(root.shadow-size)); }
            Slider {
                panel: true; minimum: 0; maximum: 4;
                value <=> root.shadow-size;
                enabled: root.can-style && !root.box-on;
                changed(value) => { root.change-shadow(value); }
                released => { root.slider-released(); }
            }
            Button { width: root.default-width; height: 22px; text: @tr("Default"); enabled: root.can-style; clicked => { root.reset-field("shadow"); } }
        }
        HorizontalLayout {
            padding-left: root.column + 3px;
            box-check := CheckBox {
                height: Theme.checkbox-row-height;
                text: @tr("Background box (replaces outline and shadow)");
                enabled: root.can-style;
                checked <=> root.box-on;
                toggled => { root.change-box(self.checked); }
            }
        }
        HorizontalLayout {
            spacing: 3px;
            RowLabel { column: root.column; text: @tr("Opacity {}%", round(root.box-opacity)); }
            Slider {
                panel: true; minimum: 0; maximum: 100;
                value <=> root.box-opacity;
                enabled: root.can-style && root.box-on;
                changed(value) => { root.change-box-opacity(value); }
                released => { root.slider-released(); }
            }
            Button { width: root.default-width; height: 22px; text: @tr("Default"); enabled: root.can-style && root.box-on; clicked => { root.reset-field("boxOpacity"); } }
        }
        HorizontalLayout {
            spacing: 3px;
            RowLabel { column: root.column; text: @tr("Margin {}%", round(root.margin-percent)); }
            Slider {
                panel: true; minimum: 2; maximum: 15;
                value <=> root.margin-percent;
                enabled: root.can-style;
                changed(value) => { root.change-margin(value); }
                released => { root.slider-released(); }
            }
            Button { width: root.default-width; height: 22px; text: @tr("Default"); enabled: root.can-style; clicked => { root.reset-field("margin"); } }
        }
        HorizontalLayout {
            spacing: 3px;
            RowLabel { column: root.column; text: @tr("ASS style"); }
            ass-combo := Choice {
                model: [@tr("Keep original styles"), @tr("Use subtitle settings")];
                current-index: root.ass-index;
                selected(index) => { root.change-ass-override(index); }
            }
            Button { width: root.default-width; height: 22px; text: @tr("Default"); clicked => { root.change-ass-override(0); } }
        }
        // Not style fields: they work without a selected track.
        HorizontalLayout {
            spacing: 3px;
            RowLabel { column: root.column; text: @tr("Sync step"); }
            // In the order of model.ts SYNC_STEPS.
            step-combo := Choice {
                model: [@tr("{} s", "0.05"), @tr("{} s", "0.1"), @tr("{} s", "0.25"), @tr("{} s", "0.5"), @tr("{} s", "1"), @tr("{} s", "5")];
                current-index: root.sync-step-index;
                selected(index) => { root.change-sync-step(index); }
            }
            Button { width: root.default-width; height: 22px; text: @tr("Default"); clicked => { root.change-sync-step(3); } }
        }
        HorizontalLayout {
            spacing: 3px;
            RowLabel { column: root.column; text: @tr("Default encoding"); }
            // In the order of formats.ts ENCODINGS.
            encoding-combo := Choice {
                model: [
                    @tr("Simplified Chinese (GB18030)"),
                    @tr("Traditional Chinese (Big5)"),
                    @tr("Japanese (Shift_JIS)"),
                    @tr("Korean (EUC-KR)"),
                    @tr("Western (Windows-1252)"),
                    @tr("Cyrillic (Windows-1251)"),
                    @tr("Western (ISO-8859-1)"),
                ];
                current-index: root.encoding-index;
                selected(index) => { root.change-encoding(index); }
            }
            Button { width: root.default-width; height: 22px; text: @tr("Default"); clicked => { root.change-encoding(0); } }
        }
        HorizontalLayout {
            padding-left: root.column + 3px;
            reload-check := CheckBox {
                height: Theme.checkbox-row-height;
                text: @tr("Reload automatically when the subtitle file changes");
                checked <=> root.auto-reload;
                toggled => { root.change-auto-reload(self.checked); }
            }
        }
        HorizontalLayout {
            padding-left: root.column + 3px;
            load-check := CheckBox {
                height: Theme.checkbox-row-height;
                text: @tr("Load subtitle files with the same name automatically");
                checked <=> root.auto-load;
                toggled => { root.change-auto-load(self.checked); }
            }
        }
        HorizontalLayout {
            spacing: 3px;
            Text {
                text: root.status != "" ? root.status : root.style-reason;
                color: Theme.text-list;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Button { height: 22px; text: @tr("Reset All"); clicked => { root.reset-style(); } }
        }
    }
}

// The status line of the windows (messages.ts has the same texts, by id, for
// the on-screen messages). A status is an id and up to three arguments
// (data), plus up to two notes joined after it; "raw" shows `a` as it is
// (a message of the player or the system), "" nothing.
export struct Status { id: string, a: string, b: string, c: string, n1: string, n2: string }

export global Messages {
    pure function note(id: string) -> string {
        if id == "noteEncoding" { return @tr("The subtitle encoding may be wrong; change the default encoding in Subtitle Settings"); }
        if id == "noteFonts" { return @tr("Fonts embedded in the subtitle were ignored"); }
        if id == "noteFps" { return @tr("Unknown video frame rate; the MicroDVD subtitle was converted at 23.976"); }
        return "";
    }
    pure function head(m: Status) -> string {
        if m.id == "cancelled" { return @tr("The operation was cancelled or the media changed."); }
        if m.id == "stale" { return @tr("The subtitle tracks changed. Adjust again."); }
        if m.id == "invalid" { return @tr("The player refused the subtitle (file too large or invalid)."); }
        if m.id == "playerBusy" { return @tr("The player is busy. Try again later."); }
        if m.id == "unsupported" { return @tr("The current media does not support this."); }
        if m.id == "backend" { return @tr("The player cannot load this subtitle."); }
        if m.id == "failed" { return @tr("The subtitle operation failed."); }
        if m.id == "cancelledByUser" { return @tr("Cancelled."); }
        if m.id == "refreshed" { return @tr("Subtitle tracks refreshed."); }
        if m.id == "select" { return @tr("Subtitles: {}", m.a); }
        if m.id == "select.waiting" { return @tr("Subtitles: {} (waiting to take effect)", m.a); }
        if m.id == "select.uncertain" { return @tr("Subtitles: {} (could not confirm it took effect)", m.a); }
        if m.id == "moved" { return @tr("Subtitles: {}. Secondary subtitle turned off (it is now the primary)", m.a); }
        if m.id == "moved.waiting" { return @tr("Subtitles: {} (waiting to take effect). Secondary subtitle turned off (it is now the primary)", m.a); }
        if m.id == "moved.uncertain" { return @tr("Subtitles: {} (could not confirm it took effect). Secondary subtitle turned off (it is now the primary)", m.a); }
        if m.id == "hidden" { return @tr("Subtitles hidden"); }
        if m.id == "tracksChanged" { return @tr("The subtitle tracks changed. Choose again."); }
        if m.id == "secondTextOnly" { return @tr("Cannot use it as the secondary subtitle: only text subtitles can be secondary"); }
        if m.id == "secondIsPrimary" { return @tr("Cannot use it as the secondary subtitle: it is already the primary subtitle"); }
        if m.id == "secondary" { return @tr("Secondary subtitle: {}", m.a); }
        if m.id == "secondary.waiting" { return @tr("Secondary subtitle: {} (waiting to take effect)", m.a); }
        if m.id == "secondary.uncertain" { return @tr("Secondary subtitle: {} (could not confirm it took effect)", m.a); }
        if m.id == "secondaryOff" { return @tr("Secondary subtitle: off"); }
        if m.id == "noFile" { return @tr("No subtitle file chosen."); }
        if m.id == "opened" { return @tr("Opened subtitle: {}", m.a); }
        if m.id == "opened.waiting" { return @tr("Opened subtitle: {} (waiting to take effect)", m.a); }
        if m.id == "opened.uncertain" { return @tr("Opened subtitle: {} (could not confirm it took effect)", m.a); }
        if m.id == "openedTracks" { return @tr("Opened subtitle: {} ({} tracks)", m.a, m.b); }
        if m.id == "openedTracks.waiting" { return @tr("Opened subtitle: {} ({} tracks) (waiting to take effect)", m.a, m.b); }
        if m.id == "openedTracks.uncertain" { return @tr("Opened subtitle: {} ({} tracks) (could not confirm it took effect)", m.a, m.b); }
        if m.id == "secondaryTracks" { return @tr("Secondary subtitle: {} ({} tracks)", m.a, m.b); }
        if m.id == "secondaryTracks.waiting" { return @tr("Secondary subtitle: {} ({} tracks) (waiting to take effect)", m.a, m.b); }
        if m.id == "secondaryTracks.uncertain" { return @tr("Secondary subtitle: {} ({} tracks) (could not confirm it took effect)", m.a, m.b); }
        if m.id == "notSecondary" { return @tr("Subtitle loaded, but it cannot be the secondary subtitle"); }
        if m.id == "notSecondary.waiting" { return @tr("Subtitle loaded, but it cannot be the secondary subtitle (waiting to take effect)"); }
        if m.id == "notSecondary.uncertain" { return @tr("Subtitle loaded, but it cannot be the secondary subtitle (could not confirm it took effect)"); }
        if m.id == "noneToShow" { return @tr("No subtitles to show."); }
        if m.id == "shown" { return @tr("Subtitles shown"); }
        if m.id == "cycle" { return @tr("Subtitles: {} ({}/{})", m.a, m.b, m.c); }
        if m.id == "cycle.waiting" { return @tr("Subtitles: {} ({}/{}) (waiting to take effect)", m.a, m.b, m.c); }
        if m.id == "cycle.uncertain" { return @tr("Subtitles: {} ({}/{}) (could not confirm it took effect)", m.a, m.b, m.c); }
        if m.id == "cycleOff" { return @tr("Subtitles: off"); }
        if m.id == "noSelection" { return @tr("No subtitle selected."); }
        if m.id == "embeddedNoReload" { return @tr("Embedded subtitles need no reload"); }
        if m.id == "notOurs" { return @tr("This subtitle was not loaded by the Subtitles plugin and cannot be reloaded"); }
        if m.id == "reloadNotFound" { return @tr("Cannot reload: subtitle file {} not found", m.a); }
        if m.id == "reloadChanged" { return @tr("Cannot reload: the content of subtitle file {} changed", m.a); }
        if m.id == "reloadFailed" { return @tr("Cannot reload: {}", m.a); }
        if m.id == "reload.readFailed" { return @tr("Cannot reload: cannot read the subtitle file."); }
        if m.id == "reload.notRegular" { return @tr("Cannot reload: the subtitle file must be a regular file of 1 byte to 8 MiB."); }
        if m.id == "reload.emptyOrLarge" { return @tr("Cannot reload: the subtitle file is empty or larger than 8 MiB."); }
        if m.id == "reload.bitmap" { return @tr("Cannot reload: image subtitle files are not supported yet"); }
        if m.id == "reload.unknownFormat" { return @tr("Cannot reload: unknown subtitle format"); }
        if m.id == "reload.noCues" { return @tr("Cannot reload: the subtitle file has no subtitles."); }
        if m.id == "reload.tooLarge" { return @tr("Cannot reload: the subtitle file is larger than 2 MiB"); }
        if m.id == "unchanged" { return @tr("Subtitle unchanged"); }
        if m.id == "reloaded" { return @tr("Reloaded subtitle {}", m.a); }
        if m.id == "autoReloaded" { return @tr("Subtitle reloaded automatically"); }
        if m.id == "selectFirst" { return @tr("Select a subtitle track first."); }
        if m.id == "notStylable" { return @tr("The current subtitle track cannot be adjusted."); }
        if m.id == "noFont" { return @tr("No subtitle font available."); }
        if m.id == "styleUpdated" { return @tr("Subtitle style updated"); }
        if m.id == "styleUpdated.waiting" { return @tr("Subtitle style updated (waiting to take effect)"); }
        if m.id == "styleUpdated.uncertain" { return @tr("Subtitle style updated (could not confirm it took effect)"); }
        if m.id == "styleReset" { return @tr("Default style restored."); }
        if m.id == "selectionChanged" { return @tr("The selected subtitle changed. Choose again."); }
        if m.id == "removed" { return @tr("External subtitle removed."); }
        if m.id == "mediaSwitched" { return @tr("The media changed; the running operation was cancelled."); }
        if m.id == "syncInteger" { return @tr("Enter whole milliseconds, for example 1250 or -500."); }
        if m.id == "syncRange" { return @tr("The sync value must be between −{} and {} ms", m.a, m.b); }
        if m.id == "switching" { return @tr("Switching subtitle track…"); }
        if m.id == "removing" { return @tr("Removing subtitle…"); }
        if m.id == "switchingSecondary" { return @tr("Switching secondary subtitle…"); }
        if m.id == "chooseFile" { return @tr("Choose a subtitle file…"); }
        if m.id == "chooseSecondaryFile" { return @tr("Choose a secondary subtitle file…"); }
        if m.id == "togglingShown" { return @tr("Switching subtitle display…"); }
        if m.id == "hiding" { return @tr("Hiding subtitles…"); }
        if m.id == "closingSecondary" { return @tr("Turning off the secondary subtitle…"); }
        if m.id == "reloading" { return @tr("Reloading subtitle…"); }
        if m.id == "refreshing" { return @tr("Refreshing…"); }
        if m.id == "applyingStyle" { return @tr("Applying subtitle style…"); }
        if m.id == "resetting" { return @tr("Restoring the default style…"); }
        if m.id == "readFailed" { return @tr("Cannot read the subtitle file."); }
        if m.id == "notRegular" { return @tr("The subtitle file must be a regular file of 1 byte to 8 MiB."); }
        if m.id == "emptyOrLarge" { return @tr("The subtitle file is empty or larger than 8 MiB."); }
        if m.id == "bitmap" { return @tr("Image subtitle files are not supported yet"); }
        if m.id == "unknownFormat" { return @tr("Unknown subtitle format"); }
        if m.id == "noCues" { return @tr("The subtitle file has no subtitles."); }
        if m.id == "tooLarge" { return @tr("The subtitle file is larger than 2 MiB"); }
        if m.id == "raw" { return m.a; }
        return "";
    }
    /** The text of a status. */
    pure public function text(m: Status) -> string {
        // TRANSLATORS: a status, then a note about it ({1}); in Chinese joined with 。
        if m.n2 != "" { return @tr("{0}. {1}", @tr("{0}. {1}", self.head(m), self.note(m.n1)), self.note(m.n2)); }
        // TRANSLATORS: a status, then a note about it ({1}); in Chinese joined with 。
        if m.n1 != "" { return @tr("{0}. {1}", self.head(m), self.note(m.n1)); }
        return self.head(m);
    }
}

/** A window's status line: the status, else the fallback (why styling is off). */
export component StatusText inherits Text {
    in property <Status> status;
    in property <Status> fallback;
    text: root.status.id != "" ? Messages.text(root.status) : Messages.text(root.fallback);
}

// 实验 Slint 界面；不是最终插件 API 或布局协议。
import { Button, Slider } from "std-widgets.slint";

export global VideoAdjustState {
    in-out property <float> brightness: 0;
    in-out property <float> contrast: 1;
    in-out property <float> saturation: 1;
    in-out property <float> hue: 0;
    in-out property <string> status: "画面调节";
    callback action(string, float);
}

export component VideoAdjustPanel inherits Rectangle {
    background: #202a36;
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        HorizontalLayout {
            Text { text: "亮度"; color: white; vertical-alignment: center; }
            Slider { minimum: -1; maximum: 1; value: VideoAdjustState.brightness;
                changed(v) => { VideoAdjustState.action("brightness", v); } }
            Text { text: "对比度"; color: white; vertical-alignment: center; }
            Slider { minimum: 0; maximum: 2; value: VideoAdjustState.contrast;
                changed(v) => { VideoAdjustState.action("contrast", v); } }
        }
        HorizontalLayout {
            Text { text: "饱和度"; color: white; vertical-alignment: center; }
            Slider { minimum: 0; maximum: 3; value: VideoAdjustState.saturation;
                changed(v) => { VideoAdjustState.action("saturation", v); } }
            Text { text: "色相"; color: white; vertical-alignment: center; }
            Slider { minimum: -180; maximum: 180; value: VideoAdjustState.hue;
                changed(v) => { VideoAdjustState.action("hue", v); } }
        }
        HorizontalLayout {
            Button { text: "明亮"; clicked => { VideoAdjustState.action("preset-bright", 0); } }
            Button { text: "影院"; clicked => { VideoAdjustState.action("preset-cinema", 0); } }
            Button { text: "复位"; clicked => { VideoAdjustState.action("reset", 0); } }
            Text { text: VideoAdjustState.status; color: white; vertical-alignment: center; }
        }
    }
}

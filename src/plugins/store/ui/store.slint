// Plugin Store v3 (vestra.store, design store-v3 rev. 2, owner rulings
// 2026-11-15): one window-wide grid of cards. On top the search box, Refresh
// and the ⋯ menu; then the tabs All / Installed / Updates with the Category
// and Sort drop-downs; the grid; a status line at the bottom. A click on a
// card opens its detail page in the same window (the grid stays alive under
// it with `visible:`, so it keeps its scroll position): ← All Plugins, the
// header and its buttons, notices, "Where to find it", tabs About (the
// README) and Details (facts, permissions, Changelog / Versions).
// The grid is a ListView of rows of cards: the column count follows the
// grid's width by a binding, TypeScript hands over one flat array and is not
// told about resizes. Texts built at run time come translated from
// TypeScript (text values); long ones are elided here, never cut there.
// Minimum 600×480: two columns of cards; the tabs and two drop-downs fit.
import { LineEdit, ListView } from "std-widgets.slint";
import { MarkdownView, MarkdownBlock } from "@vestra/markdown.slint";
import { Theme } from "@vestra/theme.slint";
import { Button, Choice, Tabs, ToolTipArea, UrlInputRow } from "@vestra/widgets.slint";
import { Cell, MenuButton, MenuEntry, StoreIcons, Tone } from "parts.slint";

// One card of the grid (design store-v3 §4.2).
export struct StoreCard {
    // Row identity (keyed patches).
    key: string,
    name: string,
    // "by <author>".
    by: string,
    // "· Unofficial", "· Local file"…; "" none. Drawn in the warning colour.
    byNote: string,
    // The introduction (the punchline), whole: elided by the Text.
    intro: string,
    // "How to open", whole: elided by the Text; "" none (the line stays empty).
    open: string,
    // The plugin's icon (drawn 40px, decoded at 80).
    icon: image,
    // "✓ Installed", "Update available", "Disabled"…; "" none.
    state: string,
    // 0 plain, 1 accent, 2 warn, 3 danger, 4 dim (see Tone).
    stateTone: int,
    // Install or Update (`id` "": no button).
    button: MenuEntry,
    // Disabled: drawn dimmed.
    dim: bool,
    // On hover: the whole introduction, or why it failed.
    tip: string,
}

export struct StoreAction {
    id: string,
    text: string,
    enabled: bool,
}

export struct StoreBanner {
    text: string,
    tone: int,
    action: string,
    actionText: string,
}

export struct StoreVersion {
    version: string,
    date: string,
    minimum: string,
    status: string,
    tone: int,
    canInstall: bool,
}

export struct StoreFact {
    label: string,
    text: string,
    link: bool,
}

export struct StorePermission {
    // The capability in words.
    text: string,
    risky: bool,
}

// A button as wide as its label (at least `min`), measured in the
// interface language.
component SizedButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> small;
    in property <length> min: 66px;
    callback clicked();
    width: max(root.min, label.preferred-width + 16px);
    label := Text {
        visible: false;
        text: root.text;
        font-size: Theme.font-body;
    }
    Button {
        width: 100%;
        height: 100%;
        text: root.text;
        enabled: root.enabled;
        small: root.small;
        clicked => { root.clicked(); }
    }
}

// The "how to open" pointer, 11px, in the dim text colour.
component Pointer inherits Path {
    width: 11px;
    height: 11px;
    viewbox-width: 14;
    viewbox-height: 14;
    commands: StoreIcons.pointer;
    fill: transparent;
    stroke: Theme.text-dim;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

// A card (design store-v3 §3.3): 136 high, padding 12; the icon with the
// name and the by-line, the introduction, "how to open", then the state and
// at most one button. Every text is one line, elided.
component Card inherits Rectangle {
    in property <StoreCard> item;
    callback open();
    callback act(string);
    background: touch.has-hover ? Theme.hover-bg : Theme.bg-list;
    border-width: 1px;
    border-color: Theme.line;
    border-radius: Theme.radius-panel;
    // Under the content, so the button takes its own clicks; anywhere else opens the detail page.
    ToolTipArea {
        width: 100%;
        height: 100%;
        text: root.item.tip;
        touch := TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.open(); }
        }
    }
    VerticalLayout {
        padding: 12px;
        spacing: 0px;
        HorizontalLayout {
            height: 40px;
            spacing: 10px;
            Image {
                width: 40px;
                height: 40px;
                source: root.item.icon;
                image-fit: contain;
                opacity: root.item.dim ? 0.5 : 1;
            }
            VerticalLayout {
                alignment: center;
                Cell {
                    height: 18px;
                    text: root.item.name;
                    color: root.item.dim ? Theme.text-dim : Theme.text;
                    font-size: Theme.font-title;
                }
                HorizontalLayout {
                    height: 16px;
                    spacing: 4px;
                    Cell { horizontal-stretch: 0; text: root.item.by; color: Theme.text-dim; }
                    if root.item.byNote != "": Cell { horizontal-stretch: 0; text: root.item.byNote; color: Tone.warn; }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
        Rectangle { height: 8px; }
        Cell {
            height: 16px;
            text: root.item.intro;
            color: root.item.dim ? Theme.text-dim : Theme.text-list;
        }
        Rectangle { height: 2px; }
        HorizontalLayout {
            height: 16px;
            spacing: 5px;
            if root.item.open != "": VerticalLayout {
                alignment: center;
                Pointer { }
            }
            Cell { horizontal-stretch: 1; text: root.item.open; color: Theme.text-dim; }
        }
        Rectangle { min-height: 8px; vertical-stretch: 1; }
        HorizontalLayout {
            height: Theme.button-height;
            spacing: 6px;
            Cell { horizontal-stretch: 1; text: root.item.state; color: Tone.color(root.item.stateTone); }
            if root.item.button.id != "": SizedButton {
                text: root.item.button.text;
                enabled: root.item.button.enabled;
                clicked => { root.act(root.item.button.id); }
            }
        }
    }
}

export component StoreWindow inherits Window {
    title: @tr("Plugin Store");
    preferred-width: 920px;
    preferred-height: 640px;
    min-width: 600px;
    min-height: 480px;
    background: Theme.bg-panel;

    in-out property <string> search-text;
    // Tabs: 0 All (installed plugins included), 1 Installed, 2 Updates.
    // In-out: the tab strip sets it on a click or an arrow key (then asks with set-category).
    in-out property <int> category;
    // What All can show: without any repository index, the installed plugins only.
    in property <int> all-count;
    in property <int> installed-count;
    // Plugins with an update (0: none).
    in property <int> updates;
    // The Category drop-down; the first entry ("Category: All", translated by the plugin) stands for all of them.
    in property <[string]> goal-model;
    // In-out: the drop-downs set them on a pick (then ask with set-goal / set-sort).
    in-out property <int> goal-index;
    in-out property <int> sort-index;
    // The ⋯ menu's "Show built-in plugins" is its opposite.
    in property <bool> hide-builtins: true;
    // The grid's cards in display order.
    in property <[StoreCard]> cards;
    in property <string> empty-text;
    // The empty grid offers Clear Search (a search or a category hides plugins).
    in property <bool> can-clear;
    // Over a grid that is not empty: All without any repository index ("" none).
    in property <string> list-note;
    in property <bool> link-open;
    in-out property <string> link-text;
    // Bumped when the search box is to be emptied.
    in property <int> search-reset;
    // The detail page is open, with these details.
    in property <bool> detail-open;
    in property <string> d-name;
    in property <string> d-meta;
    in property <string> d-punchline;
    // "How to open" in full; "" none (no Where to find it row).
    in property <string> d-open;
    in property <image> d-icon;
    in property <[StoreAction]> actions;
    // The action row's ⋯ menu (Open Data Folder, Replace with x from y…); empty: no ⋯.
    in property <[MenuEntry]> more;
    in property <[StoreBanner]> banners;
    // In-out: the detail's tab strips set them (then ask with set-tab / set-sub-tab).
    // tab: 0 About, 1 Details; sub-tab (under Details): 0 Changelog, 1 Versions.
    in-out property <int> tab;
    in-out property <int> sub-tab;
    in property <[MarkdownBlock]> doc;
    in property <string> doc-note;
    in property <[StoreVersion]> versions;
    in property <[StoreFact]> facts;
    in property <[StorePermission]> permissions;
    // The index has a scan of the version shown: the Permissions heading shows (even over an empty list).
    in property <bool> scanned;
    // Status line: one message, or a text per repository.
    in property <string> status;
    in property <bool> status-warn;
    in property <string> busy-text;
    in property <bool> can-cancel;

    callback search(string);
    callback set-category(int);
    callback set-goal(int);
    callback set-sort(int);
    callback set-hide-builtins(bool);
    callback clear-search();
    // A click on a card (its key); a card's button (its key and the action).
    callback open-card(string);
    callback card-act(string, string);
    callback back();
    callback set-tab(int);
    callback set-sub-tab(int);
    callback act(string);
    callback banner-act(string);
    callback install-version(string);
    callback open-link(string);
    callback fact-link(int);
    callback from-file();
    callback from-link();
    callback link-accepted(string);
    callback link-cancelled();
    callback repos();
    callback settings();
    callback refresh();
    callback cancel();

    forward-focus: search-box;

    changed search-reset => { root.search-text = ""; }
    // The page takes the keys (Esc goes back); back on the grid, the search box.
    changed detail-open => {
        if root.detail-open {
            page.focus();
        } else {
            search-box.focus();
        }
    }

    // The only layout arithmetic (design store-v3 §3.2): how many cards of at
    // least 264px fit with 16px sides and 12px gaps.
    private property <int> columns: clamp(floor((grid.width - 20px) / 276px), 2, 5);
    private property <int> row-count: ceil(root.cards.length / root.columns);

    // Widths that follow the interface language, never under the original ones.
    // A drop-down: its widest label + 21px (6 + 5 padding, 2 gap, 8 caret).
    private property <length> goal-width: max(120px, goal-measure.preferred-width + 21px);
    private property <length> sort-width: max(110px, sort-measure.preferred-width + 21px);
    private property <length> version-width: max(56px, version-measure.preferred-width);
    private property <length> published-width: max(76px, published-measure.preferred-width);
    private property <length> install-width: max(48px, install-measure.preferred-width + 2 * Theme.button-padding);
    private property <length> fact-width: max(44px, fact-measure.preferred-width);
    Rectangle {
        visible: false;
        width: 0;
        height: 0;
        goal-measure := Cell { text: root.goal-model.length > 0 ? root.goal-model[0] : ""; }
        sort-measure := VerticalLayout {
            for text in [@tr("Sort: Name"), @tr("Sort: Updated")]: Cell { text: text; }
        }
        version-measure := Cell { text: @tr("Version"); }
        published-measure := Cell { text: @tr("Published"); }
        install-measure := Cell { text: @tr("Install"); }
        fact-measure := VerticalLayout {
            for fact in root.facts: Cell { text: fact.label; }
        }
    }

    VerticalLayout {
        padding-top: 8px;
        spacing: 6px;
        Rectangle {
            vertical-stretch: 1;
            // The grid page.
            VerticalLayout {
                visible: !root.detail-open;
                spacing: 6px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 6px;
                    height: 22px;
                    search-box := LineEdit {
                        min-width: 160px;
                        max-width: 420px;
                        horizontal-stretch: 1;
                        placeholder-text: @tr("Search names, authors, tags…");
                        font-size: Theme.font-body;
                        text <=> root.search-text;
                        edited(text) => { root.search(text); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ToolTipArea {
                        width: 23px;
                        text: @tr("Refresh");
                        Button {
                            width: 100%;
                            height: 100%;
                            icon: StoreIcons.refresh;
                            stroked: true;
                            clicked => { root.refresh(); }
                        }
                    }
                    MenuButton {
                        width: 23px;
                        icon: StoreIcons.more;
                        tip: @tr("More");
                        entries: [
                            { id: "file", text: @tr("Install from File…"), enabled: true },
                            { id: "link", text: @tr("Install from Link…"), enabled: true },
                            { id: "repos", text: @tr("Repositories…"), enabled: true },
                            { id: "", text: "", enabled: false },
                            { id: "builtins", text: @tr("Show built-in plugins"), enabled: true },
                            { id: "", text: "", enabled: false },
                            { id: "settings", text: @tr("Store Settings…"), enabled: true },
                        ];
                        checks: [1, 1, 1, 0, root.hide-builtins ? 1 : 2];
                        picked(id) => {
                            if id == "file" { root.from-file(); }
                            if id == "link" { root.from-link(); }
                            if id == "repos" { root.repos(); }
                            if id == "builtins" { root.set-hide-builtins(!root.hide-builtins); }
                            if id == "settings" { root.settings(); }
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 6px;
                    height: 22px;
                    // The library Tabs (Left/Right/Home/End, tab-list role) at the row's 22px on
                    // the panel background: Updates is in the accent colour while updates wait.
                    Tabs {
                        height: 22px;
                        horizontal-stretch: 1;
                        background: transparent;
                        model: [
                            @tr("All ({})", root.all-count),
                            @tr("Installed ({})", root.installed-count),
                            @tr("Updates ({})", root.updates),
                        ];
                        emphasis: [false, false, root.updates > 0];
                        current-index <=> root.category;
                        selected(index) => { root.set-category(index); }
                    }
                    Choice {
                        width: root.goal-width;
                        model: root.goal-model;
                        max-visible-rows: 11;
                        popup-min-width: 160px;
                        current-index <=> root.goal-index;
                        selected(index) => { root.set-goal(index); }
                    }
                    Choice {
                        width: root.sort-width;
                        model: [@tr("Sort: Name"), @tr("Sort: Updated")];
                        popup-min-width: 120px;
                        current-index <=> root.sort-index;
                        selected(index) => { root.set-sort(index); }
                    }
                }
                if root.link-open: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    UrlInputRow {
                        text <=> root.link-text;
                        placeholder: @tr("Plugin package link (https://…/name-version.vxp)");
                        confirm-text: @tr("Install");
                        accepted(url) => { root.link-accepted(url); }
                        cancelled => { root.link-cancelled(); }
                        init => { self.focus-input(); }
                    }
                }
                // All offline: the installed plugins are shown, the repositories' are not.
                // `visible:`, not `if`: a tab change toggles it (menu-view.slint rule); no height while hidden.
                HorizontalLayout {
                    visible: root.list-note != "" && root.cards.length > 0;
                    max-height: self.visible ? 200px : 0px;
                    padding-left: 16px;
                    padding-right: 16px;
                    Text {
                        text: root.list-note;
                        color: Theme.text-dim;
                        font-size: Theme.font-body;
                        wrap: word-wrap;
                        line-height-factor: 1.25;
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    // Rows of cards (design store-v3 §4.2): always `columns` cells, so the cards are equally wide
                    // and a short last row keeps their width. 12px above the first row; centred beyond 1800px.
                    grid := ListView {
                        x: (parent.width - self.width) / 2;
                        y: 6px;
                        width: min(parent.width, 1800px);
                        height: parent.height - 6px;
                        for r in root.row-count: HorizontalLayout {
                            height: 148px;
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-bottom: 12px;
                            spacing: 12px;
                            for c in root.columns: Rectangle {
                                horizontal-stretch: 1;
                                if r * root.columns + c < root.cards.length: Card {
                                    width: 100%;
                                    height: 100%;
                                    item: root.cards[r * root.columns + c];
                                    open => { root.open-card(self.item.key); }
                                    act(id) => { root.card-act(self.item.key, id); }
                                }
                            }
                        }
                    }
                    if root.cards.length == 0: VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 10px;
                        alignment: center;
                        Text {
                            text: root.empty-text;
                            color: Theme.text-dim;
                            font-size: Theme.font-body;
                            wrap: word-wrap;
                            line-height-factor: 1.25;
                            horizontal-alignment: center;
                        }
                        if root.can-clear: HorizontalLayout {
                            alignment: center;
                            SizedButton {
                                height: Theme.button-height;
                                text: @tr("Clear Search");
                                clicked => { root.clear-search(); }
                            }
                        }
                    }
                }
            }
            // The detail page (design store-v3 §3.5). Esc and the mouse's back button go back too.
            page := FocusScope {
                visible: root.detail-open;
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.back();
                        return accept;
                    }
                    return reject;
                }
                // Under the content: the back button anywhere on the page.
                TouchArea {
                    pointer-event(event) => {
                        if event.button == PointerEventButton.back && event.kind == PointerEventKind.down {
                            root.back();
                        }
                    }
                }
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 6px;
                    HorizontalLayout {
                        height: 22px;
                        alignment: start;
                        SizedButton {
                            height: Theme.button-height;
                            text: @tr("← All Plugins");
                            clicked => { root.back(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        height: 56px;
                        Image {
                            width: 56px;
                            height: 56px;
                            source: root.d-icon;
                            image-fit: contain;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Cell { text: root.d-name; color: Theme.text; font-size: Theme.font-title; font-weight: 700; }
                            Cell { text: root.d-meta; color: Theme.text-dim; }
                            ToolTipArea {
                                text: root.d-punchline;
                                Cell { width: 100%; height: 100%; text: root.d-punchline; color: Theme.text-list; }
                            }
                        }
                    }
                    HorizontalLayout {
                        height: Theme.button-height;
                        spacing: 6px;
                        alignment: start;
                        for action in root.actions: SizedButton {
                            text: action.text;
                            enabled: action.enabled;
                            clicked => { root.act(action.id); }
                        }
                        if root.more.length > 0: MenuButton {
                            width: 23px;
                            icon: StoreIcons.more;
                            tip: @tr("More");
                            entries: root.more;
                            picked(id) => { root.act(id); }
                        }
                    }
                    for banner in root.banners: Rectangle {
                        background: Theme.bg-list;
                        border-radius: Theme.radius-control;
                        HorizontalLayout {
                            padding: 5px;
                            padding-left: 0px;
                            spacing: 8px;
                            Rectangle { width: 3px; background: Tone.color(banner.tone); }
                            Text {
                                horizontal-stretch: 1;
                                text: banner.text;
                                color: Tone.color(banner.tone);
                                font-size: Theme.font-body;
                                wrap: word-wrap;
                                line-height-factor: 1.25;
                                vertical-alignment: center;
                            }
                            if banner.action != "": SizedButton {
                                min: 41px;
                                small: true;
                                text: banner.actionText;
                                clicked => { root.banner-act(banner.action); }
                            }
                        }
                    }
                    // Where to find it: the pointer, the label and the line in full (at most 2 lines).
                    if root.d-open != "": Rectangle {
                        background: Theme.bg-list;
                        border-radius: Theme.radius-control;
                        HorizontalLayout {
                            padding-top: 6px;
                            padding-bottom: 6px;
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Pointer { }
                            }
                            Text {
                                text: @tr("Where to find it");
                                color: Theme.text-dim;
                                font-size: Theme.font-body;
                                vertical-alignment: center;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: root.d-open;
                                color: Theme.text-list;
                                font-size: Theme.font-body;
                                wrap: word-wrap;
                                max-lines: 2;
                                overflow: elide;
                                line-height-factor: 1.25;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Tabs {
                        height: 22px;
                        background: transparent;
                        model: [@tr("About"), @tr("Details")];
                        current-index <=> root.tab;
                        selected(index) => { root.set-tab(index); }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        // About: the README.
                        if root.tab == 0: Rectangle {
                            background: Theme.bg-list;
                            border-width: 1px;
                            border-color: Theme.line;
                            MarkdownView {
                                x: 1px;
                                y: 1px;
                                width: parent.width - 2px;
                                height: parent.height - 2px;
                                blocks: root.doc;
                                link-clicked(url) => { root.open-link(url); }
                            }
                            if root.doc-note != "": Text {
                                x: 12px;
                                width: parent.width - 24px;
                                height: parent.height;
                                text: root.doc-note;
                                color: Theme.text-dim;
                                font-size: Theme.font-body;
                                wrap: word-wrap;
                                line-height-factor: 1.25;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        // Details: facts and permissions, then the changelog and the version history.
                        if root.tab == 1: HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                width: 240px;
                                spacing: 2px;
                                for fact[index] in root.facts: HorizontalLayout {
                                    height: 18px;
                                    spacing: 6px;
                                    Cell { width: root.fact-width; text: fact.label; color: Theme.text-dim; }
                                    ToolTipArea {
                                        horizontal-stretch: 1;
                                        text: fact.text;
                                        Cell {
                                            width: 100%;
                                            height: 100%;
                                            text: fact.text;
                                            color: fact.link ? Theme.accent : Theme.text-list;
                                        }
                                        if fact.link: TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: pointer;
                                            clicked => { root.fact-link(index); }
                                        }
                                    }
                                }
                                Rectangle { height: 6px; }
                                // Only with a scan of the version shown: without one the store has nothing to say, not "(0)".
                                if root.scanned: Cell { text: @tr("Permissions ({})", root.permissions.length); color: Theme.text; }
                                if root.scanned: Rectangle { height: 1px; background: Theme.line; }
                                ListView {
                                    vertical-stretch: 1;
                                    for p in root.permissions: Text {
                                        height: self.preferred-height + 3px;
                                        text: "· " + p.text;
                                        color: p.risky ? Tone.warn : Theme.text-list;
                                        font-size: Theme.font-body;
                                        wrap: word-wrap;
                                        line-height-factor: 1.25;
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 0px;
                                Tabs {
                                    height: 22px;
                                    background: transparent;
                                    model: [@tr("Changelog"), @tr("Versions")];
                                    current-index <=> root.sub-tab;
                                    selected(index) => { root.set-sub-tab(index); }
                                }
                                Rectangle {
                                    vertical-stretch: 1;
                                    background: Theme.bg-list;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    if root.sub-tab == 0: MarkdownView {
                                        x: 1px;
                                        y: 1px;
                                        width: parent.width - 2px;
                                        height: parent.height - 2px;
                                        blocks: root.doc;
                                        link-clicked(url) => { root.open-link(url); }
                                    }
                                    if root.sub-tab == 0 && root.doc-note != "": Text {
                                        x: 12px;
                                        width: parent.width - 24px;
                                        height: parent.height;
                                        text: root.doc-note;
                                        color: Theme.text-dim;
                                        font-size: Theme.font-body;
                                        wrap: word-wrap;
                                        line-height-factor: 1.25;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    if root.sub-tab == 1: VerticalLayout {
                                        x: 1px;
                                        y: 1px;
                                        width: parent.width - 2px;
                                        height: parent.height - 2px;
                                        HorizontalLayout {
                                            height: 20px;
                                            padding-left: 6px;
                                            padding-right: 8px;
                                            spacing: 6px;
                                            Cell { width: root.version-width; text: @tr("Version"); color: Theme.text-dim; }
                                            Cell { width: root.published-width; text: @tr("Published"); color: Theme.text-dim; }
                                            Cell { horizontal-stretch: 1; text: @tr("Minimum player"); color: Theme.text-dim; }
                                            Rectangle { width: root.install-width; }
                                        }
                                        Rectangle { height: 1px; background: Theme.line; }
                                        // Two lines per version: the facts, then the status in full (wrapped).
                                        ListView {
                                            vertical-stretch: 1;
                                            for v in root.versions: VerticalLayout {
                                                padding-left: 6px;
                                                padding-right: 8px;
                                                padding-top: 3px;
                                                padding-bottom: 3px;
                                                HorizontalLayout {
                                                    height: 20px;
                                                    spacing: 6px;
                                                    Cell { width: root.version-width; text: v.version; color: Theme.text; }
                                                    Cell { width: root.published-width; text: v.date; color: Theme.text-list; }
                                                    Cell { horizontal-stretch: 1; text: v.minimum; color: Theme.text-list; }
                                                    VerticalLayout {
                                                        width: root.install-width;
                                                        alignment: center;
                                                        if v.canInstall: Button {
                                                            small: true;
                                                            text: @tr("Install");
                                                            clicked => { root.install-version(v.version); }
                                                        }
                                                    }
                                                }
                                                if v.status != "": Text {
                                                    text: v.status;
                                                    color: Tone.color(v.tone);
                                                    font-size: Theme.font-body;
                                                    wrap: word-wrap;
                                                    line-height-factor: 1.25;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // Status line.
        HorizontalLayout {
            height: 20px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 8px;
            ToolTipArea {
                horizontal-stretch: 1;
                text: root.status;
                Cell {
                    width: 100%;
                    height: 100%;
                    text: root.status;
                    color: root.status-warn ? Tone.warn : Theme.text-dim;
                }
            }
            if root.busy-text != "": Cell { text: root.busy-text; color: Theme.text; }
            if root.can-cancel: Button { small: true; text: @tr("Cancel"); clicked => { root.cancel(); } }
        }
    }
}

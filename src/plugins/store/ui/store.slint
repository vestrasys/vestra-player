// Plugin Store (vestra.store, design §2.1; plugin-center spec 2026-10): tabs
// All / Installed / Updates with the refresh and ⚙ menu buttons on top,
// then search, tags and sort; the plugin list on the left (300 wide, 62px
// rows with the logo, one button and a … menu), the selected plugin on the
// right (header, actions, notices, tabs Description / Changelog / Versions
// and a 200px column with facts and permissions), a status line at the bottom.
// Texts built at run time come translated from TypeScript (text values).
// Minimum 760×480: the tabs and two 23px buttons, search ≥ 180 + two 110px
// drop-downs; the detail keeps ≥ 440 next to the list.
import { LineEdit, ListView } from "std-widgets.slint";
import { MarkdownView, MarkdownBlock } from "@vestra/markdown.slint";
import { Theme } from "@vestra/theme.slint";
import { Button, Check, Choice, Tabs, ToolTipArea, UrlInputRow } from "@vestra/widgets.slint";
import { Cell, MenuButton, MenuEntry, StoreIcons, Tone } from "parts.slint";

// A row's small tag before the badge (Dev, Warning).
export struct StoreTag {
    text: string,
    // As StoreRow.tone.
    tone: int,
}

export struct StoreRow {
    key: string,
    name: string,
    version: string,
    meta: string,
    punchline: string,
    // Left of the version: ✓ (installed), Disabled or Failed; "" none.
    mark: string,
    // As tone.
    markTone: int,
    // The mark's text alternative when it is a symbol (✓: "Installed"); "" when it is a word.
    markLabel: string,
    // The second line's state (Update → x, Revoked, Built-in…); "" none.
    badge: string,
    // 0 plain, 1 accent, 2 warn, 3 danger, 4 dim (see Tone)
    tone: int,
    selected: bool,
    // On hover: the punchline, or why it failed.
    tip: string,
    // Disabled: drawn dimmed.
    dim: bool,
    // Tags before the badge: a development load, what a running plugin was refused.
    flags: [StoreTag],
    // The plugin's logo (drawn 32px, decoded at 64).
    logo: image,
    // The row's one control, bottom right: a button by state (Install, Update; `id` "": none),
    // else the ⋯ manage menu (empty: none). Never both.
    primary: MenuEntry,
    menu: [MenuEntry],
}

export struct StoreAction {
    id: string,
    text: string,
    enabled: bool,
}

export struct StoreBanner {
    text: string,
    tone: int,
    action: string,
    actionText: string,
}

export struct StoreVersion {
    version: string,
    date: string,
    minimum: string,
    status: string,
    tone: int,
    canInstall: bool,
}

export struct StoreFact {
    label: string,
    text: string,
    link: bool,
}

export struct StorePermission {
    // The capability in words.
    text: string,
    risky: bool,
}

// A button as wide as its label (at least `min`), measured in the
// interface language.
component SizedButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> small;
    in property <length> min: 66px;
    callback clicked();
    width: max(root.min, label.preferred-width + 16px);
    label := Text {
        visible: false;
        text: root.text;
        font-size: Theme.font-body;
    }
    Button {
        width: 100%;
        height: 100%;
        text: root.text;
        enabled: root.enabled;
        small: root.small;
        clicked => { root.clicked(); }
    }
}

component ListRow inherits Rectangle {
    in property <StoreRow> item;
    callback select();
    callback act(string);
    // The 32px logo, then three lines (18 + 16 + 18) with 4px padding top and bottom.
    height: 62px;
    background: root.item.selected ? Theme.selected-bg : touch.has-hover ? Theme.hover-bg : transparent;
    // Under the content, so the row's buttons take their own clicks.
    ToolTipArea {
        width: 100%;
        height: 100%;
        text: root.item.tip;
        touch := TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.select(); }
        }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;
        // In line with the name and the author.
        VerticalLayout {
            alignment: start;
            padding-top: 2px;
            Image {
                width: 32px;
                height: 32px;
                source: root.item.logo;
                image-fit: contain;
                opacity: root.item.dim ? 0.5 : 1;
            }
        }
        VerticalLayout {
            spacing: 1px;
            HorizontalLayout {
                height: 18px;
                spacing: 6px;
                Cell { horizontal-stretch: 1; text: root.item.name; color: root.item.dim ? Theme.text-dim : Theme.text; font-size: Theme.font-tab; }
                // ✓ / Disabled / Failed right before the version (VS Code's extension list).
                if root.item.mark != "": Cell {
                    text: root.item.mark;
                    color: Tone.color(root.item.markTone);
                    accessible-label: root.item.markLabel != "" ? root.item.markLabel : root.item.mark;
                }
                Cell { text: root.item.version; color: Theme.text-dim; }
            }
            HorizontalLayout {
                height: 16px;
                spacing: 6px;
                Cell { horizontal-stretch: 1; text: root.item.meta; color: Theme.text-dim; }
                for flag in root.item.flags: Cell { text: flag.text; color: Tone.color(flag.tone); }
                if root.item.badge != "": Cell { text: root.item.badge; color: Tone.color(root.item.tone); }
            }
            HorizontalLayout {
                height: Theme.button-small-height;
                spacing: 4px;
                Cell { horizontal-stretch: 1; text: root.item.punchline; color: root.item.dim ? Theme.text-dim : Theme.text-list; }
                if root.item.primary.id != "" || root.item.primary.text != "": Button {
                    small: true;
                    text: root.item.primary.text;
                    enabled: root.item.primary.enabled;
                    clicked => { root.act(root.item.primary.id); }
                }
                // One control in the same place on every row: the button, or the ⋯ manage menu.
                if root.item.primary.id == "" && root.item.primary.text == "" && root.item.menu.length > 0: MenuButton {
                    width: Theme.button-small-height;
                    height: Theme.button-small-height;
                    icon: StoreIcons.more;
                    tip: @tr("Manage");
                    entries: root.item.menu;
                    picked(id) => { root.act(id); }
                }
            }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
}

export component StoreWindow inherits Window {
    title: @tr("Plugin Store");
    preferred-width: 900px;
    preferred-height: 600px;
    min-width: 760px;
    min-height: 480px;
    background: Theme.bg-panel;

    // Tabs and list: 0 All (installed plugins included), 1 Installed, 2 Updates.
    in-out property <string> search-text;
    // In-out: the tab strip sets it on a click or an arrow key (then asks with set-category).
    in-out property <int> category;
    // What All can show: without any repository index, the installed plugins only.
    in property <int> all-count;
    in property <int> installed-count;
    // Plugins with an update (0: none).
    in property <int> updates;
    // Tags; the first entry ("Tags: All", translated by the plugin) stands for all of them.
    in property <[string]> tag-model;
    // In-out: the drop-downs set them on a pick (then ask with set-tag / set-sort).
    in-out property <int> tag-index;
    in-out property <int> sort-index;
    // In-out: "Hide built-in plugins" sets it on a click or Space (then asks with set-hide-builtins).
    in-out property <bool> hide-builtins: true;
    in property <[StoreRow]> rows;
    in property <string> empty-text;
    // Under a list that is not empty: All without any repository index ("" none).
    in property <string> list-note;
    in property <bool> link-open;
    in-out property <string> link-text;
    // Detail: the selected row (always one the list shows; -1 none) and its details.
    in property <bool> has-selection;
    in property <int> selected-index: -1;
    // Bumped when the list should bring the selected row into view (a tab, search, tag or sort change, a selection made for you).
    in property <int> scroll-request;
    // Bumped when the search box is to be emptied (to show a plugin the search hid).
    in property <int> clear-search;
    in property <string> d-name;
    in property <string> d-meta;
    in property <string> d-punchline;
    in property <image> d-icon;
    in property <[StoreAction]> actions;
    in property <[StoreBanner]> banners;
    // In-out: the detail tab strip sets it (then asks with set-tab).
    in-out property <int> tab;
    in property <[MarkdownBlock]> doc;
    in property <string> doc-note;
    in property <[StoreVersion]> versions;
    in property <[StoreFact]> facts;
    in property <[StorePermission]> permissions;
    // Status line: one message, or a text per repository.
    in property <string> status;
    in property <bool> status-warn;
    in property <string> busy-text;
    in property <bool> can-cancel;

    callback search(string);
    callback set-category(int);
    // A row's button or … menu entry: the row's key and the action.
    callback row-act(string, string);
    callback set-tag(int);
    callback set-sort(int);
    callback set-hide-builtins(bool);
    callback select(string);
    callback set-tab(int);
    callback act(string);
    callback banner-act(string);
    callback install-version(string);
    callback open-link(string);
    callback fact-link(int);
    callback from-file();
    callback from-link();
    callback link-accepted(string);
    callback link-cancelled();
    callback repos();
    callback settings();
    callback refresh();
    callback cancel();

    forward-focus: search-box;

    changed clear-search => { root.search-text = ""; }
    // Rows are 62px (ListRow): scroll only as far as needed to show the selected row; nothing selected: the top.
    // Kept within the list, which may have just become shorter.
    changed scroll-request => {
        let top = root.selected-index * 62px;
        let view = plugin-list.visible-height;
        let lowest = min(0px, view - root.rows.length * 62px);
        let current = max(lowest, min(0px, plugin-list.content-y));
        if root.selected-index < 0 {
            plugin-list.content-y = 0px;
        } else if top < -current {
            plugin-list.content-y = -top;
        } else if top + 62px > view - current {
            plugin-list.content-y = max(lowest, view - top - 62px);
        } else {
            plugin-list.content-y = current;
        }
    }

    // Widths that follow the interface language, never under the original ones.
    // A drop-down: its widest label + 21px (6 + 5 padding, 2 gap, 8 caret).
    private property <length> tag-width: max(110px, tag-measure.preferred-width + 21px);
    private property <length> sort-width: max(110px, sort-measure.preferred-width + 21px);
    private property <length> version-width: max(56px, version-measure.preferred-width);
    private property <length> published-width: max(76px, published-measure.preferred-width);
    private property <length> install-width: max(48px, install-measure.preferred-width + 2 * Theme.button-padding);
    private property <length> fact-width: max(44px, fact-measure.preferred-width);
    Rectangle {
        visible: false;
        width: 0;
        height: 0;
        tag-measure := Cell { text: @tr("Tags: All"); }
        sort-measure := VerticalLayout {
            for text in [@tr("Sort: Name"), @tr("Sort: Updated")]: Cell { text: text; }
        }
        version-measure := Cell { text: @tr("Version"); }
        published-measure := Cell { text: @tr("Published"); }
        install-measure := Cell { text: @tr("Install"); }
        fact-measure := VerticalLayout {
            for fact in root.facts: Cell { text: fact.label; }
        }
    }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            height: 22px;
            // The library Tabs (Left/Right/Home/End, tab-list role) at the row's 22px on
            // the panel background: Updates is in the accent colour while updates wait.
            Tabs {
                height: 22px;
                horizontal-stretch: 1;
                background: transparent;
                model: [
                    @tr("All ({})", root.all-count),
                    @tr("Installed ({})", root.installed-count),
                    @tr("Updates ({})", root.updates),
                ];
                emphasis: [false, false, root.updates > 0];
                current-index <=> root.category;
                selected(index) => { root.set-category(index); }
            }
            ToolTipArea {
                width: 23px;
                text: @tr("Refresh");
                Button {
                    width: 100%;
                    height: 100%;
                    icon: StoreIcons.refresh;
                    stroked: true;
                    clicked => { root.refresh(); }
                }
            }
            MenuButton {
                width: 23px;
                icon: StoreIcons.settings;
                tip: @tr("More");
                entries: [
                    { id: "file", text: @tr("Install from File…"), enabled: true },
                    { id: "link", text: @tr("Install from Link…"), enabled: true },
                    { id: "repos", text: @tr("Repositories…"), enabled: true },
                    { id: "", text: "", enabled: false },
                    { id: "settings", text: @tr("Store Settings…"), enabled: true },
                ];
                picked(id) => {
                    if id == "file" { root.from-file(); }
                    if id == "link" { root.from-link(); }
                    if id == "repos" { root.repos(); }
                    if id == "settings" { root.settings(); }
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            height: 24px;
            search-box := LineEdit {
                min-width: 180px;
                horizontal-stretch: 1;
                placeholder-text: @tr("Search names, authors, tags…");
                font-size: Theme.font-body;
                text <=> root.search-text;
                edited(text) => { root.search(text); }
            }
            Choice {
                width: root.tag-width;
                y: 1px;
                model: root.tag-model;
                max-visible-rows: 11;
                popup-min-width: 120px;
                current-index <=> root.tag-index;
                selected(index) => { root.set-tag(index); }
            }
            Choice {
                width: root.sort-width;
                y: 1px;
                model: [@tr("Sort: Name"), @tr("Sort: Updated")];
                popup-min-width: 120px;
                current-index <=> root.sort-index;
                selected(index) => { root.set-sort(index); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            height: Theme.button-height;
            Cell {
                horizontal-stretch: 1;
                text: @tr("You can also drop a .vxp plugin package on the player's video area to install it");
                color: Theme.text-dim;
            }
            // Under the two drop-downs, as wide as both; Tab reaches it after them.
            Check {
                width: root.tag-width + 6px + root.sort-width;
                text: @tr("Hide built-in plugins");
                checked <=> root.hide-builtins;
                toggled(on) => { root.set-hide-builtins(on); }
            }
        }
        if root.link-open: link-row := UrlInputRow {
            text <=> root.link-text;
            placeholder: @tr("Plugin package link (https://…/name-version.vxp)");
            confirm-text: @tr("Install");
            accepted(url) => { root.link-accepted(url); }
            cancelled => { root.link-cancelled(); }
            init => { self.focus-input(); }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 8px;
            // The plugin list, and under it All's offline note (installed plugins shown, the repositories' not).
            VerticalLayout {
                width: 300px;
                spacing: root.list-note == "" ? 0px : 4px;
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg-list;
                    border-width: 1px;
                    border-color: Theme.line;
                    plugin-list := ListView {
                        x: 1px;
                        y: 1px;
                        width: parent.width - 2px;
                        height: parent.height - 2px;
                        for row in root.rows: ListRow {
                            item: row;
                            select => { root.select(row.key); }
                            act(id) => { root.row-act(row.key, id); }
                        }
                    }
                    if root.rows.length == 0: Text {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text: root.empty-text;
                        color: Theme.text-dim;
                        font-size: Theme.font-body;
                        wrap: word-wrap;
                        line-height-factor: 1.25;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                // `visible:`, not `if`: a tab change toggles it (menu-view.slint rule); no height while hidden.
                Text {
                    visible: root.list-note != "";
                    max-height: self.visible ? 200px : 0px;
                    text: root.list-note;
                    color: Theme.text-dim;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                    line-height-factor: 1.25;
                }
            }
            // The selected plugin; an empty list leaves the pane empty (the list says why).
            // `visible:`, not `if`: a tab, search or tag change toggles it (menu-view.slint rule).
            Rectangle {
                horizontal-stretch: 1;
                Text {
                    visible: !root.has-selection && root.rows.length > 0;
                    width: 100%;
                    height: 100%;
                    text: @tr("Select a plugin on the left to see its details");
                    color: Theme.text-dim;
                    font-size: Theme.font-body;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    visible: root.has-selection;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 10px;
                        height: 56px;
                        Image {
                            width: 56px;
                            height: 56px;
                            source: root.d-icon;
                            image-fit: contain;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Cell { text: root.d-name; color: Theme.text; font-size: Theme.font-title; font-weight: 700; }
                            Cell { text: root.d-meta; color: Theme.text-dim; }
                            Cell { text: root.d-punchline; color: Theme.text-list; }
                        }
                    }
                    HorizontalLayout {
                        height: Theme.button-height;
                        spacing: 6px;
                        alignment: start;
                        for action in root.actions: SizedButton {
                            text: action.text;
                            enabled: action.enabled;
                            clicked => { root.act(action.id); }
                        }
                    }
                    for banner in root.banners: Rectangle {
                        background: Theme.bg-list;
                        border-radius: Theme.radius-control;
                        HorizontalLayout {
                            padding: 5px;
                            padding-left: 0px;
                            spacing: 8px;
                            Rectangle { width: 3px; background: Tone.color(banner.tone); }
                            Text {
                                horizontal-stretch: 1;
                                text: banner.text;
                                color: Tone.color(banner.tone);
                                font-size: Theme.font-body;
                                wrap: word-wrap;
                                line-height-factor: 1.25;
                                vertical-alignment: center;
                            }
                            if banner.action != "": SizedButton {
                                min: 41px;
                                small: true;
                                text: banner.actionText;
                                clicked => { root.banner-act(banner.action); }
                            }
                        }
                    }
                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 0px;
                            Tabs {
                                height: 22px;
                                background: transparent;
                                model: [@tr("Description"), @tr("Changelog"), @tr("Versions")];
                                current-index <=> root.tab;
                                selected(index) => { root.set-tab(index); }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                background: Theme.bg-list;
                                border-width: 1px;
                                border-color: Theme.line;
                                if root.tab != 2: MarkdownView {
                                    x: 1px;
                                    y: 1px;
                                    width: parent.width - 2px;
                                    height: parent.height - 2px;
                                    blocks: root.doc;
                                    link-clicked(url) => { root.open-link(url); }
                                }
                                if root.tab != 2 && root.doc-note != "": Text {
                                    x: 12px;
                                    width: parent.width - 24px;
                                    height: parent.height;
                                    text: root.doc-note;
                                    color: Theme.text-dim;
                                    font-size: Theme.font-body;
                                    wrap: word-wrap;
                                    line-height-factor: 1.25;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                if root.tab == 2: VerticalLayout {
                                    x: 1px;
                                    y: 1px;
                                    width: parent.width - 2px;
                                    height: parent.height - 2px;
                                    HorizontalLayout {
                                        height: 20px;
                                        padding-left: 6px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        Cell { width: root.version-width; text: @tr("Version"); color: Theme.text-dim; }
                                        Cell { width: root.published-width; text: @tr("Published"); color: Theme.text-dim; }
                                        Cell { horizontal-stretch: 1; text: @tr("Minimum player"); color: Theme.text-dim; }
                                        Rectangle { width: root.install-width; }
                                    }
                                    Rectangle { height: 1px; background: Theme.line; }
                                    // Two lines per version: the facts, then the status in full (wrapped).
                                    ListView {
                                        vertical-stretch: 1;
                                        for v in root.versions: VerticalLayout {
                                            padding-left: 6px;
                                            padding-right: 8px;
                                            padding-top: 3px;
                                            padding-bottom: 3px;
                                            HorizontalLayout {
                                                height: 20px;
                                                spacing: 6px;
                                                Cell { width: root.version-width; text: v.version; color: Theme.text; }
                                                Cell { width: root.published-width; text: v.date; color: Theme.text-list; }
                                                Cell { horizontal-stretch: 1; text: v.minimum; color: Theme.text-list; }
                                                VerticalLayout {
                                                    width: root.install-width;
                                                    alignment: center;
                                                    if v.canInstall: Button {
                                                        small: true;
                                                        text: @tr("Install");
                                                        clicked => { root.install-version(v.version); }
                                                    }
                                                }
                                            }
                                            if v.status != "": Text {
                                                text: v.status;
                                                color: Tone.color(v.tone);
                                                font-size: Theme.font-body;
                                                wrap: word-wrap;
                                                line-height-factor: 1.25;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // Facts and permissions.
                        VerticalLayout {
                            width: 200px;
                            spacing: 2px;
                            for fact[index] in root.facts: HorizontalLayout {
                                height: 18px;
                                spacing: 6px;
                                Cell { width: root.fact-width; text: fact.label; color: Theme.text-dim; }
                                ToolTipArea {
                                    horizontal-stretch: 1;
                                    text: fact.text;
                                    Cell {
                                        width: 100%;
                                        height: 100%;
                                        text: fact.text;
                                        color: fact.link ? Theme.accent : Theme.text-list;
                                    }
                                    if fact.link: TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        mouse-cursor: pointer;
                                        clicked => { root.fact-link(index); }
                                    }
                                }
                            }
                            Rectangle { height: 6px; }
                            Cell { text: @tr("Permissions ({})", root.permissions.length); color: Theme.text; }
                            Rectangle { height: 1px; background: Theme.line; }
                            ListView {
                                vertical-stretch: 1;
                                for p in root.permissions: Text {
                                    height: self.preferred-height + 3px;
                                    text: "· " + p.text;
                                    color: p.risky ? Tone.warn : Theme.text-list;
                                    font-size: Theme.font-body;
                                    wrap: word-wrap;
                                    line-height-factor: 1.25;
                                }
                            }
                        }
                    }

                }
            }
        }
        // Status line.
        HorizontalLayout {
            height: 20px;
            spacing: 8px;
            ToolTipArea {
                horizontal-stretch: 1;
                text: root.status;
                Cell {
                    width: 100%;
                    height: 100%;
                    text: root.status;
                    color: root.status-warn ? Tone.warn : Theme.text-dim;
                }
            }
            if root.busy-text != "": Cell { text: root.busy-text; color: Theme.text; }
            if root.can-cancel: Button { small: true; text: @tr("Cancel"); clicked => { root.cancel(); } }
        }
    }
}

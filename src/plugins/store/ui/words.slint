// Every sentence the store builds at run time (text.ts: WINDOW and PART), as
// window text. TypeScript passes a `Msg` (template and arguments) as data;
// `Words.msg()` finds its @tr here. tests/words.test.ts checks that this file
// and text.ts list the same templates with the same number of arguments.

// A plain argument (`id` empty, the value in `a`), or a PART template with
// plain arguments a–d.
export struct Arg { id: string, a: string, b: string, c: string, d: string }
// A WINDOW template; each argument may be a PART.
export struct Msg { id: string, args: [Arg] }

export global Words {
    // A PART, or a plain value.
    public pure function arg(x: Arg) -> string {
        if x.id == "" { return x.a; }
        if x.id == "Official repository" { return @tr("Official repository"); }
        // TRANSLATORS: a third-party repository: its own name (host)
        if x.id == "{} ({})" { return @tr("{} ({})", x.a, x.b); }
        if x.id == "Unnamed repository ({})" { return @tr("Unnamed repository ({})", x.a); }
        if x.id == "Unofficial: {} ({})" { return @tr("Unofficial: {} ({})", x.a, x.b); }
        if x.id == "Unofficial: Unnamed repository ({})" { return @tr("Unofficial: Unnamed repository ({})", x.a); }
        if x.id == "Vestra Player official repository" { return @tr("Vestra Player official repository"); }
        if x.id == "Built-in" { return @tr("Built-in"); }
        if x.id == "Local file" { return @tr("Local file"); }
        if x.id == "Link" { return @tr("Link"); }
        if x.id == "Plugin Workshop" { return @tr("Plugin Workshop"); }
        // TRANSLATORS: where a plugin was installed from: a repository at this host
        if x.id == "Repository {}" { return @tr("Repository {}", x.a); }
        if x.id == "Unknown source" { return @tr("Unknown source"); }
        if x.id == "Unknown author" { return @tr("Unknown author"); }
        if x.id == "Cancelled" { return @tr("Cancelled"); }
        if x.id == "Only https:// addresses are supported" { return @tr("Only https:// addresses are supported"); }
        if x.id == "Redirected to an insecure address" { return @tr("Redirected to an insecure address"); }
        if x.id == "Redirect without a target address ({})" { return @tr("Redirect without a target address ({})", x.a); }
        if x.id == "Too many redirects" { return @tr("Too many redirects"); }
        if x.id == "Size does not match the description" { return @tr("Size does not match the description"); }
        if x.id == "File exceeds the size limit" { return @tr("File exceeds the size limit"); }
        if x.id == "Checksum does not match the description" { return @tr("Checksum does not match the description"); }
        if x.id == "Connection timed out" { return @tr("Connection timed out"); }
        if x.id == "Server not found" { return @tr("Server not found"); }
        if x.id == "Connection refused" { return @tr("Connection refused"); }
        if x.id == "Connection reset" { return @tr("Connection reset"); }
        if x.id == "Secure connection failed" { return @tr("Secure connection failed"); }
        if x.id == "File exceeds 256 KB" { return @tr("File exceeds 256 KB"); }
        if x.id == "Not JSON" { return @tr("Not JSON"); }
        if x.id == "The top level is not an object" { return @tr("The top level is not an object"); }
        if x.id == "Wrong schema" { return @tr("Wrong schema"); }
        if x.id == "plugins is not an array" { return @tr("plugins is not an array"); }
        if x.id == "revoked is not an array" { return @tr("revoked is not an array"); }
        if x.id == "revoked has more than {} entries" { return @tr("revoked has more than {} entries", x.a); }
        if x.id == "Needs a newer plugin API ({})" { return @tr("Needs a newer plugin API ({})", x.a); }
        if x.id == "Needs Vestra Player ≥ {} (current {})" { return @tr("Needs Vestra Player ≥ {} (current {})", x.a, x.b); }
        if x.id == "Revoked: {}" { return @tr("Revoked: {}", x.a); }
        if x.id == "This plugin has been revoked: {}" { return @tr("This plugin has been revoked: {}", x.a); }
        if x.id == "“{}”: ids starting with vestra. are reserved for the player's built-in plugins and cannot be installed or loaded for testing" { return @tr("“{}”: ids starting with vestra. are reserved for the player's built-in plugins and cannot be installed or loaded for testing", x.a); }
        if x.id == "This plugin: ids starting with vestra. are reserved for the player's built-in plugins and cannot be installed or loaded for testing" { return @tr("This plugin: ids starting with vestra. are reserved for the player's built-in plugins and cannot be installed or loaded for testing"); }
        if x.id == "Enter a repository address starting with https://" { return @tr("Enter a repository address starting with https://"); }
        if x.id == "The address cannot contain a user name or password" { return @tr("The address cannot contain a user name or password"); }
        if x.id == "The repository address is too long" { return @tr("The repository address is too long"); }
        return x.id;
    }

    // A WINDOW template (a PART or a plain value on its own comes as the first argument).
    public pure function msg(m: Msg) -> string {
        if m.id == "" { return arg(m.args[0]); }
        if m.id == "Another install is in progress; wait for it to finish" { return @tr("Another install is in progress; wait for it to finish"); }
        if m.id == "This system does not support confirmation dialogs; cannot continue" { return @tr("This system does not support confirmation dialogs; cannot continue"); }
        if m.id == "Another dialog is open; close it first" { return @tr("Another dialog is open; close it first"); }
        if m.id == "Couldn't open the link: {}" { return @tr("Couldn't open the link: {}", arg(m.args[0])); }
        if m.id == "This kind of link cannot be opened" { return @tr("This kind of link cannot be opened"); }
        if m.id == "The downloaded file does not match the repository's description (size); deleted" { return @tr("The downloaded file does not match the repository's description (size); deleted"); }
        if m.id == "The downloaded file does not match the repository's description (checksum); deleted" { return @tr("The downloaded file does not match the repository's description (checksum); deleted"); }
        if m.id == "The plugin package exceeds 64 MB; download stopped" { return @tr("The plugin package exceeds 64 MB; download stopped"); }
        if m.id == "The download address is insecure or redirects too often; stopped" { return @tr("The download address is insecure or redirects too often; stopped"); }
        if m.id == "Download cancelled" { return @tr("Download cancelled"); }
        if m.id == "Couldn't write the download file: {}" { return @tr("Couldn't write the download file: {}", arg(m.args[0])); }
        if m.id == "Download failed: {}" { return @tr("Download failed: {}", arg(m.args[0])); }
        if m.id == "This is not a valid plugin package: {}" { return @tr("This is not a valid plugin package: {}", arg(m.args[0])); }
        if m.id == "This plugin needs Vestra Player ≥ {} (current {})" { return @tr("This plugin needs Vestra Player ≥ {} (current {})", arg(m.args[0]), arg(m.args[1])); }
        if m.id == "This plugin needs a newer Vestra Player (current {})" { return @tr("This plugin needs a newer Vestra Player (current {})", arg(m.args[0])); }
        if m.id == "“{}” has the same id as a built-in plugin and cannot be installed" { return @tr("“{}” has the same id as a built-in plugin and cannot be installed", arg(m.args[0])); }
        if m.id == "This plugin has the same id as a built-in plugin and cannot be installed" { return @tr("This plugin has the same id as a built-in plugin and cannot be installed"); }
        if m.id == "This plugin is being installed or rolled back; try again later" { return @tr("This plugin is being installed or rolled back; try again later"); }
        if m.id == "The Plugin Store lacks the “Manage plugins” permission" { return @tr("The Plugin Store lacks the “Manage plugins” permission"); }
        if m.id == "This plugin no longer exists" { return @tr("This plugin no longer exists"); }
        if m.id == "The plugin package does not match the repository's description (id); not installed" { return @tr("The plugin package does not match the repository's description (id); not installed"); }
        if m.id == "The plugin package does not match the repository's description (version); not installed" { return @tr("The plugin package does not match the repository's description (version); not installed"); }
        if m.id == "The plugin package does not match the repository's description (permissions); not installed" { return @tr("The plugin package does not match the repository's description (permissions); not installed"); }
        if m.id == "You can only install from https:// links" { return @tr("You can only install from https:// links"); }
        if m.id == "Not installed" { return @tr("Not installed"); }
        if m.id == "Installed {} {}" { return @tr("Installed {} {}", arg(m.args[0]), arg(m.args[1])); }
        if m.id == "Updated {} to {}" { return @tr("Updated {} to {}", arg(m.args[0]), arg(m.args[1])); }
        if m.id == "Rolled back {} to {}" { return @tr("Rolled back {} to {}", arg(m.args[0]), arg(m.args[1])); }
        if m.id == "Restored {} to {}" { return @tr("Restored {} to {}", arg(m.args[0]), arg(m.args[1])); }
        if m.id == "Uninstalled {} (data deleted)" { return @tr("Uninstalled {} (data deleted)", arg(m.args[0])); }
        if m.id == "Uninstalled {} (data kept)" { return @tr("Uninstalled {} (data kept)", arg(m.args[0])); }
        if m.id == "This plugin cannot be rolled back" { return @tr("This plugin cannot be rolled back"); }
        if m.id == "Built-in plugins can only be disabled" { return @tr("Built-in plugins can only be disabled"); }
        if m.id == "Enabled “{}” again" { return @tr("Enabled “{}” again", arg(m.args[0])); }
        if m.id == "Couldn't enable “{}”: {}" { return @tr("Couldn't enable “{}”: {}", arg(m.args[0]), arg(m.args[1])); }
        if m.id == "Can no longer cancel; the installation continues" { return @tr("Can no longer cancel; the installation continues"); }
        if m.id == "Can no longer cancel; the uninstallation continues" { return @tr("Can no longer cancel; the uninstallation continues"); }
        if m.id == "Can no longer cancel; the rollback continues" { return @tr("Can no longer cancel; the rollback continues"); }
        if m.id == "Can no longer cancel; the restore continues" { return @tr("Can no longer cancel; the restore continues"); }
        if m.id == "Installation failed; the previous version was restored" { return @tr("Installation failed; the previous version was restored"); }
        if m.id == "Uninstallation failed; the previous version was restored" { return @tr("Uninstallation failed; the previous version was restored"); }
        if m.id == "Rollback failed; the previous version was restored" { return @tr("Rollback failed; the previous version was restored"); }
        if m.id == "Restore failed; the previous version was restored" { return @tr("Restore failed; the previous version was restored"); }
        if m.id == "Installation cancelled" { return @tr("Installation cancelled"); }
        if m.id == "Uninstallation cancelled" { return @tr("Uninstallation cancelled"); }
        if m.id == "Rollback cancelled" { return @tr("Rollback cancelled"); }
        if m.id == "Restore cancelled" { return @tr("Restore cancelled"); }
        if m.id == "Installation failed: {}" { return @tr("Installation failed: {}", arg(m.args[0])); }
        if m.id == "Uninstallation failed: {}" { return @tr("Uninstallation failed: {}", arg(m.args[0])); }
        if m.id == "Rollback failed: {}" { return @tr("Rollback failed: {}", arg(m.args[0])); }
        if m.id == "Restore failed: {}" { return @tr("Restore failed: {}", arg(m.args[0])); }
        if m.id == "Downloading {} {}" { return @tr("Downloading {} {}", arg(m.args[0]), arg(m.args[1])); }
        if m.id == "Downloading {} {} ({}%)" { return @tr("Downloading {} {} ({}%)", arg(m.args[0]), arg(m.args[1]), arg(m.args[2])); }
        if m.id == "Downloading the plugin package" { return @tr("Downloading the plugin package"); }
        if m.id == "Downloading the plugin package ({}%)" { return @tr("Downloading the plugin package ({}%)", arg(m.args[0])); }
        if m.id == "Checking {}…" { return @tr("Checking {}…", arg(m.args[0])); }
        if m.id == "Checking the plugin package…" { return @tr("Checking the plugin package…"); }
        if m.id == "Installing {}…" { return @tr("Installing {}…", arg(m.args[0])); }
        if m.id == "Rolling back {}…" { return @tr("Rolling back {}…", arg(m.args[0])); }
        if m.id == "Restoring {}…" { return @tr("Restoring {}…", arg(m.args[0])); }
        if m.id == "Uninstalling {}…" { return @tr("Uninstalling {}…", arg(m.args[0])); }
        if m.id == "Installing… (preparing)" { return @tr("Installing… (preparing)"); }
        if m.id == "Installing… (activating)" { return @tr("Installing… (activating)"); }
        if m.id == "Uninstalling… (preparing)" { return @tr("Uninstalling… (preparing)"); }
        if m.id == "Uninstalling… (activating)" { return @tr("Uninstalling… (activating)"); }
        if m.id == "Rolling back… (preparing)" { return @tr("Rolling back… (preparing)"); }
        if m.id == "Rolling back… (activating)" { return @tr("Rolling back… (activating)"); }
        if m.id == "Restoring… (preparing)" { return @tr("Restoring… (preparing)"); }
        if m.id == "Restoring… (activating)" { return @tr("Restoring… (activating)"); }
        if m.id == "Updating {}…" { return @tr("Updating {}…", arg(m.args[0])); }
        if m.id == "{0}: up to date at {1}" { return @tr("{0}: up to date at {1}", arg(m.args[0]), arg(m.args[1])); }
        if m.id == "{0}: updated at {1}" { return @tr("{0}: updated at {1}", arg(m.args[0]), arg(m.args[1])); }
        if m.id == "{0}: data from {1}" { return @tr("{0}: data from {1}", arg(m.args[0]), arg(m.args[1])); }
        if m.id == "The official repository has no signature file; this update was ignored" { return @tr("The official repository has no signature file; this update was ignored"); }
        if m.id == "The official repository's signature check failed (it may have been tampered with); this update was ignored" { return @tr("The official repository's signature check failed (it may have been tampered with); this update was ignored"); }
        if m.id == "The official repository returned an old index; this update was ignored" { return @tr("The official repository returned an old index; this update was ignored"); }
        if m.id == "{} uses a newer format; please update Vestra Player" { return @tr("{} uses a newer format; please update Vestra Player", arg(m.args[0])); }
        if m.id == "{}'s index is malformed" { return @tr("{}'s index is malformed", arg(m.args[0])); }
        if m.id == "{0}'s index is malformed; showing the data from {1}" { return @tr("{0}'s index is malformed; showing the data from {1}", arg(m.args[0]), arg(m.args[1])); }
        if m.id == "{0} returned error {1}" { return @tr("{0} returned error {1}", arg(m.args[0]), arg(m.args[1])); }
        if m.id == "{0} returned error {1}; showing the data from {2}" { return @tr("{0} returned error {1}; showing the data from {2}", arg(m.args[0]), arg(m.args[1]), arg(m.args[2])); }
        if m.id == "{}'s index exceeds 4 MB; refused" { return @tr("{}'s index exceeds 4 MB; refused", arg(m.args[0])); }
        if m.id == "{0}'s index exceeds 4 MB; refused; showing the data from {1}" { return @tr("{0}'s index exceeds 4 MB; refused; showing the data from {1}", arg(m.args[0]), arg(m.args[1])); }
        // TRANSLATORS: a repository and what went wrong with it
        if m.id == "{0}: {1}" { return @tr("{0}: {1}", arg(m.args[0]), arg(m.args[1])); }
        if m.id == "{0}: {1}; showing the data from {2}" { return @tr("{0}: {1}; showing the data from {2}", arg(m.args[0]), arg(m.args[1]), arg(m.args[2])); }
        if m.id == "Can't connect to {0} ({1}); its plugins are not available for now" { return @tr("Can't connect to {0} ({1}); its plugins are not available for now", arg(m.args[0]), arg(m.args[1])); }
        if m.id == "Can't connect to {0} ({1}); showing the cache from {2}" { return @tr("Can't connect to {0} ({1}); showing the cache from {2}", arg(m.args[0]), arg(m.args[1]), arg(m.args[2])); }
        if m.id == "This repository has already been added" { return @tr("This repository has already been added"); }
        if m.id == "At most {} repositories can be added" { return @tr("At most {} repositories can be added", arg(m.args[0])); }
        if m.id == "Reading {}…" { return @tr("Reading {}…", arg(m.args[0])); }
        if m.id == "Couldn't read this repository: {}. Check the address (the repository's root address or the full address of index.json)" { return @tr("Couldn't read this repository: {}. Check the address (the repository's root address or the full address of index.json)", arg(m.args[0])); }
        if m.id == "Added {}" { return @tr("Added {}", arg(m.args[0])); }
        if m.id == "Removed {}" { return @tr("Removed {}", arg(m.args[0])); }
        if m.id == "No plugins match" { return @tr("No plugins match"); }
        if m.id == "All plugins are up to date" { return @tr("All plugins are up to date"); }
        if m.id == "No plugins installed yet" { return @tr("No plugins installed yet"); }
        if m.id == "Reading repositories…" { return @tr("Reading repositories…"); }
        if m.id == "Can't connect to the repositories and there is no cached copy. Click “Refresh” once you are online." { return @tr("Can't connect to the repositories and there is no cached copy. Click “Refresh” once you are online."); }
        if m.id == "The repositories have no plugins yet" { return @tr("The repositories have no plugins yet"); }
        // TRANSLATORS: author · where the plugin comes from
        if m.id == "{} · {}" { return @tr("{} · {}", arg(m.args[0]), arg(m.args[1])); }
        // TRANSLATORS: a list badge, and a fact label (44 px wide): the installed version
        if m.id == "Installed" { return @tr("Installed"); }
        // TRANSLATORS: a list badge: a newer version is available
        if m.id == "Update → {}" { return @tr("Update → {}", arg(m.args[0])); }
        if m.id == "Revoked" { return @tr("Revoked"); }
        if m.id == "Installed from {}" { return @tr("Installed from {}", arg(m.args[0])); }
        if m.id == "Incompatible" { return @tr("Incompatible"); }
        if m.id == "Cannot be installed" { return @tr("Cannot be installed"); }
        if m.id == "Install {}" { return @tr("Install {}", arg(m.args[0])); }
        if m.id == "Update to {}" { return @tr("Update to {}", arg(m.args[0])); }
        if m.id == "Enable Anyway…" { return @tr("Enable Anyway…"); }
        if m.id == "Replace…" { return @tr("Replace…"); }
        if m.id == "Roll Back to {}" { return @tr("Roll Back to {}", arg(m.args[0])); }
        if m.id == "Restore to {}" { return @tr("Restore to {}", arg(m.args[0])); }
        if m.id == "Uninstall…" { return @tr("Uninstall…"); }
        if m.id == "Load" { return @tr("Load"); }
        if m.id == "Show Images" { return @tr("Show Images"); }
        if m.id == "Retry" { return @tr("Retry"); }
        if m.id == "This version has been revoked: {}." { return @tr("This version has been revoked: {}.", arg(m.args[0])); }
        if m.id == "This version has been revoked: {}. You confirmed the risk and enabled it again; the store will not disable it again." { return @tr("This version has been revoked: {}. You confirmed the risk and enabled it again; the store will not disable it again.", arg(m.args[0])); }
        if m.id == "This version has been revoked: {}. The store has disabled it." { return @tr("This version has been revoked: {}. The store has disabled it.", arg(m.args[0])); }
        if m.id == "Unofficial repository: not reviewed by Vestra Player; plugins may read your files or use the network" { return @tr("Unofficial repository: not reviewed by Vestra Player; plugins may read your files or use the network"); }
        if m.id == "This is a test repository on this machine, without encryption" { return @tr("This is a test repository on this machine, without encryption"); }
        if m.id == "Installed {1} from {0}. Replacing it continues with the data from an earlier install from this source, if there was one, otherwise with new, empty data; the current data is kept" { return @tr("Installed {1} from {0}. Replacing it continues with the data from an earlier install from this source, if there was one, otherwise with new, empty data; the current data is kept", arg(m.args[0]), arg(m.args[1])); }
        if m.id == "Same id as a built-in plugin of the player; cannot be installed from here" { return @tr("Same id as a built-in plugin of the player; cannot be installed from here"); }
        if m.id == "Built-in plugins are updated with the player and cannot be uninstalled; to disable one, use “Settings ▸ Plugin Manager…”" { return @tr("Built-in plugins are updated with the player and cannot be uninstalled; to disable one, use “Settings ▸ Plugin Manager…”"); }
        if m.id == "The repository no longer offers this plugin; the store no longer checks it for updates (it still checks for revocations)" { return @tr("The repository no longer offers this plugin; the store no longer checks it for updates (it still checks for revocations)"); }
        if m.id == "Its repository was removed from the store; the store no longer checks it for updates or revocations" { return @tr("Its repository was removed from the store; the store no longer checks it for updates or revocations"); }
        if m.id == "Sideloaded plugin: not reviewed; the store does not check it for updates" { return @tr("Sideloaded plugin: not reviewed; the store does not check it for updates"); }
        if m.id == "This run uses the development-loaded version" { return @tr("This run uses the development-loaded version"); }
        if m.id == "The description is on another website ({}); not loaded automatically" { return @tr("The description is on another website ({}); not loaded automatically", arg(m.args[0])); }
        if m.id == "Remote images blocked (unofficial source): {}" { return @tr("Remote images blocked (unofficial source): {}", arg(m.args[0])); }
        if m.id == "Loading…" { return @tr("Loading…"); }
        if m.id == "Loading the description…" { return @tr("Loading the description…"); }
        if m.id == "Loading the changelog…" { return @tr("Loading the changelog…"); }
        if m.id == "The author provided no description" { return @tr("The author provided no description"); }
        if m.id == "The author provided no changelog" { return @tr("The author provided no changelog"); }
        if m.id == "The description is on another website; not loaded automatically" { return @tr("The description is on another website; not loaded automatically"); }
        if m.id == "The changelog is on another website; not loaded automatically" { return @tr("The changelog is on another website; not loaded automatically"); }
        if m.id == "Couldn't load the description: {}" { return @tr("Couldn't load the description: {}", arg(m.args[0])); }
        if m.id == "Couldn't load the changelog: {}" { return @tr("Couldn't load the changelog: {}", arg(m.args[0])); }
        if m.id == "Couldn't show the description: {}" { return @tr("Couldn't show the description: {}", arg(m.args[0])); }
        if m.id == "Couldn't show the changelog: {}" { return @tr("Couldn't show the changelog: {}", arg(m.args[0])); }
        if m.id == "Current" { return @tr("Current"); }
        if m.id == "Current, {}" { return @tr("Current, {}", arg(m.args[0])); }
        if m.id == "Incompatible: {}" { return @tr("Incompatible: {}", arg(m.args[0])); }
        if m.id == "Latest" { return @tr("Latest"); }
        // TRANSLATORS: a fact label (44 px wide)
        if m.id == "Version" { return @tr("Version"); }
        // TRANSLATORS: a fact label (44 px wide): when the latest version was published
        if m.id == "Updated" { return @tr("Updated"); }
        // TRANSLATORS: a fact label (44 px wide): where the plugin comes from
        if m.id == "Source" { return @tr("Source"); }
        // TRANSLATORS: a fact label (44 px wide)
        if m.id == "License" { return @tr("License"); }
        // TRANSLATORS: a fact label (44 px wide): the plugin's source code; the link says Open ↗
        if m.id == "Code" { return @tr("Code"); }
        if m.id == "Open ↗" { return @tr("Open ↗"); }
        return m.id;
    }

    // The status line: one text per repository (or one message), separated by " · ".
    public pure function line(list: [Msg]) -> string {
        return (list.length > 0 ? msg(list[0]) : "")
            + (list.length > 1 ? " · " + msg(list[1]) : "")
            + (list.length > 2 ? " · " + msg(list[2]) : "")
            + (list.length > 3 ? " · " + msg(list[3]) : "")
            + (list.length > 4 ? " · " + msg(list[4]) : "")
            + (list.length > 5 ? " · " + msg(list[5]) : "")
            + (list.length > 6 ? " · " + msg(list[6]) : "")
            + (list.length > 7 ? " · " + msg(list[7]) : "")
            + (list.length > 8 ? " · " + msg(list[8]) : "")
            + (list.length > 9 ? " · " + msg(list[9]) : "")
            + (list.length > 10 ? " · " + msg(list[10]) : "")
            + (list.length > 11 ? " · " + msg(list[11]) : "")
            + (list.length > 12 ? " · " + msg(list[12]) : "")
            + (list.length > 13 ? " · " + msg(list[13]) : "")
            + (list.length > 14 ? " · " + msg(list[14]) : "")
            + (list.length > 15 ? " · " + msg(list[15]) : "")
            + (list.length > 16 ? " · " + msg(list[16]) : "");
    }

    // A capability in plain words (labels.ts CAPABILITIES).
    public pure function cap(id: string) -> string {
        if id == "commands" { return @tr("Add menu commands and shortcuts"); }
        if id == "ui.window" { return @tr("Open tool windows"); }
        if id == "ui.mount" { return @tr("Show panels in the bottom bar, the sidebar or behind the video"); }
        if id == "ui.dialog" { return @tr("Show file pickers and confirmations"); }
        if id == "ui.osd" { return @tr("Show messages on the video"); }
        if id == "ui.drop" { return @tr("Receive files dropped on the player"); }
        if id == "ui.theme" { return @tr("Change the player's palette"); }
        if id == "ui.settings" { return @tr("Add pages to the Options window"); }
        if id == "playback.read" { return @tr("Read what is playing and the position"); }
        if id == "events" { return @tr("Receive playback changes as they happen"); }
        if id == "playback.control" { return @tr("Open media, control playback, keep the computer awake"); }
        if id == "producer.av" { return @tr("Provide audio and video it generates itself"); }
        if id == "processing.video" { return @tr("Process the picture (filters, shaders)"); }
        if id == "processing.audio" { return @tr("Process the sound"); }
        if id == "subtitles.read" { return @tr("Read subtitles"); }
        if id == "subtitles.control" { return @tr("Load and change subtitles"); }
        if id == "media.read" { return @tr("Take snapshots and export clips"); }
        if id == "media.control" { return @tr("Take snapshots and export clips"); }
        if id == "source.resolve" { return @tr("Resolve online video addresses"); }
        if id == "timeline.marks" { return @tr("Show marks on the progress bar"); }
        if id == "window.control" { return @tr("Adjust the main window (size, on top, picture-in-picture)"); }
        if id == "clipboard" { return @tr("Read and write the clipboard"); }
        if id == "bindings.manage" { return @tr("Change all shortcuts"); }
        if id == "secrets" { return @tr("Store sign-in details in the system keychain"); }
        if id == "plugins.manage" { return @tr("Install, uninstall and disable other plugins"); }
        return @tr("Unknown permission: {}", id);
    }

    // Capabilities in plain words, one after another (at most 25).
    public pure function caps(list: [string]) -> string {
        // TRANSLATORS: between two permissions in a list
        return Words.join-caps(list, @tr(", "));
    }
    pure function join-caps(list: [string], sep: string) -> string {
        return (list.length > 0 ? cap(list[0]) : "")
            + (list.length > 1 ? sep + cap(list[1]) : "")
            + (list.length > 2 ? sep + cap(list[2]) : "")
            + (list.length > 3 ? sep + cap(list[3]) : "")
            + (list.length > 4 ? sep + cap(list[4]) : "")
            + (list.length > 5 ? sep + cap(list[5]) : "")
            + (list.length > 6 ? sep + cap(list[6]) : "")
            + (list.length > 7 ? sep + cap(list[7]) : "")
            + (list.length > 8 ? sep + cap(list[8]) : "")
            + (list.length > 9 ? sep + cap(list[9]) : "")
            + (list.length > 10 ? sep + cap(list[10]) : "")
            + (list.length > 11 ? sep + cap(list[11]) : "")
            + (list.length > 12 ? sep + cap(list[12]) : "")
            + (list.length > 13 ? sep + cap(list[13]) : "")
            + (list.length > 14 ? sep + cap(list[14]) : "")
            + (list.length > 15 ? sep + cap(list[15]) : "")
            + (list.length > 16 ? sep + cap(list[16]) : "")
            + (list.length > 17 ? sep + cap(list[17]) : "")
            + (list.length > 18 ? sep + cap(list[18]) : "")
            + (list.length > 19 ? sep + cap(list[19]) : "")
            + (list.length > 20 ? sep + cap(list[20]) : "")
            + (list.length > 21 ? sep + cap(list[21]) : "")
            + (list.length > 22 ? sep + cap(list[22]) : "")
            + (list.length > 23 ? sep + cap(list[23]) : "")
            + (list.length > 24 ? sep + cap(list[24]) : "");
    }
}

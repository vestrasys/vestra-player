// Compact controls of the store's window and settings page (11px text, 21px
// controls). std-widgets' fluent ComboBox has a 160px minimum, so the
// drop-down is our own (same geometry as the hotkeys plugin's).
import { ListView } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Icon } from "@vestra/icons.slint";
import { Button, ToolTipArea } from "@vestra/widgets.slint";

// One entry of a MenuButton's menu; `id` "" is a separator.
export struct MenuEntry {
    id: string,
    text: string,
    enabled: bool,
}

// V-Line strokes (1.5px, round caps) for the store's icon buttons, drawn in a
// 14×12 box like the player's set, which has no refresh, settings or "more"
// icon yet (round doc 2026-10-ui-polish, request STORE-ICONS).
export global StoreIcons {
    // A circle open at the upper right, the arrow turning clockwise.
    out property <string> refresh: "M 10.99 7.45 A 4.25 4.25 0 1 1 10.26 3.27 M 10.26 0.87 L 10.26 3.27 L 7.9 2.85";
    // A small gear: a ring and eight teeth.
    out property <string> settings: "M 9 6 A 2 2 0 1 1 5 6 A 2 2 0 1 1 9 6 M 10.5 6 H 12 M 2 6 H 3.5 M 7 1 V 2.5 M 7 9.5 V 11 M 9.47 3.53 L 10.54 2.46 M 4.53 3.53 L 3.46 2.46 M 9.47 8.47 L 10.54 9.54 M 4.53 8.47 L 3.46 9.54";
    // Three dots.
    // (Small rings: a zero-length line draws nothing in the software renderer.)
    out property <string> more: "M 3.5 6 A 0.5 0.5 0 1 1 2.5 6 A 0.5 0.5 0 1 1 3.5 6 M 7.5 6 A 0.5 0.5 0 1 1 6.5 6 A 0.5 0.5 0 1 1 7.5 6 M 11.5 6 A 0.5 0.5 0 1 1 10.5 6 A 0.5 0.5 0 1 1 11.5 6";
}

// A menu row in the main menu's style (ui-spec §6.3): 24px, 12px text, the
// lit row selected-bg with a 2×14 accent bar on its left edge.
component MenuRow {
    in property <string> text;
    in property <bool> enabled: true;
    callback picked();
    private property <bool> lit: touch.has-hover && root.enabled;
    height: 24px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    Rectangle {
        border-radius: Theme.radius-control;
        background: root.lit ? Theme.selected-bg : transparent;
    }
    if root.lit: Rectangle {
        x: 0;
        y: 5px;
        width: 2px;
        height: 14px;
        border-radius: 1px;
        background: Theme.accent;
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            color: !root.enabled ? Theme.text-dim : root.lit ? Theme.text : Theme.text-list;
            font-size: Theme.font-tab;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.picked(); }
    }
}

// An icon button that opens a menu under it, right-aligned with it, in the
// main menu's style (bg-panel, a line border, radius-panel). The caller sizes it.
export component MenuButton {
    in property <string> icon;
    in property <length> icon-width: 14px;
    in property <length> icon-height: 12px;
    in property <string> tip;
    in property <[MenuEntry]> entries;
    in property <bool> enabled: true;
    callback picked(string);
    private property <length> menu-width: max(120px, measure.preferred-width + 20px);
    ToolTipArea {
        width: 100%;
        height: 100%;
        text: root.tip;
        Button {
            width: 100%;
            height: 100%;
            icon: root.icon;
            icon-width: root.icon-width;
            icon-height: root.icon-height;
            stroked: true;
            enabled: root.enabled && root.entries.length > 0;
            clicked => { menu.show(); }
        }
    }
    Rectangle {
        visible: false;
        width: 0;
        height: 0;
        measure := VerticalLayout {
            for entry in root.entries: Text { text: entry.text; font-size: Theme.font-tab; }
        }
    }
    menu := PopupWindow {
        x: root.width - root.menu-width;
        y: root.height + 2px;
        width: root.menu-width;
        Rectangle {
            background: Theme.bg-panel;
            border-color: Theme.line;
            border-width: 1px;
            border-radius: Theme.radius-panel;
            VerticalLayout {
                padding: 2px;
                for entry in root.entries: VerticalLayout {
                    if entry.id == "": Rectangle {
                        height: 7px;
                        Rectangle { x: 8px; width: parent.width - 16px; height: 1px; background: Theme.line; }
                    }
                    if entry.id != "": MenuRow {
                        text: entry.text;
                        enabled: entry.enabled;
                        picked => {
                            menu.close();
                            root.picked(entry.id);
                        }
                    }
                }
            }
        }
    }
}

// Status colours: amber for warnings (the theme has no token for it: a
// darker amber on a light palette's panels), the theme's danger red for
// revoked or tampered things.
export global Tone {
    out property <color> warn: Theme.bg-panel.to-hsv().value > 0.5 ? #a8670a : #e3a336;
    out property <color> danger: Theme.danger;
    // 0 plain, 1 accent, 2 warn, 3 danger, 4 dim.
    public pure function color(tone: int) -> color {
        return tone == 1 ? Theme.accent : tone == 2 ? self.warn : tone == 3 ? self.danger : tone == 4 ? Theme.text-dim : Theme.text-list;
    }
}

export component Label inherits Text {
    color: Theme.text;
    font-size: Theme.font-body;
    vertical-alignment: center;
}

export component Cell inherits Text {
    font-size: Theme.font-body;
    vertical-alignment: center;
    overflow: elide;
}

// A filter toggle: 21px, accent text and a selected background when on.
export component Chip {
    in property <string> text;
    in property <bool> checked;
    callback clicked();
    height: Theme.button-height;
    // Its label with 8px on each side; rows set at least their own width.
    preferred-width: chip-label.preferred-width + 16px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    Rectangle {
        border-radius: Theme.radius-control;
        background: root.checked ? Theme.selected-bg : touch.pressed ? Theme.button-press : touch.has-hover ? Theme.button-hover : Theme.button-bg;
        border-width: root.checked ? 1px : 0px;
        border-color: Theme.accent;
    }
    chip-label := Text {
        text: root.text;
        color: root.checked ? Theme.accent : Theme.text-list;
        font-size: Theme.font-body;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component ChoiceItem {
    in property <string> text;
    in property <bool> selected;
    callback picked();
    height: 20px;
    Rectangle { background: touch.has-hover ? Theme.press-bg : transparent; }
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        spacing: 4px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.selected ? Theme.playing : transparent;
            }
        }
        Text {
            text: root.text;
            color: touch.has-hover ? Theme.accent : Theme.text-list;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea { clicked => { root.picked(); } }
}

// 21px drop-down; the list opens below and scrolls past `popup-height`.
// `first-label`, when set, is shown for the first entry instead of its text.
export component Choice {
    in property <[string]> model;
    in property <string> first-label;
    in property <int> current-index;
    in property <bool> enabled: true;
    in property <length> popup-height: 220px;
    callback selected(int);
    height: 21px;
    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-value: root.label(root.current-index);
    pure function label(index: int) -> string {
        return index == 0 && root.first-label != "" ? root.first-label
            : index >= 0 && index < root.model.length ? root.model[index] : "";
    }
    Rectangle {
        border-radius: Theme.radius-control;
        background: !root.enabled ? Theme.button-disabled
            : touch.pressed ? Theme.button-press
            : touch.has-hover ? Theme.button-hover : Theme.button-bg;
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 5px;
        spacing: 2px;
        Text {
            horizontal-stretch: 1;
            text: root.label(root.current-index);
            color: root.enabled ? Theme.text-list : Theme.text-dim;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
        }
        // The drop-down arrow: a small V.
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            Icon { name: "caret-down"; color: root.enabled ? Theme.text-dim : Theme.icon-disabled; }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { list.show(); }
    }
    list := PopupWindow {
        x: 0;
        y: root.height;
        width: max(root.width, 120px);
        height: min(root.model.length * 20px + 2px, root.popup-height);
        Rectangle {
            background: Theme.bg-list;
            border-color: Theme.line;
            border-width: 1px;
            ListView {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                for name[index] in root.model: ChoiceItem {
                    text: root.label(index);
                    selected: index == root.current-index;
                    picked => {
                        root.selected(index);
                        list.close();
                    }
                }
            }
        }
    }
}

// 14px check box with a label; the plugin owns the state (`clicked` asks it).
export component Check {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback clicked();
    // One row; a label longer than the room wraps onto more lines.
    min-height: Theme.checkbox-row-height;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    HorizontalLayout {
        spacing: 5px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 13px;
                height: 13px;
                border-radius: 3px;
                border-width: root.checked ? 0px : 1px;
                border-color: touch.has-hover && root.enabled ? Theme.accent : Theme.text-dim;
                background: root.checked ? Theme.accent : Theme.bg-list;
                if root.checked: Icon { name: "check-box"; color: Colors.white; }
            }
        }
        Text {
            text: root.text;
            color: root.enabled ? Theme.text-list : Theme.text-dim;
            font-size: Theme.font-body;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

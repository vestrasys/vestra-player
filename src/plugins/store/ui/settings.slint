// Plugin Store settings page (options window ▸ Plugins, id store.repos):
// automatic update checks and the repositories. Width 440: 6px padding leaves
// 428; a repository row is name / address (stretch) and a 50px Remove button.
import { LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button } from "@vestra/widgets.slint";
import { Cell, Check, Tone } from "parts.slint";
import { Msg, Words } from "words.slint";

export struct RepoRow {
    name: Msg,
    url: string,
    note: Msg,
    // 0 plain, 2 warn (see Tone)
    tone: int,
    removable: bool,
}

export global StoreSettings {
    in property <bool> auto-check: true;
    in property <[RepoRow]> repos;
    in property <bool> adding;
    in-out property <string> add-text;
    in property <bool> can-add: true;
    in property <Msg> message;
    in property <bool> message-warn;
    callback toggle-auto();
    callback start-add();
    callback add(string);
    callback cancel-add();
    callback remove(string);
}

export component StorePage inherits Rectangle {
    height: 400px;
    VerticalLayout {
        padding: 6px;
        spacing: 6px;
        Check {
            text: @tr("Check for updates automatically (30 seconds after the player starts, then every 24 hours)");
            checked: StoreSettings.auto-check;
            clicked => { StoreSettings.toggle-auto(); }
        }
        Text {
            text: @tr("When off, the store goes online only when you open it or click “Refresh”; plugins revoked by a repository are disabled only then too. When updates are available, the “Plugin Store…” menu item shows how many.");
            color: Theme.text-dim;
            font-size: Theme.font-body;
            wrap: word-wrap;
            line-height-factor: 1.25;
        }
        Rectangle { height: 4px; }
        Cell { text: @tr("Repositories"); color: Theme.text; }
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-list;
            border-width: 1px;
            border-color: Theme.line;
            ListView {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                for repo in StoreSettings.repos: HorizontalLayout {
                    height: 38px;
                    padding-left: 6px;
                    padding-right: 10px;
                    spacing: 6px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Cell { text: Words.msg(repo.name); color: Theme.text; }
                        Cell { text: repo.url; color: Theme.text-dim; }
                        if Words.msg(repo.note) != "": Cell { text: Words.msg(repo.note); color: Tone.color(repo.tone); }
                    }
                    VerticalLayout {
                        width: 50px;
                        alignment: center;
                        if repo.removable: Button {
                            small: true;
                            text: @tr("Remove");
                            clicked => { StoreSettings.remove(repo.url); }
                        }
                    }
                }
            }
        }
        if !StoreSettings.adding: HorizontalLayout {
            height: Theme.button-height;
            Button {
                width: 84px;
                text: @tr("Add Repository…");
                enabled: StoreSettings.can-add;
                clicked => { StoreSettings.start-add(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        // One line: address, Add, Cancel (Enter adds, Esc cancels). The fluent
        // LineEdit asks for 32px; pinned to input-height (as the row) it stays
        // inside the row, so the warning below starts under it.
        if StoreSettings.adding: FocusScope {
            height: Theme.input-height;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    StoreSettings.cancel-add();
                    return accept;
                }
                return reject;
            }
            HorizontalLayout {
                spacing: 6px;
                address := LineEdit {
                    height: Theme.input-height;
                    horizontal-stretch: 1;
                    font-size: Theme.font-body;
                    placeholder-text: @tr("The repository's root address or the full address of index.json (https://…)");
                    text <=> StoreSettings.add-text;
                    accepted(text) => { StoreSettings.add(text); }
                    init => { self.focus(); }
                }
                VerticalLayout {
                    alignment: center;
                    Button { width: 52px; text: @tr("Add"); clicked => { StoreSettings.add(address.text); } }
                }
                VerticalLayout {
                    alignment: center;
                    Button { width: 52px; text: @tr("Cancel"); clicked => { StoreSettings.cancel-add(); } }
                }
            }
        }
        Text {
            text: @tr("Third-party repositories are not reviewed by Vestra Player; their plugins may read your files or use the network. Only add repositories you trust. The official repository cannot be removed; to keep the store offline, disable the Plugin Store in “Plugin Manager”.");
            color: Tone.warn;
            font-size: Theme.font-body;
            wrap: word-wrap;
            line-height-factor: 1.25;
        }
        if Words.msg(StoreSettings.message) != "": Text {
            text: Words.msg(StoreSettings.message);
            color: StoreSettings.message-warn ? Tone.warn : Theme.text-dim;
            font-size: Theme.font-body;
            wrap: word-wrap;
            line-height-factor: 1.25;
        }
    }
}

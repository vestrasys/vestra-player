// Options ▸ Appearance ▸ Logo and Album Cover: the settings page for H12 and J11 (440 wide,
// the options window's page area). The same switches as the menu items.
// Heights (padding 14): title 24 + 6 + section 14 + 6 + check 18 + 8 + logo row 64
//   + 6 + note 14 + 14 + section 14 + 6 + check 18 + 6 + note 28 + 8 + cache row 21 = 297 + 28.
import { CheckBox } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button } from "@vestra/widgets.slint";

export global LogoPage {
    in-out property <bool> idle-on: true;
    in-out property <bool> audio-on: true;
    in property <bool> custom-logo: false;
    in property <image> logo;
    // The cover cache: unavailable without a data directory; else its tracks and size ("12.3 MB").
    in property <bool> cache-available: true;
    in property <int> cache-entries: 0;
    in property <string> cache-size;
    in property <bool> can-clear: false;
    callback set-idle(bool);
    callback set-audio(bool);
    callback choose-logo();
    callback reset-logo();
    callback clear-cache();
}

component Section inherits Text {
    height: Theme.label-height;
    font-size: Theme.font-body;
    color: Theme.text-dim;
}

export component LogoCoverPage inherits Rectangle {
    background: Theme.bg-panel;
    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: 6px;
        alignment: start;
        Text {
            height: 24px;
            text: @tr("Logo and Album Cover");
            font-size: Theme.font-title;
            font-weight: 700;
            vertical-alignment: center;
            color: Theme.text;
        }
        Section { text: @tr("Idle screen"); }
        CheckBox {
            height: Theme.checkbox-row-height;
            text: @tr("Show logo when idle");
            checked <=> LogoPage.idle-on;
            toggled => { LogoPage.set-idle(self.checked); }
        }
        HorizontalLayout {
            height: 64px;
            spacing: 12px;
            padding-left: 22px;
            // The logo as the idle screen shows it: on the video background.
            Rectangle {
                width: 96px;
                border-radius: Theme.radius-control;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.bg-video;
                Image {
                    width: 44px;
                    height: 44px;
                    source: LogoPage.custom-logo ? LogoPage.logo : @image-url("logo.png");
                    image-fit: contain;
                    opacity: LogoPage.idle-on ? 0.92 : 0.35;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: LogoPage.custom-logo ? @tr("Current: custom image") : @tr("Current: Vestra Player logo");
                    font-size: Theme.font-body;
                    color: Theme.text-list;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Button { width: 96px; text: @tr("Choose Image…"); clicked => { LogoPage.choose-logo(); } }
                    Button { width: 96px; text: @tr("Restore Default"); enabled: LogoPage.custom-logo; clicked => { LogoPage.reset-logo(); } }
                }
            }
        }
        Text {
            height: Theme.label-height;
            text: @tr("PNG or JPEG, up to 4096×4096 and 16 MB. The image is copied, so the original can be moved.");
            font-size: Theme.font-body;
            color: Theme.text-dim;
            overflow: elide;
        }
        Rectangle { height: 8px; }
        Section { text: @tr("Audio only"); }
        CheckBox {
            height: Theme.checkbox-row-height;
            text: @tr("Show album cover for audio only");
            checked <=> LogoPage.audio-on;
            toggled => { LogoPage.set-audio(self.checked); }
        }
        // No fixed height: the layout gives the wrapped text all its lines.
        Text {
            text: @tr("The cover comes from the picture embedded in the file, or a cover, folder or front image in the same folder; without one the logo is shown as a placeholder.");
            font-size: Theme.font-body;
            color: Theme.text-dim;
            wrap: word-wrap;
            line-height-factor: 1.25;
        }
        HorizontalLayout {
            height: Theme.button-height;
            spacing: 6px;
            Text {
                horizontal-stretch: 1;
                text: !LogoPage.cache-available ? @tr("Cover cache unavailable")
                    : LogoPage.cache-entries == 0 ? @tr("Cover cache: empty")
                    : @tr("Cover cache: {n} track, {0}" | "Cover cache: {n} tracks, {0}" % LogoPage.cache-entries, LogoPage.cache-size);
                font-size: Theme.font-body;
                color: Theme.text-list;
                vertical-alignment: center;
                overflow: elide;
            }
            Button { width: 96px; text: @tr("Clear Cover Cache"); enabled: LogoPage.can-clear; clicked => { LogoPage.clear-cache(); } }
        }
    }
}

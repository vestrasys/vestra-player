{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "skipLibCheck": true,
    "paths": {
      "jsnes": ["./plugins/nes/node_modules/jsnes/src/nes.d.ts"]
    }
  },
  "include": [
    "runtime/**/*.ts",
    "examples/**/*.ts",
    "plugins/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["**/node_modules/**", "**/vendor/**", "**/dist/**"]
}

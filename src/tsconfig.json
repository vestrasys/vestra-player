{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "sdk/**/*.ts",
    "runtime/**/*.ts",
    "examples/**/*.ts",
    "plugins/**/*.ts",
    "tests/**/*.ts"
  ]
}

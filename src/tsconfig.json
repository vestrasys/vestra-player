{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "sdk/**/*.ts",
    "runtime/**/*.ts",
    "tests/**/*.ts",
    "plugins/**/*.ts",
    "tools/**/*.ts"
  ],
  "exclude": ["**/node_modules/**", "host/**"]
}
